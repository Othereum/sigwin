// The image viewer window. Fixed dark look: globals (`Theme`) aren't shared between windows.

component ViewerButton inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 13px;
    in property <string> font-family;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    min-height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? #ffffff30 : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: white;
            font-size: root.font-size;
            font-family: root.font-family;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ImageViewer inherits Window {
    in property <image> source;
    // "2 / 3"; empty for a single image
    in property <string> caption;
    // size to draw the image at, physical px
    in property <int> shown-w;
    in property <int> shown-h;
    // width of the original, for the scale readout
    in property <int> original-w;
    // wanted offset of the image from the center when it is bigger than the window, physical px
    in-out property <float> pan-x;
    in-out property <float> pan-y;
    callback prev();
    callback next();
    callback save();
    callback open-outside();
    callback dismiss();
    callback resized();
    callback drag-window();
    // wheel notches (+ = up) and the cursor in physical px
    callback zoom(float, float, float);
    title: "이미지 보기";
    icon: @image-url("../assets/icon.png");
    default-font-family: "Malgun Gothic";
    background: #111111;
    no-frame: true;
    min-width: 360px;
    min-height: 240px;
    forward-focus: keys;
    changed width => { root.resized(); }
    changed height => { root.resized(); }

    // Normally 1:1 with the fitted image; until it arrives, and at high zoom, its pixels are
    // stretched to this size
    property <length> full-w: shown-w * 1phx;
    property <length> full-h: shown-h * 1phx;
    // how far the image sticks out of the window on each side, physical px
    property <float> over-x: max(0, (shown-w - root.width / 1phx) / 2);
    property <float> over-y: max(0, (shown-h - root.height / 1phx) / 2);
    property <bool> overflows: over-x > 0 || over-y > 0;
    // the image's offset from the center, physical px
    out property <float> cur-x: clamp(pan-x, -over-x, over-x);
    out property <float> cur-y: clamp(pan-y, -over-y, over-y);
    // this press moved the window or the image: its release is not a click
    property <bool> dragged;
    property <bool> panning;
    property <float> pan-start-x;
    property <float> pan-start-y;
    Image {
        source: root.source;
        image-fit: fill;
        width: full-w;
        height: full-h;
        x: round((root.width - self.width) / 2 / 1phx + cur-x) * 1phx;
        y: round((root.height - self.height) / 2 / 1phx + cur-y) * 1phx;
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                root.prev();
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.next();
                return accept;
            }
            reject
        }
    }

    // the parent of the controls, so hovering them still counts
    hover := TouchArea {
        mouse-cursor: !root.overflows ? MouseCursor.default : root.panning && self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragged = false;
                root.panning = false;
                root.pan-start-x = root.cur-x;
                root.pan-start-y = root.cur-y;
            }
        }
        moved => {
            if (!root.dragged && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                root.dragged = true;
                root.panning = root.overflows;
                if (!root.panning) {
                    root.drag-window();
                }
            }
            if (root.panning) {
                root.pan-x = root.pan-start-x + (self.mouse-x - self.pressed-x) / 1phx;
                root.pan-y = root.pan-start-y + (self.mouse-y - self.pressed-y) / 1phx;
            }
        }
        clicked => {
            if (!root.dragged) {
                root.dismiss();
            }
        }
        scroll-event(e) => {
            root.zoom(e.delta-y / 60px, self.mouse-x / 1phx, self.mouse-y / 1phx);
            accept
        }
        if hover.has-hover && hover.mouse-x > root.width - 100px && hover.mouse-y < 100px: ViewerButton {
            x: root.width - self.width - 12px;
            y: 12px;
            width: 36px;
            height: 36px;
            text: "✕";
            font-family: "Segoe UI Symbol";
            background: self.hovered ? #c42b1c : #00000090;
            clicked => { root.dismiss(); }
        }
        if hover.has-hover && root.caption != "": ViewerButton {
            x: 12px;
            y: (root.height - self.height) / 2;
            width: 44px;
            height: 64px;
            text: "‹";
            font-size: 28px;
            background: self.hovered ? #000000d0 : #00000090;
            clicked => { root.prev(); }
        }
        if hover.has-hover && root.caption != "": ViewerButton {
            x: root.width - self.width - 12px;
            y: (root.height - self.height) / 2;
            width: 44px;
            height: 64px;
            text: "›";
            font-size: 28px;
            background: self.hovered ? #000000d0 : #00000090;
            clicked => { root.next(); }
        }
        if hover.has-hover: Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - self.height - 12px;
            width: bar.preferred-width;
            height: bar.preferred-height;
            border-radius: 8px;
            background: #000000c0;
            // clicks between the buttons don't close the window
            TouchArea {}
            bar := HorizontalLayout {
                padding: 4px;
                spacing: 2px;
                if root.caption != "": Text {
                    text: root.caption;
                    color: white;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: self.preferred-width + 20px;
                }
                Text {
                    text: round(root.shown-w * 100 / max(root.original-w, 1)) + "%";
                    color: white;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: self.preferred-width + 20px;
                }
                ViewerButton {
                    text: "저장";
                    clicked => { root.save(); }
                }
                ViewerButton {
                    text: "기본 앱으로 열기";
                    clicked => { root.open-outside(); }
                }
            }
        }
    }
}
