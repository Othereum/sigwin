// The image viewer window. Fixed dark look: globals (`Theme`) aren't shared between windows.

import { Notice } from "widgets.slint";
import { MediaLabel, VideoMark } from "bubble.slint";
import { MediaState } from "types.slint";
import { Icon, Icons } from "icons.slint";

component ViewerButton inherits Rectangle {
    in property <string> text;
    // one of `Icons`, before the text or alone
    in property <string> icon;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    min-height: 30px;
    border-radius: 7px;
    background: ta.has-hover ? #ffffff30 : transparent;
    HorizontalLayout {
        padding-left: root.text != "" ? 8px : 0px;
        padding-right: root.text != "" ? 10px : 0px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            size: root.text != "" ? 16px : 18px;
            icon: root.icon;
            tint: white;
        }
        if root.text != "": Text {
            text: root.text;
            color: white;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// round previous / next button
component NavButton inherits Rectangle {
    in property <bool> forward;
    callback clicked();
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: ta.has-hover ? #000000e0 : #000000a0;
    border-width: 1px;
    border-color: ta.has-hover ? #ffffff60 : #ffffff28;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 24px;
        icon: root.forward ? Icons.chevron-right : Icons.chevron-left;
        tint: white;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ImageViewer inherits Window {
    in property <image> source;
    // of the images in the message, empty for a single image; blank until each one arrives
    in property <[image]> thumbs;
    // the one on screen, or on its way
    in property <int> current;
    // size to draw the image at, physical px
    in property <int> shown-w;
    in property <int> shown-h;
    // width of the original, for the scale readout
    in property <int> original-w;
    // the scale readout is showing: for a moment after each wheel notch
    in property <bool> scale-on;
    in property <string> notice-text;
    in property <string> notice-action;
    callback notice-action-clicked();
    // the thumbnail strip is showing wherever the cursor is: for a moment after going to an image
    in property <bool> strip-on;
    // for a moment after opening: the buttons at the top show wherever the cursor is
    in property <bool> top-on;
    // for a moment after opening, a bit longer: the hint shows, if it's on
    in property <bool> intro-on;
    // how to close without the ✕, until the user once has
    in property <bool> hint-on;
    // wanted offset of the image from the center when it is bigger than the window, physical px
    in-out property <float> pan-x;
    in-out property <float> pan-y;
    // the visible part of the image, resampled: drawn 1:1 over the stretched `source`, at this
    // offset within the image, physical px
    in property <image> patch;
    in property <bool> patch-on;
    in property <int> patch-x;
    in property <int> patch-y;
    // the image moved within the window
    callback panned();
    // a press started: where a drag of the window would start from
    callback press-started();
    // the image is being dragged and fits the window on one axis: the window moves on that axis
    callback window-followed();
    callback go(int);
    callback prev();
    callback next();
    callback save();
    callback open-outside();
    callback dismiss();
    // closed by a click or Esc, before `dismiss`
    callback quick-closed();
    // the picture on screen is on its way: how far (one), and its mark stops or restarts that
    in property <[MediaState]> loading;
    callback toggle-download();
    callback resized();
    callback drag-window();
    // wheel notches (+ = up) and the cursor in physical px
    callback zoom(float, float, float);
    title: "이미지 보기";
    icon: @image-url("../assets/icon.png");
    default-font-family: "Malgun Gothic";
    // flipped to force a full repaint: the two colors look the same (see `viewer::repaint`)
    in property <bool> repaint-flip;
    background: repaint-flip ? #111112 : #111111;
    no-frame: true;
    min-width: 360px;
    min-height: 240px;
    forward-focus: keys;
    changed width => { root.resized(); }
    changed height => { root.resized(); }

    // Pixels of `source` are stretched to this size (nearest neighbor)
    property <length> full-w: shown-w * 1phx;
    property <length> full-h: shown-h * 1phx;
    // how far the image sticks out of the window on each side, physical px
    property <float> over-x: max(0, (shown-w - root.width / 1phx) / 2);
    property <float> over-y: max(0, (shown-h - root.height / 1phx) / 2);
    property <bool> overflows: over-x > 0 || over-y > 0;
    // the image's offset from the center, physical px
    out property <float> cur-x: clamp(pan-x, -over-x, over-x);
    out property <float> cur-y: clamp(pan-y, -over-y, over-y);
    // this press moved the window or the image: its release is not a click
    property <bool> has-strip: root.thumbs.length > 1;
    property <length> strip-w: min(root.thumbs.length * 48px - 4px, root.width - 32px);
    // the strip shows when the cursor is about where it appears
    property <bool> near-strip: hover.has-hover && hover.mouse-y > root.height - 100px && abs(hover.mouse-x - root.width / 2) < strip-w / 2 + 40px;
    property <bool> strip-shown: root.has-strip && (root.near-strip || root.strip-on);
    // what sits above the strip moves along with its fade; only this animates, not their `y`,
    // which must follow the window as the wheel resizes it
    property <length> strip-lift: root.strip-shown ? 58px : 0px;
    animate strip-lift { duration: root.strip-shown ? 100ms : 250ms; }
    // height of the cursor where the previous and next buttons may show
    property <bool> near-side: hover.has-hover && root.has-strip && abs(hover.mouse-y - root.height / 2) < 130px;
    // the buttons at the top right show when the cursor is about where they appear
    property <bool> near-top: hover.has-hover && hover.mouse-y < 100px && hover.mouse-x > root.width - 300px;
    property <bool> top-shown: root.near-top || root.top-on;
    property <bool> dragged;
    property <bool> panning;
    property <float> pan-start-x;
    property <float> pan-start-y;
    property <length> image-x: round((root.width - full-w) / 2 / 1phx + cur-x) * 1phx;
    property <length> image-y: round((root.height - full-h) / 2 / 1phx + cur-y) * 1phx;
    Image {
        source: root.source;
        image-fit: fill;
        width: full-w;
        height: full-h;
        x: image-x;
        y: image-y;
    }
    if root.patch-on: Image {
        source: root.patch;
        image-fit: fill;
        width: root.patch.width * 1phx;
        height: root.patch.height * 1phx;
        x: image-x + root.patch-x * 1phx;
        y: image-y + root.patch-y * 1phx;
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.quick-closed();
                root.dismiss();
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                root.prev();
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.next();
                return accept;
            }
            reject
        }
    }

    // the parent of the controls, so hovering them still counts
    hover := TouchArea {
        mouse-cursor: !root.overflows ? MouseCursor.default : root.panning && self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragged = false;
                root.panning = false;
                root.pan-start-x = root.cur-x;
                root.pan-start-y = root.cur-y;
                root.press-started();
            }
        }
        moved => {
            if (!root.dragged && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                root.dragged = true;
                root.panning = root.overflows;
                if (!root.panning) {
                    root.drag-window();
                }
            }
            if (root.panning) {
                let old-x = root.cur-x;
                let old-y = root.cur-y;
                // on an axis where the image fits, `cur-x` / `cur-y` ignore this
                root.pan-x = root.pan-start-x + (self.mouse-x - self.pressed-x) / 1phx;
                root.pan-y = root.pan-start-y + (self.mouse-y - self.pressed-y) / 1phx;
                if (old-x != root.cur-x || old-y != root.cur-y) {
                    root.panned();
                }
                if (root.over-x == 0 || root.over-y == 0) {
                    root.window-followed();
                }
            }
        }
        clicked => {
            if (!root.dragged) {
                root.quick-closed();
                root.dismiss();
            }
        }
        scroll-event(e) => {
            root.zoom(e.delta-y / 60px, self.mouse-x / 1phx, self.mouse-y / 1phx);
            accept
        }
        // a picture on its way, over its blurhash: the list's mark, and how much has come
        // (here already, it is only being decoded: no mark)
        if root.loading.length > 0 && root.loading[0].undownloaded: VerticalLayout {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: 8px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                VideoMark {
                    undownloaded: true;
                    progress: root.loading[0].progress;
                    ring: root.loading[0].ring;
                    hovered: mark-ta.has-hover;
                    mark-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-download(); }
                    }
                }
            }
            if root.loading[0].label != "": HorizontalLayout {
                alignment: center;
                MediaLabel {
                    text: root.loading[0].label;
                }
            }
        }
        Rectangle {
            // apart from ✕, which closes the window
            x: root.width - self.width - 56px;
            y: 12px;
            width: bar.preferred-width;
            height: bar.preferred-height;
            border-radius: 10px;
            background: #000000c0;
            opacity: root.top-shown ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: root.top-shown ? 100ms : 250ms; }
            // clicks between the buttons don't close the window
            TouchArea {}
            bar := HorizontalLayout {
                padding: 3px;
                spacing: 2px;
                ViewerButton {
                    text: "저장";
                    icon: Icons.download;
                    clicked => { root.save(); }
                }
                ViewerButton {
                    text: "기본 앱으로 열기";
                    icon: Icons.open-outside;
                    clicked => { root.open-outside(); }
                }
            }
        }
        ViewerButton {
            x: root.width - self.width - 12px;
            y: 12px;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            opacity: root.top-shown ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: root.top-shown ? 100ms : 250ms; }
            icon: Icons.close;
            background: self.hovered ? #c42b1c : #00000090;
            clicked => { root.dismiss(); }
        }
        if root.near-side && hover.mouse-x < 100px: NavButton {
            x: 12px;
            y: (root.height - self.height) / 2;
            clicked => { root.prev(); }
        }
        if root.near-side && hover.mouse-x > root.width - 100px: NavButton {
            forward: true;
            x: root.width - self.width - 12px;
            y: (root.height - self.height) / 2;
            clicked => { root.next(); }
        }
        if root.has-strip: Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - self.height - 12px;
            width: root.strip-w + 8px;
            height: 52px;
            border-radius: 8px;
            background: #000000c0;
            opacity: root.strip-shown ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: root.strip-shown ? 100ms : 250ms; }
            // clicks between the thumbnails don't close the window. The wheel over the strip
            // scrolls it instead of zooming: the horizontal Flickable rejects the wheel and it
            // bubbles to this parent.
            TouchArea {
                scroll-event(e) => {
                    strip.content-x = clamp(strip.content-x + (e.delta-y != 0px ? e.delta-y : e.delta-x),
                        min(0px, strip.width - strip.content-width), 0px);
                    accept
                }
                strip := Flickable {
                    property <int> at: root.current;
                    property <bool> shown: root.strip-shown;
                    function reveal() {
                        // the current one in the middle, as far as the row goes
                        self.content-x = -clamp(at * 48px - (self.width - 44px) / 2, 0px, max(0px, self.content-width - self.width));
                    }
                    init => { self.reveal(); }
                    changed at => { self.reveal(); }
                    // a row scrolled away while it showed comes back around the current one
                    changed shown => {
                        if (self.shown) {
                            self.reveal();
                        }
                    }
                    x: 4px;
                    y: 4px;
                    width: root.strip-w;
                    height: 44px;
                    content-width: root.thumbs.length * 48px - 4px;
                    for thumb[i] in root.thumbs: Rectangle {
                        x: i * 48px;
                        width: 44px;
                        height: 44px;
                        border-radius: 4px;
                        clip: true;
                        background: #ffffff20;
                        Image {
                            source: thumb;
                            width: 100%;
                            height: 100%;
                            image-fit: fill;
                        }
                        Rectangle {
                            background: i == root.current || cell.has-hover ? transparent : #00000070;
                            border-radius: 4px;
                            border-width: i == root.current ? 2px : 0px;
                            border-color: white;
                        }
                        cell := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.go(i); }
                        }
                    }
                }
            }
        }
    }

    // above the strip if it's showing; clicks go through it
    if root.scale-on: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 12px - root.strip-lift;
        width: scale-text.preferred-width + 24px;
        height: 30px;
        border-radius: 8px;
        background: #000000c0;
        scale-text := Text {
            text: round(root.shown-w * 100 / max(root.original-w, 1)) + "%";
            color: white;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // above the scale readout
    if root.notice-text != "": Notice {
        text: root.notice-text;
        action: root.notice-action;
        action-clicked => { root.notice-action-clicked(); }
        max-text-width: root.width - 64px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 50px - root.strip-lift;
    }
    // where the notice would be, which comes first
    if root.notice-text == "" && root.hint-on: Notice {
        text: "이미지를 클릭하거나 Esc를 눌러 닫을 수 있습니다";
        opacity: root.intro-on ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 250ms; }
        max-text-width: root.width - 64px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 50px - root.strip-lift;
    }
}
