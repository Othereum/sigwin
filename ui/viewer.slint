// The image viewer window. Fixed dark look: globals (`Theme`) aren't shared between windows.

import { Notice } from "widgets.slint";

component ViewerButton inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 13px;
    in property <string> font-family;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    min-height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? #ffffff30 : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: white;
            font-size: root.font-size;
            font-family: root.font-family;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ImageViewer inherits Window {
    in property <image> source;
    // of the images in the message, empty for a single image; blank until each one arrives
    in property <[image]> thumbs;
    // the one on screen, or on its way
    in property <int> current;
    // size to draw the image at, physical px
    in property <int> shown-w;
    in property <int> shown-h;
    // width of the original, for the scale readout
    in property <int> original-w;
    // the scale readout is showing: for a moment after each wheel notch
    in property <bool> scale-on;
    in property <string> notice-text;
    // the thumbnail strip is showing wherever the cursor is: for a moment after going to an image
    in property <bool> strip-on;
    // wanted offset of the image from the center when it is bigger than the window, physical px
    in-out property <float> pan-x;
    in-out property <float> pan-y;
    // the visible part of the image, resampled: drawn 1:1 over the stretched `source`, at this
    // offset within the image, physical px
    in property <image> patch;
    in property <bool> patch-on;
    in property <int> patch-x;
    in property <int> patch-y;
    callback panned();
    callback go(int);
    callback prev();
    callback next();
    callback save();
    callback open-outside();
    callback dismiss();
    callback resized();
    callback drag-window();
    // wheel notches (+ = up) and the cursor in physical px
    callback zoom(float, float, float);
    title: "이미지 보기";
    icon: @image-url("../assets/icon.png");
    default-font-family: "Malgun Gothic";
    // flipped to force a full repaint: the two colors look the same (see `viewer::repaint`)
    in property <bool> repaint-flip;
    background: repaint-flip ? #111112 : #111111;
    no-frame: true;
    min-width: 360px;
    min-height: 240px;
    forward-focus: keys;
    changed width => { root.resized(); }
    changed height => { root.resized(); }

    // Pixels of `source` are stretched to this size (nearest neighbor)
    property <length> full-w: shown-w * 1phx;
    property <length> full-h: shown-h * 1phx;
    // how far the image sticks out of the window on each side, physical px
    property <float> over-x: max(0, (shown-w - root.width / 1phx) / 2);
    property <float> over-y: max(0, (shown-h - root.height / 1phx) / 2);
    property <bool> overflows: over-x > 0 || over-y > 0;
    // the image's offset from the center, physical px
    out property <float> cur-x: clamp(pan-x, -over-x, over-x);
    out property <float> cur-y: clamp(pan-y, -over-y, over-y);
    // this press moved the window or the image: its release is not a click
    property <bool> has-strip: root.thumbs.length > 1;
    property <length> strip-w: min(root.thumbs.length * 48px - 4px, root.width - 32px);
    property <bool> strip-shown: root.has-strip && (root.near-bar || root.strip-on);
    // height of the cursor where the previous and next buttons may show
    property <bool> near-side: hover.has-hover && root.has-strip && abs(hover.mouse-y - root.height / 2) < 130px;
    // the bar shows when the cursor is about where it appears
    property <bool> near-bar: hover.has-hover && hover.mouse-y > root.height - (has-strip ? 150px : 100px) && abs(hover.mouse-x - root.width / 2) < max(200px, has-strip ? strip-w / 2 + 40px : 0px);
    property <bool> dragged;
    property <bool> panning;
    property <float> pan-start-x;
    property <float> pan-start-y;
    property <length> image-x: round((root.width - full-w) / 2 / 1phx + cur-x) * 1phx;
    property <length> image-y: round((root.height - full-h) / 2 / 1phx + cur-y) * 1phx;
    Image {
        source: root.source;
        image-fit: fill;
        width: full-w;
        height: full-h;
        x: image-x;
        y: image-y;
    }
    if root.patch-on: Image {
        source: root.patch;
        image-fit: fill;
        width: root.patch.width * 1phx;
        height: root.patch.height * 1phx;
        x: image-x + root.patch-x * 1phx;
        y: image-y + root.patch-y * 1phx;
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                root.prev();
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.next();
                return accept;
            }
            reject
        }
    }

    // the parent of the controls, so hovering them still counts
    hover := TouchArea {
        mouse-cursor: !root.overflows ? MouseCursor.default : root.panning && self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragged = false;
                root.panning = false;
                root.pan-start-x = root.cur-x;
                root.pan-start-y = root.cur-y;
            }
        }
        moved => {
            if (!root.dragged && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                root.dragged = true;
                root.panning = root.overflows;
                if (!root.panning) {
                    root.drag-window();
                }
            }
            if (root.panning) {
                root.pan-x = root.pan-start-x + (self.mouse-x - self.pressed-x) / 1phx;
                root.pan-y = root.pan-start-y + (self.mouse-y - self.pressed-y) / 1phx;
                root.panned();
            }
        }
        clicked => {
            if (!root.dragged) {
                root.dismiss();
            }
        }
        scroll-event(e) => {
            root.zoom(e.delta-y / 60px, self.mouse-x / 1phx, self.mouse-y / 1phx);
            accept
        }
        if hover.has-hover && hover.mouse-x > root.width - 100px && hover.mouse-y < 100px: ViewerButton {
            x: root.width - self.width - 12px;
            y: 12px;
            width: 36px;
            height: 36px;
            text: "✕";
            font-family: "Segoe UI Symbol";
            background: self.hovered ? #c42b1c : #00000090;
            clicked => { root.dismiss(); }
        }
        if root.near-side && hover.mouse-x < 100px: ViewerButton {
            x: 12px;
            y: (root.height - self.height) / 2;
            width: 44px;
            height: 64px;
            text: "‹";
            font-size: 28px;
            background: self.hovered ? #000000d0 : #00000090;
            clicked => { root.prev(); }
        }
        if root.near-side && hover.mouse-x > root.width - 100px: ViewerButton {
            x: root.width - self.width - 12px;
            y: (root.height - self.height) / 2;
            width: 44px;
            height: 64px;
            text: "›";
            font-size: 28px;
            background: self.hovered ? #000000d0 : #00000090;
            clicked => { root.next(); }
        }
        if root.near-bar: Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - self.height - 12px;
            width: bar.preferred-width;
            height: bar.preferred-height;
            border-radius: 8px;
            background: #000000c0;
            // clicks between the buttons don't close the window
            TouchArea {}
            bar := HorizontalLayout {
                padding: 4px;
                spacing: 2px;
                ViewerButton {
                    text: "저장";
                    clicked => { root.save(); }
                }
                ViewerButton {
                    text: "기본 앱으로 열기";
                    clicked => { root.open-outside(); }
                }
            }
        }
        if root.strip-shown: Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - self.height - 56px;
            width: root.strip-w + 8px;
            height: 52px;
            border-radius: 8px;
            background: #000000c0;
            // nor clicks between the thumbnails, or just below them on the way to the buttons
            TouchArea {
                height: parent.height + 6px;
                y: 0;
            }
            Flickable {
                property <int> at: root.current;
                function reveal() {
                    // the current one in the middle, as far as the row goes
                    self.content-x = -clamp(at * 48px - (self.width - 44px) / 2, 0px, max(0px, self.content-width - self.width));
                }
                init => { self.reveal(); }
                changed at => { self.reveal(); }
                x: 4px;
                y: 4px;
                width: root.strip-w;
                height: 44px;
                content-width: root.thumbs.length * 48px - 4px;
                for thumb[i] in root.thumbs: Rectangle {
                    x: i * 48px;
                    width: 44px;
                    height: 44px;
                    border-radius: 4px;
                    clip: true;
                    background: #ffffff20;
                    Image {
                        source: thumb;
                        width: 100%;
                        height: 100%;
                        image-fit: fill;
                    }
                    Rectangle {
                        background: i == root.current || cell.has-hover ? transparent : #00000070;
                        border-radius: 4px;
                        border-width: i == root.current ? 2px : 0px;
                        border-color: white;
                    }
                    cell := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.go(i); }
                    }
                }
            }
        }
    }

    // above the bar, which may not be showing; clicks go through it
    if root.scale-on: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (root.strip-shown ? 114px : 58px);
        width: scale-text.preferred-width + 24px;
        height: 30px;
        border-radius: 8px;
        background: #000000c0;
        scale-text := Text {
            text: round(root.shown-w * 100 / max(root.original-w, 1)) + "%";
            color: white;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // above the scale readout
    if root.notice-text != "": Notice {
        text: root.notice-text;
        max-text-width: root.width - 64px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (root.strip-shown ? 152px : 96px);
    }
}
