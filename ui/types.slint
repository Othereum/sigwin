// Data rows the Rust side fills (exported from app.slint for the generated code).

// one reader's photo (or the initial) under a message or in the thread list
export struct ReaderItem {
    photo: image,
    has-photo: bool,
    initial: string,
    tint: color,
}

export struct ThreadItem {
    key: string,
    name: string,
    snippet: string,
    time: string,
    unread: int,
    initial: string,
    color: color,
    is-group: bool,
    photo: image,
    has-photo: bool,
    // snippet is the unsent draft: shown after an italic "작성 중:"
    draft: bool,
    // notifications are off: a crossed-out bell, a grey unread count
    muted: bool,
    // photos of those who read our last message (the preview line), and how many more there are
    readers: [ReaderItem],
    readers-more: int,
}

// what a picture says about its download
export struct MediaState {
    // a video's length, or the size of what isn't downloaded yet
    label: string,
    // a click on it downloads it first
    undownloaded: bool,
    // percent while it downloads; -1: none
    progress: int,
    // that percent, drawn
    ring: image,
}

// one image of a message's grid
export struct ImageCell {
    x: length,
    y: length,
    w: length,
    h: length,
    image: image,
    // images not shown, covered by this cell's "+N"
    more: int,
    video: bool,
    // a GIF: it plays in place while the pointer is on it (`frames` then hold its current frame)
    gif: bool,
    // what it says about its download: one row, shared with every cell of the same picture and
    // changed in place, so a percent going up doesn't draw the cell again (a click that began on
    // the old one would end on nothing)
    state: [MediaState],
    // the playing GIF's frame: its index in `frame[0]` (empty: show `image`)
    frames: [image],
    frame: [int],
}

export struct ReactionItem {
    emoji: string,
    count: int,
    // our own reaction: the chip is highlighted
    mine: bool,
    // names of who reacted, joined by ", " ("나" for us)
    who: string,
}

export struct MsgItem {
    id: string,
    sender: string,
    sender-color: color,
    text: string,
    // text with highlighted @mentions and links (only when has-rich)
    rich: styled-text,
    has-rich: bool,
    time: string,
    outgoing: bool,
    show-sender: bool,
    // incoming in a group: photo column; the photo itself on the last row of a run
    avatar-col: bool,
    show-avatar: bool,
    avatar: image,
    has-avatar: bool,
    initial: string,
    status: string,
    // photos of those who read it (outgoing; replaces the status text) and how many more there are
    readers: [ReaderItem],
    readers-more: int,
    quote: string,
    quote-author: string,
    // sent timestamp of the quoted message (empty: not clickable)
    quote-id: string,
    // a picture of the quoted message, shown at the quote's right
    has-quote-image: bool,
    quote-image: image,
    reactions: [ReactionItem],
    // how many messages quote this one (a chip next to the reactions)
    replies: int,
    big-emoji: bool,
    attachment: string,
    // the file card: name, size and the badge text
    file-name: string,
    file-size: string,
    file-ext: string,
    // a kind that can run or change the system: marked
    file-danger: bool,
    // how far saving the files has come (one, while it is on its way), as a picture's `state`
    file-state: [MediaState],
    // a picture, video or sticker is shown (`cells`, or `image` for a sticker)
    has-image: bool,
    // a sticker's picture
    image: image,
    // animated sticker: frames and the current one's index in `frame[0]` (empty: show `image`)
    frames: [image],
    frame: [int],
    img-w: length,
    img-h: length,
    // the preview of a link in the text (link-url empty: none); link-img-w 0: no image
    link-url: string,
    link-title: string,
    link-desc: string,
    link-domain: string,
    link-image: image,
    link-img-w: length,
    link-img-h: length,
    // several images: the grid drawn instead of `image`
    cells: [ImageCell],
    deleted: bool,
    day-sep: bool,
    // the day it was sent on, for the date shown while scrolling (AppWindow.day-label)
    day: int,
    // the first unread message: a line above it
    unread-divider: bool,
    system: bool,
    sticker: bool,
    receipt-info: string,
    pending: bool,
    // the send failed: "다시 보내기" / "삭제" below the bubble
    failed: bool,
    // collapsed with the next row: no time / status footer
    hide-time: bool,
    // same run as the row above / below: flatter corners on that side, tighter spacing
    collapse-above: bool,
    collapse-below: bool,
    // the text is cut short: "더 읽기" under it
    more: bool,
    // the "someone is typing" bubble at the end of the list
    typing: bool,
}

export struct PinItem {
    // sent timestamp of the pinned message
    id: string,
    sender: string,
    text: string,
}

// a line of the list a message's reply chip opens
export struct ReplyItem {
    // sent timestamp of the reply
    id: string,
    sender: string,
    text: string,
    time: string,
}

export struct MentionItem {
    name: string,
    initial: string,
    tint: color,
}

// a line of the release notes: 0 = heading, 1 = bullet, 2 = text, 3 = version
export struct NoteLine {
    kind: int,
    text: string,
}

// an attachment waiting in the composer
export struct PendingFile {
    // the extension, drawn when there is no picture
    ext: string,
    thumb: image,
    has-thumb: bool,
    // plays while the pointer is on it
    gif: bool,
    // its frames are showing
    playing: bool,
    // not a picture or video: shown as a card with name and size
    is-file: bool,
    danger: bool,
    name: string,
    size: string,
}

export struct PackItem {
    id: string,
    title: string,
    installed: bool,
    cover: image,
}

export struct StickerItem {
    id: int,
    emoji: string,
    img: image,
    // plays while hovered (frames are loaded then and dropped after)
    animated: bool,
    frames: [image],
    frame: [int],
}
