// Device linking page (QR code).

import { Theme } from "theme.slint";
import { Field, PrimaryButton } from "widgets.slint";

export component LinkPage inherits Rectangle {
    in property <image> qr;
    in property <bool> has-qr;
    in property <string> status;
    in-out property <string> device-name: "Sigwin";
    callback start-link(string);
    background: Theme.pane;
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;
        Text {
            text: "Sigwin";
            font-size: 28px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("On your phone, open Signal → Settings → Linked devices → '+' and scan the QR code below.");
            color: Theme.subtle;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 280px;
                height: 280px;
                background: white;
                border-radius: 12px;
                if has-qr: Image {
                    width: 256px;
                    height: 256px;
                    source: qr;
                    image-rendering: pixelated;
                }
                if !has-qr: Text {
                    text: @tr("Waiting for the QR code");
                    color: #888;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Text { text: @tr("Device name"); color: Theme.text; vertical-alignment: center; }
            Field {
                width: 200px;
                height: 32px;
                text <=> root.device-name;
            }
            PrimaryButton {
                text: has-qr ? @tr("New QR code") : @tr("Start linking");
                clicked => { root.start-link(root.device-name); }
            }
        }
        Text {
            text: status;
            color: Theme.subtle;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
