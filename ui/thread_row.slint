// A row of the thread list.

import { ThreadItem } from "types.slint";
import { Theme } from "theme.slint";
import { Avatar } from "widgets.slint";
import { Icon, Icons } from "icons.slint";

// the unread count; grey while the thread is muted, unless something got through
component Unread inherits Rectangle {
    in property <ThreadItem> item;
    width: max(20px, count.preferred-width + 12px);
    height: 18px;
    border-radius: 9px;
    background: item.muted && !item.loud ? Theme.subtle : Theme.accent;
    count := Text {
        text: item.unread > 99 ? "99+" : item.unread;
        color: white;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ThreadRow inherits Rectangle {
    in property <ThreadItem> item;
    in property <bool> selected;
    // in the folded sidebar: the photo alone, with the unread count on it
    in property <bool> folded;
    // how much of the row's left takes the pointer; the folded sidebar's card shown whole over the
    // pane limits it to the rail's width, so only the photo's own place counts
    in property <length> hit-width: root.width;
    // the pointer lands on the visible card alone, not the margin and the 2px around it, where the
    // photo is all there is of the row
    property <bool> card-hit: root.folded || root.hit-width < root.width;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    // right click, at window coordinates
    callback menu(length, length);
    // the pointer came onto the row or left it; again when a row under it is reused for another
    // thread, as the list scrolls
    callback hover(bool);
    changed hovered => { root.hover(self.hovered); }
    changed item => {
        if (self.hovered) {
            root.hover(true);
        }
    }
    height: 64px;
    // the reader photos' outline: the row's own color
    property <color> ring: selected ? Theme.selected : (ta.has-hover ? Theme.hover : Theme.sidebar);
    // an inset card with round corners; the 2px between cards still takes the click
    Rectangle {
        x: 8px;
        y: 1px;
        width: parent.width - 16px;
        height: parent.height - 2px;
        border-radius: 10px;
        background: root.selected ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    }
    ta := TouchArea {
        x: root.card-hit ? 8px : 0px;
        y: root.card-hit ? 1px : 0px;
        width: min(root.hit-width, root.width) - (root.card-hit ? 16px : 0px);
        height: root.height - (root.card-hit ? 2px : 0px);
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        alignment: stretch;
        Avatar {
            y: (parent.height - self.height) / 2;
            initial: item.initial;
            tint: item.color;
            photo: item.photo;
            has-photo: item.has-photo;
        }
        if !root.folded: VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.name;
                    color: Theme.text;
                    font-weight: 700;
                    font-size: 14px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if item.muted: Icon {
                    y: (parent.height - self.height) / 2;
                    size: 14px;
                    icon: Icons.bell-off;
                    horizontal-stretch: 0;
                }
                Text {
                    text: item.time;
                    color: Theme.subtle;
                    font-size: 11px;
                    horizontal-stretch: 0;
                }
            }
            // nothing to put on the second line (a contact without a number): the name alone, centered
            if item.snippet != "" || item.draft || item.unread > 0 || item.readers.length > 0: HorizontalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    if item.draft: Text {
                        text: @tr("Draft:");
                        color: Theme.subtle;
                        font-size: 13px;
                        font-italic: true;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: item.snippet;
                        color: Theme.subtle;
                        font-size: 13px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                // who read our last message: overlapping round photos, ringed in the row's color
                if !item.draft && item.readers.length > 0: Rectangle {
                    horizontal-stretch: 0;
                    width: 16px + (item.readers.length + (item.readers-more > 0 ? 1 : 0) - 1) * 9px;
                    height: 16px;
                    for r[i] in item.readers: Rectangle {
                        x: i * 9px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: root.ring;
                        Avatar {
                            x: 1px;
                            y: 1px;
                            size: 14px;
                            initial: r.initial;
                            tint: r.tint;
                            photo: r.photo;
                            has-photo: r.has-photo;
                        }
                    }
                    if item.readers-more > 0: Rectangle {
                        x: item.readers.length * 9px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: root.ring;
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: Theme.hover;
                            Text {
                                text: "+" + item.readers-more;
                                font-size: 8px;
                                color: Theme.text;
                            }
                        }
                    }
                }
                if item.unread > 0: Unread {
                    horizontal-stretch: 0;
                    item: root.item;
                }
            }
        }
    }
    // over the photo's top right corner, ringed in the row's color to stand off it
    if root.folded && item.unread > 0: Rectangle {
        x: 18px + 40px + 6px - self.width;
        y: (parent.height - 40px) / 2 - 4px;
        width: badge.width + 4px;
        height: badge.height + 4px;
        border-radius: self.height / 2;
        background: root.ring;
        badge := Unread {
            x: 2px;
            y: 2px;
            item: root.item;
        }
    }
}
