// A row of the thread list.

import { ThreadItem } from "types.slint";
import { Theme } from "theme.slint";
import { Avatar } from "widgets.slint";

export component ThreadRow inherits Rectangle {
    in property <ThreadItem> item;
    in property <bool> selected;
    callback clicked;
    // right click, at window coordinates
    callback menu(length, length);
    height: 64px;
    background: selected ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    // the reader photos' outline: the row's own color
    property <color> ring: selected ? Theme.selected : (ta.has-hover ? Theme.hover : Theme.sidebar);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: stretch;
        Avatar {
            y: (parent.height - self.height) / 2;
            initial: item.initial;
            tint: item.color;
            photo: item.photo;
            has-photo: item.has-photo;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.name;
                    color: Theme.text;
                    font-weight: item.unread > 0 ? 700 : 500;
                    font-size: 14px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if item.muted: Text {
                    text: "🔕";
                    font-family: "Segoe UI Symbol";
                    color: Theme.subtle;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: item.time;
                    color: Theme.subtle;
                    font-size: 11px;
                    horizontal-stretch: 0;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    if item.draft: Text {
                        text: "작성 중:";
                        color: Theme.subtle;
                        font-size: 12.5px;
                        font-italic: true;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: item.snippet;
                        color: Theme.subtle;
                        font-size: 12.5px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                // who read our last message: overlapping round photos, ringed in the row's color
                if !item.draft && item.readers.length > 0: Rectangle {
                    horizontal-stretch: 0;
                    width: 16px + (item.readers.length + (item.readers-more > 0 ? 1 : 0) - 1) * 9px;
                    height: 16px;
                    for r[i] in item.readers: Rectangle {
                        x: i * 9px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: root.ring;
                        Avatar {
                            x: 1px;
                            y: 1px;
                            size: 14px;
                            initial: r.initial;
                            tint: r.tint;
                            photo: r.photo;
                            has-photo: r.has-photo;
                        }
                    }
                    if item.readers-more > 0: Rectangle {
                        x: item.readers.length * 9px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: root.ring;
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: Theme.hover;
                            Text {
                                text: "+" + item.readers-more;
                                font-size: 8px;
                                color: Theme.text;
                            }
                        }
                    }
                }
                if item.unread > 0: Rectangle {
                    horizontal-stretch: 0;
                    min-width: 20px;
                    height: 18px;
                    border-radius: 9px;
                    background: item.muted ? Theme.subtle : Theme.accent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: item.unread > 99 ? "99+" : item.unread;
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
