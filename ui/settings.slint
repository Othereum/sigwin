// Settings page.

import { ListView } from "std-widgets.slint";
import { Links, Theme } from "theme.slint";
import { Avatar, DangerButton, IconButton, PlainButton, Segmented, Toggle } from "widgets.slint";
import { Icons } from "icons.slint";

// a heading over its rows, which sit together on one rounded card
export component SettingSection inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    padding-top: 20px;
    HorizontalLayout {
        padding-left: 4px;
        Text {
            text: root.title;
            color: Theme.subtle;
            font-size: 12px;
            font-weight: 700;
        }
    }
    Rectangle {
        border-radius: 12px;
        background: Theme.group;
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 6px;
            padding-bottom: 6px;
            @children
        }
    }
}

// label (+ optional hint) on the left, a control on the right
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.label; color: Theme.text; font-size: 14px; wrap: word-wrap; }
        if root.hint != "": Text { text: root.hint; color: Theme.subtle; font-size: 12px; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

// a few related rows under a small heading, indented
export component SettingGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    padding-top: 12px;
    spacing: 2px;
    Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 700; }
    if root.hint != "": Text { text: root.hint; color: Theme.subtle; font-size: 12px; wrap: word-wrap; }
    HorizontalLayout {
        padding-top: 2px;
        padding-left: 16px;
        VerticalLayout {
            @children
        }
    }
}

// What the settings page shows and edits. Rust fills it (`gui::window::show_settings`) and
// reads it back on `changed`; the sidebar's update bar uses the update state too.
export global SettingsData {
    in-out property <bool> notify: true;
    in-out property <int> preview;
    in-out property <bool> sound: true;
    in-out property <int> badge-count: 0;
    in-out property <int> theme;
    // index into settings::LANGUAGES, and the one this run started with
    in-out property <int> language;
    in property <int> language-at-start;
    callback restart-app();
    // index into the zoom steps (see settings::ZOOMS)
    in-out property <int> zoom: 1;
    in-out property <bool> enter-sends: true;
    in-out property <bool> link-previews: true;
    in-out property <int> photo-quality: 0;
    in-out property <bool> autostart;
    in-out property <bool> start-hidden: true;
    in-out property <bool> auto-update: true;
    in-out property <bool> muted-mentions: true;
    in-out property <bool> muted-replies: true;
    in-out property <bool> badge-muted: true;
    // a value above changed on the page
    callback changed();
    // result of the last manual update check; checking = waiting for it
    in-out property <string> update-status;
    in-out property <bool> update-checking;
    // a newer version replaced the exe; restart to use it
    in property <string> update-version;
    // a newer release that is not downloaded yet ("automatic download" off)
    in-out property <string> update-available;
    in-out property <bool> update-installing;
    callback check-update();
    callback install-update();
    callback restart-for-update();
    // the account card (the sidebar's own photo is `AppWindow.me-photo`)
    in property <image> account-photo;
    in property <bool> account-has-photo;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <string> account-name;
    in property <string> account-number;
    in property <string> account-device;
    in property <string> account-phone;
    in property <string> storage;
    in property <string> version;
    callback clear-thumbs();
    callback open-logs();
}

export component SettingsPage inherits Rectangle {
    callback open-whatsnew();
    callback close();
    callback unlink();
    background: Theme.pane;
    // swallow clicks so nothing underneath reacts
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 12px;
                Text {
                    text: @tr("Settings");
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.close;
                    clicked => { root.close(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // a ListView for its scrollbar (it takes a single `for`: one row holding everything)
        ListView {
            vertical-stretch: 1;
            for _ in [0]: Rectangle {
            height: body.preferred-height;
            HorizontalLayout {
                width: parent.width;
                alignment: center;
                body := VerticalLayout {
                    width: min(560px, root.width - 48px);
                    padding-top: 20px;
                    padding-bottom: 24px;
                    Rectangle {
                    border-radius: 12px;
                    background: Theme.group;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 16px;
                        Avatar {
                            size: 56px;
                            y: 0px;
                            initial: SettingsData.account-initial;
                            tint: SettingsData.account-tint;
                            photo: SettingsData.account-photo;
                            has-photo: SettingsData.account-has-photo;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: SettingsData.account-name != "" ? SettingsData.account-name : @tr("My account");
                                color: Theme.text;
                                font-size: 17px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text { text: SettingsData.account-number; color: Theme.subtle; font-size: 13px; overflow: elide; }
                            if SettingsData.account-device != "": Text {
                                text: @tr("This device: {}", SettingsData.account-device);
                                color: Theme.subtle;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                    }
                    }
                    SettingSection {
                        title: @tr("Notifications");
                        SettingRow {
                            label: @tr("New message notifications");
                            hint: @tr("Not shown while you're looking at the Sigwin window");
                            Toggle {
                                checked <=> SettingsData.notify;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: @tr("Show in notifications");
                            Segmented {
                                enabled: SettingsData.notify;
                                options: [@tr("Name and message"), @tr("Name only"), @tr("Hidden")];
                                current <=> SettingsData.preview;
                                changed => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: @tr("Notification sound");
                            Toggle {
                                enabled: SettingsData.notify;
                                checked <=> SettingsData.sound;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: @tr("Badge count");
                            hint: @tr("Shows on the taskbar and notification area icons");
                            Segmented {
                                options: [@tr("Unread messages"), @tr("Unread chats")];
                                current <=> SettingsData.badge-count;
                                changed => { SettingsData.changed(); }
                            }
                        }
                        SettingGroup {
                            title: @tr("Muted chats");
                            hint: @tr("You can mute a chat by right-clicking it, and set each chat under \"Notification settings…\"");
                            SettingRow {
                                label: @tr("Notify when I'm mentioned");
                                Toggle {
                                    enabled: SettingsData.notify;
                                    checked <=> SettingsData.muted-mentions;
                                    toggled => { SettingsData.changed(); }
                                }
                            }
                            SettingRow {
                                label: @tr("Notify on replies to my messages");
                                Toggle {
                                    enabled: SettingsData.notify;
                                    checked <=> SettingsData.muted-replies;
                                    toggled => { SettingsData.changed(); }
                                }
                            }
                            SettingRow {
                                label: @tr("Include in badge count");
                                Toggle {
                                    checked <=> SettingsData.badge-muted;
                                    toggled => { SettingsData.changed(); }
                                }
                            }
                        }
                    }
                    SettingSection {
                        title: @tr("Startup");
                        SettingRow {
                            label: @tr("Open at computer login");
                            hint: @tr("Starts Sigwin when you sign in to Windows");
                            Toggle {
                                checked <=> SettingsData.autostart;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: @tr("Start minimized to tray");
                            hint: @tr("When started at login, stays in the tray without a window");
                            Toggle {
                                enabled: SettingsData.autostart;
                                checked <=> SettingsData.start-hidden;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: @tr("Appearance");
                        SettingRow {
                            label: @tr("Theme");
                            Segmented {
                                options: [@tr("System"), @tr("Light"), @tr("Dark")];
                                current <=> SettingsData.theme;
                                changed => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: @tr("Language");
                            hint: SettingsData.language != SettingsData.language-at-start ? @tr("Applies after Sigwin restarts") : "";
                            HorizontalLayout {
                                spacing: 8px;
                                if SettingsData.language != SettingsData.language-at-start: PlainButton {
                                    text: @tr("Restart");
                                    clicked => { SettingsData.restart-app(); }
                                }
                                Segmented {
                                    // names in their own language, so anyone finds theirs
                                    options: [@tr("System"), "English", "Deutsch", "한국어"];
                                    current <=> SettingsData.language;
                                    changed => { SettingsData.changed(); }
                                }
                            }
                        }
                        SettingRow {
                            label: @tr("Zoom");
                            hint: @tr("Applied on top of the Windows scale");
                            Segmented {
                                options: ["90%", "100%", "110%", "125%", "150%"];
                                current <=> SettingsData.zoom;
                                changed => { SettingsData.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: @tr("Typing");
                        SettingRow {
                            label: @tr("Send message");
                            hint: SettingsData.enter-sends ? @tr("Shift+Enter starts a new line") : @tr("Enter starts a new line");
                            Segmented {
                                options: ["Enter", "Ctrl+Enter"];
                                current: SettingsData.enter-sends ? 0 : 1;
                                changed(i) => {
                                    SettingsData.enter-sends = i == 0;
                                    SettingsData.changed();
                                }
                            }
                        }
                        SettingRow {
                            label: @tr("Sent photo quality");
                            hint: [@tr("Sends photos downsized. Details like location are removed."), @tr("Sends photos at a higher resolution. Details like location are removed.")][SettingsData.photo-quality];
                            Segmented {
                                options: [@tr("Standard"), @tr("High")];
                                current: SettingsData.photo-quality;
                                changed(i) => {
                                    SettingsData.photo-quality = i;
                                    SettingsData.changed();
                                }
                            }
                        }
                        SettingRow {
                            label: @tr("Generate link previews");
                            hint: @tr("Adds the title and image of a link to messages you send. Sigwin visits the site to get them, so the site sees your IP address.");
                            Toggle {
                                checked <=> SettingsData.link-previews;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: @tr("Account");
                        SettingRow {
                            label: @tr("Read receipts · Typing indicators");
                            hint: SettingsData.account-phone;
                        }
                        SettingRow {
                            label: @tr("Delete data");
                            hint: @tr("Unlinks this PC and deletes all messages and files");
                            DangerButton {
                                text: @tr("Delete data");
                                clicked => { root.unlink(); }
                            }
                        }
                    }
                    SettingSection {
                        title: @tr("Storage");
                        SettingRow {
                            label: @tr("In use");
                            hint: SettingsData.storage;
                        }
                        SettingRow {
                            label: @tr("Clear thumbnail cache");
                            hint: @tr("Deletes cached image previews and profile photos. They are made again when needed.");
                            PlainButton {
                                text: @tr("Clear");
                                clicked => { SettingsData.clear-thumbs(); }
                            }
                        }
                    }
                    SettingSection {
                        title: @tr("Troubleshooting");
                        SettingRow {
                            label: @tr("Log folder");
                            hint: @tr("When reporting a problem, please include the files in this folder. Message contents are never logged.");
                            PlainButton {
                                text: @tr("Open");
                                clicked => { SettingsData.open-logs(); }
                            }
                        }
                    }
                    SettingSection {
                        title: @tr("Updates");
                        SettingRow {
                            label: @tr("Download updates automatically");
                            hint: @tr("Downloads and installs new versions in the background. They apply the next time Sigwin starts.");
                            Toggle {
                                checked <=> SettingsData.auto-update;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: @tr("Check for updates");
                            hint: SettingsData.version + (SettingsData.update-version != "" ? "  ·  " + @tr("A new version is ready. Restart from the bottom left.")
                                : SettingsData.update-available != "" ? "  ·  " + @tr("Version {} is available. Update from the bottom left.", SettingsData.update-available)
                                : SettingsData.update-status != "" ? "  ·  " + SettingsData.update-status : "");
                            PlainButton {
                                text: SettingsData.update-checking ? @tr("Checking…") : @tr("Check now");
                                enabled: !SettingsData.update-checking && SettingsData.update-version == "" && SettingsData.update-available == "";
                                clicked => { SettingsData.check-update(); }
                            }
                        }
                    }
                    SettingSection {
                        title: @tr("About");
                        SettingRow {
                            label: SettingsData.version;
                            hint: @tr("An unofficial client, not affiliated with Signal. \"Signal\" is a trademark of the Signal Technology Foundation.");
                        }
                        SettingRow {
                            label: @tr("What's new");
                            hint: @tr("You can see what changed in each version on GitHub.");
                            PlainButton {
                                text: @tr("View");
                                clicked => { root.open-whatsnew(); }
                            }
                        }
                        SettingRow {
                            label: @tr("Source code");
                            hint: @tr("© 2026 Othereum. Free software under the AGPL-3.0 license, with no warranty.");
                            HorizontalLayout {
                                spacing: 6px;
                                PlainButton {
                                    text: "GitHub";
                                    clicked => { Links.open("https://github.com/Othereum/sigwin"); }
                                }
                                PlainButton {
                                    text: @tr("License");
                                    clicked => { Links.open("https://www.gnu.org/licenses/agpl-3.0.html"); }
                                }
                            }
                        }
                        SettingRow {
                            label: @tr("Open source licenses");
                            hint: @tr("Copyright and license notices of the libraries in Sigwin");
                            PlainButton {
                                text: @tr("View");
                                clicked => { Links.open("sigwin-licenses:"); }
                            }
                        }
                    }
                    Rectangle { height: 16px; }
                }
            }
            }
        }
    }
}
