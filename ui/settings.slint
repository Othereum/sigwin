// Settings page.

import { Button, Switch } from "std-widgets.slint";
import { Links, Theme } from "theme.slint";
import { Avatar, DangerButton, IconButton, Segmented } from "widgets.slint";

export component SettingSection inherits VerticalLayout {
    in property <string> title;
    spacing: 2px;
    padding-top: 18px;
    Text {
        text: root.title;
        color: Theme.accent;
        font-size: 12.5px;
        font-weight: 700;
    }
    Rectangle { height: 4px; }
    @children
}

// label (+ optional hint) on the left, a control on the right
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.label; color: Theme.text; font-size: 13.5px; wrap: word-wrap; }
        if root.hint != "": Text { text: root.hint; color: Theme.subtle; font-size: 11.5px; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

// a few related rows under a small heading, indented
export component SettingGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    padding-top: 12px;
    spacing: 2px;
    Text { text: root.title; color: Theme.text; font-size: 13.5px; font-weight: 600; }
    if root.hint != "": Text { text: root.hint; color: Theme.subtle; font-size: 11.5px; wrap: word-wrap; }
    HorizontalLayout {
        padding-top: 2px;
        padding-left: 16px;
        VerticalLayout {
            @children
        }
    }
}

export component SettingsPage inherits Rectangle {
    in-out property <bool> notify;
    in-out property <int> preview;
    in-out property <bool> sound;
    in-out property <int> badge-count;
    in-out property <int> theme;
    in-out property <int> zoom;
    in-out property <bool> enter-sends;
    in-out property <bool> link-previews;
    in-out property <bool> autostart;
    in-out property <bool> start-hidden;
    in-out property <bool> auto-update;
    in-out property <bool> muted-mentions;
    in-out property <bool> muted-replies;
    in-out property <bool> badge-muted;
    in property <string> update-status;
    in property <bool> update-checking;
    in property <bool> update-ready;
    in property <string> update-available;
    callback check-update();
    in property <image> account-photo;
    in property <bool> account-has-photo;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <string> account-name;
    in property <string> account-number;
    in property <string> account-device;
    in property <string> account-phone;
    in property <string> storage;
    in property <string> version;
    in property <bool> whatsnew-has;
    callback open-whatsnew();
    callback changed();
    callback close();
    callback clear-thumbs();
    callback open-logs();
    callback unlink();
    background: Theme.pane;
    // swallow clicks so nothing underneath reacts
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 12px;
                Text {
                    text: "설정";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    label: "✕";
                    clicked => { root.close(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        Flickable {
            vertical-stretch: 1;
            max-width: 100000px;
            content-height: body.preferred-height;
            HorizontalLayout {
                width: parent.width;
                alignment: center;
                body := VerticalLayout {
                    width: min(560px, root.width - 48px);
                    padding-bottom: 24px;
                    HorizontalLayout {
                        padding-top: 20px;
                        padding-bottom: 4px;
                        spacing: 16px;
                        Avatar {
                            size: 64px;
                            y: 0px;
                            initial: root.account-initial;
                            tint: root.account-tint;
                            photo: root.account-photo;
                            has-photo: root.account-has-photo;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.account-name != "" ? root.account-name : "내 계정";
                                color: Theme.text;
                                font-size: 17px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text { text: root.account-number; color: Theme.subtle; font-size: 12.5px; overflow: elide; }
                            if root.account-device != "": Text {
                                text: "이 기기: " + root.account-device;
                                color: Theme.subtle;
                                font-size: 12.5px;
                                overflow: elide;
                            }
                        }
                    }
                    SettingSection {
                        title: "알림";
                        SettingRow {
                            label: "새 메시지 알림";
                            hint: "Sigwin 창을 보고 있을 때는 알리지 않습니다";
                            Switch {
                                checked <=> root.notify;
                                toggled => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "알림에 표시할 내용";
                            Segmented {
                                enabled: root.notify;
                                options: ["이름과 내용", "이름만", "숨김"];
                                current <=> root.preview;
                                changed => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "알림 소리";
                            Switch {
                                enabled: root.notify;
                                checked <=> root.sound;
                                toggled => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "알림 배지";
                            hint: "작업 표시줄과 알림 영역 아이콘에 표시합니다";
                            Segmented {
                                options: ["읽지 않은 메시지", "읽지 않은 대화"];
                                current <=> root.badge-count;
                                changed => { root.changed(); }
                            }
                        }
                        SettingGroup {
                            title: "알림을 끈 대화";
                            hint: "대화를 오른쪽 클릭해서 끌 수 있고, \"알림 설정…\"에서 대화별로 설정할 수 있습니다";
                            SettingRow {
                                label: "나를 멘션하면 알림";
                                Switch {
                                    enabled: root.notify;
                                    checked <=> root.muted-mentions;
                                    toggled => { root.changed(); }
                                }
                            }
                            SettingRow {
                                label: "내 메시지에 답장하면 알림";
                                Switch {
                                    enabled: root.notify;
                                    checked <=> root.muted-replies;
                                    toggled => { root.changed(); }
                                }
                            }
                            SettingRow {
                                label: "배지에 포함";
                                Switch {
                                    checked <=> root.badge-muted;
                                    toggled => { root.changed(); }
                                }
                            }
                        }
                    }
                    SettingSection {
                        title: "시작";
                        SettingRow {
                            label: "컴퓨터 로그인 시 열기";
                            hint: "Windows에 로그인하면 Sigwin을 자동으로 실행합니다";
                            Switch {
                                checked <=> root.autostart;
                                toggled => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "시스템 트레이로 최소화된 상태로 열기";
                            hint: "자동 실행할 때 창을 띄우지 않고 트레이에 둡니다";
                            Switch {
                                enabled: root.autostart;
                                checked <=> root.start-hidden;
                                toggled => { root.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "화면";
                        SettingRow {
                            label: "테마";
                            Segmented {
                                options: ["시스템", "밝게", "어둡게"];
                                current <=> root.theme;
                                changed => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "크기";
                            hint: "Windows 배율에 곱해서 적용합니다";
                            Segmented {
                                options: ["90%", "100%", "110%", "125%", "150%"];
                                current <=> root.zoom;
                                changed => { root.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "입력";
                        SettingRow {
                            label: "메시지 보내기";
                            hint: root.enter-sends ? "Shift+Enter로 줄을 바꿉니다" : "Enter로 줄을 바꿉니다";
                            Segmented {
                                options: ["Enter", "Ctrl+Enter"];
                                current: root.enter-sends ? 0 : 1;
                                changed(i) => {
                                    root.enter-sends = i == 0;
                                    root.changed();
                                }
                            }
                        }
                        SettingRow {
                            label: "링크 미리보기 만들기";
                            hint: "보내는 메시지에 링크의 제목과 이미지를 붙입니다. 이를 위해 그 사이트에 접속하므로 사이트에 내 IP 주소가 보입니다.";
                            Switch {
                                checked <=> root.link-previews;
                                toggled => { root.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "계정";
                        SettingRow {
                            label: "읽음 확인 · 입력 중 표시";
                            hint: root.account-phone;
                        }
                        SettingRow {
                            label: "데이터 삭제";
                            hint: "이 PC의 연결을 끊고 메시지와 파일을 모두 지웁니다";
                            DangerButton {
                                text: "데이터 삭제";
                                clicked => { root.unlink(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "저장 공간";
                        SettingRow {
                            label: "사용 중";
                            hint: root.storage;
                        }
                        SettingRow {
                            label: "썸네일 캐시 비우기";
                            hint: "이미지 미리보기와 프로필 사진 캐시를 지웁니다. 필요할 때 다시 만듭니다.";
                            Button {
                                text: "비우기";
                                clicked => { root.clear-thumbs(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "문제 해결";
                        SettingRow {
                            label: "로그 폴더";
                            hint: "문제를 알릴 때 이 폴더의 파일을 함께 보내 주세요. 메시지 내용은 기록하지 않습니다.";
                            Button {
                                text: "열기";
                                clicked => { root.open-logs(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "업데이트";
                        SettingRow {
                            label: "자동으로 업데이트 다운로드";
                            hint: "새 버전을 백그라운드에서 내려받아 설치합니다. 다음에 시작할 때 적용됩니다.";
                            Switch {
                                checked <=> root.auto-update;
                                toggled => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "업데이트 확인";
                            hint: root.version + (root.update-ready ? "  ·  새 버전이 준비되었습니다. 왼쪽 아래에서 다시 시작하세요."
                                : root.update-available != "" ? "  ·  새 버전 " + root.update-available + "이(가) 있습니다. 왼쪽 아래에서 업데이트하세요."
                                : root.update-status != "" ? "  ·  " + root.update-status : "");
                            Button {
                                text: root.update-checking ? "확인 중…" : "지금 확인";
                                enabled: !root.update-checking && !root.update-ready && root.update-available == "";
                                clicked => { root.check-update(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "정보";
                        SettingRow {
                            label: root.version;
                            hint: "Signal과 무관한 비공식 클라이언트입니다. \"Signal\"은 Signal Technology Foundation의 상표입니다.";
                        }
                        if root.whatsnew-has: SettingRow {
                            label: "새로운 점";
                            hint: "이 버전에서 달라진 점을 볼 수 있습니다.";
                            Button {
                                text: "보기";
                                clicked => { root.open-whatsnew(); }
                            }
                        }
                        SettingRow {
                            label: "소스 코드";
                            hint: "© 2026 Othereum. AGPL-3.0 라이선스로 공개된 자유 소프트웨어이며, 어떠한 보증도 하지 않습니다.";
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "GitHub";
                                    clicked => { Links.open("https://github.com/Othereum/sigwin"); }
                                }
                                Button {
                                    text: "라이선스";
                                    clicked => { Links.open("https://www.gnu.org/licenses/agpl-3.0.html"); }
                                }
                            }
                        }
                        SettingRow {
                            label: "오픈소스 라이선스";
                            hint: "Sigwin에 포함된 라이브러리의 저작권과 라이선스 고지";
                            Button {
                                text: "보기";
                                clicked => { Links.open("sigwin-licenses:"); }
                            }
                        }
                    }
                    Rectangle { height: 16px; }
                }
            }
        }
    }
}
