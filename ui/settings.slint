// Settings page.

import { Button, ListView, Switch } from "std-widgets.slint";
import { Links, Theme } from "theme.slint";
import { Avatar, DangerButton, IconButton, Segmented } from "widgets.slint";
import { Icons } from "icons.slint";

// a heading over its rows, which sit together on one rounded card
export component SettingSection inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    padding-top: 20px;
    HorizontalLayout {
        padding-left: 4px;
        Text {
            text: root.title;
            color: Theme.subtle;
            font-size: 12px;
            font-weight: 700;
        }
    }
    Rectangle {
        border-radius: 12px;
        background: Theme.group;
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 6px;
            padding-bottom: 6px;
            @children
        }
    }
}

// label (+ optional hint) on the left, a control on the right
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.label; color: Theme.text; font-size: 14px; wrap: word-wrap; }
        if root.hint != "": Text { text: root.hint; color: Theme.subtle; font-size: 12px; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

// a few related rows under a small heading, indented
export component SettingGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    padding-top: 12px;
    spacing: 2px;
    Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 700; }
    if root.hint != "": Text { text: root.hint; color: Theme.subtle; font-size: 12px; wrap: word-wrap; }
    HorizontalLayout {
        padding-top: 2px;
        padding-left: 16px;
        VerticalLayout {
            @children
        }
    }
}

// What the settings page shows and edits. Rust fills it (`gui::window::show_settings`) and
// reads it back on `changed`; the sidebar's update bar uses the update state too.
export global SettingsData {
    in-out property <bool> notify: true;
    in-out property <int> preview;
    in-out property <bool> sound: true;
    in-out property <int> badge-count: 0;
    in-out property <int> theme;
    // index into the zoom steps (see settings::ZOOMS)
    in-out property <int> zoom: 1;
    in-out property <bool> enter-sends: true;
    in-out property <bool> link-previews: true;
    in-out property <int> photo-quality: 0;
    in-out property <bool> autostart;
    in-out property <bool> start-hidden: true;
    in-out property <bool> auto-update: true;
    in-out property <bool> muted-mentions: true;
    in-out property <bool> muted-replies: true;
    in-out property <bool> badge-muted: true;
    // a value above changed on the page
    callback changed();
    // result of the last manual update check; checking = waiting for it
    in-out property <string> update-status;
    in-out property <bool> update-checking;
    // a newer version replaced the exe; restart to use it
    in property <string> update-version;
    // a newer release that is not downloaded yet ("automatic download" off)
    in-out property <string> update-available;
    in-out property <bool> update-installing;
    callback check-update();
    callback install-update();
    callback restart-for-update();
    // the account card (the sidebar's own photo is `AppWindow.me-photo`)
    in property <image> account-photo;
    in property <bool> account-has-photo;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <string> account-name;
    in property <string> account-number;
    in property <string> account-device;
    in property <string> account-phone;
    in property <string> storage;
    in property <string> version;
    callback clear-thumbs();
    callback open-logs();
}

export component SettingsPage inherits Rectangle {
    in property <bool> whatsnew-has;
    callback open-whatsnew();
    callback close();
    callback unlink();
    background: Theme.pane;
    // swallow clicks so nothing underneath reacts
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 12px;
                Text {
                    text: "설정";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.close;
                    clicked => { root.close(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // a ListView for its scrollbar (it takes a single `for`: one row holding everything)
        ListView {
            vertical-stretch: 1;
            for _ in [0]: Rectangle {
            height: body.preferred-height;
            HorizontalLayout {
                width: parent.width;
                alignment: center;
                body := VerticalLayout {
                    width: min(560px, root.width - 48px);
                    padding-top: 20px;
                    padding-bottom: 24px;
                    Rectangle {
                    border-radius: 12px;
                    background: Theme.group;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 16px;
                        Avatar {
                            size: 56px;
                            y: 0px;
                            initial: SettingsData.account-initial;
                            tint: SettingsData.account-tint;
                            photo: SettingsData.account-photo;
                            has-photo: SettingsData.account-has-photo;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: SettingsData.account-name != "" ? SettingsData.account-name : "내 계정";
                                color: Theme.text;
                                font-size: 17px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text { text: SettingsData.account-number; color: Theme.subtle; font-size: 13px; overflow: elide; }
                            if SettingsData.account-device != "": Text {
                                text: "이 기기: " + SettingsData.account-device;
                                color: Theme.subtle;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                    }
                    }
                    SettingSection {
                        title: "알림";
                        SettingRow {
                            label: "새 메시지 알림";
                            hint: "Sigwin 창을 보고 있을 때는 알리지 않습니다";
                            Switch {
                                checked <=> SettingsData.notify;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: "알림에 표시할 내용";
                            Segmented {
                                enabled: SettingsData.notify;
                                options: ["이름과 내용", "이름만", "숨김"];
                                current <=> SettingsData.preview;
                                changed => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: "알림 소리";
                            Switch {
                                enabled: SettingsData.notify;
                                checked <=> SettingsData.sound;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: "알림 배지";
                            hint: "작업 표시줄과 알림 영역 아이콘에 표시합니다";
                            Segmented {
                                options: ["읽지 않은 메시지", "읽지 않은 대화"];
                                current <=> SettingsData.badge-count;
                                changed => { SettingsData.changed(); }
                            }
                        }
                        SettingGroup {
                            title: "알림을 끈 대화";
                            hint: "대화를 오른쪽 클릭해서 끌 수 있고, \"알림 설정…\"에서 대화별로 설정할 수 있습니다";
                            SettingRow {
                                label: "나를 멘션하면 알림";
                                Switch {
                                    enabled: SettingsData.notify;
                                    checked <=> SettingsData.muted-mentions;
                                    toggled => { SettingsData.changed(); }
                                }
                            }
                            SettingRow {
                                label: "내 메시지에 답장하면 알림";
                                Switch {
                                    enabled: SettingsData.notify;
                                    checked <=> SettingsData.muted-replies;
                                    toggled => { SettingsData.changed(); }
                                }
                            }
                            SettingRow {
                                label: "배지에 포함";
                                Switch {
                                    checked <=> SettingsData.badge-muted;
                                    toggled => { SettingsData.changed(); }
                                }
                            }
                        }
                    }
                    SettingSection {
                        title: "시작";
                        SettingRow {
                            label: "컴퓨터 로그인 시 열기";
                            hint: "Windows에 로그인하면 Sigwin을 자동으로 실행합니다";
                            Switch {
                                checked <=> SettingsData.autostart;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: "시스템 트레이로 최소화된 상태로 열기";
                            hint: "자동 실행할 때 창을 띄우지 않고 트레이에 둡니다";
                            Switch {
                                enabled: SettingsData.autostart;
                                checked <=> SettingsData.start-hidden;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "화면";
                        SettingRow {
                            label: "테마";
                            Segmented {
                                options: ["시스템", "밝게", "어둡게"];
                                current <=> SettingsData.theme;
                                changed => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: "크기";
                            hint: "Windows 배율에 곱해서 적용합니다";
                            Segmented {
                                options: ["90%", "100%", "110%", "125%", "150%"];
                                current <=> SettingsData.zoom;
                                changed => { SettingsData.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "입력";
                        SettingRow {
                            label: "메시지 보내기";
                            hint: SettingsData.enter-sends ? "Shift+Enter로 줄을 바꿉니다" : "Enter로 줄을 바꿉니다";
                            Segmented {
                                options: ["Enter", "Ctrl+Enter"];
                                current: SettingsData.enter-sends ? 0 : 1;
                                changed(i) => {
                                    SettingsData.enter-sends = i == 0;
                                    SettingsData.changed();
                                }
                            }
                        }
                        SettingRow {
                            label: "사진 전송 품질";
                            hint: ["사진을 줄여서 보냅니다. 위치 같은 정보는 지워집니다.", "큰 해상도로 보냅니다. 위치 같은 정보는 지워집니다."][SettingsData.photo-quality];
                            Segmented {
                                options: ["표준", "높음"];
                                current: SettingsData.photo-quality;
                                changed(i) => {
                                    SettingsData.photo-quality = i;
                                    SettingsData.changed();
                                }
                            }
                        }
                        SettingRow {
                            label: "링크 미리보기 만들기";
                            hint: "보내는 메시지에 링크의 제목과 이미지를 붙입니다. 이를 위해 그 사이트에 접속하므로 사이트에 내 IP 주소가 보입니다.";
                            Switch {
                                checked <=> SettingsData.link-previews;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "계정";
                        SettingRow {
                            label: "읽음 확인 · 입력 중 표시";
                            hint: SettingsData.account-phone;
                        }
                        SettingRow {
                            label: "데이터 삭제";
                            hint: "이 PC의 연결을 끊고 메시지와 파일을 모두 지웁니다";
                            DangerButton {
                                text: "데이터 삭제";
                                clicked => { root.unlink(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "저장 공간";
                        SettingRow {
                            label: "사용 중";
                            hint: SettingsData.storage;
                        }
                        SettingRow {
                            label: "썸네일 캐시 비우기";
                            hint: "이미지 미리보기와 프로필 사진 캐시를 지웁니다. 필요할 때 다시 만듭니다.";
                            Button {
                                text: "비우기";
                                clicked => { SettingsData.clear-thumbs(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "문제 해결";
                        SettingRow {
                            label: "로그 폴더";
                            hint: "문제를 알릴 때 이 폴더의 파일을 함께 보내 주세요. 메시지 내용은 기록하지 않습니다.";
                            Button {
                                text: "열기";
                                clicked => { SettingsData.open-logs(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "업데이트";
                        SettingRow {
                            label: "자동으로 업데이트 다운로드";
                            hint: "새 버전을 백그라운드에서 내려받아 설치합니다. 다음에 시작할 때 적용됩니다.";
                            Switch {
                                checked <=> SettingsData.auto-update;
                                toggled => { SettingsData.changed(); }
                            }
                        }
                        SettingRow {
                            label: "업데이트 확인";
                            hint: SettingsData.version + (SettingsData.update-version != "" ? "  ·  새 버전이 준비되었습니다. 왼쪽 아래에서 다시 시작하세요."
                                : SettingsData.update-available != "" ? "  ·  새 버전 " + SettingsData.update-available + "이(가) 있습니다. 왼쪽 아래에서 업데이트하세요."
                                : SettingsData.update-status != "" ? "  ·  " + SettingsData.update-status : "");
                            Button {
                                text: SettingsData.update-checking ? "확인 중…" : "지금 확인";
                                enabled: !SettingsData.update-checking && SettingsData.update-version == "" && SettingsData.update-available == "";
                                clicked => { SettingsData.check-update(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "정보";
                        SettingRow {
                            label: SettingsData.version;
                            hint: "Signal과 무관한 비공식 클라이언트입니다. \"Signal\"은 Signal Technology Foundation의 상표입니다.";
                        }
                        if root.whatsnew-has: SettingRow {
                            label: "새로운 점";
                            hint: "이 버전에서 달라진 점을 볼 수 있습니다.";
                            Button {
                                text: "보기";
                                clicked => { root.open-whatsnew(); }
                            }
                        }
                        SettingRow {
                            label: "소스 코드";
                            hint: "© 2026 Othereum. AGPL-3.0 라이선스로 공개된 자유 소프트웨어이며, 어떠한 보증도 하지 않습니다.";
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "GitHub";
                                    clicked => { Links.open("https://github.com/Othereum/sigwin"); }
                                }
                                Button {
                                    text: "라이선스";
                                    clicked => { Links.open("https://www.gnu.org/licenses/agpl-3.0.html"); }
                                }
                            }
                        }
                        SettingRow {
                            label: "오픈소스 라이선스";
                            hint: "Sigwin에 포함된 라이브러리의 저작권과 라이선스 고지";
                            Button {
                                text: "보기";
                                clicked => { Links.open("sigwin-licenses:"); }
                            }
                        }
                    }
                    Rectangle { height: 16px; }
                }
            }
            }
        }
    }
}
