// The thread menu and a chat's own notification settings.

import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MenuRow, Segmented } from "widgets.slint";

// The thread menu's and the notification settings dialog's state; Rust fills it (`gui::wire`).
export global ThreadMenuData {
    // the menu's thread; "" when closed
    in-out property <string> key;
    in property <length> menu-x;
    in property <length> menu-y;
    // "오후 3:00까지 알림 꺼짐" while off, else ""
    in property <string> status;
    // Sigwin's own choice: "휴대폰 설정 따르기" is offered, with the phone's state
    in property <bool> overridden;
    in property <string> phone;
    // thread key and where: Rust fills the menu, then opens it
    callback open(string, length, length);
    // seconds off; 0 = on, -1 = always, -2 = follow the phone
    callback set-mute(string, int);
    // the dialog's thread; "" when closed.
    // Each value is an index into its options, 0 = the default (described by its *-default text).
    in-out property <string> prefs-key;
    in property <string> prefs-name;
    in-out property <int> prefs-preview;
    in-out property <int> prefs-sound;
    in-out property <int> prefs-mentions;
    in-out property <int> prefs-replies;
    in-out property <int> prefs-badge;
    in property <string> prefs-preview-default;
    in property <string> prefs-sound-default;
    in property <string> prefs-mentions-default;
    in property <string> prefs-replies-default;
    in property <string> prefs-badge-default;
    callback open-prefs(string);
    // key, item (0 preview, 1 mentions, 2 replies, 3 badge, 4 sound), option index
    callback set-pref(string, int, int);
}

// a row of the chat notification settings dialog: label + the default, choices on the right
component PrefRow inherits HorizontalLayout {
    in property <string> label;
    // what "기본값" means right now
    in property <string> hint;
    in property <[string]> options;
    in property <int> current;
    callback changed(int);
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.label; color: Theme.text; font-size: 13px; wrap: word-wrap; }
        Text { text: "기본값: " + root.hint; color: Theme.subtle; font-size: 12px; wrap: word-wrap; }
    }
    Segmented {
        y: (parent.height - self.height) / 2;
        horizontal-stretch: 0;
        options: root.options;
        current: root.current;
        changed(v) => { root.changed(v); }
    }
}

// The thread menu: notifications off / on for a chat (right click in the list, bell in the header).
export component ThreadMenu inherits Rectangle {
    TouchArea {
        clicked => { ThreadMenuData.key = ""; }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                ThreadMenuData.key = "";
            }
        }
    }
    Rectangle {
        property <length> w: 230px;
        width: w;
        height: tmenu-col.preferred-height;
        x: max(8px, min(ThreadMenuData.menu-x, root.width - w - 8px));
        y: max(8px, min(ThreadMenuData.menu-y, root.height - self.height - 8px));
        border-radius: 12px;
        background: Theme.pane;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        TouchArea { }
        tmenu-col := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    height: 28px;
                    text: ThreadMenuData.status != "" ? ThreadMenuData.status : "알림 끄기";
                    color: Theme.subtle;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if ThreadMenuData.status != "": MenuRow {
                text: "알림 켜기";
                clicked => {
                    ThreadMenuData.set-mute(ThreadMenuData.key, 0);
                    ThreadMenuData.key = "";
                }
            }
            for d in ThreadMenuData.status == "" ? [
                { label: "1시간", secs: 3600 },
                { label: "8시간", secs: 28800 },
                { label: "1일", secs: 86400 },
                { label: "1주", secs: 604800 },
                { label: "항상", secs: -1 },
            ] : []: MenuRow {
                text: d.label;
                clicked => {
                    ThreadMenuData.set-mute(ThreadMenuData.key, d.secs);
                    ThreadMenuData.key = "";
                }
            }
            if ThreadMenuData.overridden: Rectangle { height: 1px; background: Theme.border; }
            if ThreadMenuData.overridden: Rectangle {
                height: phone-col.preferred-height;
                border-radius: 6px;
                background: phone-ta.has-hover ? Theme.hover : transparent;
                phone-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ThreadMenuData.set-mute(ThreadMenuData.key, -2);
                        ThreadMenuData.key = "";
                    }
                }
                phone-col := VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 1px;
                    Text { text: "휴대폰 설정 따르기"; color: Theme.text; font-size: 13px; }
                    Text { text: ThreadMenuData.phone; color: Theme.subtle; font-size: 12px; overflow: elide; }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            MenuRow {
                text: "알림 설정…";
                clicked => {
                    ThreadMenuData.open-prefs(ThreadMenuData.key);
                    ThreadMenuData.key = "";
                }
            }
        }
    }
}

// A chat's own notification settings.
export component ThreadPrefsDialog inherits Rectangle {
    background: #00000080;
    TouchArea {
        clicked => { ThreadMenuData.prefs-key = ""; }
    }
    Rectangle {
        width: min(460px, parent.width - 40px);
        height: tprefs-col.preferred-height;
        border-radius: 12px;
        background: Theme.pane;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea { }
        tprefs-col := VerticalLayout {
            padding: 18px;
            spacing: 14px;
            VerticalLayout {
                spacing: 2px;
                Text { text: "알림 설정"; font-weight: 700; font-size: 15px; color: Theme.text; }
                Text { text: ThreadMenuData.prefs-name; color: Theme.subtle; font-size: 12px; overflow: elide; }
            }
            PrefRow {
                label: "알림에 표시할 내용";
                hint: ThreadMenuData.prefs-preview-default;
                options: ["기본값", "이름과 내용", "이름만", "숨김"];
                current: ThreadMenuData.prefs-preview;
                changed(v) => { ThreadMenuData.set-pref(ThreadMenuData.prefs-key, 0, v); }
            }
            PrefRow {
                label: "알림 소리";
                hint: ThreadMenuData.prefs-sound-default;
                options: ["기본값", "켬", "끔"];
                current: ThreadMenuData.prefs-sound;
                changed(v) => { ThreadMenuData.set-pref(ThreadMenuData.prefs-key, 4, v); }
            }
            VerticalLayout {
                spacing: 10px;
                Text { text: "알림을 끈 동안"; color: Theme.text; font-size: 13px; font-weight: 700; }
                HorizontalLayout {
                    padding-left: 16px;
                    VerticalLayout {
                        spacing: 14px;
                        for row[i] in [
                            { label: "나를 멘션하면 알림", hint: ThreadMenuData.prefs-mentions-default, current: ThreadMenuData.prefs-mentions },
                            { label: "내 메시지에 답장하면 알림", hint: ThreadMenuData.prefs-replies-default, current: ThreadMenuData.prefs-replies },
                            { label: "배지에 포함", hint: ThreadMenuData.prefs-badge-default, current: ThreadMenuData.prefs-badge },
                        ]: PrefRow {
                            label: row.label;
                            hint: row.hint;
                            options: ["기본값", "켬", "끔"];
                            current: row.current;
                            changed(v) => { ThreadMenuData.set-pref(ThreadMenuData.prefs-key, i + 1, v); }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: "닫기";
                    clicked => { ThreadMenuData.prefs-key = ""; }
                }
            }
        }
    }
}
