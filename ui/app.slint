import { LineEdit, Button, ListView, Palette, Spinner } from "std-widgets.slint";
import { ThreadItem, MsgItem, PinItem, MentionItem, PackItem, StickerItem } from "types.slint";
import { Theme } from "theme.slint";
import { Avatar, IconButton, MenuRow, Notice, Segmented, TextButton } from "widgets.slint";
import { Bubble } from "bubble.slint";
import { ThreadRow } from "thread_row.slint";
import { StickerPanel } from "stickers.slint";
import { SettingsPage } from "settings.slint";
import { LinkPage } from "link.slint";

// Structs and globals the Rust side uses.
export { ThreadItem, ImageCell, ReactionItem, ReaderItem, MsgItem, PinItem, MentionItem, PackItem, StickerItem } from "types.slint";
export { Anim, Links, Theme } from "theme.slint";
export { ImageViewer } from "viewer.slint";

// a row of the chat notification settings dialog: label + the default, choices on the right
component PrefRow inherits HorizontalLayout {
    in property <string> label;
    // what "기본값" means right now
    in property <string> hint;
    in property <[string]> options;
    in property <int> current;
    callback changed(int);
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.label; color: Theme.text; font-size: 13px; wrap: word-wrap; }
        Text { text: "기본값: " + root.hint; color: Theme.subtle; font-size: 11.5px; wrap: word-wrap; }
    }
    Segmented {
        y: (parent.height - self.height) / 2;
        horizontal-stretch: 0;
        options: root.options;
        current: root.current;
        changed(v) => { root.changed(v); }
    }
}

export component AppWindow inherits Window {
    in property <int> total-unread;
    // dev builds (no SIGWIN_RELEASE): commit hash, else "개발"; empty for releases
    in property <string> dev-tag;
    title: (dev-tag != "" ? "Sigwin [" + dev-tag + "]" : "Sigwin") + (total-unread > 0 ? " (" + total-unread + ")" : "");
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 420px;
    // Flipping this repaints the whole window: the software renderer only redraws damaged
    // regions and loses track of them when the window was updated while minimized.
    in property <bool> repaint-flip;
    background: repaint-flip ? Theme.pane-twin : Theme.pane;
    default-font-family: "Malgun Gothic";
    icon: @image-url("../assets/icon.png");

    // "loading" | "link" | "main"
    in property <string> page: "loading";
    in property <string> loading-text: "불러오는 중…";

    in property <image> qr;
    in property <bool> has-qr: false;
    in property <string> link-status;

    in property <[ThreadItem]> threads;
    in-out property <string> current-key;
    in property <string> current-name;
    in property <string> current-initial;
    in property <color> current-tint;
    in property <image> current-photo;
    in property <bool> current-has-photo;
    in property <string> current-sub;
    in property <[MsgItem]> messages;
    in property <bool> can-load-older;
    in property <bool> can-load-newer;
    // incoming messages that arrived while scrolled up
    in-out property <int> new-below;
    callback jump-to-bottom();
    // a short message over the conversation pane (gui::notice)
    in property <string> notice-text;
    // what's going on with the connection, "" when all is well
    in property <string> connection-text;
    in property <string> reply-preview;
    // the link preview above the composer (url empty: none)
    in property <string> compose-link-url;
    in property <string> compose-link-title;
    in property <string> compose-link-desc;
    in property <string> compose-link-domain;
    in property <image> compose-link-image;
    in property <bool> compose-link-has-image;
    callback link-check();
    callback link-dismiss();
    in property <[string]> pending-files;
    in-out property <string> search;
    in-out property <string> draft;

    callback start-link(string);
    callback open-thread(string);
    callback send(string);
    // the composer text changed: cut it to the message size limit; the new cursor offset, or -1 if it fit
    callback clamp-draft(string) -> int;
    callback load-older();
    callback load-newer();
    callback at-bottom-changed(bool);
    callback attach();
    callback clear-attachments();
    // the message and which of its images
    callback attachment-clicked(string, int);
    callback file-clicked(string);
    callback reply(string);
    callback cancel-reply();
    callback search-changed(string);
    callback unlink();

    // settings page (over the conversation pane)
    in-out property <bool> settings-open;
    in-out property <bool> set-notify: true;
    in-out property <int> set-preview;
    in-out property <bool> set-sound: true;
    in-out property <int> set-badge-count: 0;
    in-out property <int> set-theme;
    // index into the zoom steps (see settings::ZOOMS)
    in-out property <int> set-zoom: 1;
    in-out property <bool> enter-sends: true;
    in-out property <bool> set-link-previews: true;
    in-out property <bool> set-autostart;
    in-out property <bool> set-start-hidden: true;
    in-out property <bool> set-auto-update: true;
    in-out property <bool> set-muted-mentions: true;
    in-out property <bool> set-muted-replies: true;
    in-out property <bool> set-badge-muted: true;
    // result of the last manual update check; checking = waiting for it
    in-out property <string> update-status;
    in-out property <bool> update-checking;
    callback check-update();
    callback install-update();
    in property <string> account-name;
    in property <string> account-number;
    in property <string> account-device;
    in property <string> account-phone;
    in property <string> storage-text;
    in property <string> version;
    // a newer version replaced the exe; restart to use it
    in property <string> update-version;
    // a newer release that is not downloaded yet ("automatic download" off)
    in-out property <string> update-available;
    in-out property <bool> update-installing;
    callback restart-for-update();
    callback open-settings();
    callback settings-changed();
    callback clear-thumbs();
    callback open-logs();

    // the message being edited (banner above the composer)
    in property <string> edit-preview;
    callback cancel-edit();
    // composer edited: true while it has text
    callback composing(bool);
    // Ctrl+V: true if the clipboard held files or an image (attached), false to paste text
    callback paste-files() -> bool;

    // @mention popup above the composer; empty when closed
    in-out property <[MentionItem]> mention-items;
    in-out property <int> mention-sel;
    // composer text, cursor (byte offset), IME preedit
    callback mention-check(string, int, string);
    // picked row, composer text, cursor
    callback mention-pick(int, string, int);
    // style shortcut (view::STYLE_*), composer text, selection anchor and cursor (bytes)
    callback format-toggle(int, string, int, int);

    // pinned messages of the open thread (newest first); the bar shows pins[pin-index]
    in property <[PinItem]> pins;
    in-out property <int> pin-index;
    // scroll to the message with this sent timestamp (pin bar, quote in a reply)
    callback show-message(string);
    callback unpin(string);
    // jump to a row: whenever jump-probe changes, the row with this id (if instantiated) reports
    // where it is on screen (0 = top of the list). Its y and content-y are read together because
    // the ListView renormalizes both on every layout.
    in-out property <string> jump-id;
    in-out property <bool> jump-found;
    in-out property <length> jump-pos;
    in-out property <length> jump-h;
    in-out property <int> jump-probe;
    // flash the jumped-to row
    in-out property <string> flash-id;
    // message menu (right click); menu-id is "" when closed
    in-out property <string> menu-id;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <string> menu-mine;
    in property <bool> menu-can-edit;
    in property <bool> menu-can-delete;
    in property <bool> menu-pinned;
    // what the message's "정보" shows; "" hides the row (incoming messages have none)
    in property <string> menu-info;
    // the menu shows the pin durations instead of the actions
    in-out property <bool> menu-pin-step;
    callback open-menu(string, length, length);
    // seconds, 0 = until unpinned
    callback pin-message(string, int);
    callback react(string, string);
    callback edit-message(string);
    callback delete-message(string);

    // thread menu (right click in the list, bell in the header); tmenu-key is "" when closed
    in-out property <string> tmenu-key;
    in property <length> tmenu-x;
    in property <length> tmenu-y;
    // "오후 3:00까지 알림 꺼짐" while off, else ""
    in property <string> tmenu-status;
    // Sigwin's own choice: "휴대폰 설정 따르기" is offered, with the phone's state
    in property <bool> tmenu-overridden;
    in property <string> tmenu-phone;
    // the open thread's notifications are off (header bell)
    in property <bool> current-muted;
    callback open-thread-menu(string, length, length);
    // seconds off; 0 = on, -1 = always, -2 = follow the phone
    callback set-mute(string, int);
    // a chat's own notification settings (dialog); tprefs-key is "" when closed.
    // Each value is an index into its options, 0 = the default (described by its *-default text).
    in-out property <string> tprefs-key;
    in property <string> tprefs-name;
    in-out property <int> tprefs-preview;
    in-out property <int> tprefs-sound;
    in-out property <int> tprefs-mentions;
    in-out property <int> tprefs-replies;
    in-out property <int> tprefs-badge;
    in property <string> tprefs-preview-default;
    in property <string> tprefs-sound-default;
    in property <string> tprefs-mentions-default;
    in property <string> tprefs-replies-default;
    in property <string> tprefs-badge-default;
    callback open-thread-prefs(string);
    // key, item (0 preview, 1 mentions, 2 replies, 3 badge, 4 sound), option index
    callback set-pref(string, int, int);

    in-out property <bool> sticker-open;
    in property <[PackItem]> packs;
    in property <[StickerItem]> stickers;
    in property <string> current-pack;
    in-out property <string> pack-url;
    callback toggle-stickers();
    in-out property <string> info-text;
    callback pick-pack(string);
    callback send-sticker(string, int);
    callback install-pack(string);
    callback add-pack-url(string);

    // headless test mode: no platform color scheme, set it explicitly
    public function set-dark(d: bool) {
        Palette.color-scheme = d ? ColorScheme.dark : ColorScheme.light;
    }
    public function scroll-to-bottom() {
        msg-list.content-y = min(0px, msg-list.visible-height - msg-list.content-height);
    }
    public function focus-composer() {
        composer.focus();
    }
    public function blur-composer() {
        composer.clear-focus();
    }
    public function composer-to-end() {
        composer.set-selection-offsets(10000000, 10000000);
    }
    public function composer-select(start: int, end: int) {
        composer.set-selection-offsets(start, end);
    }
    public function composer-cursor(offset: int) {
        composer.set-selection-offsets(offset, offset);
    }
    public function content-height() -> length {
        return msg-list.content-height;
    }
    public function set-content-y(y: length) {
        msg-list.content-y = max(msg-list.visible-height - msg-list.content-height, min(0px, y));
    }
    public function list-visible-height() -> length {
        return msg-list.visible-height;
    }
    // a switched-to thread at the bottom from its first frame: the ListView lays out only when
    // drawing, and the Flickable first clamps content-y to the (old thread's) content height.
    // A huge content height avoids the clamp; past the end, the layout puts the last row at the
    // bottom with real row heights above it (vendor patch) and sets both values right.
    public function seek-end() {
        msg-list.content-height = 10000000px;
        msg-list.content-y = msg-list.visible-height - 10000000px;
    }
    // prefetch within two screens of the top: rows inserted above the ones on screen keep the
    // view still, so a wheel scroll in progress never hits the top and waits
    public function check-older() {
        if (msg-list.content-y >= -2 * msg-list.visible-height && root.can-load-older) {
            root.load-older();
        }
    }
    // the same below, when the rows stop short of the thread's newest message
    public function check-newer() {
        if (msg-list.content-y <= 3 * msg-list.visible-height - msg-list.content-height && root.can-load-newer) {
            root.load-newer();
        }
    }
    public function list-content-y() -> length {
        return msg-list.content-y;
    }
    // no clamping: the content height is still the old estimate right after a model change
    public function set-content-y-raw(y: length) {
        msg-list.content-y = y;
    }
    public function shift-by(d: length) {
        msg-list.content-y = max(msg-list.visible-height - msg-list.content-height, min(0px, msg-list.content-y - d));
    }
    out property <bool> near-bottom: msg-list.content-y <= msg-list.visible-height - msg-list.content-height + 120px;
    changed near-bottom => {
        if (near-bottom && !can-load-newer) { new-below = 0; }
        at-bottom-changed(near-bottom);
    }
    changed can-load-newer => {
        if (near-bottom && !can-load-newer) { new-below = 0; }
    }

    if page == "loading": Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                Spinner { indeterminate: true; width: 36px; height: 36px; }
            }
            Text { text: loading-text; color: Theme.subtle; horizontal-alignment: center; }
        }
    }

    if page == "link": LinkPage {
        qr: root.qr;
        has-qr: root.has-qr;
        status: root.link-status;
        start-link(name) => { root.start-link(name); }
    }

    main := HorizontalLayout {
        visible: page == "main";
        // sidebar
        Rectangle {
            width: 300px;
            background: Theme.sidebar;
            VerticalLayout {
                HorizontalLayout {
                    padding: 10px;
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: "검색";
                        text <=> root.search;
                        edited(t) => { root.search-changed(t); }
                    }
                    IconButton {
                        label: "⚙";
                        clicked => {
                            if (root.settings-open) {
                                root.settings-open = false;
                            } else {
                                root.open-settings();
                            }
                        }
                    }
                }
                if root.connection-text != "": Rectangle {
                    height: 30px;
                    background: Theme.selected;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: root.connection-text;
                        color: Theme.text;
                        font-size: 12.5px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                ListView {
                    for t in root.threads: ThreadRow {
                        item: t;
                        selected: t.key == root.current-key;
                        clicked => {
                            root.settings-open = false;
                            root.open-thread(t.key);
                        }
                        menu(x, y) => { root.open-thread-menu(t.key, x, y); }
                    }
                }
                if root.update-version == "" && root.update-available != "": Rectangle {
                    height: 38px;
                    background: avail-ta.has-hover && !root.update-installing ? Theme.hover : Theme.sidebar;
                    Rectangle { y: 0; height: 1px; background: Theme.border; }
                    avail-ta := TouchArea {
                        mouse-cursor: root.update-installing ? default : pointer;
                        clicked => {
                            if !root.update-installing {
                                root.update-installing = true;
                                root.install-update();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: "새 버전 " + root.update-available + " 있음";
                            color: Theme.text;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: root.update-installing ? "받는 중…" : "업데이트";
                            color: root.update-installing ? Theme.subtle : Theme.accent;
                            font-size: 12.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.update-version != "": Rectangle {
                    height: 38px;
                    background: upd-ta.has-hover ? Theme.hover : Theme.sidebar;
                    Rectangle { y: 0; height: 1px; background: Theme.border; }
                    upd-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.restart-for-update(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: "새 버전 " + root.update-version + " 준비됨";
                            color: Theme.text;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: "다시 시작";
                            color: Theme.accent;
                            font-size: 12.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        }
        // conversation pane
        VerticalLayout {
            if root.current-key == "": Rectangle {
                vertical-stretch: 1;
                Text {
                    text: "대화를 선택하세요";
                    color: Theme.subtle;
                    font-size: 15px;
                }
            }
            if root.current-key != "": Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    Avatar {
                        y: (parent.height - self.height) / 2;
                        initial: root.current-initial;
                        tint: root.current-tint;
                        photo: root.current-photo;
                        has-photo: root.current-has-photo;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: root.current-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                        if root.current-sub != "": Text { text: root.current-sub; color: Theme.subtle; font-size: 11.5px; overflow: elide; }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        label: root.current-muted ? "🔕" : "🔔";
                        clicked => {
                            root.open-thread-menu(root.current-key, self.absolute-position.x + self.width, self.absolute-position.y + self.height + 4px);
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            if root.current-key != "" && root.pins.length > 0: Rectangle {
                property <int> idx: Math.min(root.pin-index, root.pins.length - 1);
                height: 48px;
                background: pin-ta.has-hover ? Theme.hover : Theme.pane;
                pin-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-message(root.pins[idx].id);
                        // like the official apps: each click moves on to the next (older) pin
                        root.pin-index = Math.mod(idx + 1, root.pins.length);
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 10px;
                    // one segment per pin, the shown one highlighted
                    VerticalLayout {
                        width: 3px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        for p[i] in root.pins: Rectangle {
                            border-radius: 1.5px;
                            background: i == idx ? Theme.accent : Theme.border;
                        }
                    }
                    Text { text: "📌"; font-size: 15px; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.pins.length > 1 ? "고정된 메시지 " + (idx + 1) + "/" + root.pins.length : "고정된 메시지";
                            color: Theme.accent;
                            font-size: 11.5px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.pins[idx].sender + ": " + root.pins[idx].text;
                            color: Theme.text;
                            font-size: 12.5px;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        TextButton {
                            width: self.min-width;
                            text: "고정 해제";
                            clicked => { root.unpin(root.pins[idx].id); }
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            Rectangle {
                visible: root.current-key != "";
                vertical-stretch: 1;
                msg-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    // the composer growing (or a resize) shrinks the list: if it was at the
                    // bottom before, keep it there so the last message isn't hidden
                    property <length> last-vh;
                    changed visible-height => {
                        if (self.last-vh > 0 && self.content-height + self.content-y - self.last-vh <= 120px) {
                            root.scroll-to-bottom();
                        }
                        self.last-vh = self.visible-height;
                    }
                    // load older history at the top. `scrolled` fires when a wheel notch starts
                    // its 180ms animation, before content-y gets there, so content-y itself is
                    // watched too, once the user has scrolled this thread
                    property <bool> user-scrolled;
                    property <string> key: root.current-key;
                    changed key => { self.user-scrolled = false; }
                    scrolled => {
                        self.user-scrolled = true;
                        root.check-older();
                        root.check-newer();
                    }
                    changed content-y => {
                        if (self.user-scrolled) {
                            root.check-older();
                            root.check-newer();
                        }
                    }
                    for m[idx] in root.messages: Bubble {
                        m: m;
                        last: idx == root.messages.length - 1;
                        max-w: min(560px, msg-list.visible-width * 0.75);
                        flash: m.id == root.flash-id;
                        property <int> probe: root.jump-probe;
                        changed probe => {
                            if (m.id == root.jump-id) {
                                root.jump-pos = self.y + self.lead + msg-list.content-y;
                                root.jump-h = self.height - self.lead;
                                root.jump-found = true;
                            }
                        }
                        attachment-clicked(id, index) => { root.attachment-clicked(id, index); }
                        file-clicked(id) => { root.file-clicked(id); }
                        quote-clicked(id) => { root.show-message(id); }
                        reply(id) => { root.reply(id); }
                        show-info(t) => { root.info-text = t; }
                        menu(id, x, y) => { root.open-menu(id, x, y); }
                    }
                }
                // jump to the latest message
                if !root.near-bottom || root.can-load-newer: Rectangle {
                    x: parent.width - self.width - 20px;
                    y: parent.height - self.height - 14px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: jump-ta.has-hover ? Theme.hover : Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: #00000040;
                    jump-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.jump-to-bottom(); }
                    }
                    Text {
                        text: "↓";
                        font-family: "Segoe UI Symbol";
                        font-size: 18px;
                        color: Theme.text;
                    }
                    if root.new-below > 0: Rectangle {
                        x: parent.width - self.width + 4px;
                        y: -6px;
                        height: 18px;
                        width: max(18px, badge.preferred-width + 10px);
                        border-radius: 9px;
                        background: Theme.accent;
                        badge := Text {
                            text: root.new-below > 99 ? "99+" : root.new-below;
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }
                }
            }
            if root.current-key != "" && root.sticker-open: StickerPanel {
                packs: root.packs;
                stickers: root.stickers;
                current-pack: root.current-pack;
                url-text <=> root.pack-url;
                pick-pack(id) => { root.pick-pack(id); }
                send-sticker(p, i) => { root.send-sticker(p, i); }
                install-pack(id) => { root.install-pack(id); }
                add-pack-url(u) => { root.add-pack-url(u); }
            }
            if root.current-key != "" && root.edit-preview != "": Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 16px;
                    spacing: 8px;
                    Rectangle { width: 3px; background: Theme.accent; }
                    Text {
                        text: "수정 중: " + root.edit-preview;
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton { label: "✕"; width: 28px; height: 28px; clicked => { root.cancel-edit(); } }
                }
            }
            if root.current-key != "" && root.reply-preview != "": Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 16px;
                    spacing: 8px;
                    Rectangle { width: 3px; background: Theme.accent; }
                    Text {
                        text: "답장: " + root.reply-preview;
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton { label: "✕"; width: 28px; height: 28px; clicked => { root.cancel-reply(); } }
                }
            }
            if root.current-key != "" && root.pending-files.length > 0: Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 16px;
                    spacing: 8px;
                    Text {
                        text: "📎 " + root.pending-files.length + "개 첨부: " + root.pending-files[0] + (root.pending-files.length > 1 ? " 외" : "");
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton { label: "✕"; width: 28px; height: 28px; clicked => { root.clear-attachments(); } }
                }
            }
            if root.current-key != "" && root.compose-link-url != "" && root.pending-files.length == 0 && root.edit-preview == "": Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 16px;
                    spacing: 8px;
                    if root.compose-link-has-image: Image {
                        width: 44px;
                        height: 44px;
                        source: root.compose-link-image;
                        // already resampled to this size
                        image-fit: fill;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.compose-link-title;
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        if root.compose-link-desc != "": Text {
                            text: root.compose-link-desc;
                            color: Theme.subtle;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Text {
                            text: root.compose-link-domain;
                            color: Theme.subtle;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    IconButton { label: "✕"; width: 28px; height: 28px; clicked => { root.link-dismiss(); } }
                }
            }
            composer-bar := Rectangle {
                visible: root.current-key != "";
                min-height: self.visible ? 48px : 0px;
                max-height: self.visible ? 400px : 0px;
                Rectangle { height: 1px; y: 0; background: Theme.border; }
                HorizontalLayout {
                    padding: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    IconButton {
                        label: "📎";
                        clicked => { root.attach(); }
                    }
                    IconButton {
                        label: "☺";
                        clicked => { root.toggle-stickers(); }
                    }
                    Rectangle {
                        border-radius: 18px;
                        background: Theme.sidebar;
                        border-width: 1px;
                        border-color: composer.has-focus ? Theme.accent : Theme.border;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            FocusScope {
                                // FocusScope and Rectangle don't take their child's size: grow with wrapped lines
                                min-height: min(composer.preferred-height, 140px);
                                capture-key-pressed(event) => {
                                    if (root.mention-items.length > 0) {
                                        if (event.text == Key.UpArrow) {
                                            root.mention-sel = Math.max(0, root.mention-sel - 1);
                                            return accept;
                                        }
                                        if (event.text == Key.DownArrow) {
                                            root.mention-sel = Math.min(root.mention-items.length - 1, root.mention-sel + 1);
                                            return accept;
                                        }
                                        if ((event.text == Key.Return && !event.modifiers.shift) || event.text == Key.Tab) {
                                            root.mention-pick(root.mention-sel, composer.text, composer.cursor-position-byte-offset);
                                            return accept;
                                        }
                                        if (event.text == Key.Escape) {
                                            root.mention-items = [];
                                            return accept;
                                        }
                                    }
                                    if (event.text == Key.Return && !event.modifiers.shift && root.enter-sends != event.modifiers.control) {
                                        root.send(composer.text);
                                        return accept;
                                    }
                                    if (event.text == Key.Escape && root.edit-preview != "") {
                                        root.cancel-edit();
                                        return accept;
                                    }
                                    if (event.text == Key.Escape && root.reply-preview != "") {
                                        root.cancel-reply();
                                        return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                                        if (root.paste-files()) {
                                            return accept;
                                        }
                                    }
                                    // text styles (Signal Desktop's shortcuts): wrap the selection in markers
                                    if (event.modifiers.control && !event.modifiers.alt) {
                                        let k = event.text;
                                        let style = !event.modifiers.shift
                                            ? (k == "b" || k == "B" ? 1 : k == "i" || k == "I" ? 2 : k == "e" || k == "E" ? 5 : 0)
                                            : (k == "x" || k == "X" ? 4 : k == "b" || k == "B" ? 3 : 0);
                                        if (style != 0) {
                                            root.format-toggle(style, composer.text, composer.anchor-position-byte-offset, composer.cursor-position-byte-offset);
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                                Rectangle {
                                    composer := TextInput {
                                        text <=> root.draft;
                                        edited => {
                                            // over the 64KB a message can carry: the new part is cut to fit
                                            let cut = root.clamp-draft(self.text);
                                            if cut >= 0 {
                                                self.set-selection-offsets(cut, cut);
                                            }
                                            root.composing(self.text != "");
                                            root.link-check();
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        cursor-position-changed => {
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        // IME composition (Hangul) changes neither text nor cursor: follow it too
                                        changed preedit-text => {
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                        font-size: 14px;
                                        max-height: 140px;
                                    }
                                    // hide as soon as IME composition starts (preedit isn't in text yet)
                                    if root.draft == "" && composer.preedit-text == "": Text {
                                        x: 0;
                                        y: 0;
                                        text: root.edit-preview != "" ? "수정할 내용 입력 (Esc 취소)" : "메시지 입력";
                                        color: Theme.subtle;
                                        font-size: 14px;
                                    }
                                }
                            }
                        }
                    }
                    IconButton {
                        label: "➤";
                        enabled: root.draft != "" || root.pending-files.length > 0;
                        clicked => { root.send(composer.text); }
                    }
                }
            }
        }
    }

    if page == "main" && root.settings-open: SettingsPage {
        x: 300px;
        width: root.width - 300px;
        height: root.height;
        notify <=> root.set-notify;
        preview <=> root.set-preview;
        sound <=> root.set-sound;
        badge-count <=> root.set-badge-count;
        theme <=> root.set-theme;
        zoom <=> root.set-zoom;
        enter-sends <=> root.enter-sends;
        link-previews <=> root.set-link-previews;
        autostart <=> root.set-autostart;
        start-hidden <=> root.set-start-hidden;
        auto-update <=> root.set-auto-update;
        muted-mentions <=> root.set-muted-mentions;
        muted-replies <=> root.set-muted-replies;
        badge-muted <=> root.set-badge-muted;
        update-status: root.update-status;
        update-checking: root.update-checking;
        update-ready: root.update-version != "";
        update-available: root.update-available;
        check-update => { root.check-update(); }
        account-name: root.account-name;
        account-number: root.account-number;
        account-device: root.account-device;
        account-phone: root.account-phone;
        storage: root.storage-text;
        version: root.version;
        changed => { root.settings-changed(); }
        close => { root.settings-open = false; }
        clear-thumbs => { root.clear-thumbs(); }
        open-logs => { root.open-logs(); }
        unlink => { root.unlink(); }
    }

    // @mention popup, just above the composer
    if root.mention-items.length > 0: Rectangle {
        x: composer.absolute-position.x - 8px;
        y: composer-bar.absolute-position.y - self.height - 4px;
        width: 240px;
        height: mention-col.preferred-height;
        border-radius: 10px;
        background: Theme.pane;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        mention-col := VerticalLayout {
            padding: 4px;
            for item[i] in root.mention-items: Rectangle {
                height: 36px;
                border-radius: 6px;
                background: i == root.mention-sel ? Theme.selected : mta.has-hover ? Theme.hover : transparent;
                mta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mention-pick(i, composer.text, composer.cursor-position-byte-offset); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;
                    Avatar {
                        size: 24px;
                        y: 6px;
                        initial: item.initial;
                        tint: item.tint;
                    }
                    Text {
                        text: item.name;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // message menu: reactions + actions, opened by right-clicking a message
    if root.menu-id != "": Rectangle {
        TouchArea {
            clicked => { root.menu-id = ""; }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.menu-id = "";
                }
            }
        }
        card := Rectangle {
            property <length> w: 6 * 36px + 12px;
            width: w;
            height: menu-col.preferred-height;
            x: max(8px, min(root.menu-x, root.width - w - 8px));
            y: max(8px, min(root.menu-y, root.height - self.height - 8px));
            border-radius: 10px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;
            TouchArea { }
            menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                HorizontalLayout {
                    for e in ["❤️", "👍", "👎", "😂", "😮", "😢"]: Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: e == root.menu-mine ? Theme.selected : (eta.has-hover ? Theme.hover : transparent);
                        Text { text: e; font-size: 20px; }
                        eta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.react(root.menu-id, e);
                                root.menu-id = "";
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.menu-pin-step: HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        height: 28px;
                        text: "고정할 기간";
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                for d in root.menu-pin-step ? [
                    { label: "24시간", secs: 86400 },
                    { label: "7일", secs: 604800 },
                    { label: "30일", secs: 2592000 },
                    { label: "해제할 때까지", secs: 0 },
                ] : []: MenuRow {
                    text: d.label;
                    clicked => {
                        root.pin-message(root.menu-id, d.secs);
                        root.menu-id = "";
                    }
                }
                if !root.menu-pin-step: MenuRow {
                    text: "답장";
                    clicked => {
                        root.reply(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if !root.menu-pin-step: MenuRow {
                    text: root.menu-pinned ? "고정 해제" : "고정";
                    clicked => {
                        if (root.menu-pinned) {
                            root.unpin(root.menu-id);
                            root.menu-id = "";
                        } else {
                            root.menu-pin-step = true;
                        }
                    }
                }
                if root.menu-can-edit && !root.menu-pin-step: MenuRow {
                    text: "수정";
                    clicked => {
                        root.edit-message(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if root.menu-info != "" && !root.menu-pin-step: MenuRow {
                    text: "정보";
                    clicked => {
                        root.info-text = root.menu-info;
                        root.menu-id = "";
                    }
                }
                if root.menu-can-delete && !root.menu-pin-step: MenuRow {
                    text: "모두에게서 삭제";
                    danger: true;
                    clicked => {
                        root.delete-message(root.menu-id);
                        root.menu-id = "";
                    }
                }
            }
        }
    }

    // thread menu: notifications off / on for a chat
    if root.tmenu-key != "": Rectangle {
        TouchArea {
            clicked => { root.tmenu-key = ""; }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.tmenu-key = "";
                }
            }
        }
        Rectangle {
            property <length> w: 230px;
            width: w;
            height: tmenu-col.preferred-height;
            x: max(8px, min(root.tmenu-x, root.width - w - 8px));
            y: max(8px, min(root.tmenu-y, root.height - self.height - 8px));
            border-radius: 10px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;
            TouchArea { }
            tmenu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        height: 28px;
                        text: root.tmenu-status != "" ? root.tmenu-status : "알림 끄기";
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.tmenu-status != "": MenuRow {
                    text: "알림 켜기";
                    clicked => {
                        root.set-mute(root.tmenu-key, 0);
                        root.tmenu-key = "";
                    }
                }
                for d in root.tmenu-status == "" ? [
                    { label: "1시간", secs: 3600 },
                    { label: "8시간", secs: 28800 },
                    { label: "1일", secs: 86400 },
                    { label: "1주", secs: 604800 },
                    { label: "항상", secs: -1 },
                ] : []: MenuRow {
                    text: d.label;
                    clicked => {
                        root.set-mute(root.tmenu-key, d.secs);
                        root.tmenu-key = "";
                    }
                }
                if root.tmenu-overridden: Rectangle { height: 1px; background: Theme.border; }
                if root.tmenu-overridden: Rectangle {
                    height: phone-col.preferred-height;
                    border-radius: 6px;
                    background: phone-ta.has-hover ? Theme.hover : transparent;
                    phone-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.set-mute(root.tmenu-key, -2);
                            root.tmenu-key = "";
                        }
                    }
                    phone-col := VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 1px;
                        Text { text: "휴대폰 설정 따르기"; color: Theme.text; font-size: 13px; }
                        Text { text: root.tmenu-phone; color: Theme.subtle; font-size: 11.5px; overflow: elide; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuRow {
                    text: "알림 설정…";
                    clicked => {
                        root.open-thread-prefs(root.tmenu-key);
                        root.tmenu-key = "";
                    }
                }
            }
        }
    }

    // a chat's own notification settings
    if root.tprefs-key != "": Rectangle {
        background: #00000080;
        TouchArea {
            clicked => { root.tprefs-key = ""; }
        }
        Rectangle {
            width: min(460px, parent.width - 40px);
            height: tprefs-col.preferred-height;
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            tprefs-col := VerticalLayout {
                padding: 18px;
                spacing: 14px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "알림 설정"; font-weight: 700; font-size: 15px; color: Theme.text; }
                    Text { text: root.tprefs-name; color: Theme.subtle; font-size: 12px; overflow: elide; }
                }
                PrefRow {
                    label: "알림에 표시할 내용";
                    hint: root.tprefs-preview-default;
                    options: ["기본값", "이름과 내용", "이름만", "숨김"];
                    current: root.tprefs-preview;
                    changed(v) => { root.set-pref(root.tprefs-key, 0, v); }
                }
                PrefRow {
                    label: "알림 소리";
                    hint: root.tprefs-sound-default;
                    options: ["기본값", "켬", "끔"];
                    current: root.tprefs-sound;
                    changed(v) => { root.set-pref(root.tprefs-key, 4, v); }
                }
                VerticalLayout {
                    spacing: 10px;
                    Text { text: "알림을 끈 동안"; color: Theme.text; font-size: 13px; font-weight: 600; }
                    HorizontalLayout {
                        padding-left: 16px;
                        VerticalLayout {
                            spacing: 14px;
                            for row[i] in [
                                { label: "나를 멘션하면 알림", hint: root.tprefs-mentions-default, current: root.tprefs-mentions },
                                { label: "내 메시지에 답장하면 알림", hint: root.tprefs-replies-default, current: root.tprefs-replies },
                                { label: "배지에 포함", hint: root.tprefs-badge-default, current: root.tprefs-badge },
                            ]: PrefRow {
                                label: row.label;
                                hint: row.hint;
                                options: ["기본값", "켬", "끔"];
                                current: row.current;
                                changed(v) => { root.set-pref(root.tprefs-key, i + 1, v); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "닫기";
                        clicked => { root.tprefs-key = ""; }
                    }
                }
            }
        }
    }

    // message info (who received / read an outgoing message)
    if root.info-text != "": Rectangle {
        background: #00000080;
        TouchArea {
            clicked => { root.info-text = ""; }
        }
        Rectangle {
            width: min(380px, parent.width - 40px);
            height: info-col.preferred-height;
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            info-col := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "메시지 정보"; font-weight: 700; font-size: 15px; color: Theme.text; }
                Text { text: root.info-text; wrap: word-wrap; color: Theme.text; font-size: 13px; }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "닫기";
                        clicked => { root.info-text = ""; }
                    }
                }
            }
        }
    }

    // over the conversation pane, just above the composer (the window's bottom when there is none)
    if page == "main" && root.notice-text != "": Notice {
        text: root.notice-text;
        max-text-width: root.width - 300px - 76px;
        x: 300px + (root.width - 300px - self.width) / 2;
        y: composer-bar.absolute-position.y - self.height - 10px;
    }
}
