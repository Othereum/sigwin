import { ListView, Palette, Spinner } from "std-widgets.slint";
import { PendingFile, ThreadItem, MsgItem, PinItem, MentionItem, PackItem, StickerItem } from "types.slint";
import { Theme } from "theme.slint";
import { Avatar, DangerButton, IconButton, MenuRow, Notice, Field, PlainButton, PrimaryButton } from "widgets.slint";
import { Icon, Icons } from "icons.slint";
import { Bubble, MediaLabel, QuoteBox } from "bubble.slint";
import { ThreadRow } from "thread_row.slint";
import { StickerPanel } from "stickers.slint";
import { SettingsData, SettingsPage } from "settings.slint";
import { EmojiPicker, PickerLayout, ReactionCell } from "reactions.slint";
import { ThreadMenu, ThreadMenuData, ThreadPrefsDialog } from "thread_menu.slint";
import { LinkPage } from "link.slint";
import { RepliesData, RepliesDialog } from "replies.slint";
import { FindKind, ResultRow, ResultKind, SearchData } from "search.slint";

// Structs and globals the Rust side uses.
export { ThreadItem, ImageCell, ReactionItem, ReaderItem, MsgItem, PinItem, ReplyItem, MentionItem, PackItem, StickerItem } from "types.slint";
export { Anim, Links, Theme } from "theme.slint";
export { ImageViewer } from "viewer.slint";
export { SettingsData } from "settings.slint";
export { ThreadMenuData } from "thread_menu.slint";
export { FindKind, ResultItem, ResultKind, SearchData } from "search.slint";
export { RepliesData } from "replies.slint";

export component AppWindow inherits Window {
    in property <int> total-unread;
    // dev builds (no SIGWIN_RELEASE): commit hash, else "개발"; empty for releases
    in property <string> dev-tag;
    title: (dev-tag != "" ? "Sigwin [" + dev-tag + "]" : "Sigwin") + (total-unread > 0 ? " (" + total-unread + ")" : "");
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 420px;
    // Flipping this repaints the whole window: the software renderer only redraws damaged
    // regions and loses track of them when the window was updated while minimized.
    in property <bool> repaint-flip;
    background: repaint-flip ? Theme.pane-twin : Theme.pane;
    default-font-family: "Malgun Gothic";
    icon: @image-url("../assets/icon.png");

    // "loading" | "link" | "main"
    in property <string> page: "loading";
    in property <string> loading-text: "불러오는 중…";

    in property <image> qr;
    in property <bool> has-qr: false;
    in property <string> link-status;

    in property <[ThreadItem]> threads;
    in-out property <string> current-key;
    in property <string> current-name;
    in property <string> current-initial;
    in property <color> current-tint;
    in property <image> current-photo;
    in property <bool> current-has-photo;
    in property <string> current-sub;
    // the open thread is a message request: the request bar instead of the composer
    in property <bool> current-request;
    // the request bar's buttons: 0 accept, 1 delete, 2 block
    callback answer-request(int);
    in property <[MsgItem]> messages;
    in property <bool> can-load-older;
    in property <bool> can-load-newer;
    // unread messages of the open thread (the jump button's badge)
    in property <int> open-unread;
    callback jump-to-bottom();
    // row id: the row's bottom edge is on screen, so everything above it has been seen
    callback row-seen(string);
    // a short message over the conversation pane (gui::notice)
    in property <string> notice-text;
    // the notice's button ("" for none)
    in property <string> notice-action;
    callback notice-action-clicked();
    // what's going on with the connection, "" when all is well
    in property <string> connection-text;
    // the message being replied to: its text (empty: no reply) and who wrote it
    in property <string> reply-preview;
    in property <string> reply-author;
    // a photo of that message, cut to the box
    in property <image> reply-image;
    in property <bool> reply-has-image;
    // the link preview above the composer (url empty: none)
    in property <string> compose-link-url;
    in property <string> compose-link-title;
    in property <string> compose-link-desc;
    in property <string> compose-link-domain;
    in property <image> compose-link-image;
    in property <bool> compose-link-has-image;
    callback link-check();
    callback link-dismiss();
    in property <[PendingFile]> pending-files;
    // a photo is among them: the quality it goes at can be picked
    in property <bool> pending-has-photo;
    in-out property <string> draft;

    callback start-link(string);
    callback open-thread(string);
    callback send(string);
    // the composer text changed: cut it to the message size limit; the new cursor offset, or -1 if it fit
    callback clamp-draft(string) -> int;
    callback load-older();
    callback load-newer();
    callback at-bottom-changed(bool);
    callback attach();
    // files are being dragged over the window
    in property <bool> drop-hover;
    callback remove-attachment(int);
    // the pointer came onto a composer tile or left it (a GIF there plays meanwhile)
    callback pending-gif-hover(int, bool);
    // the message and which of its images
    callback attachment-clicked(string, int);
    callback file-clicked(string);
    callback save-clicked(string);
    callback reply(string);
    callback cancel-reply();
    callback unlink();

    // settings page (over the conversation pane)
    in-out property <bool> settings-open;
    // our own photo in the sidebar header (the card on the settings page has its own)
    in property <image> me-photo;
    in property <bool> me-has-photo;
    // "what's new" after an update: the sidebar offers the release notes until opened or dismissed
    in-out property <bool> whatsnew-offer;
    // opens the release notes on GitHub
    callback open-whatsnew();
    callback dismiss-whatsnew();
    callback open-settings();

    // the message being edited (banner above the composer)
    in property <string> edit-preview;
    callback cancel-edit();
    // composer edited: true while it has text
    callback composing(bool);
    // Ctrl+V: true if the clipboard held files or an image (attached), false to paste text
    callback paste-files() -> bool;

    // @mention popup above the composer; empty when closed
    in-out property <[MentionItem]> mention-items;
    in-out property <int> mention-sel;
    // composer text, cursor (byte offset), IME preedit
    callback mention-check(string, int, string);
    // picked row, composer text, cursor
    callback mention-pick(int, string, int);
    // style shortcut (view::STYLE_*), composer text, selection anchor and cursor (bytes)
    callback format-toggle(int, string, int, int);
    // composer text, selection anchor and cursor (bytes): remove the selection, cursor where it began
    callback drop-selection(string, int, int);

    // pinned messages of the open thread (newest first); the bar shows pins[pin-index]
    in property <[PinItem]> pins;
    in-out property <int> pin-index;
    // scroll to the message with this sent timestamp (pin bar, quote in a reply)
    callback show-message(string);
    callback unpin(string);
    // jump to a row: whenever jump-probe changes, the row with this id (if instantiated) reports
    // where it is on screen (0 = top of the list). Its y and content-y are read together because
    // the ListView renormalizes both on every layout.
    in-out property <string> jump-id;
    in-out property <bool> jump-found;
    in-out property <length> jump-pos;
    in-out property <length> jump-h;
    // height above the row's bubble (day separator, unread line)
    in-out property <length> jump-lead;
    // where the "unread" line's row is on screen (scenario checks); stale once it scrolls out of the instantiated rows
    in-out property <length> divider-top: -100000px;
    // the view is on its way to the first unread row: what passes by is not reported as seen,
    // nor is the bottom (gui::scroll::jump_to_unread). Lifting it reports the rows on screen.
    in-out property <bool> reading-hold;
    // the window is in the background (or the user is away): nothing is being read. Becoming
    // active reports the rows on screen.
    in property <bool> inactive;
    in-out property <int> jump-probe;
    // the row across the message list's top edge (0 = its top, above the edge when negative)
    in-out property <string> view-top-id;
    in-out property <length> view-top-off;
    // the message list moved: the hover is brought up to date for the cursor (gui::anim)
    callback gif-scrolled();
    // the date shown at the top while scrolling: "오늘", "어제", "11월 7일 (토)" for a day number
    pure callback day-label(int) -> string;
    // scroll to the first message of a day (a day number, as in `Message.day`)
    callback show-day(int);
    // the day of the row across the list's top edge; 0: none, or its own day separator is in view
    property <int> top-day;
    // the last non-zero `top-day`: what the label says while it fades out
    property <int> shown-day;
    changed top-day => { if (self.top-day != 0) { self.shown-day = self.top-day; } }
    // the date label is up; it goes `date-idle` ticks after the last scroll
    property <bool> date-show;
    property <int> date-idle;
    // flash the jumped-to row
    in-out property <string> flash-id;
    // message menu (right click); menu-id is "" when closed
    in-out property <string> menu-id;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <string> menu-mine;
    in property <bool> menu-can-edit;
    in property <bool> menu-can-delete;
    in property <bool> menu-pinned;
    // what the message's "정보" shows; "" hides the row (incoming messages have none)
    in property <string> menu-info;
    // the menu shows the pin durations instead of the actions
    in-out property <bool> menu-pin-step;
    // the menu shows the emoji picker instead of the actions
    in-out property <bool> menu-picker;
    // the pinned bar's pin was clicked: its menu at (pin-menu-x, pin-menu-y), its right edge at x
    property <bool> pin-menu-open;
    property <length> pin-menu-x;
    property <length> pin-menu-y;
    // the menu shows only the reactions (opened by the hover tools' reaction button)
    in-out property <bool> menu-reacts;
    in-out property <int> picker-tab;
    // the open tab's rows (empty while the picker is closed) and the emoji we reacted with lately
    in property <[[string]]> picker-rows;
    in property <[string]> recent-emoji;
    callback picker-tab-changed(int);
    // the menu closed: the Rust side drops the grid's rows
    callback picker-closed();
    changed menu-id => {
        if (root.menu-id == "") {
            root.menu-picker = false;
            root.menu-reacts = false;
            root.picker-closed();
        }
    }
    callback open-menu(string, length, length);
    // seconds, 0 = until unpinned
    callback pin-message(string, int);
    callback react(string, string);
    callback edit-message(string);
    callback edit-last() -> bool;
    callback delete-message(string);

    // the open thread's notifications are off (header bell)
    in property <bool> current-muted;

    in-out property <bool> sticker-open;
    in property <[PackItem]> packs;
    in property <[StickerItem]> stickers;
    in property <string> current-pack;
    in-out property <string> pack-url;
    callback toggle-stickers();
    in-out property <string> info-text;
    in-out property <string> info-title: "메시지 정보";
    callback pick-pack(string);
    callback send-sticker(string, int);
    callback install-pack(string);
    callback add-pack-url(string);

    // headless test mode: no platform color scheme, set it explicitly
    public function set-dark(d: bool) {
        Palette.color-scheme = d ? ColorScheme.dark : ColorScheme.light;
    }
    public function scroll-to-bottom() {
        msg-list.content-y = min(0px, msg-list.visible-height - msg-list.content-height);
    }
    public function focus-composer() {
        composer.focus();
    }
    public function blur-composer() {
        composer.clear-focus();
    }
    public function composer-to-end() {
        composer.set-selection-offsets(10000000, 10000000);
    }
    public function composer-select(start: int, end: int) {
        composer.set-selection-offsets(start, end);
    }
    public function composer-cursor(offset: int) {
        composer.set-selection-offsets(offset, offset);
    }
    public function content-height() -> length {
        return msg-list.content-height;
    }
    public function set-content-y(y: length) {
        msg-list.content-y = max(msg-list.visible-height - msg-list.content-height, min(0px, y));
    }
    public function list-visible-height() -> length {
        return msg-list.visible-height;
    }
    // the part of the list not under the composer: where a row can be read
    public function list-open-height() -> length {
        return msg-list.visible-height - root.float-h;
    }
    // what floats over the message list's bottom (composer, sticker panel, request bar)
    property <length> float-h: pane-col.height - list-box.y - list-box.height;
    // a switched-to thread at the bottom from its first frame: the ListView lays out only when
    // drawing, and the Flickable first clamps content-y to the (old thread's) content height.
    // A huge content height avoids the clamp; past the end, the layout puts the last row at the
    // bottom with real row heights above it (vendor patch) and sets both values right.
    public function seek-end() {
        msg-list.content-height = 10000000px;
        msg-list.content-y = msg-list.visible-height - 10000000px;
    }
    // prefetch within two screens of the top: rows inserted above the ones on screen keep the
    // view still, so a wheel scroll in progress never hits the top and waits
    public function check-older() {
        if (msg-list.content-y >= -2 * msg-list.visible-height && root.can-load-older) {
            root.load-older();
        }
    }
    // the same below, when the rows stop short of the thread's newest message
    public function check-newer() {
        if (msg-list.content-y <= 3 * msg-list.visible-height - msg-list.content-height && root.can-load-newer) {
            root.load-newer();
        }
    }
    public function list-content-y() -> length {
        return msg-list.content-y;
    }
    // no clamping: the content height is still the old estimate right after a model change
    public function set-content-y-raw(y: length) {
        msg-list.content-y = y;
    }
    public function shift-by(d: length) {
        msg-list.content-y = max(msg-list.visible-height - msg-list.content-height, min(0px, msg-list.content-y - d));
    }
    out property <bool> near-bottom: msg-list.content-y <= msg-list.visible-height - msg-list.content-height + 120px;
    // the jump button wants a much tighter margin than following news: even one message up shows it
    out property <bool> off-bottom: msg-list.content-y > msg-list.visible-height - msg-list.content-height + 16px;
    changed near-bottom => {
        if (!reading-hold) {
            at-bottom-changed(near-bottom);
        }
    }

    if page == "loading": Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                Spinner { indeterminate: true; width: 36px; height: 36px; }
            }
            Text { text: loading-text; color: Theme.subtle; horizontal-alignment: center; }
        }
    }

    if page == "link": LinkPage {
        qr: root.qr;
        has-qr: root.has-qr;
        status: root.link-status;
        start-link(name) => { root.start-link(name); }
    }

    main := HorizontalLayout {
        visible: page == "main";
        // sidebar
        Rectangle {
            width: 300px;
            background: Theme.sidebar;
            VerticalLayout {
                HorizontalLayout {
                    padding: 10px;
                    spacing: 6px;
                    // the contact list: the way back to the threads
                    if SearchData.contacts: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.back;
                        clicked => { SearchData.step-back(); }
                    }
                    if !SearchData.contacts: Rectangle {
                        width: 32px;
                        // as tall as the search box beside it
                        min-height: 36px;
                        Avatar {
                            y: (parent.height - self.height) / 2;
                            size: 32px;
                            initial: SettingsData.account-initial;
                            tint: SettingsData.account-tint;
                            photo: root.me-photo;
                            has-photo: root.me-has-photo;
                        }
                        // the photo is the way into the settings: a gear over it on hover, a ring while open
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: me-ta.has-hover ? #000000a0 : transparent;
                            border-width: 2px;
                            border-color: root.settings-open && !me-ta.has-hover ? Theme.subtle : transparent;
                            Icon {
                                visible: me-ta.has-hover;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon: Icons.settings;
                                tint: white;
                            }
                        }
                        me-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.settings-open) {
                                    root.settings-open = false;
                                } else {
                                    root.open-settings();
                                }
                            }
                        }
                    }
                    search-edit := Field {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.search;
                        placeholder: !SearchData.contacts ? "검색"
                            : SearchData.find == FindKind.phone ? "전화번호 입력"
                            : SearchData.find == FindKind.username ? "사용자 이름 (예: name.42)"
                            : "이름, 전화번호, 사용자 이름";
                        text <=> SearchData.query;
                        edited => { SearchData.changed(); }
                        accepted => { SearchData.accept(); }
                        key-pressed(event) => {
                            if (event.text != Key.Escape) {
                                return reject;
                            }
                            SearchData.back();
                            accept
                        }
                    }
                    // start a conversation: the contact list
                    if !SearchData.contacts: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.compose;
                        clicked => {
                            SearchData.contacts = true;
                            SearchData.query = "";
                            SearchData.changed();
                            search-edit.focus();
                        }
                    }
                }
                if root.connection-text != "": Rectangle {
                    height: 34px;
                    Rectangle {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 30px;
                        border-radius: 8px;
                        background: Theme.selected;
                    }
                    Text {
                        x: 20px;
                        width: parent.width - 40px;
                        text: root.connection-text;
                        color: Theme.text;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                // the threads, or the search's results over them (the threads keep their place)
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        visible: !SearchData.active;
                        for t in root.threads: ThreadRow {
                            item: t;
                            selected: t.key == root.current-key;
                            clicked => {
                                root.settings-open = false;
                                root.open-thread(t.key);
                            }
                            menu(x, y) => { ThreadMenuData.open(t.key, x, y); }
                        }
                    }
                    if SearchData.active: ListView {
                        for r in SearchData.results: ResultRow {
                            item: r;
                            selected: (r.kind == ResultKind.thread || r.kind == ResultKind.contact) && r.thread.key == root.current-key;
                            clicked => {
                                if (r.kind == ResultKind.find) {
                                    SearchData.pick-find(r.text);
                                    search-edit.focus();
                                } else if (r.kind == ResultKind.start) {
                                    if (r.ready) {
                                        SearchData.start(r.text);
                                    }
                                } else if (r.kind != ResultKind.header) {
                                    root.settings-open = false;
                                    root.open-thread(r.thread.key);
                                    SearchData.leave-contacts();
                                }
                            }
                            menu(x, y) => {
                                if (r.kind == ResultKind.thread) {
                                    ThreadMenuData.open(r.thread.key, x, y);
                                }
                            }
                        }
                    }
                    if SearchData.active && SearchData.results.length == 0: Text {
                        y: 24px;
                        width: parent.width;
                        horizontal-alignment: center;
                        text: SearchData.contacts && SearchData.query == "" ? "연락처가 없습니다" : "결과가 없습니다";
                        color: Theme.subtle;
                        font-size: 13px;
                    }
                }
                if root.whatsnew-offer: Rectangle {
                    height: 46px;
                    // a card at the foot of the sidebar
                    Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 38px;
                    border-radius: 10px;
                    background: wn-ta.has-hover ? Theme.hover : Theme.pane;
                    border-width: 1px;
                    border-color: Theme.border;
                    wn-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-whatsnew(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 4px;
                        spacing: 8px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                size: 18px;
                                icon: Icons.info;
                                tint: Theme.accent;
                            }
                        Text {
                            text: "업데이트 완료";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: "새로운 점";
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.close;
                            clicked => { root.dismiss-whatsnew(); }
                        }
                    }
                    }
                }
                if SettingsData.update-version == "" && SettingsData.update-available != "": Rectangle {
                    height: 46px;
                    // a card at the foot of the sidebar
                    Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 38px;
                    border-radius: 10px;
                    background: avail-ta.has-hover && !SettingsData.update-installing ? Theme.hover : Theme.pane;
                    border-width: 1px;
                    border-color: Theme.border;
                    avail-ta := TouchArea {
                        mouse-cursor: SettingsData.update-installing ? default : pointer;
                        clicked => {
                            if !SettingsData.update-installing {
                                SettingsData.update-installing = true;
                                SettingsData.install-update();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                size: 18px;
                                icon: Icons.download;
                                tint: Theme.accent;
                            }
                        Text {
                            text: "새 버전 " + SettingsData.update-available + " 있음";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: SettingsData.update-installing ? "받는 중…" : "업데이트";
                            color: SettingsData.update-installing ? Theme.subtle : Theme.accent;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    }
                }
                if SettingsData.update-version != "": Rectangle {
                    height: 46px;
                    // a card at the foot of the sidebar
                    Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 38px;
                    border-radius: 10px;
                    background: upd-ta.has-hover ? Theme.hover : Theme.pane;
                    border-width: 1px;
                    border-color: Theme.border;
                    upd-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { SettingsData.restart-for-update(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                size: 18px;
                                icon: Icons.download;
                                tint: Theme.accent;
                            }
                        Text {
                            text: "새 버전 " + SettingsData.update-version + " 준비됨";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: "다시 시작";
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    }
                }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        }
        // conversation pane
        pane-col := VerticalLayout {
            if root.current-key == "": Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { icon: Icons.chat; size: 48px; }
                    }
                    Text {
                        text: "대화를 선택하세요";
                        color: Theme.subtle;
                        font-size: 15px;
                        horizontal-alignment: center;
                    }
                }
            }
            if root.current-key != "": Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    Avatar {
                        y: (parent.height - self.height) / 2;
                        size: 36px;
                        initial: root.current-initial;
                        tint: root.current-tint;
                        photo: root.current-photo;
                        has-photo: root.current-has-photo;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: root.current-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                        if root.current-sub != "": Text { text: root.current-sub; color: Theme.subtle; font-size: 12px; overflow: elide; }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: root.current-muted ? Icons.bell-off : Icons.bell;
                        clicked => {
                            ThreadMenuData.open(root.current-key, self.absolute-position.x + self.width, self.absolute-position.y + self.height + 4px);
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            if root.current-key != "" && root.pins.length > 0: Rectangle {
                property <int> idx: Math.min(root.pin-index, root.pins.length - 1);
                height: 48px;
                background: pin-ta.has-hover ? Theme.hover : Theme.pane;
                pin-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-message(root.pins[idx].id);
                        // like the official apps: each click moves on to the next (older) pin
                        root.pin-index = Math.mod(idx + 1, root.pins.length);
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 10px;
                    // one segment per pin, the shown one highlighted
                    VerticalLayout {
                        width: 3px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        for p[i] in root.pins: Rectangle {
                            border-radius: 1.5px;
                            background: i == idx ? Theme.accent : Theme.border;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.pins.length > 1 ? "고정된 메시지 " + (idx + 1) + "/" + root.pins.length : "고정된 메시지";
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.pins[idx].sender + ": " + root.pins[idx].text;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    // the pin itself is the button: its menu
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.pin;
                        active: true;
                        clicked => {
                            root.pin-menu-x = self.absolute-position.x + self.width;
                            root.pin-menu-y = self.absolute-position.y + self.height + 4px;
                            root.pin-menu-open = true;
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            list-box := Rectangle {
                visible: root.current-key != "";
                // hidden, it would still take half the height from the empty screen
                vertical-stretch: self.visible ? 1 : 0;
                max-height: self.visible ? 100000px : 0px;
                // The list runs on behind the composer (and the sticker panel or request bar),
                // which float over its bottom. The newest row carries their height as room below
                // it, so the list's own end is still where the last message sits above them.
                msg-list := ListView {
                    // taller than its parent: without a y it would be centered, half of it over the header
                    y: 0px;
                    width: parent.width;
                    height: parent.height + root.float-h;
                    // what floats over the bottom growing (a reply card, a second line, the
                    // sticker panel): if the list was at the bottom, keep the last message above it.
                    // The rows lay out only when drawing, so the content height is still the old
                    // one here: seek-end lets the layout put the last row at the bottom.
                    changed tail => {
                        if (!root.off-bottom) {
                            root.seek-end();
                        }
                    }
                    property <length> tail: root.float-h;
                    // the composer growing (or a resize) shrinks the list: if it was at the
                    // bottom before, keep it there so the last message isn't hidden
                    property <length> last-vh;
                    changed visible-height => {
                        if (self.last-vh > 0 && self.content-height + self.content-y - self.last-vh <= 120px) {
                            root.scroll-to-bottom();
                        }
                        self.last-vh = self.visible-height;
                    }
                    // load older history at the top. `scrolled` fires when a wheel notch starts
                    // its 180ms animation, before content-y gets there, so content-y itself is
                    // watched too, once the user has scrolled this thread
                    property <bool> user-scrolled;
                    property <string> key: root.current-key;
                    changed key => { self.user-scrolled = false; root.date-show = false; }
                    scrolled => {
                        self.user-scrolled = true;
                        root.check-older();
                        root.check-newer();
                        root.gif-scrolled();
                    }
                    changed content-y => {
                        root.gif-scrolled();
                        if (self.user-scrolled) {
                            root.check-older();
                            root.check-newer();
                            // not while stuck to the bottom: news arriving moves content-y too
                            // nor while a jump is on its way: the row it lands on shows its own separator
                            if (root.off-bottom && root.jump-id == "") {
                                root.date-show = true;
                                root.date-idle = 0;
                            }
                        }
                    }
                    for m[idx] in root.messages: Bubble {
                        m: m;
                        last: idx == root.messages.length - 1;
                        tail: root.float-h;
                        max-w: min(560px, msg-list.visible-width * 0.75);
                        flash: m.id == root.flash-id;
                        property <int> probe: root.jump-probe;
                        changed probe => {
                            if (m.id == root.jump-id) {
                                root.jump-pos = self.y + self.lead + msg-list.content-y;
                                root.jump-h = self.height - self.lead;
                                root.jump-lead = self.lead;
                                root.jump-found = true;
                            }
                        }
                        property <length> screen-top: self.y + msg-list.content-y;
                        property <bool> is-divider: m.unread-divider;
                        // the row across the list's top edge and where its top is: where the user
                        // left off (gui::scroll::remember_place)
                        property <string> top-id: self.screen-top <= 0px && self.screen-top + self.height > 0px ? m.id : "";
                        // the day of the top row, unless its own separator pill is still in view
                        property <int> top-day: !(m.day-sep && self.screen-top + self.lead > 0px) ? m.day : 0;
                        changed top-id => { if (self.top-id != "") { root.view-top-id = self.top-id; root.view-top-off = self.screen-top; root.top-day = self.top-day; } }
                        changed screen-top => {
                            if (self.is-divider) { root.divider-top = self.screen-top; }
                            if (self.top-id != "") { root.view-top-id = self.top-id; root.view-top-off = self.screen-top; root.top-day = self.top-day; }
                        }
                        changed is-divider => { if (self.is-divider) { root.divider-top = self.screen-top; } }
                        // reading as the user goes: a row whose bottom edge is on screen, above
                        // the composer floating over the list. The id, not a bool: the ListView
                        // gives rows old instances with new data.
                        property <string> seen-id: !root.reading-hold && !root.inactive && !m.typing && self.y + self.height - self.below + msg-list.content-y <= msg-list.visible-height - root.float-h + 1px ? m.id : "";
                        changed seen-id => {
                            if (self.seen-id != "") {
                                root.row-seen(self.seen-id);
                            }
                        }
                        attachment-clicked(id, index) => { root.attachment-clicked(id, index); }
                        day-label(d) => { return root.day-label(d); }
                        file-clicked(id) => { root.file-clicked(id); }
                        save-clicked(id) => { root.save-clicked(id); }
                        quote-clicked(id) => { root.show-message(id); }
                        reply(id) => { root.reply(id); }
                        show-info(t) => { root.info-title = "메시지 정보"; root.info-text = t; }
                        show-reactors(t) => { root.info-title = "반응"; root.info-text = t; }
                        menu(id, x, y) => {
                            root.menu-reacts = false;
                            root.open-menu(id, x, y);
                        }
                        react-menu(id, x, y) => {
                            root.menu-reacts = true;
                            root.open-menu(id, x, y);
                        }
                    }
                }
                // Under what floats: the software renderer can't blur, so messages behind it are
                // dimmed instead, fading in above the pill and evenly dimmed around it. A fully
                // opaque ground looked walled off; none at all, busy.
                Rectangle {
                    y: parent.height - 12px;
                    height: 36px;
                    visible: root.float-h > 0;
                    background: @linear-gradient(180deg, Theme.pane.transparentize(1) 0%, Theme.pane.transparentize(0.35) 100%);
                }
                Rectangle {
                    y: parent.height + 24px;
                    height: max(0px, root.float-h - 24px);
                    background: Theme.pane.transparentize(0.35);
                }
                // the date of the messages at the top, while the user scrolls
                date-pill := Rectangle {
                    y: 8px;
                    x: (parent.width - self.width) / 2;
                    width: date-text.preferred-width + 20px;
                    height: 26px;
                    border-radius: 13px;
                    background: date-ta.has-hover ? Theme.hover : Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    opacity: root.date-show && root.top-day != 0 ? 1.0 : 0.0;
                    visible: self.opacity > 0;
                    animate opacity { duration: 150ms; }
                    // a click goes to the first message of that day
                    date-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.date-show = false;
                            root.show-day(root.shown-day);
                        }
                    }
                    date-text := Text {
                        x: 10px;
                        height: parent.height;
                        text: root.day-label(root.shown-day);
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                Timer {
                    interval: 300ms;
                    running: root.date-show;
                    triggered => {
                        // stays up while the cursor is on it
                        root.date-idle = date-ta.has-hover ? 0 : root.date-idle + 1;
                        if (root.date-idle >= 9) { root.date-show = false; }
                    }
                }
                // jump to the latest message
                if root.off-bottom || root.can-load-newer: Rectangle {
                    x: parent.width - self.width - 20px;
                    y: parent.height - self.height - 14px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: jump-ta.has-hover ? Theme.hover : Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: Theme.shadow;
                    jump-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.jump-to-bottom(); }
                    }
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.chevron-down;
                        tint: Theme.text;
                    }
                    if root.open-unread > 0: Rectangle {
                        x: parent.width - self.width + 4px;
                        y: -6px;
                        height: 18px;
                        width: max(18px, badge.preferred-width + 10px);
                        border-radius: 9px;
                        background: Theme.accent;
                        badge := Text {
                            text: root.open-unread > 99 ? "99+" : root.open-unread;
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }
                }
            }
            if root.current-key != "" && root.sticker-open: StickerPanel {
                packs: root.packs;
                stickers: root.stickers;
                current-pack: root.current-pack;
                url-text <=> root.pack-url;
                pick-pack(id) => { root.pick-pack(id); }
                send-sticker(p, i) => { root.send-sticker(p, i); }
                install-pack(id) => { root.install-pack(id); }
                add-pack-url(u) => { root.add-pack-url(u); }
                close => {
                    root.toggle-stickers();
                    root.focus-composer();
                }
            }
            // in place of the composer, the same inset
            if root.current-key != "" && root.current-request: HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 12px;
                Rectangle {
                border-radius: 16px;
                background: Theme.field;
                VerticalLayout {
                    padding: 16px;
                    padding-top: 14px;
                    spacing: 12px;
                    Text {
                        text: "\{root.current-name}님이 메시지를 보냈습니다. 수락하면 상대가 내 이름과 사진을 볼 수 있고, 메시지를 읽었는지도 알 수 있습니다.";
                        color: Theme.subtle;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        DangerButton { text: "차단"; clicked => { root.answer-request(2); } }
                        DangerButton { text: "삭제"; clicked => { root.answer-request(1); } }
                        PrimaryButton { text: "수락"; clicked => { root.answer-request(0); } }
                    }
                }
                }
            }
            composer-bar := Rectangle {
                visible: root.current-key != "" && !root.current-request;
                // as tall as what it holds: the message list takes the rest
                vertical-stretch: 0;
                min-height: self.visible ? 64px : 0px;
                max-height: self.visible ? 400px : 0px;
                // a pill holding the buttons and the text
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 12px;
                    Rectangle {
                    border-radius: 22px;
                    background: Theme.field;
                    VerticalLayout {
                        // what goes with the message: cards inside the pill, above the text
                        if root.edit-preview != "": HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                            Rectangle {
                                border-radius: 16px;
                                background: Theme.pane;
                                HorizontalLayout {
                                    padding: 6px;
                                    padding-left: 12px;
                                    spacing: 10px;
                                    Icon { y: (parent.height - self.height) / 2; size: 16px; icon: Icons.edit; tint: Theme.accent; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text { text: "수정 중"; color: Theme.accent; font-size: 12px; font-weight: 700; }
                                        Text { text: root.edit-preview; color: Theme.subtle; font-size: 12px; overflow: elide; }
                                    }
                                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.close; icon-size: 16px; width: 28px; height: 28px; clicked => { root.cancel-edit(); } }
                                }
                            }
                        }
                        if root.reply-preview != "": HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                            Rectangle {
                                border-radius: 16px;
                                background: Theme.pane;
                                HorizontalLayout {
                                    padding: 6px;
                                    padding-left: 12px;
                                    spacing: 10px;
                                    Icon { y: (parent.height - self.height) / 2; size: 16px; icon: Icons.reply; tint: Theme.accent; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text {
                                            text: root.reply-author == "" ? "답장" : root.reply-author == "나" ? "내 메시지에 답장" : root.reply-author + "에게 답장";
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }
                                        Text { text: root.reply-preview; color: Theme.subtle; font-size: 12px; overflow: elide; }
                                    }
                                    // the quote thumbnail, already sized for the message list's quote box
                                    if root.reply-has-image: Rectangle {
                                        width: 54px;
                                        height: 54px;
                                        border-radius: 11px;
                                        clip: true;
                                        background: Theme.loading;
                                        Image { width: 100%; height: 100%; source: root.reply-image; image-fit: cover; }
                                    }
                                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.close; icon-size: 16px; width: 28px; height: 28px; clicked => { root.cancel-reply(); } }
                                }
                            }
                        }
                        // a file goes alone: one card with its name and size
                        if root.pending-files.length > 0 && root.pending-files[0].is-file: HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                Rectangle {
                    height: 64px;
                    border-radius: 16px;
                    background: Theme.pane;
                    Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 40px;
                        height: 40px;
                        border-radius: 6px;
                        background: root.pending-files[0].danger ? Theme.warning : Theme.accent;
                        Text {
                            text: root.pending-files[0].ext;
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        x: 64px;
                        y: 0px;
                        width: parent.width - 64px - 40px;
                        height: parent.height;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.pending-files[0].name;
                            color: Theme.text;
                            font-size: 14px;
                            overflow: elide;
                        }
                        Text {
                            text: root.pending-files[0].danger ? root.pending-files[0].size + " · 위험할 수 있음" : root.pending-files[0].size;
                            color: root.pending-files[0].danger ? Theme.warning-text : Theme.subtle;
                            font-size: 12px;
                        }
                    }
                    Rectangle {
                        x: parent.width - self.width - 10px;
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: file-remove.has-hover ? Theme.on-media-hover : Theme.on-media;
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            viewbox-width: 8;
                            viewbox-height: 8;
                            commands: "M 0 0 L 8 8 M 8 0 L 0 8";
                            stroke: #ffffff;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                        }
                        file-remove := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.remove-attachment(0); }
                        }
                    }
                }
                        }
                        if root.pending-files.length > 0 && !root.pending-files[0].is-file: HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                            Rectangle {
                                border-radius: 16px;
                                background: Theme.pane;
                                HorizontalLayout {
                                    padding: 6px;
                    // The wheel only scrolls vertically, which this Flickable can't: the TouchArea
                    // gets the event the Flickable rejects and turns it into a horizontal move.
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 120px;
                        scroll-event(e) => {
                            files-flick.content-x = clamp(files-flick.content-x + (e.delta-y != 0px ? e.delta-y : e.delta-x),
                                min(0px, files-flick.width - files-flick.content-width), 0px);
                            accept
                        }
                        files-flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-width: files-row.preferred-width;
                            files-row := HorizontalLayout {
                                spacing: 8px;
                                for f[i] in root.pending-files: Rectangle {
                                    width: 120px;
                                    height: 120px;
                                    border-radius: 10px;
                                    clip: true;
                                    background: Theme.hover;
                                    if f.has-thumb: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: f.thumb;
                                        // a still is already this size; a GIF's frame is cut to fill it
                                        image-fit: cover;
                                    }
                                    if f.gif && !f.playing: MediaLabel {
                                        text: "GIF";
                                        x: 6px;
                                        y: parent.height - self.height - 6px;
                                    }
                                    if f.gif: TouchArea {
                                        property <bool> hovered: self.has-hover;
                                        changed hovered => { root.pending-gif-hover(i, self.hovered); }
                                    }
                                    if !f.has-thumb: Text {
                                        text: f.ext;
                                        color: Theme.subtle;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        x: parent.width - self.width - 3px;
                                        y: 3px;
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: remove-area.has-hover ? Theme.on-media-hover : Theme.on-media;
                                        // drawn, not a glyph: the glyph sits off the circle's center
                                        Path {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 8px;
                                            height: 8px;
                                            viewbox-width: 8;
                                            viewbox-height: 8;
                                            commands: "M 0 0 L 8 8 M 8 0 L 0 8";
                                            stroke: #ffffff;
                                            stroke-width: 1.5px;
                                            stroke-line-cap: round;
                                        }
                                        remove-area := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-attachment(i); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                                }
                            }
                        }
                        if root.compose-link-url != "" && root.pending-files.length == 0 && root.edit-preview == "": HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                            Rectangle {
                                border-radius: 16px;
                                background: Theme.pane;
                                HorizontalLayout {
                                    padding: 6px;
                                    spacing: 10px;
                                    if root.compose-link-has-image: Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 10px;
                                        clip: true;
                                        Image {
                                            width: 44px;
                                            height: 44px;
                                            source: root.compose-link-image;
                                            // already resampled to this size
                                            image-fit: fill;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 1px;
                                        padding-left: root.compose-link-has-image ? 0px : 6px;
                                        Text {
                                            text: root.compose-link-title;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }
                                        if root.compose-link-desc != "": Text {
                                            text: root.compose-link-desc;
                                            color: Theme.subtle;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.compose-link-domain;
                                            color: Theme.subtle;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.close; icon-size: 16px; width: 28px; height: 28px; clicked => { root.link-dismiss(); } }
                                }
                            }
                        }
                    HorizontalLayout {
                        padding: 5px;
                        spacing: 2px;
                        IconButton {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            // the pill is about as light as the usual hover
                            hover-color: Theme.field-off;
                            icon: Icons.attach;
                            clicked => { root.attach(); }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            padding-left: 8px;
                            padding-right: 4px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            FocusScope {
                                // FocusScope and Rectangle don't take their child's size: grow with wrapped lines
                                min-height: min(composer.preferred-height, 140px);
                                capture-key-pressed(event) => {
                                    if (root.mention-items.length > 0) {
                                        if (event.text == Key.UpArrow) {
                                            root.mention-sel = Math.max(0, root.mention-sel - 1);
                                            return accept;
                                        }
                                        if (event.text == Key.DownArrow) {
                                            root.mention-sel = Math.min(root.mention-items.length - 1, root.mention-sel + 1);
                                            return accept;
                                        }
                                        if ((event.text == Key.Return && !event.modifiers.shift) || event.text == Key.Tab) {
                                            root.mention-pick(root.mention-sel, composer.text, composer.cursor-position-byte-offset);
                                            return accept;
                                        }
                                        if (event.text == Key.Escape) {
                                            root.mention-items = [];
                                            return accept;
                                        }
                                    }
                                    // empty composer: edit my last message (not while an IME is composing)
                                    if (event.text == Key.UpArrow && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt
                                        && root.draft == "" && composer.preedit-text == "" && root.edit-last()) {
                                        return accept;
                                    }
                                    if (event.text == Key.Return && !event.modifiers.shift && SettingsData.enter-sends != event.modifiers.control) {
                                        root.send(composer.text);
                                        return accept;
                                    }
                                    // the panel floats over the composer: Esc closes it before edit/reply
                                    if (event.text == Key.Escape && root.sticker-open) {
                                        root.toggle-stickers();
                                        return accept;
                                    }
                                    if (event.text == Key.Escape && root.edit-preview != "") {
                                        root.cancel-edit();
                                        return accept;
                                    }
                                    if (event.text == Key.Escape && root.reply-preview != "") {
                                        root.cancel-reply();
                                        return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                                        if (root.paste-files()) {
                                            return accept;
                                        }
                                    }
                                    // text styles (Signal Desktop's shortcuts): wrap the selection in markers
                                    if (event.modifiers.control && !event.modifiers.alt) {
                                        let k = event.text;
                                        let style = !event.modifiers.shift
                                            ? (k == "b" || k == "B" ? 1 : k == "i" || k == "I" ? 2 : k == "e" || k == "E" ? 5 : 0)
                                            : (k == "x" || k == "X" ? 4 : k == "b" || k == "B" ? 3 : 0);
                                        if (style != 0) {
                                            root.format-toggle(style, composer.text, composer.anchor-position-byte-offset, composer.cursor-position-byte-offset);
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                                Rectangle {
                                    composer := TextInput {
                                        text <=> root.draft;
                                        edited => {
                                            // over the 64KB a message can carry: the new part is cut to fit
                                            let cut = root.clamp-draft(self.text);
                                            if cut >= 0 {
                                                self.set-selection-offsets(cut, cut);
                                            }
                                            root.composing(self.text != "");
                                            root.link-check();
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        cursor-position-changed => {
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        // IME composition (Hangul) changes neither text nor cursor: follow it too
                                        changed preedit-text => {
                                            // Slint deletes the selection only when the composition commits
                                            // (not when it starts, like other apps), so typing Hangul over
                                            // selected text showed both until then
                                            if (self.preedit-text != "" && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                                                root.drop-selection(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                                            }
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                        font-size: 14px;
                                        max-height: 140px;
                                    }
                                    // hide as soon as IME composition starts (preedit isn't in text yet)
                                    if root.draft == "" && composer.preedit-text == "": Text {
                                        x: 0;
                                        y: 0;
                                        text: root.edit-preview != "" ? "수정할 내용 입력 (Esc 취소)" : "메시지 입력";
                                        color: Theme.subtle;
                                        font-size: 14px;
                                    }
                                }
                            }
                        }
                        // a sticker goes alone, never with a photo: a photo being sent takes its
                        // place with the quality photos go at (the setting)
                        if !root.pending-has-photo: IconButton {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            // the pill is about as light as the usual hover
                            hover-color: Theme.field-off;
                            icon: Icons.sticker;
                            active: root.sticker-open;
                            clicked => { root.toggle-stickers(); }
                        }
                        // drawn like its neighbors (an outline, no fill), crossed out when off and lit
                        // with the accent when on
                        if root.pending-has-photo: hd-btn := Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: hd-area.has-hover ? Theme.field-off : transparent;
                            // the hint shows after the pointer rests on the button
                            property <bool> tip-ready;
                            Timer {
                                running: hd-area.has-hover && !hd-btn.tip-ready;
                                interval: 400ms;
                                triggered => { hd-btn.tip-ready = true; }
                            }
                            hd-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    SettingsData.photo-quality = SettingsData.photo-quality == 1 ? 0 : 1;
                                    SettingsData.changed();
                                }
                                changed has-hover => {
                                    if (!self.has-hover) {
                                        hd-btn.tip-ready = false;
                                    }
                                }
                            }
                            Rectangle {
                                width: 24px;
                                height: 17px;
                                border-radius: 4px;
                                border-width: 1.5px;
                                border-color: SettingsData.photo-quality == 1 ? Theme.accent : Theme.subtle;
                                background: SettingsData.photo-quality == 1 ? Theme.accent.with-alpha(0.2) : transparent;
                                Text {
                                    text: "HD";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: SettingsData.photo-quality == 1 ? Theme.accent : Theme.subtle;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            if SettingsData.photo-quality != 1: Path {
                                width: 34px;
                                height: 34px;
                                viewbox-width: 34;
                                viewbox-height: 34;
                                commands: "M 7 7 L 27 27";
                                stroke: Theme.subtle;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                            }
                            if hd-area.has-hover && hd-btn.tip-ready: Rectangle {
                                x: 0px;
                                y: -self.height - 8px;
                                width: hd-tip.preferred-width + 20px;
                                height: hd-tip.preferred-height + 14px;
                                border-radius: 6px;
                                background: Theme.sidebar;
                                border-width: 1px;
                                border-color: Theme.border;
                                hd-tip := Text {
                                    x: 10px;
                                    y: 7px;
                                    text: SettingsData.photo-quality == 1 ? "높은 화질로 보냅니다\n눌러서 표준으로 바꿀 수 있습니다" : "표준 화질로 보냅니다\n눌러서 높은 화질로 바꿀 수 있습니다";
                                    color: Theme.text;
                                    font-size: 12px;
                                }
                            }
                        }
                        send-btn := Rectangle {
                            property <bool> ready: root.draft != "" || root.pending-files.length > 0;
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: !self.ready ? Theme.field-off : send-ta.pressed ? Theme.accent.darker(0.2) : send-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                            send-ta := TouchArea {
                                enabled: send-btn.ready;
                                mouse-cursor: pointer;
                                clicked => { root.send(composer.text); }
                            }
                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 18px;
                                icon: Icons.send;
                                tint: send-btn.ready ? white : Theme.subtle;
                            }
                        }
                    }
                    }
                    }
                }
            }
        }
    }

    if page == "main" && root.settings-open: SettingsPage {
        x: 300px;
        width: root.width - 300px;
        height: root.height;
        open-whatsnew => { root.open-whatsnew(); }
        close => { root.settings-open = false; }
        unlink => { root.unlink(); }
    }

    // @mention popup, just above the composer
    if root.mention-items.length > 0: Rectangle {
        x: composer.absolute-position.x - 8px;
        y: composer-bar.absolute-position.y - self.height - 4px;
        width: 240px;
        height: mention-col.preferred-height;
        border-radius: 10px;
        background: Theme.pane;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        mention-col := VerticalLayout {
            padding: 4px;
            for item[i] in root.mention-items: Rectangle {
                height: 36px;
                border-radius: 6px;
                background: i == root.mention-sel ? Theme.selected : mta.has-hover ? Theme.hover : transparent;
                mta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mention-pick(i, composer.text, composer.cursor-position-byte-offset); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;
                    Avatar {
                        size: 24px;
                        y: 6px;
                        initial: item.initial;
                        tint: item.tint;
                    }
                    Text {
                        text: item.name;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // message menu: reactions + actions, opened by right-clicking a message
    if root.menu-id != "": Rectangle {
        TouchArea {
            clicked => { root.menu-id = ""; }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.menu-id = "";
                }
            }
        }
        card := Rectangle {
            property <length> w: (root.menu-picker ? PickerLayout.columns : 7) * PickerLayout.cell + 12px;
            width: w;
            height: menu-col.preferred-height;
            x: max(8px, min(root.menu-x, root.width - w - 8px));
            y: max(8px, min(root.menu-y, root.height - self.height - 8px));
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if root.menu-picker: EmojiPicker {
                    mine: root.menu-mine;
                    recent: root.recent-emoji;
                    rows: root.picker-rows;
                    tab: root.picker-tab;
                    tab-changed(i) => {
                        root.picker-tab = i;
                        root.picker-tab-changed(i);
                    }
                    picked(e) => {
                        root.react(root.menu-id, e);
                        root.menu-id = "";
                    }
                }
                if !root.menu-picker: HorizontalLayout {
                    for e in ["❤️", "👍", "👎", "😂", "😮", "😢"]: ReactionCell {
                        emoji: e;
                        mine: e == root.menu-mine;
                        picked => {
                            root.react(root.menu-id, e);
                            root.menu-id = "";
                        }
                    }
                    // any other emoji; ours when it is none of the six
                    plus := ReactionCell {
                        icon: Icons.plus;
                        mine: root.menu-mine != "" && root.menu-mine != "❤️" && root.menu-mine != "👍" && root.menu-mine != "👎"
                            && root.menu-mine != "😂" && root.menu-mine != "😮" && root.menu-mine != "😢";
                        picked => {
                            root.picker-tab = 0;
                            root.menu-picker = true;
                            root.picker-tab-changed(0);
                        }
                    }
                }
                if !root.menu-picker && !root.menu-reacts: Rectangle { height: 1px; background: Theme.border; }
                if root.menu-pin-step && !root.menu-picker: HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        height: 28px;
                        text: "고정할 기간";
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                for d in root.menu-pin-step && !root.menu-picker ? [
                    { label: "24시간", secs: 86400 },
                    { label: "7일", secs: 604800 },
                    { label: "30일", secs: 2592000 },
                    { label: "해제할 때까지", secs: 0 },
                ] : []: MenuRow {
                    text: d.label;
                    clicked => {
                        root.pin-message(root.menu-id, d.secs);
                        root.menu-id = "";
                    }
                }
                if !root.menu-pin-step && !root.menu-picker && !root.menu-reacts: MenuRow {
                    icon: Icons.reply;
                    text: "답장";
                    clicked => {
                        root.reply(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if !root.menu-pin-step && !root.menu-picker && !root.menu-reacts: MenuRow {
                    icon: Icons.pin;
                    text: root.menu-pinned ? "고정 해제" : "고정";
                    clicked => {
                        if (root.menu-pinned) {
                            root.unpin(root.menu-id);
                            root.menu-id = "";
                        } else {
                            root.menu-pin-step = true;
                        }
                    }
                }
                if root.menu-can-edit && !root.menu-pin-step && !root.menu-picker && !root.menu-reacts: MenuRow {
                    icon: Icons.edit;
                    text: "수정";
                    clicked => {
                        root.edit-message(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if root.menu-info != "" && !root.menu-pin-step && !root.menu-picker && !root.menu-reacts: MenuRow {
                    icon: Icons.info;
                    text: "정보";
                    clicked => {
                        root.info-title = "메시지 정보";
                        root.info-text = root.menu-info;
                        root.menu-id = "";
                    }
                }
                if root.menu-can-delete && !root.menu-pin-step && !root.menu-picker && !root.menu-reacts: MenuRow {
                    icon: Icons.trash;
                    text: "모두에게서 삭제";
                    danger: true;
                    clicked => {
                        root.delete-message(root.menu-id);
                        root.menu-id = "";
                    }
                }
            }
        }
    }

    // the pinned bar's menu, under its pin, right-aligned to it
    if root.pin-menu-open && root.pins.length > 0: Rectangle {
        property <int> idx: Math.min(root.pin-index, root.pins.length - 1);
        TouchArea {
            clicked => { root.pin-menu-open = false; }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.pin-menu-open = false;
                }
            }
        }
        Rectangle {
            property <length> w: 180px;
            width: w;
            height: pin-menu-col.preferred-height;
            x: max(8px, min(root.pin-menu-x - w, root.width - w - 8px));
            y: max(8px, min(root.pin-menu-y, root.height - self.height - 8px));
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            pin-menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                MenuRow {
                    text: "메시지로 이동";
                    clicked => {
                        root.pin-menu-open = false;
                        root.show-message(root.pins[idx].id);
                    }
                }
                MenuRow {
                    text: "고정 해제";
                    clicked => {
                        root.pin-menu-open = false;
                        root.unpin(root.pins[idx].id);
                    }
                }
            }
        }
    }

    if ThreadMenuData.key != "": ThreadMenu { }
    if ThreadMenuData.prefs-key != "": ThreadPrefsDialog { }

    if RepliesData.open: RepliesDialog { }

    // message info (who received / read an outgoing message)
    if root.info-text != "": Rectangle {
        background: Theme.scrim;
        TouchArea {
            clicked => { root.info-text = ""; }
        }
        Rectangle {
            width: min(380px, parent.width - 40px);
            height: info-col.preferred-height;
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            info-col := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: root.info-title; font-weight: 700; font-size: 15px; color: Theme.text; }
                Text { text: root.info-text; wrap: word-wrap; color: Theme.text; font-size: 13px; }
                HorizontalLayout {
                    alignment: end;
                    PlainButton {
                        text: "닫기";
                        clicked => { root.info-text = ""; }
                    }
                }
            }
        }
    }

    // files being dragged over the conversation: where they would go
    if page == "main" && root.current-key != "" && root.drop-hover: Rectangle {
        x: 300px;
        y: 0px;
        width: root.width - 300px;
        height: root.height;
        background: Theme.accent.with-alpha(0.14);
        border-width: 3px;
        border-color: Theme.accent;
        Text {
            text: "여기에 놓아서 첨부합니다";
            color: Theme.accent;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // over the conversation pane, just above the composer (the window's bottom when there is none)
    if page == "main" && root.notice-text != "": Notice {
        text: root.notice-text;
        action: root.notice-action;
        action-clicked => { root.notice-action-clicked(); }
        max-text-width: root.width - 300px - 76px;
        x: 300px + (root.width - 300px - self.width) / 2;
        // above everything that sits over the input (attachment, reply, link preview), not just the
        // input row: the list ends where those begin
        y: msg-list.absolute-position.y + msg-list.height - self.height - 10px;
    }
}
