import { LineEdit, Button, ListView, Palette, Spinner, Switch } from "std-widgets.slint";

export struct ThreadItem {
    key: string,
    name: string,
    snippet: string,
    time: string,
    unread: int,
    initial: string,
    color: color,
    is-group: bool,
    photo: image,
    has-photo: bool,
}

export struct ReactionItem {
    emoji: string,
    count: int,

}

export struct ReaderItem {
    photo: image,
    has-photo: bool,
    initial: string,
    tint: color,
}

export struct MsgItem {
    id: string,
    sender: string,
    sender-color: color,
    text: string,
    // text with highlighted @mentions and links (only when has-rich)
    rich: styled-text,
    has-rich: bool,
    time: string,
    outgoing: bool,
    show-sender: bool,
    // incoming in a group: photo column; the photo itself on the last row of a run
    avatar-col: bool,
    show-avatar: bool,
    avatar: image,
    has-avatar: bool,
    initial: string,
    status: string,
    // photos of those who read it (outgoing; replaces the status text) and how many more there are
    readers: [ReaderItem],
    readers-more: int,
    quote: string,
    reactions: [ReactionItem],
    big-emoji: bool,
    attachment: string,
    has-image: bool,
    image: image,
    img-w: length,
    img-h: length,
    deleted: bool,
    day-sep: string,
    system: bool,
    sticker: bool,
    receipt-info: string,
    pending: bool,
    // same run and minute as the next row: no time / status footer
    hide-time: bool,
    // the "someone is typing" bubble at the end of the list
    typing: bool,
}

export struct PinItem {
    // sent timestamp of the pinned message
    id: string,
    sender: string,
    text: string,
}

export struct MentionItem {
    name: string,
    initial: string,
    tint: color,
}

export struct PackItem {
    id: string,
    title: string,
    installed: bool,
    cover: image,
}

export struct StickerItem {
    id: int,
    emoji: string,
    img: image,
}

// clickable links in message text (see src/link.rs)
export global Links {
    callback open(string);
}

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> accent: #2c6bed;
    out property <color> sidebar: dark ? #1b1b1d : #f6f6f8;
    out property <color> pane: dark ? #121212 : #ffffff;
    // visually identical twin of `pane`, used to force a full repaint (see AppWindow.repaint-flip)
    out property <color> pane-twin: dark ? #121213 : #fffffe;
    out property <color> border: dark ? #2a2a2d : #e3e3e6;
    out property <color> text: dark ? #e9e9eb : #1b1b1d;
    out property <color> subtle: dark ? #9a9aa0 : #6b6b70;
    out property <color> bubble-in: dark ? #2b2b2e : #e9e9eb;
    out property <color> bubble-out: accent;
    out property <color> selected: dark ? #2c2c31 : #dfe7fb;
    out property <color> hover: dark ? #232326 : #ececf0;
}

component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <length> size: 40px;
    // pre-cut round by the backend (avatar.rs) at the exact physical size
    in property <image> photo;
    in property <bool> has-photo;
    width: size;
    height: size;
    border-radius: size / 2;
    background: has-photo ? transparent : tint;
    Text {
        visible: !has-photo;
        text: initial;
        color: white;
        font-size: size * 0.42;
        font-weight: 600;
    }
    Image {
        visible: has-photo;
        width: size;
        height: size;
        source: photo;
        image-fit: fill;
    }
}

component IconButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: ta.has-hover && enabled ? Theme.hover : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: label;
        // the UI font (Malgun Gothic) lacks symbols like ✕ ➤, and the software renderer
        // does not fall back per glyph: use the symbol font for icons
        font-family: "Segoe UI Symbol";
        font-size: 18px;
        color: enabled ? Theme.subtle : Theme.border;
    }
}

component ThreadRow inherits Rectangle {
    in property <ThreadItem> item;
    in property <bool> selected;
    callback clicked;
    height: 64px;
    background: selected ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: stretch;
        Avatar {
            y: (parent.height - self.height) / 2;
            initial: item.initial;
            tint: item.color;
            photo: item.photo;
            has-photo: item.has-photo;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.name;
                    color: Theme.text;
                    font-weight: item.unread > 0 ? 700 : 500;
                    font-size: 14px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: item.time;
                    color: Theme.subtle;
                    font-size: 11px;
                    horizontal-stretch: 0;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.snippet;
                    color: Theme.subtle;
                    font-size: 12.5px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if item.unread > 0: Rectangle {
                    horizontal-stretch: 0;
                    min-width: 20px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.accent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: item.unread > 99 ? "99+" : item.unread;
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// time + delivery status of a message; clicking either shows who has it
component MsgMeta inherits HorizontalLayout {
    in property <MsgItem> m;
    callback info(string);
    spacing: 4px;
    property <bool> bare: m.has-image && m.text == "" && m.quote == "" && m.attachment == "";
    Text {
        text: m.time;
        font-size: 10.5px;
        vertical-alignment: bottom;
        color: m.outgoing && !m.sticker && !m.big-emoji && !m.deleted && !root.bare ? #ffffffb0 : Theme.subtle;
        TouchArea {
            enabled: m.outgoing;
            mouse-cursor: m.outgoing ? pointer : default;
            clicked => { root.info(m.receipt-info); }
        }
    }
    if m.outgoing && m.status != "": Text {
        text: m.status;
        // ✓ is missing from the UI font; Hangul ("읽음") is missing from the symbol font
        font-family: m.status == "✓" || m.status == "✓✓" ? "Segoe UI Symbol" : "Malgun Gothic";
        font-size: 12px;
        vertical-alignment: bottom;
        color: m.sticker || m.big-emoji || root.bare ? Theme.subtle : #ffffffd0;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.info(m.receipt-info); }
        }
    }
}

component MsgImage inherits Rectangle {
    in property <MsgItem> m;
    // flush: as wide as the bubble (which clips the corners), otherwise a fixed size
    in property <bool> flush;
    callback attachment-clicked(string);
    callback menu(string, length, length);
    min-width: flush ? m.img-w : 0px;
    preferred-width: m.img-w;
    max-width: flush ? 100000px : m.img-w;
    height: m.img-h;
    // flush: only the top corners follow the bubble (the bubble itself must not clip: reader photos hang over its edge)
    border-radius: flush ? 0px : 8px;
    border-top-left-radius: flush ? 14px : 8px;
    border-top-right-radius: flush ? 14px : 8px;
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        source: m.image;
        image-fit: m.sticker ? contain : cover;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.attachment-clicked(m.id); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// hover toolbar beside a bubble: reply, more (the menu has the reactions)
component MsgTools inherits Rectangle {
    in property <bool> shown;
    out property <bool> hovered: ta-reply.has-hover || ta-more.has-hover || gap.has-hover;
    callback reply();
    callback more(length, length);
    width: 2 * 28px + 8px;
    height: 28px;
    opacity: shown || hovered ? 1.0 : 0.0;
    // 4px transparent gap next to the bubble keeps the hover from dropping while crossing to the buttons
    gap := TouchArea { }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        for icon[i] in ["↩", "⋯"]: Rectangle {
            width: 28px;
            border-radius: 14px;
            background: (i == 0 ? ta-reply.has-hover : ta-more.has-hover) ? Theme.hover : transparent;
            Text {
                text: icon;
                font-family: "Segoe UI Symbol";
                font-size: 16px;
                color: Theme.subtle;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    ta-reply := TouchArea {
        x: 4px;
        width: 28px;
        mouse-cursor: pointer;
        clicked => { root.reply(); }
    }
    ta-more := TouchArea {
        x: 32px;
        width: 28px;
        mouse-cursor: pointer;
        clicked => { root.more(self.absolute-position.x, self.absolute-position.y); }
    }
}

component Bubble inherits VerticalLayout {
    in property <MsgItem> m;
    in property <length> max-w;
    // briefly outlined after jumping to it (pinned message bar)
    in property <bool> flash;
    callback attachment-clicked(string);
    callback reply(string);
    callback show-info(string);
    // right click: message menu at (x, y) in window coordinates
    callback menu(string, length, length);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: m.show-sender || m.day-sep != "" || m.typing ? 8px : 2px;
    // the newest row gets extra room below so it doesn't touch the composer
    in property <bool> last;
    padding-bottom: (m.typing ? 8px : (m.outgoing && m.readers.length > 0 ? (no-bubble ? 22px : 12px) : 2px)) + (last ? 10px : 0px);
    spacing: 4px;
    opacity: m.pending ? 0.6 : 1.0;
    // plain text: the time sits at the right of the last line instead of below
    property <bool> inline-time: m.text != "" && !m.big-emoji && !m.sticker;
    // a photo alone: no bubble around it, the picture itself is the message
    property <bool> bare: m.has-image && m.text == "" && m.quote == "" && m.attachment == "";
    // photo with text: the photo sits flush on top of the bubble, the text below it
    property <bool> flush: m.has-image && !m.sticker && m.text != "" && m.quote == "";
    property <bool> no-bubble: m.sticker || m.big-emoji || bare;
    // height of the day separator above the message itself (centering a jump on the bubble)
    out property <length> lead: m.day-sep != "" ? root.padding-top + 36px + root.spacing : 0px;

    if m.day-sep != "": HorizontalLayout {
        alignment: center;
        height: 36px;
        padding-top: 6px;
        padding-bottom: 6px;
        Rectangle {
            border-radius: 10px;
            background: Theme.hover;
            HorizontalLayout {
                padding: 4px;
                padding-left: 10px;
                padding-right: 10px;
                Text { text: m.day-sep; color: Theme.subtle; font-size: 11.5px; }
            }
        }
    }

    if m.system: HorizontalLayout {
        alignment: center;
        Text {
            text: m.text;
            color: Theme.subtle;
            font-size: 12px;
            font-italic: true;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    // typing bubble: three dots lighting up in turn
    if m.typing: HorizontalLayout {
        alignment: start;
        spacing: 8px;
        if m.avatar-col: Avatar {
            size: 28px;
            initial: m.initial;
            tint: m.sender-color;
            photo: m.avatar;
            has-photo: m.has-avatar;
        }
        dots := Rectangle {
            border-radius: 14px;
            background: Theme.bubble-in;
            property <int> phase;
            Timer {
                interval: 350ms;
                triggered => { dots.phase = Math.mod(dots.phase + 1, 4); }
            }
            HorizontalLayout {
                padding: 11px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 5px;
                alignment: center;
                for i in 3: Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.subtle;
                    opacity: dots.phase == i ? 1.0 : 0.4;
                }
            }
        }
    }

    if !m.system && !m.typing: HorizontalLayout {
        alignment: m.outgoing ? end : start;
        spacing: 8px;
        if m.avatar-col: Rectangle {
            width: 28px;
            if m.show-avatar: Avatar {
                y: parent.height - self.height;
                size: 28px;
                initial: m.initial;
                tint: m.sender-color;
                photo: m.avatar;
                has-photo: m.has-avatar;
            }
        }
        Rectangle {
            max-width: root.flush ? max(m.img-w, 200px) : root.max-w;
            border-radius: 14px;
            background: m.deleted || m.sticker || m.big-emoji || root.bare ? transparent : (m.outgoing ? Theme.bubble-out : Theme.bubble-in);
            border-width: root.flash ? 3px : m.deleted ? 1px : 0px;
            border-color: root.flash ? #f5b400 : Theme.border;
            if !m.pending && !m.deleted: tools := MsgTools {
                x: m.outgoing ? -self.width : parent.width;
                y: (parent.height - self.height) / 2;
                shown: bta.has-hover;
                reply => { root.reply(m.id); }
                more(x, y) => { root.menu(m.id, x, y + 28px); }
            }
            // TouchArea is the parent of the content (not a sibling below it): it sees hover even over
            // the TextInput, and still takes the clicks the content ignores. It forwards the layout's size.
            bta := TouchArea {
                min-width: content.min-width;
                max-width: content.max-width;
                preferred-width: content.preferred-width;
                min-height: content.min-height;
                max-height: content.max-height;
                preferred-height: content.preferred-height;
                double-clicked => { root.reply(m.id); }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                        root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            content := VerticalLayout {
                spacing: 0px;
                if root.flush: MsgImage {
                    m: m;
                    flush: true;
                    attachment-clicked(id) => { root.attachment-clicked(id); }
                    menu(id, x, y) => { root.menu(id, x, y); }
                }
            VerticalLayout {
                padding: root.bare ? 0px : 9px;
                padding-top: root.bare ? 0px : root.flush ? 7px : 9px;
                padding-left: root.bare ? 0px : 12px;
                padding-right: root.bare ? 0px : 12px;
                spacing: 4px;
                if m.show-sender && !m.outgoing: Text {
                    text: m.sender;
                    color: m.sender-color;
                    font-size: 12px;
                    font-weight: 700;
                }
                if m.quote != "": Rectangle {
                    border-radius: 6px;
                    background: m.outgoing ? #ffffff30 : (Theme.dark ? #ffffff14 : #00000010);
                    HorizontalLayout {
                        Rectangle { width: 3px; background: m.outgoing ? white : Theme.accent; }
                        VerticalLayout {
                            padding: 6px;
                            Text {
                                text: m.quote;
                                color: m.outgoing ? #ffffffd0 : Theme.subtle;
                                font-size: 12px;
                                wrap: word-wrap;
                                overflow: elide;
                                max-height: 48px;
                            }
                        }
                    }
                }
                if m.has-image && !root.flush: MsgImage {
                    m: m;
                    attachment-clicked(id) => { root.attachment-clicked(id); }
                    menu(id, x, y) => { root.menu(id, x, y); }
                }
                if m.attachment != "": Rectangle {
                    border-radius: 6px;
                    background: ata.has-hover ? (m.outgoing ? #ffffff30 : Theme.hover) : transparent;
                    ata := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.attachment-clicked(m.id); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        padding: 2px;
                        Text { text: "📎"; font-size: 14px; }
                        Text {
                            text: m.attachment;
                            color: m.outgoing ? white : Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                // With @mentions or links the visible glyphs come from a StyledText on top (same font
                // and size, only colors and underlines differ, so it lays out like the TextInput) and
                // the TextInput under it is transparent, keeping selection. The StyledText takes only
                // events over a link (patched i-slint-core); the rest falls through to the TextInput,
                // and right clicks, which a read-only TextInput ignores, on to the bubble's TouchArea.
                if m.text != "": HorizontalLayout {
                    spacing: 8px;
                    if m.text != "": Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            TextInput {
                                text: m.text;
                                read-only: true;
                                single-line: false;
                                text-cursor-width: 0px; // selectable, but no blinking caret
                                wrap: word-wrap;
                                color: m.has-rich ? transparent : m.deleted ? Theme.subtle : (m.outgoing && !m.sticker && !m.big-emoji && !m.deleted ? white : Theme.text);
                                font-italic: m.deleted;
                                // emoji-only messages are shown large (color comes from the patched renderer)
                                font-size: m.big-emoji ? 40px : 14px;
                                selection-background-color: m.outgoing ? #ffffff60 : #2c6bed60;
                                selection-foreground-color: m.has-rich ? transparent : m.outgoing ? white : Theme.text;
                            }
                        }
                        if m.has-rich: StyledText {
                            width: parent.width;
                            height: parent.height;
                            text: m.rich;
                            default-color: m.outgoing && !m.sticker ? white : Theme.text;
                            default-font-size: 14px;
                            link-color: m.outgoing ? white : Theme.dark ? #7aa7ff : #1f5fd6;
                            link-clicked(url) => { Links.open(url); }
                        }
                    }
                    if root.inline-time && !m.hide-time: MsgMeta {
                        m: m;
                        info(t) => { root.show-info(t); }
                    }
                }
                if (!m.hide-time && !root.inline-time) || m.reactions.length > 0: HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    if m.reactions.length > 0: HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        for r in m.reactions: HorizontalLayout {
                            spacing: 1px;
                            Text {
                                text: r.emoji;
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            if r.count > 1: Text {
                                text: r.count;
                                font-size: 11px;
                                color: m.outgoing && !m.sticker && !m.big-emoji && !m.deleted ? white : Theme.text;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if !m.hide-time && !root.inline-time: MsgMeta {
                        m: m;
                        info(t) => { root.show-info(t); }
                    }
                }
            }
            }
            }
            // who read it: overlapping round photos straddling the bubble's bottom edge (ringed in the
            // pane color), a "+N" circle for the rest; `Bubble.padding-bottom` makes room for the lower half
            if m.outgoing && m.readers.length > 0: Rectangle {
                x: parent.width - self.width - 8px;
                // no bubble (sticker, bare photo, big emoji): the time sits at the bottom edge, so go fully below it
                y: root.no-bubble ? parent.height + 2px : parent.height - 9px;
                width: 18px + (m.readers.length + (m.readers-more > 0 ? 1 : 0) - 1) * 11px;
                height: 18px;
                for r[i] in m.readers: Rectangle {
                    x: i * 11px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.pane;
                    Avatar {
                        x: 1px;
                        y: 1px;
                        size: 16px;
                        initial: r.initial;
                        tint: r.tint;
                        photo: r.photo;
                        has-photo: r.has-photo;
                    }
                }
                if m.readers-more > 0: Rectangle {
                    x: m.readers.length * 11px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.pane;
                    Rectangle {
                        x: 1px;
                        y: 1px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.hover;
                        Text {
                            text: "+" + m.readers-more;
                            font-size: 9px;
                            color: Theme.text;
                        }
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-info(m.receipt-info); }
                }
            }
        }
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: 10px;
        text: root.text;
        color: root.danger ? #e5484d : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 28px;
    min-width: lbl.preferred-width + 20px;
    max-width: 160px;
    border-radius: 14px;
    background: active ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: Theme.text;
        font-size: 12.5px;
        overflow: elide;
        vertical-alignment: center;
    }
}

component StickerPanel inherits Rectangle {
    in property <[PackItem]> packs;
    in property <[StickerItem]> stickers;
    in property <string> current-pack;
    in-out property <string> url-text;
    callback pick-pack(string);
    callback send-sticker(string, int);
    callback install-pack(string);
    callback add-pack-url(string);

    property <length> cell: 84px;
    property <int> cols: max(1, floor((self.width - 16px) / cell));
    property <bool> suggest: current-pack == "" || current-pack == "+";

    height: 300px;
    background: Theme.sidebar;
    Rectangle { height: 1px; y: 0; background: Theme.border; }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        // pack tabs
        Flickable {
            height: 40px;
            // a Flickable's max size defaults to its content: don't let that shrink the window
            max-width: 100000px;
            content-width: tabs.preferred-width;
            tabs := HorizontalLayout {
                spacing: 4px;
                for p in root.packs: Rectangle {
                    visible: p.installed;
                    width: p.installed ? 40px : 0px;
                    height: 40px;
                    border-radius: 8px;
                    background: p.id == root.current-pack ? Theme.selected : (pta.has-hover ? Theme.hover : transparent);
                    Image { width: 32px; height: 32px; source: p.cover; image-fit: contain; }
                    pta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-pack(p.id); }
                    }
                }
                TextButton {
                    y: 6px;
                    text: "＋ 팩 추가";
                    active: root.suggest;
                    clicked => { root.pick-pack("+"); }
                }
            }
        }
        // sticker grid
        if !root.suggest: Flickable {
            vertical-stretch: 1;
            max-width: 100000px;
            content-height: ceil(root.stickers.length / root.cols) * root.cell;
            for s[i] in root.stickers: Rectangle {
                x: mod(i, root.cols) * root.cell;
                y: floor(i / root.cols) * root.cell;
                width: root.cell;
                height: root.cell;
                border-radius: 8px;
                background: sta.has-hover ? Theme.hover : transparent;
                Image { width: root.cell - 12px; height: root.cell - 12px; source: s.img; image-fit: contain; }
                sta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.send-sticker(root.current-pack, s.id); }
                }
            }
        }
        // add packs: Signal's built-in packs + signal.art link
        if root.suggest: Flickable {
            vertical-stretch: 1;
            max-width: 100000px;
            content-height: sug.preferred-height;
            sug := VerticalLayout {
                spacing: 4px;
                Text { text: "추천 스티커 팩"; color: Theme.subtle; font-size: 12px; }
                for p in root.packs: HorizontalLayout {
                    visible: !p.installed;
                    height: p.installed ? 0px : 34px;
                    spacing: 8px;
                    Text {
                        text: p.title;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Button {
                        text: "추가";
                        clicked => { root.install-pack(p.id); }
                    }
                }
                Rectangle { height: 8px; }
                Text { text: "signal.art 스티커 링크로 추가"; color: Theme.subtle; font-size: 12px; }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: "https://signal.art/addstickers/#pack_id=…&pack_key=…";
                        text <=> root.url-text;
                        accepted(t) => { root.add-pack-url(t); }
                    }
                    Button {
                        text: "추가";
                        clicked => { root.add-pack-url(root.url-text); }
                    }
                }
            }
        }
    }
}

// a row of mutually exclusive choices
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    callback changed(int);
    height: 30px;
    border-radius: 8px;
    background: Theme.hover;
    opacity: enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            min-width: seg-label.preferred-width + 20px;
            border-radius: 6px;
            background: i == root.current ? Theme.pane : (sta.has-hover && root.enabled ? Theme.selected : transparent);
            drop-shadow-blur: i == root.current ? 2px : 0px;
            drop-shadow-color: #00000030;
            sta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    if (root.current != i) {
                        root.current = i;
                        root.changed(i);
                    }
                }
            }
            seg-label := Text {
                text: o;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: i == root.current ? 600 : 400;
            }
        }
    }
}

component SettingSection inherits VerticalLayout {
    in property <string> title;
    spacing: 2px;
    padding-top: 18px;
    Text {
        text: root.title;
        color: Theme.accent;
        font-size: 12.5px;
        font-weight: 700;
    }
    Rectangle { height: 4px; }
    @children
}

// label (+ optional hint) on the left, a control on the right
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.label; color: Theme.text; font-size: 13.5px; wrap: word-wrap; }
        if root.hint != "": Text { text: root.hint; color: Theme.subtle; font-size: 11.5px; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

component SettingsPage inherits Rectangle {
    in-out property <bool> notify;
    in-out property <int> preview;
    in-out property <bool> badge;
    in-out property <int> theme;
    in-out property <int> zoom;
    in-out property <bool> enter-sends;
    in property <string> account-name;
    in property <string> account-number;
    in property <string> account-device;
    in property <string> account-phone;
    in property <string> storage;
    in property <string> version;
    callback changed();
    callback close();
    callback clear-thumbs();
    callback unlink();
    background: Theme.pane;
    // swallow clicks so nothing underneath reacts
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 12px;
                Text {
                    text: "설정";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    label: "✕";
                    clicked => { root.close(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        Flickable {
            vertical-stretch: 1;
            max-width: 100000px;
            content-height: body.preferred-height;
            HorizontalLayout {
                width: parent.width;
                alignment: center;
                body := VerticalLayout {
                    width: min(560px, root.width - 48px);
                    padding-bottom: 24px;
                    SettingSection {
                        title: "알림";
                        SettingRow {
                            label: "새 메시지 알림";
                            hint: "열려 있는 대화를 보고 있을 때는 알리지 않습니다";
                            Switch {
                                checked <=> root.notify;
                                toggled => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "알림에 표시할 내용";
                            Segmented {
                                enabled: root.notify;
                                options: ["이름과 내용", "이름만", "숨김"];
                                current <=> root.preview;
                                changed => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "작업 표시줄 배지";
                            hint: "작업 표시줄 아이콘에 안 읽은 메시지 수를 표시합니다";
                            Switch {
                                checked <=> root.badge;
                                toggled => { root.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "화면";
                        SettingRow {
                            label: "테마";
                            Segmented {
                                options: ["시스템", "밝게", "어둡게"];
                                current <=> root.theme;
                                changed => { root.changed(); }
                            }
                        }
                        SettingRow {
                            label: "크기";
                            hint: "Windows 배율에 곱해서 적용합니다";
                            Segmented {
                                options: ["90%", "100%", "110%", "125%", "150%"];
                                current <=> root.zoom;
                                changed => { root.changed(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "입력";
                        SettingRow {
                            label: "메시지 보내기";
                            hint: root.enter-sends ? "Shift+Enter로 줄을 바꿉니다" : "Enter로 줄을 바꿉니다";
                            Segmented {
                                options: ["Enter", "Ctrl+Enter"];
                                current: root.enter-sends ? 0 : 1;
                                changed(i) => {
                                    root.enter-sends = i == 0;
                                    root.changed();
                                }
                            }
                        }
                    }
                    SettingSection {
                        title: "계정";
                        SettingRow {
                            label: root.account-name != "" ? root.account-name : "내 계정";
                            hint: root.account-number + (root.account-device != "" ? "  ·  이 기기: " + root.account-device : "");
                        }
                        SettingRow {
                            label: "읽음 확인 · 입력 중 표시";
                            hint: root.account-phone;
                        }
                        SettingRow {
                            label: "연결 해제";
                            hint: "이 PC의 연결을 끊고 메시지와 파일을 모두 지웁니다";
                            Button {
                                text: "연결 해제";
                                clicked => { root.unlink(); }
                            }
                        }
                    }
                    SettingSection {
                        title: "저장 공간";
                        SettingRow {
                            label: "사용 중";
                            hint: root.storage;
                        }
                        SettingRow {
                            label: "썸네일 캐시 비우기";
                            hint: "이미지 미리보기와 프로필 사진 캐시를 지웁니다. 필요할 때 다시 만듭니다.";
                            Button {
                                text: "비우기";
                                clicked => { root.clear-thumbs(); }
                            }
                        }
                    }
                    Rectangle { height: 20px; }
                    Text {
                        text: root.version;
                        color: Theme.subtle;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

component LinkPage inherits Rectangle {
    in property <image> qr;
    in property <bool> has-qr;
    in property <string> status;
    in-out property <string> device-name: "Sigwin";
    callback start-link(string);
    background: Theme.pane;
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;
        Text {
            text: "Sigwin";
            font-size: 28px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: "휴대폰의 Signal 앱 → 설정 → 연결된 기기 → '+' 를 눌러 아래 QR 코드를 스캔하세요.";
            color: Theme.subtle;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 280px;
                height: 280px;
                background: white;
                border-radius: 12px;
                if has-qr: Image {
                    width: 256px;
                    height: 256px;
                    source: qr;
                    image-rendering: pixelated;
                }
                if !has-qr: Text {
                    text: "QR 코드 대기 중";
                    color: #888;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Text { text: "기기 이름"; color: Theme.text; vertical-alignment: center; }
            LineEdit {
                width: 200px;
                text <=> root.device-name;
            }
            Button {
                text: has-qr ? "QR 다시 만들기" : "연결 시작";
                clicked => { root.start-link(root.device-name); }
            }
        }
        Text {
            text: status;
            color: Theme.subtle;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component AppWindow inherits Window {
    in property <int> total-unread;
    title: total-unread > 0 ? "Sigwin (" + total-unread + ")" : "Sigwin";
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 420px;
    // Flipping this repaints the whole window: the software renderer only redraws damaged
    // regions and loses track of them when the window was updated while minimized.
    in property <bool> repaint-flip;
    background: repaint-flip ? Theme.pane-twin : Theme.pane;
    default-font-family: "Malgun Gothic";
    icon: @image-url("../assets/icon.png");

    // "loading" | "link" | "main"
    in property <string> page: "loading";
    in property <string> loading-text: "불러오는 중…";

    in property <image> qr;
    in property <bool> has-qr: false;
    in property <string> link-status;

    in property <[ThreadItem]> threads;
    in-out property <string> current-key;
    in property <string> current-name;
    in property <string> current-initial;
    in property <color> current-tint;
    in property <image> current-photo;
    in property <bool> current-has-photo;
    in property <string> current-sub;
    in property <[MsgItem]> messages;
    in property <bool> can-load-older;
    // incoming messages that arrived while scrolled up
    in-out property <int> new-below;
    callback jump-to-bottom();
    in property <string> status-text;
    in property <string> reply-preview;
    in property <[string]> pending-files;
    in-out property <string> search;
    in-out property <string> draft;

    callback start-link(string);
    callback open-thread(string);
    callback send(string);
    callback load-older();
    callback attach();
    callback clear-attachments();
    callback attachment-clicked(string);
    callback reply(string);
    callback cancel-reply();
    callback search-changed(string);
    callback unlink();

    // settings page (over the conversation pane)
    in-out property <bool> settings-open;
    in-out property <bool> set-notify: true;
    in-out property <int> set-preview;
    in-out property <bool> set-badge: true;
    in-out property <int> set-theme;
    // index into the zoom steps (see settings::ZOOMS)
    in-out property <int> set-zoom: 1;
    in-out property <bool> enter-sends: true;
    in property <string> account-name;
    in property <string> account-number;
    in property <string> account-device;
    in property <string> account-phone;
    in property <string> storage-text;
    in property <string> version;
    callback open-settings();
    callback settings-changed();
    callback clear-thumbs();

    // the message being edited (banner above the composer)
    in property <string> edit-preview;
    callback cancel-edit();
    // composer edited: true while it has text
    callback composing(bool);
    // Ctrl+V: true if the clipboard held files or an image (attached), false to paste text
    callback paste-files() -> bool;

    // @mention popup above the composer; empty when closed
    in-out property <[MentionItem]> mention-items;
    in-out property <int> mention-sel;
    // composer text, cursor (byte offset), IME preedit
    callback mention-check(string, int, string);
    // picked row, composer text, cursor
    callback mention-pick(int, string, int);
    // style shortcut (view::STYLE_*), composer text, selection anchor and cursor (bytes)
    callback format-toggle(int, string, int, int);

    // pinned messages of the open thread (newest first); the bar shows pins[pin-index]
    in property <[PinItem]> pins;
    in-out property <int> pin-index;
    // the bar was clicked: scroll to that message
    callback pin-clicked(string);
    callback unpin(string);
    // jump to a row: whenever jump-probe changes, the row with this id (if instantiated) reports
    // where it is on screen (0 = top of the list). Its y and content-y are read together because
    // the ListView renormalizes both on every layout.
    in-out property <string> jump-id;
    in-out property <bool> jump-found;
    in-out property <length> jump-pos;
    in-out property <length> jump-h;
    in-out property <int> jump-probe;
    // flash the jumped-to row
    in-out property <string> flash-id;
    // message menu (right click); menu-id is "" when closed
    in-out property <string> menu-id;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <string> menu-mine;
    in property <bool> menu-can-edit;
    in property <bool> menu-can-delete;
    in property <bool> menu-pinned;
    // the menu shows the pin durations instead of the actions
    in-out property <bool> menu-pin-step;
    callback open-menu(string, length, length);
    // seconds, 0 = until unpinned
    callback pin-message(string, int);
    callback react(string, string);
    callback edit-message(string);
    callback delete-message(string);

    in-out property <bool> sticker-open;
    in property <[PackItem]> packs;
    in property <[StickerItem]> stickers;
    in property <string> current-pack;
    in-out property <string> pack-url;
    callback toggle-stickers();
    in-out property <string> info-text;
    callback pick-pack(string);
    callback send-sticker(string, int);
    callback install-pack(string);
    callback add-pack-url(string);

    // headless test mode: no platform color scheme, set it explicitly
    public function set-dark(d: bool) {
        Palette.color-scheme = d ? ColorScheme.dark : ColorScheme.light;
    }
    public function scroll-to-bottom() {
        msg-list.content-y = min(0px, msg-list.visible-height - msg-list.content-height);
    }
    public function focus-composer() {
        composer.focus();
    }
    public function blur-composer() {
        composer.clear-focus();
    }
    public function composer-to-end() {
        composer.set-selection-offsets(10000000, 10000000);
    }
    public function composer-select(start: int, end: int) {
        composer.set-selection-offsets(start, end);
    }
    public function composer-cursor(offset: int) {
        composer.set-selection-offsets(offset, offset);
    }
    public function content-height() -> length {
        return msg-list.content-height;
    }
    public function set-content-y(y: length) {
        msg-list.content-y = max(msg-list.visible-height - msg-list.content-height, min(0px, y));
    }
    public function list-visible-height() -> length {
        return msg-list.visible-height;
    }
    // prefetch within two screens of the top: rows inserted above the ones on screen keep the
    // view still, so a wheel scroll in progress never hits the top and waits
    public function check-older() {
        if (msg-list.content-y >= -2 * msg-list.visible-height && root.can-load-older) {
            root.load-older();
        }
    }
    public function list-content-y() -> length {
        return msg-list.content-y;
    }
    // no clamping: the content height is still the old estimate right after a model change
    public function set-content-y-raw(y: length) {
        msg-list.content-y = y;
    }
    public function shift-by(d: length) {
        msg-list.content-y = max(msg-list.visible-height - msg-list.content-height, min(0px, msg-list.content-y - d));
    }
    out property <bool> near-bottom: msg-list.content-y <= msg-list.visible-height - msg-list.content-height + 120px;
    changed near-bottom => {
        if (near-bottom) { new-below = 0; }
    }

    if page == "loading": Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                Spinner { indeterminate: true; width: 36px; height: 36px; }
            }
            Text { text: loading-text; color: Theme.subtle; horizontal-alignment: center; }
        }
    }

    if page == "link": LinkPage {
        qr: root.qr;
        has-qr: root.has-qr;
        status: root.link-status;
        start-link(name) => { root.start-link(name); }
    }

    main := HorizontalLayout {
        visible: page == "main";
        // sidebar
        Rectangle {
            width: 300px;
            background: Theme.sidebar;
            VerticalLayout {
                HorizontalLayout {
                    padding: 10px;
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: "검색";
                        text <=> root.search;
                        edited(t) => { root.search-changed(t); }
                    }
                    IconButton {
                        label: "⚙";
                        clicked => {
                            if (root.settings-open) {
                                root.settings-open = false;
                            } else {
                                root.open-settings();
                            }
                        }
                    }
                }
                ListView {
                    for t in root.threads: ThreadRow {
                        item: t;
                        selected: t.key == root.current-key;
                        clicked => {
                            root.settings-open = false;
                            root.open-thread(t.key);
                        }
                    }
                }
                Rectangle {
                    height: 24px;
                    Text {
                        x: 12px;
                        text: root.status-text;
                        color: Theme.subtle;
                        font-size: 11px;
                        overflow: elide;
                        width: parent.width - 24px;
                    }
                }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        }
        // conversation pane
        VerticalLayout {
            if root.current-key == "": Rectangle {
                vertical-stretch: 1;
                Text {
                    text: "대화를 선택하세요";
                    color: Theme.subtle;
                    font-size: 15px;
                }
            }
            if root.current-key != "": Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    Avatar {
                        y: (parent.height - self.height) / 2;
                        initial: root.current-initial;
                        tint: root.current-tint;
                        photo: root.current-photo;
                        has-photo: root.current-has-photo;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: root.current-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                        if root.current-sub != "": Text { text: root.current-sub; color: Theme.subtle; font-size: 11.5px; overflow: elide; }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            if root.current-key != "" && root.pins.length > 0: Rectangle {
                property <int> idx: Math.min(root.pin-index, root.pins.length - 1);
                height: 48px;
                background: pin-ta.has-hover ? Theme.hover : Theme.pane;
                pin-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pin-clicked(root.pins[idx].id);
                        // like the official apps: each click moves on to the next (older) pin
                        root.pin-index = Math.mod(idx + 1, root.pins.length);
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 10px;
                    // one segment per pin, the shown one highlighted
                    VerticalLayout {
                        width: 3px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        for p[i] in root.pins: Rectangle {
                            border-radius: 1.5px;
                            background: i == idx ? Theme.accent : Theme.border;
                        }
                    }
                    Text { text: "📌"; font-size: 15px; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.pins.length > 1 ? "고정된 메시지 " + (idx + 1) + "/" + root.pins.length : "고정된 메시지";
                            color: Theme.accent;
                            font-size: 11.5px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.pins[idx].sender + ": " + root.pins[idx].text;
                            color: Theme.text;
                            font-size: 12.5px;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        TextButton {
                            width: self.min-width;
                            text: "고정 해제";
                            clicked => { root.unpin(root.pins[idx].id); }
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            Rectangle {
                visible: root.current-key != "";
                vertical-stretch: 1;
                msg-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    // the composer growing (or a resize) shrinks the list: if it was at the
                    // bottom before, keep it there so the last message isn't hidden
                    property <length> last-vh;
                    changed visible-height => {
                        if (self.last-vh > 0 && self.content-height + self.content-y - self.last-vh <= 120px) {
                            root.scroll-to-bottom();
                        }
                        self.last-vh = self.visible-height;
                    }
                    // load older history at the top. `scrolled` fires when a wheel notch starts
                    // its 180ms animation, before content-y gets there, so content-y itself is
                    // watched too, once the user has scrolled this thread
                    property <bool> user-scrolled;
                    property <string> key: root.current-key;
                    changed key => { self.user-scrolled = false; }
                    scrolled => {
                        self.user-scrolled = true;
                        root.check-older();
                    }
                    changed content-y => {
                        if (self.user-scrolled) {
                            root.check-older();
                        }
                    }
                    for m[idx] in root.messages: Bubble {
                        m: m;
                        last: idx == root.messages.length - 1;
                        max-w: min(560px, msg-list.visible-width * 0.75);
                        flash: m.id == root.flash-id;
                        property <int> probe: root.jump-probe;
                        changed probe => {
                            if (m.id == root.jump-id) {
                                root.jump-pos = self.y + self.lead + msg-list.content-y;
                                root.jump-h = self.height - self.lead;
                                root.jump-found = true;
                            }
                        }
                        attachment-clicked(id) => { root.attachment-clicked(id); }
                        reply(id) => { root.reply(id); }
                        show-info(t) => { root.info-text = t; }
                        menu(id, x, y) => { root.open-menu(id, x, y); }
                    }
                }
                // jump to the latest message
                if !root.near-bottom: Rectangle {
                    x: parent.width - self.width - 20px;
                    y: parent.height - self.height - 14px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: jump-ta.has-hover ? Theme.hover : Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: #00000040;
                    jump-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.jump-to-bottom(); }
                    }
                    Text {
                        text: "↓";
                        font-family: "Segoe UI Symbol";
                        font-size: 18px;
                        color: Theme.text;
                    }
                    if root.new-below > 0: Rectangle {
                        x: parent.width - self.width + 4px;
                        y: -6px;
                        height: 18px;
                        width: max(18px, badge.preferred-width + 10px);
                        border-radius: 9px;
                        background: Theme.accent;
                        badge := Text {
                            text: root.new-below > 99 ? "99+" : root.new-below;
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }
                }
            }
            if root.current-key != "" && root.sticker-open: StickerPanel {
                packs: root.packs;
                stickers: root.stickers;
                current-pack: root.current-pack;
                url-text <=> root.pack-url;
                pick-pack(id) => { root.pick-pack(id); }
                send-sticker(p, i) => { root.send-sticker(p, i); }
                install-pack(id) => { root.install-pack(id); }
                add-pack-url(u) => { root.add-pack-url(u); }
            }
            if root.current-key != "" && root.edit-preview != "": Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 16px;
                    spacing: 8px;
                    Rectangle { width: 3px; background: Theme.accent; }
                    Text {
                        text: "수정 중: " + root.edit-preview;
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton { label: "✕"; width: 28px; height: 28px; clicked => { root.cancel-edit(); } }
                }
            }
            if root.current-key != "" && root.reply-preview != "": Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 16px;
                    spacing: 8px;
                    Rectangle { width: 3px; background: Theme.accent; }
                    Text {
                        text: "답장: " + root.reply-preview;
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton { label: "✕"; width: 28px; height: 28px; clicked => { root.cancel-reply(); } }
                }
            }
            if root.current-key != "" && root.pending-files.length > 0: Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 16px;
                    spacing: 8px;
                    Text {
                        text: "📎 " + root.pending-files.length + "개 첨부: " + root.pending-files[0] + (root.pending-files.length > 1 ? " 외" : "");
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton { label: "✕"; width: 28px; height: 28px; clicked => { root.clear-attachments(); } }
                }
            }
            composer-bar := Rectangle {
                visible: root.current-key != "";
                min-height: self.visible ? 48px : 0px;
                max-height: self.visible ? 400px : 0px;
                Rectangle { height: 1px; y: 0; background: Theme.border; }
                HorizontalLayout {
                    padding: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    IconButton {
                        label: "📎";
                        clicked => { root.attach(); }
                    }
                    IconButton {
                        label: "☺";
                        clicked => { root.toggle-stickers(); }
                    }
                    Rectangle {
                        border-radius: 18px;
                        background: Theme.sidebar;
                        border-width: 1px;
                        border-color: composer.has-focus ? Theme.accent : Theme.border;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            FocusScope {
                                // FocusScope and Rectangle don't take their child's size: grow with wrapped lines
                                min-height: min(composer.preferred-height, 140px);
                                capture-key-pressed(event) => {
                                    if (root.mention-items.length > 0) {
                                        if (event.text == Key.UpArrow) {
                                            root.mention-sel = Math.max(0, root.mention-sel - 1);
                                            return accept;
                                        }
                                        if (event.text == Key.DownArrow) {
                                            root.mention-sel = Math.min(root.mention-items.length - 1, root.mention-sel + 1);
                                            return accept;
                                        }
                                        if ((event.text == Key.Return && !event.modifiers.shift) || event.text == Key.Tab) {
                                            root.mention-pick(root.mention-sel, composer.text, composer.cursor-position-byte-offset);
                                            return accept;
                                        }
                                        if (event.text == Key.Escape) {
                                            root.mention-items = [];
                                            return accept;
                                        }
                                    }
                                    if (event.text == Key.Return && !event.modifiers.shift && root.enter-sends != event.modifiers.control) {
                                        root.send(composer.text);
                                        return accept;
                                    }
                                    if (event.text == Key.Escape && root.edit-preview != "") {
                                        root.cancel-edit();
                                        return accept;
                                    }
                                    if (event.text == Key.Escape && root.reply-preview != "") {
                                        root.cancel-reply();
                                        return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                                        if (root.paste-files()) {
                                            return accept;
                                        }
                                    }
                                    // text styles (Signal Desktop's shortcuts): wrap the selection in markers
                                    if (event.modifiers.control && !event.modifiers.alt) {
                                        let k = event.text;
                                        let style = !event.modifiers.shift
                                            ? (k == "b" || k == "B" ? 1 : k == "i" || k == "I" ? 2 : k == "e" || k == "E" ? 5 : 0)
                                            : (k == "x" || k == "X" ? 4 : k == "b" || k == "B" ? 3 : 0);
                                        if (style != 0) {
                                            root.format-toggle(style, composer.text, composer.anchor-position-byte-offset, composer.cursor-position-byte-offset);
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                                Rectangle {
                                    composer := TextInput {
                                        text <=> root.draft;
                                        edited => {
                                            root.composing(self.text != "");
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        cursor-position-changed => {
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        // IME composition (Hangul) changes neither text nor cursor: follow it too
                                        changed preedit-text => {
                                            root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                        }
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                        font-size: 14px;
                                        max-height: 140px;
                                    }
                                    // hide as soon as IME composition starts (preedit isn't in text yet)
                                    if root.draft == "" && composer.preedit-text == "": Text {
                                        x: 0;
                                        y: 0;
                                        text: root.edit-preview != "" ? "수정할 내용 입력 (Esc 취소)" : root.enter-sends ? "메시지 입력 (Enter 전송, Shift+Enter 줄바꿈)" : "메시지 입력 (Ctrl+Enter 전송)";
                                        color: Theme.subtle;
                                        font-size: 14px;
                                    }
                                }
                            }
                        }
                    }
                    IconButton {
                        label: "➤";
                        enabled: root.draft != "" || root.pending-files.length > 0;
                        clicked => { root.send(composer.text); }
                    }
                }
            }
        }
    }

    if page == "main" && root.settings-open: SettingsPage {
        x: 300px;
        width: root.width - 300px;
        height: root.height;
        notify <=> root.set-notify;
        preview <=> root.set-preview;
        badge <=> root.set-badge;
        theme <=> root.set-theme;
        zoom <=> root.set-zoom;
        enter-sends <=> root.enter-sends;
        account-name: root.account-name;
        account-number: root.account-number;
        account-device: root.account-device;
        account-phone: root.account-phone;
        storage: root.storage-text;
        version: root.version;
        changed => { root.settings-changed(); }
        close => { root.settings-open = false; }
        clear-thumbs => { root.clear-thumbs(); }
        unlink => { root.unlink(); }
    }

    // @mention popup, just above the composer
    if root.mention-items.length > 0: Rectangle {
        x: composer.absolute-position.x - 8px;
        y: composer-bar.absolute-position.y - self.height - 4px;
        width: 240px;
        height: mention-col.preferred-height;
        border-radius: 10px;
        background: Theme.pane;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        mention-col := VerticalLayout {
            padding: 4px;
            for item[i] in root.mention-items: Rectangle {
                height: 36px;
                border-radius: 6px;
                background: i == root.mention-sel ? Theme.selected : mta.has-hover ? Theme.hover : transparent;
                mta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mention-pick(i, composer.text, composer.cursor-position-byte-offset); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;
                    Avatar {
                        size: 24px;
                        y: 6px;
                        initial: item.initial;
                        tint: item.tint;
                    }
                    Text {
                        text: item.name;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // message menu: reactions + actions, opened by right-clicking a message
    if root.menu-id != "": Rectangle {
        TouchArea {
            clicked => { root.menu-id = ""; }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.menu-id = "";
                }
            }
        }
        card := Rectangle {
            property <length> w: 6 * 36px + 12px;
            width: w;
            height: menu-col.preferred-height;
            x: max(8px, min(root.menu-x, root.width - w - 8px));
            y: max(8px, min(root.menu-y, root.height - self.height - 8px));
            border-radius: 10px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;
            TouchArea { }
            menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                HorizontalLayout {
                    for e in ["❤️", "👍", "👎", "😂", "😮", "😢"]: Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: e == root.menu-mine ? Theme.selected : (eta.has-hover ? Theme.hover : transparent);
                        Text { text: e; font-size: 20px; }
                        eta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.react(root.menu-id, e);
                                root.menu-id = "";
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.menu-pin-step: HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        height: 28px;
                        text: "고정할 기간";
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                for d in root.menu-pin-step ? [
                    { label: "24시간", secs: 86400 },
                    { label: "7일", secs: 604800 },
                    { label: "30일", secs: 2592000 },
                    { label: "해제할 때까지", secs: 0 },
                ] : []: MenuRow {
                    text: d.label;
                    clicked => {
                        root.pin-message(root.menu-id, d.secs);
                        root.menu-id = "";
                    }
                }
                if !root.menu-pin-step: MenuRow {
                    text: "답장";
                    clicked => {
                        root.reply(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if !root.menu-pin-step: MenuRow {
                    text: root.menu-pinned ? "고정 해제" : "고정";
                    clicked => {
                        if (root.menu-pinned) {
                            root.unpin(root.menu-id);
                            root.menu-id = "";
                        } else {
                            root.menu-pin-step = true;
                        }
                    }
                }
                if root.menu-can-edit && !root.menu-pin-step: MenuRow {
                    text: "수정";
                    clicked => {
                        root.edit-message(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if root.menu-can-delete && !root.menu-pin-step: MenuRow {
                    text: "모두에게서 삭제";
                    danger: true;
                    clicked => {
                        root.delete-message(root.menu-id);
                        root.menu-id = "";
                    }
                }
            }
        }
    }

    // message info (who received / read an outgoing message)
    if root.info-text != "": Rectangle {
        background: #00000080;
        TouchArea {
            clicked => { root.info-text = ""; }
        }
        Rectangle {
            width: min(380px, parent.width - 40px);
            height: info-col.preferred-height;
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            info-col := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "메시지 정보"; font-weight: 700; font-size: 15px; color: Theme.text; }
                Text { text: root.info-text; wrap: word-wrap; color: Theme.text; font-size: 13px; }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "닫기";
                        clicked => { root.info-text = ""; }
                    }
                }
            }
        }
    }
}
