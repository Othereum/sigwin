// Structs and globals the Rust side uses.
export { ThreadItem, ImageCell, ReactionItem, ReaderItem, MsgItem, PinItem, ReplyItem, MentionItem, PackItem, PreviewItem, StickerItem, ViewOnce } from "types.slint";
export { Anim, Links, Theme } from "theme.slint";
export { ImageViewer } from "viewer.slint";
export { SettingsData } from "settings.slint";
export { PackCell, PackData } from "packmaker.slint";
export { ThreadMenuData } from "thread_menu.slint";
export { FindKind, ResultItem, ResultKind, SearchData } from "search.slint";
export { RepliesData } from "replies.slint";
export { RequestData } from "request.slint";
export { StickerData } from "stickers.slint";
export { GalleryCell, GalleryData, GalleryRow } from "gallery.slint";
export { CalendarCell, CalendarData } from "calendar.slint";
export { ConfirmData } from "confirm.slint";

// Our photo at the sidebar's top, the way into the settings: a gear over it on hover, a ring while open.
component MeButton inherits Rectangle {
    in property <image> photo;
    in property <bool> has-photo;
    in property <bool> open;
    callback clicked;
    width: 32px;
    Avatar {
        y: (parent.height - self.height) / 2;
        size: 32px;
        initial: SettingsData.account-initial;
        tint: SettingsData.account-tint;
        photo: root.photo;
        has-photo: root.has-photo;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: ta.has-hover ? #000000a0 : transparent;
        border-width: 2px;
        border-color: root.open && !ta.has-hover ? Theme.subtle : transparent;
        Icon {
            visible: ta.has-hover;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: Icons.settings;
            tint: white;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One shape of `AppMark`, in the icon's 256-unit box. A shape per Path: subpaths of one Path
// that overlap in opposite directions cancel out under the nonzero rule and leave a hole.
component MarkShape inherits Path {
    in property <color> color;
    // in icon units: a Path's stroke width doesn't scale with its viewbox
    in property <float> line;
    in property <length> unit;
    width: 100%;
    height: 100%;
    viewbox-width: 256;
    viewbox-height: 256;
    fill: root.color;
    stroke: root.line > 0 ? root.color : transparent;
    stroke-width: root.line * root.unit;
    stroke-line-join: round;
}

// The app's icon drawn as paths, after assets/icon.svg (change both together): an image would
// be sampled nearest-neighbor, and the renderer has no SVG. The SVG's mask, the gap around the
// front bubble, is painted in the pane's color, so this belongs on the plain pane.
component AppMark inherits Rectangle {
    in property <length> size: 72px;
    property <length> u: root.size / 256;
    width: root.size;
    height: root.size;
    MarkShape { commands: "M 76 100 A 80 80 0 1 1 236 100 A 80 80 0 1 1 76 100 Z"; color: #a9c3f8; unit: root.u; }
    MarkShape { commands: "M 220 134 L 244 184 L 186 168 Z"; color: #a9c3f8; line: 10; unit: root.u; }
    MarkShape { commands: "M 10 152 A 94 94 0 1 1 198 152 A 94 94 0 1 1 10 152 Z"; color: Theme.pane; unit: root.u; }
    MarkShape { commands: "M 40 196 L 22 244 L 96 222 Z"; color: Theme.pane; line: 28; unit: root.u; }
    MarkShape { commands: "M 24 152 A 80 80 0 1 1 184 152 A 80 80 0 1 1 24 152 Z"; color: #2c6bed; unit: root.u; }
    MarkShape { commands: "M 52 200 L 30 240 L 92 222 Z"; color: #2c6bed; line: 10; unit: root.u; }
}

// A bar docked at the sidebar's foot: flat on it, a rule above, its icon and then the children.
// Folded, the icon alone, and what the bar says in a tip beside it while the pointer is on it.
component FootBar inherits Rectangle {
    in property <bool> folded;
    in property <string> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    // the TouchArea holds the rest, so this stays on over the buttons in it
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        Rectangle { background: ta.has-hover && root.enabled ? Theme.notice-hover : Theme.notice; }
        Rectangle { y: 0px; height: 1px; background: Theme.border; }
        if root.folded: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: 20px;
            icon: root.icon;
            tint: Theme.accent;
        }
        HorizontalLayout {
            visible: !root.folded;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 10px;
            Icon {
                y: (parent.height - self.height) / 2;
                size: 18px;
                icon: root.icon;
                tint: Theme.accent;
            }
            @children
        }
    }
    // beside the rail, over the pane; it waits as briefly as the rail's row preview: only for a
    // pointer passing by
    Tip {
        hovered: root.folded && ta.has-hover;
        place: TipPlace.right-center;
        gap: 6px;
        delay: 100ms;
        text: root.tip;
    }
}

export component AppWindow inherits Window {
    in property <int> total-unread;
    // dev builds (no SIGWIN_RELEASE): commit hash, else "dev"; empty for releases
    in property <string> dev-tag;
    title: (dev-tag != "" ? "Sigwin [" + dev-tag + "]" : "Sigwin") + (total-unread > 0 ? " (" + total-unread + ")" : "");
    preferred-width: 1000px;
    preferred-height: 680px;
    // an open sidebar keeps its narrowest width: unfolding it in a narrow window widens the window
    min-width: (root.side-folded ? root.rail-w : root.side-min) + root.pane-min;
    min-height: 420px;

    // the sidebar: its open width (dragged on its edge) and whether it's folded to the rail of
    // photos; `side-changed` saves both (gui::window)
    in-out property <length> side-width: 300px;
    in-out property <bool> side-folded;
    callback side-changed();
    property <length> rail-w: 76px;
    property <length> side-min: 280px;
    property <length> side-max: 480px;
    property <length> pane-min: 340px;
    // the open width the window leaves room for: it gives way before the pane does
    property <length> side-open-w: max(root.side-min, min(root.side-width, root.side-max, root.width - root.pane-min));
    // the search box needs the open width: a folded sidebar opens over the pane while it has the
    // focus (`side-hold` until it gets it), and goes back once it's left
    property <bool> side-hold;
    property <bool> side-wide: !root.side-folded || root.side-hold || sidebar.typing;
    // where the pane starts: a folded sidebar opened for the search lies over it
    property <length> pane-x: root.side-folded ? root.rail-w : root.side-open-w;
    // dragging the edge to `x`: short of halfway to the narrowest open width it folds, keeping the
    // width the drag started from (passing by on the way doesn't set it) for unfolding
    property <length> drag-from;
    function drag-edge(x: length) {
        if (x < (root.rail-w + root.side-min) / 2) {
            root.side-folded = true;
            root.side-width = root.drag-from;
        } else {
            root.side-folded = false;
            root.side-width = max(root.side-min, min(root.side-max, x));
        }
    }
    // folded: the row under the pointer shows whole over the pane, after a moment the first time
    // and at once while the pointer goes along the rail; the pointer on it keeps it
    property <string> hover-key;
    property <ThreadItem> hover-item;
    property <length> hover-y;
    property <bool> peek-on;
    property <ThreadItem> peek-item;
    property <length> peek-y;
    function rail-hover(t: ThreadItem, y: length) {
        // a row the list's edge hides more than half of is passed over: its preview would stand
        // mostly where the row isn't
        let top = thread-list.absolute-position.y;
        let shown = min(y + 64px, top + thread-list.height) - max(y, top);
        if (shown < 32px) {
            root.hover-key = "";
            root.peek-on = false;
            return;
        }
        root.hover-key = t.key;
        root.hover-item = t;
        root.hover-y = y;
        if (root.peek-on) {
            root.peek-item = t;
            root.peek-y = y;
        }
    }
    changed side-wide => { root.peek-on = false; root.hover-key = ""; }
    // Flipping this repaints the whole window: the software renderer only redraws damaged
    // regions and loses track of them when the window was updated while minimized.
    in property <bool> repaint-flip;
    background: repaint-flip ? Theme.pane-twin : Theme.pane;
    default-font-family: "Malgun Gothic";
    icon: @image-url("../assets/icon.png");

    // "loading" | "link" | "main"
    in property <string> page: "loading";
    in property <string> loading-text: @tr("Loading…");

    in property <image> qr;
    in property <bool> has-qr: false;
    in property <string> link-status;

    in property <[ThreadItem]> threads;
    in-out property <string> current-key;
    in property <string> current-name;
    in property <string> current-initial;
    in property <color> current-tint;
    in property <image> current-photo;
    // the same, pre-cut for the search box's "searching in" token
    in property <image> current-photo-small;
    in property <bool> current-has-photo;
    in property <string> current-sub;
    // the open thread is a message request: the request bar instead of the composer
    in property <bool> current-request;
    // the request bar's buttons: 0 accept, 1 delete, 2 block
    callback answer-request(int);
    in property <[MsgItem]> messages;
    in property <bool> can-load-older;
    in property <bool> can-load-newer;
    // unread messages of the open thread (the jump button's badge)
    in property <int> open-unread;
    callback jump-to-bottom();
    // row id: the row's bottom edge is on screen, so everything above it has been seen
    callback row-seen(string);
    // the rows on screen run from `view-top-id` to `view-bottom-id` ("": the list's first or
    // last); only theirs keep their pictures (gui::media::view_moved)
    callback view-moved(string, string);
    changed view-top-id => { root.view-moved(root.view-top-id, root.view-bottom-id); }
    changed view-bottom-id => { root.view-moved(root.view-top-id, root.view-bottom-id); }
    // a short message over the conversation pane (gui::notice)
    in property <string> notice-text;
    // the notice's button ("" for none)
    in property <string> notice-action;
    callback notice-action-clicked();
    // what's going on with the connection, "" when all is well
    in property <string> connection-text;
    // the text is work going on (a spinner before it), not a failure (a warning icon when folded)
    in property <bool> connection-busy;
    // the message being replied to: its text (empty: no reply) and who wrote it
    in property <string> reply-preview;
    in property <string> reply-author;
    // a photo of that message, cut to the box
    in property <image> reply-image;
    in property <bool> reply-has-image;
    // the link preview above the composer (url empty: none)
    in property <string> compose-link-url;
    in property <string> compose-link-title;
    in property <string> compose-link-desc;
    in property <string> compose-link-domain;
    in property <image> compose-link-image;
    in property <bool> compose-link-has-image;
    callback link-check();
    callback link-dismiss();
    in property <[PendingFile]> pending-files;
    // a photo is among them: the quality it goes at can be picked
    in property <bool> pending-has-photo;
    // they are one photo, which can go as a view-once message
    in property <bool> pending-view-once-able;
    // the photo goes as a view-once message, alone: the text stays hidden in the composer (as
    // Signal Desktop does), and a reply or an edit can't be one
    in-out property <bool> view-once;
    property <bool> view-once-on: view-once && pending-view-once-able && reply-preview == "" && edit-preview == "";
    in-out property <string> draft;

    callback start-link(string);
    // the loading screen offers to go on without the history the phone is sending
    in property <bool> history-skippable;
    callback skip-history();
    callback open-thread(string);
    callback send(string);
    // the composer text changed: cut it to the message size limit; the new cursor offset, or -1 if it fit
    callback clamp-draft(string) -> int;
    callback load-older();
    callback load-newer();
    callback at-bottom-changed(bool);
    callback attach();
    // files are being dragged over the window
    in property <bool> drop-hover;
    callback remove-attachment(int);
    // the pointer came onto a composer tile or left it (a GIF there plays meanwhile)
    callback pending-gif-hover(int, bool);
    // the message and which of its images
    callback attachment-clicked(string, int);
    callback file-clicked(string);
    callback view-once-clicked(string);
    callback save-clicked(string);
    callback copy-image-clicked(string);
    callback reply(string);
    callback cancel-reply();
    callback unlink();

    // settings page (over the conversation pane)
    in-out property <bool> settings-open;
    // our own photo in the sidebar header (the card on the settings page has its own)
    in property <image> me-photo;
    in property <bool> me-has-photo;
    // opens the release notes on GitHub
    callback open-whatsnew();
    callback open-settings();

    // the message being edited (banner above the composer)
    in property <string> edit-preview;
    callback cancel-edit();
    // composer edited: true while it has text
    callback composing(bool);
    // Ctrl+V: true if the clipboard held files or an image (attached), false to paste text
    callback paste-files() -> bool;

    // @mention popup above the composer; empty when closed
    in-out property <[MentionItem]> mention-items;
    in-out property <int> mention-sel;
    // composer text, cursor (byte offset), IME preedit
    callback mention-check(string, int, string);
    // picked row, composer text, cursor
    callback mention-pick(int, string, int);
    // style shortcut (view::STYLE_*), composer text, selection anchor and cursor (bytes)
    callback format-toggle(int, string, int, int);

    // pinned messages of the open thread (newest first); the bar shows pins[pin-index]
    in property <[PinItem]> pins;
    in-out property <int> pin-index;
    // scroll to the message with this sent timestamp (pin bar, quote in a reply)
    callback show-message(string);
    callback unpin(string);
    // jump to a row: whenever jump-probe changes, the row with this id (if instantiated) reports
    // where it is on screen (0 = top of the list). Its y and content-y are read together because
    // the ListView renormalizes both on every layout.
    in-out property <string> jump-id;
    in-out property <bool> jump-found;
    in-out property <length> jump-pos;
    in-out property <length> jump-h;
    // height above the row's bubble (day separator, unread line)
    in-out property <length> jump-lead;
    // where the "unread" line's row is on screen (scenario checks); stale once it scrolls out of the instantiated rows
    in-out property <length> divider-top: -100000px;
    // the view is on its way to the first unread row: what passes by is not reported as seen,
    // nor is the bottom (gui::scroll::jump_to_unread). Lifting it reports the rows on screen.
    in-out property <bool> reading-hold;
    in-out property <int> jump-probe;
    // the row across the message list's top edge (0 = its top, above the edge when negative)
    in-out property <string> view-top-id;
    in-out property <string> view-bottom-id;
    in-out property <length> view-top-off;
    // the widest a message may be in the message list: the row's padding (16px a side in
    // `Bubble`), a group's avatar column (28px and 8px of spacing) and 20px more left out, so the
    // hover tools' "more" (36px, `MsgTools.compact`) fits beside any message, past the padding.
    property <length> lane-room: msg-list.visible-width - 2 * 16px - 36px - 20px;
    // the width a picture may take. The backend sizes pictures to it, so a narrow chat shrinks
    // them instead of cutting them. Whole px: the rows compare it with the room they were sized
    // for (`Bubble.k`).
    out property <length> photo-room: floor(root.lane-room / 1px) * 1px;
    changed photo-room => { root.photo-room-changed(); }
    // the widest a message's bubble gets, leaving the same room for the tools
    property <length> bubble-max-w: min(560px, msg-list.visible-width * 0.75, root.lane-room);
    // the same inside a bubble's padding (12px a side in `Bubble`): a reply's picture, one with a
    // file line, a link preview's image
    out property <length> photo-room-boxed: floor((root.bubble-max-w - 2 * 12px) / 1px) * 1px;
    changed photo-room-boxed => { root.photo-room-changed(); }
    callback photo-room-changed();
    // the date shown at the top while scrolling: "Today", "Yesterday", "Sat, Nov 7" for a day number
    pure callback day-label(int) -> string;
    // scroll to the first message of a day (a day number, as in `Message.day`)
    callback show-day(int);
    // the day of the row across the list's top edge; 0: none, or its own day separator is in view
    property <int> top-day;
    // the last non-zero `top-day`: what the label says while it fades out
    property <int> shown-day;
    changed top-day => { if (self.top-day != 0) { self.shown-day = self.top-day; } }
    // a day separator is where the date label would cover it; separators are farther apart than
    // that area, so one row at most sets it
    property <bool> sep-near;
    // the date label is up; it goes `date-idle` ticks after the last scroll
    property <bool> date-show;
    property <int> date-idle;
    // flash the jumped-to row
    in-out property <string> flash-id;
    // message menu (right click); menu-id is "" when closed
    in-out property <string> menu-id;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <string> menu-mine;
    in property <bool> menu-can-edit;
    in property <bool> menu-can-delete;
    // its pictures or files can be saved (the hover tools' save, which a narrow chat hides)
    in property <bool> menu-can-save;
    in property <bool> menu-can-copy;
    in property <bool> menu-pinned;
    // what the message's "Info" shows; "" hides the row (incoming messages have none)
    in property <string> menu-info;
    // the menu shows the pin durations instead of the actions
    in-out property <bool> menu-pin-step;
    // the menu shows the emoji picker instead of the actions
    in-out property <bool> menu-picker;
    // the pinned bar's pin was clicked: its menu at (pin-menu-x, pin-menu-y), its right edge at x
    property <bool> pin-menu-open;
    property <length> pin-menu-x;
    property <length> pin-menu-y;
    // the menu shows only the reactions (opened by the hover tools' reaction button)
    in-out property <bool> menu-reacts;
    // what the message shows that has a size choice: 0 none, 1 photos, 2 a sticker
    in property <int> menu-media;
    // the menu shows that size's choices instead of the actions, and stays open as they apply
    in-out property <bool> menu-size-step;
    // the menu shows its actions (not a step, the picker or only the reactions)
    property <bool> menu-actions: !root.menu-pin-step && !root.menu-size-step && !root.menu-picker && !root.menu-reacts;
    in-out property <int> picker-tab;
    // the open tab's rows (empty while the picker is closed) and the emoji we reacted with lately
    in property <[[string]]> picker-rows;
    in property <[string]> recent-emoji;
    callback picker-tab-changed(int);
    // the menu closed: the Rust side drops the grid's rows
    callback picker-closed();
    changed menu-id => {
        if (root.menu-id == "") {
            root.menu-picker = false;
            root.menu-reacts = false;
            root.picker-closed();
        }
    }
    callback open-menu(string, length, length);
    // seconds, 0 = until unpinned
    callback pin-message(string, int);
    callback react(string, string);
    callback edit-message(string);
    callback edit-last() -> bool;
    callback delete-message(string);

    // the open thread's notifications are off (header bell)
    in property <bool> current-muted;

    in-out property <bool> sticker-open;
    callback toggle-stickers();
    in-out property <string> info-text;
    in-out property <string> info-title: @tr("Message info");

    // headless test mode: no platform color scheme, set it explicitly
    public function set-dark(d: bool) {
        Palette.color-scheme = d ? ColorScheme.dark : ColorScheme.light;
    }
    public function scroll-to-bottom() {
        msg-list.content-y = min(0px, msg-list.visible-height - msg-list.content-height);
    }
    public function focus-composer() {
        composer.focus();
    }
    // the header's search button and Ctrl+F: the search box, over the open chat's messages
    function search-in-chat() {
        root.settings-open = false;
        SearchData.search-in(root.current-key, root.current-name, root.current-initial, root.current-tint,
            root.current-photo-small, root.current-has-photo);
        root.focus-search();
    }
    public function focus-search() {
        root.side-hold = true;
        search-edit.focus();
    }
    function pick-thread(key: string) {
        root.settings-open = false;
        PackData.close();
        GalleryData.close();
        root.open-thread(key);
    }
    function toggle-settings() {
        if (root.settings-open) {
            root.settings-open = false;
        } else {
            root.open-settings();
        }
    }
    // the ✎ button: the contact list, in the search box
    function open-contacts() {
        SearchData.contacts = true;
        SearchData.query = "";
        SearchData.changed();
        root.focus-search();
    }
    // a left press at `x` anywhere in the window (winhook): one past the sidebar leaves the search
    // box, as a press on the list's empty space wouldn't by itself. Not while a filter's menu or
    // date picker, which reach past the sidebar, is open
    public function pressed-at(x: length) {
        if (x >= sidebar.width && !kind-menu.is-open && !CalendarData.open) {
            search-edit.blur();
            root.side-hold = false;
        }
    }
    public function blur-composer() {
        composer.clear-focus();
    }
    public function composer-to-end() {
        composer.set-selection-offsets(10000000, 10000000);
    }
    public function composer-select(start: int, end: int) {
        composer.set-selection-offsets(start, end);
    }
    public function composer-cursor(offset: int) {
        composer.set-selection-offsets(offset, offset);
    }
    public function content-height() -> length {
        return msg-list.content-height;
    }
    public function set-content-y(y: length) {
        msg-list.content-y = max(msg-list.visible-height - msg-list.content-height, min(0px, y));
    }
    public function list-visible-height() -> length {
        return msg-list.visible-height;
    }
    // the part of the list not under the composer: where a row can be read
    public function list-open-height() -> length {
        return msg-list.visible-height - root.under-h;
    }
    // what floats over the message list's bottom (composer, sticker panel, request bar)
    property <length> float-h: pane-col.height - list-box.y - list-box.height;
    // how far the list runs on under that: down to the middle of the composer pill (or the
    // request bar). Both sit 8px below their top edge and 12px above their bottom edge.
    property <length> bottom-h: composer-bar.height + request-bar.height;
    property <length> under-h: max(0px, root.float-h - (root.bottom-h > 0 ? root.bottom-h / 2 + 2px : 0px));
    // a switched-to thread at the bottom from its first frame: the ListView lays out only when
    // drawing, and the Flickable first clamps content-y to the (old thread's) content height.
    // A huge content height avoids the clamp; past the end, the layout puts the last row at the
    // bottom with real row heights above it (vendor patch) and sets both values right. Not ensure-row-visible:
    // it puts a row taller than the view at its top, so a long last message slid into place.
    public function seek-end() {
        msg-list.content-height = 10000000px;
        msg-list.content-y = msg-list.visible-height - 10000000px;
    }
    // prefetch within two screens of the top: rows inserted above the ones on screen keep the
    // view still, so a wheel scroll in progress never hits the top and waits
    public function check-older() {
        if (msg-list.content-y >= -2 * msg-list.visible-height && root.can-load-older) {
            root.load-older();
        }
    }
    // the same below, when the rows stop short of the thread's newest message
    public function check-newer() {
        if (msg-list.content-y <= 3 * msg-list.visible-height - msg-list.content-height && root.can-load-newer) {
            root.load-newer();
        }
    }
    public function list-content-y() -> length {
        return msg-list.content-y;
    }
    // no clamping: the content height is still the old estimate right after a model change
    public function set-content-y-raw(y: length) {
        msg-list.content-y = y;
    }
    public function shift-by(d: length) {
        msg-list.content-y = max(msg-list.visible-height - msg-list.content-height, min(0px, msg-list.content-y - d));
    }
    out property <bool> near-bottom: msg-list.content-y <= msg-list.visible-height - msg-list.content-height + 120px;
    // the jump button wants a much tighter margin than following news: even one message up shows it
    out property <bool> off-bottom: msg-list.content-y > msg-list.visible-height - msg-list.content-height + 16px;
    changed near-bottom => {
        if (!reading-hold) {
            at-bottom-changed(near-bottom);
        }
    }

    if page == "loading": Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                BusySpinner { }
            }
            Text { text: loading-text; color: Theme.subtle; horizontal-alignment: center; }
            if root.history-skippable: HorizontalLayout {
                alignment: center;
                PlainButton {
                    text: @tr("Continue without history");
                    clicked => { root.skip-history(); }
                }
            }
        }
    }

    if page == "link": LinkPage {
        qr: root.qr;
        has-qr: root.has-qr;
        status: root.link-status;
        start-link(name) => { root.start-link(name); }
    }

    // conversation pane, right of the sidebar's place: the sidebar lies over the window outside
    // any layout, so that it can open over the pane
    main := Rectangle {
        visible: page == "main";
        x: root.pane-x;
        width: root.width - root.pane-x;
        pane-col := VerticalLayout {
            if root.current-key == "": Rectangle {
                vertical-stretch: 1;
                // seen at every start: who this is, its version and what changed in it
                VerticalLayout {
                    alignment: center;
                    padding: 24px;
                    HorizontalLayout {
                        alignment: center;
                        AppMark { size: 72px; }
                    }
                    Rectangle { height: 14px; }
                    Text {
                        text: "Sigwin";
                        color: Theme.text;
                        font-size: 22px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Rectangle { height: 4px; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "v" + SettingsData.current-version;
                            color: Theme.subtle;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "·";
                            color: Theme.subtle;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        wn-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-whatsnew(); }
                            min-width: wn-row.min-width;
                            preferred-width: wn-row.preferred-width;
                            min-height: wn-row.min-height;
                            preferred-height: wn-row.preferred-height;
                            wn-row := HorizontalLayout {
                                spacing: 3px;
                                Text {
                                    text: @tr("What's new");
                                    color: Theme.link;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    opacity: wn-ta.has-hover ? 0.75 : 1;
                                }
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.open-outside;
                                    size: 14px;
                                    tint: Theme.link;
                                    opacity: wn-ta.has-hover ? 0.75 : 1;
                                }
                            }
                        }
                    }
                    Rectangle { height: 22px; }
                    Text {
                        text: @tr("Choose a chat on the left, or start a new one.");
                        color: Theme.subtle;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
            if root.current-key != "": Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    Avatar {
                        // default size: the photo is the thread row's, pre-cut for it (avatar.rs)
                        y: (parent.height - self.height) / 2;
                        initial: root.current-initial;
                        tint: root.current-tint;
                        photo: root.current-photo;
                        has-photo: root.current-has-photo;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: root.current-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                        if root.current-sub != "": Text { text: root.current-sub; color: Theme.subtle; font-size: 12px; overflow: elide; }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.search;
                        active: SearchData.scope-key == root.current-key;
                        clicked => { root.search-in-chat(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.calendar;
                        active: CalendarData.open && !CalendarData.until;
                        clicked => {
                            CalendarData.show(0, self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height + 4px);
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.gallery;
                        active: GalleryData.open;
                        clicked => { GalleryData.show(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: root.current-muted ? Icons.bell-off : Icons.bell;
                        clicked => {
                            ThreadMenuData.open(root.current-key, self.absolute-position.x + self.width, self.absolute-position.y + self.height + 4px);
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            if root.current-key != "" && root.pins.length > 0: Rectangle {
                property <int> idx: Math.min(root.pin-index, root.pins.length - 1);
                height: 48px;
                background: pin-ta.has-hover ? Theme.hover : Theme.pane;
                pin-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-message(root.pins[idx].id);
                        // like the official apps: each click moves on to the next (older) pin
                        root.pin-index = Math.mod(idx + 1, root.pins.length);
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 10px;
                    // one segment per pin, the shown one highlighted
                    VerticalLayout {
                        width: 3px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        for p[i] in root.pins: Rectangle {
                            border-radius: 1.5px;
                            background: i == idx ? Theme.accent : Theme.border;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.pins.length > 1 ? @tr("Pinned message {}/{}", idx + 1, root.pins.length) : @tr("Pinned message");
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.pins[idx].sender + ": " + root.pins[idx].text;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    // the pin itself is the button: its menu
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.pin;
                        active: true;
                        clicked => {
                            root.pin-menu-x = self.absolute-position.x + self.width;
                            root.pin-menu-y = self.absolute-position.y + self.height + 4px;
                            root.pin-menu-open = true;
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            list-box := Rectangle {
                visible: root.current-key != "";
                // hidden, it would still take half the height from the empty screen
                vertical-stretch: self.visible ? 1 : 0;
                max-height: self.visible ? 100000px : 0px;
                // The list runs on behind the sticker panel and the top half of the composer (or
                // request bar), which float over its bottom. The newest row carries that height as
                // room below it, so the list's own end is still where the last message sits above them.
                msg-list := ListView {
                    // taller than its parent: without a y it would be centered, half of it over the header
                    y: 0px;
                    width: parent.width;
                    height: parent.height + root.under-h;
                    // No scrollbar: its height is an estimate from the rows on screen and its
                    // range only the loaded window, so a thumb jitters and can't say where in
                    // the thread the view is. The date pill, the jump button and jumping to a
                    // date do its jobs.
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    // what floats over the bottom growing (a reply card, a second line, the
                    // sticker panel): if the list was at the bottom, keep the last message above it.
                    // The rows lay out only when drawing, so the content height is still the old
                    // one here: seek-end lets the layout put the last row at the bottom.
                    changed tail => {
                        if (!root.off-bottom) {
                            root.seek-end();
                        }
                    }
                    property <length> tail: root.under-h;
                    // the composer growing (or a resize) shrinks the list: if it was at the
                    // bottom before, keep it there so the last message isn't hidden
                    property <length> last-vh;
                    changed visible-height => {
                        if (self.last-vh > 0 && self.content-height + self.content-y - self.last-vh <= 120px) {
                            root.scroll-to-bottom();
                        }
                        self.last-vh = self.visible-height;
                    }
                    // load older history at the top. `scrolled` fires when a wheel notch starts
                    // its 180ms animation, before content-y gets there, so content-y itself is
                    // watched too, once the user has scrolled this thread
                    property <bool> user-scrolled;
                    property <string> key: root.current-key;
                    changed key => { self.user-scrolled = false; root.date-show = false; root.sep-near = false; }
                    scrolled => {
                        self.user-scrolled = true;
                        root.check-older();
                        root.check-newer();
                        Hover.refresh();
                    }
                    // not a ThinScroll (no scrollbar here): it brings the hover up to date itself
                    changed content-y => {
                        Hover.refresh();
                        if (self.user-scrolled) {
                            root.check-older();
                            root.check-newer();
                            // not while stuck to the bottom: news arriving moves content-y too
                            // nor while a jump is on its way: the row it lands on shows its own separator
                            if (root.off-bottom && root.jump-id == "") {
                                root.date-show = true;
                                root.date-idle = 0;
                            }
                        }
                    }
                    for m[idx] in root.messages: Bubble {
                        m: m;
                        last: idx == root.messages.length - 1;
                        tail: root.under-h;
                        max-w: root.bubble-max-w;
                        room: root.photo-room;
                        room-boxed: root.photo-room-boxed;
                        flash: m.id == root.flash-id;
                        property <int> probe: root.jump-probe;
                        changed probe => {
                            if (m.id == root.jump-id) {
                                root.jump-pos = self.y + self.lead + msg-list.content-y;
                                root.jump-h = self.height - self.lead;
                                root.jump-lead = self.lead;
                                root.jump-found = true;
                            }
                        }
                        property <length> screen-top: self.y + msg-list.content-y;
                        property <bool> is-divider: m.unread-divider;
                        // the row across the list's top edge and where its top is: where the user
                        // left off (gui::scroll::remember_place)
                        property <string> top-id: self.screen-top <= 0px && self.screen-top + self.height > 0px ? m.id : "";
                        // the day of the top row, unless its own separator pill is still in view
                        property <int> top-day: !(m.day-sep && self.screen-top + self.lead > 0px) ? m.day : 0;
                        // a day separator under the date pill or just below it: the pill would cover
                        // it with the previous day, so it steps aside (14px: where the separator's
                        // pill starts in the row)
                        property <bool> sep-near: m.day-sep && self.screen-top + 14px < date-pill.y + date-pill.height + 8px && self.screen-top + 14px + 24px > date-pill.y - 8px;
                        changed sep-near => { root.sep-near = self.sep-near; }
                        changed top-id => { if (self.top-id != "") { root.view-top-id = self.top-id; root.view-top-off = self.screen-top; root.top-day = self.top-day; } }
                        // the row at the list's bottom edge: what's on screen runs from `top-id` to it
                        property <string> bottom-id: !m.typing && self.screen-top < msg-list.visible-height && self.screen-top + self.height >= msg-list.visible-height ? m.id : "";
                        changed bottom-id => { if (self.bottom-id != "") { root.view-bottom-id = self.bottom-id; } }
                        changed screen-top => {
                            if (self.is-divider) { root.divider-top = self.screen-top; }
                            if (self.top-id != "") { root.view-top-id = self.top-id; root.view-top-off = self.screen-top; root.top-day = self.top-day; }
                            if (self.bottom-id != "") { root.view-bottom-id = self.bottom-id; }
                            // a row scrolled in (or reused) already near never changes `sep-near`
                            if (self.sep-near) { root.sep-near = true; }
                        }
                        changed is-divider => { if (self.is-divider) { root.divider-top = self.screen-top; } }
                        // reading as the user goes: a row whose bottom edge is on screen, above
                        // the composer floating over the list, reported whether or not the user
                        // is at the window (`gui::presence`). The id, not a bool: the ListView
                        // gives rows old instances with new data.
                        property <string> seen-id: !root.reading-hold && !m.typing && self.y + self.height - self.below + msg-list.content-y <= msg-list.visible-height - root.under-h + 1px ? m.id : "";
                        changed seen-id => {
                            if (self.seen-id != "") {
                                root.row-seen(self.seen-id);
                            }
                        }
                        attachment-clicked(id, index) => { root.attachment-clicked(id, index); }
                        day-label(d) => { return root.day-label(d); }
                        file-clicked(id) => { root.file-clicked(id); }
                        view-once-clicked(id) => { root.view-once-clicked(id); }
                        save-clicked(id) => { root.save-clicked(id); }
                        quote-clicked(id) => { root.show-message(id); }
                        reply(id) => { root.reply(id); }
                        show-info(t) => { root.info-title = @tr("Message info"); root.info-text = t; }
                        show-reactors(t) => { root.info-title = @tr("Reactions"); root.info-text = t; }
                        menu(id, x, y) => {
                            root.menu-reacts = false;
                            root.open-menu(id, x, y);
                        }
                        react-menu(id, x, y) => {
                            root.menu-reacts = true;
                            root.open-menu(id, x, y);
                        }
                    }
                }
                // the date of the messages at the top, while the user scrolls
                date-pill := Rectangle {
                    y: 8px;
                    x: (parent.width - self.width) / 2;
                    width: date-text.preferred-width + 20px;
                    height: 26px;
                    border-radius: 13px;
                    background: date-ta.has-hover ? Theme.hover : Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    opacity: root.date-show && root.top-day != 0 && !root.sep-near ? 1.0 : 0.0;
                    visible: self.opacity > 0;
                    animate opacity { duration: 150ms; }
                    // a click goes to the first message of that day
                    date-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.date-show = false;
                            root.show-day(root.shown-day);
                        }
                    }
                    date-text := Text {
                        x: 10px;
                        height: parent.height;
                        text: root.day-label(root.shown-day);
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                Timer {
                    interval: 300ms;
                    running: root.date-show;
                    triggered => {
                        // stays up while the cursor is on it
                        root.date-idle = date-ta.has-hover ? 0 : root.date-idle + 1;
                        if (root.date-idle >= 9) { root.date-show = false; }
                    }
                }
                // jump to the latest message
                if root.off-bottom || root.can-load-newer: Rectangle {
                    x: parent.width - self.width - 20px;
                    y: parent.height - self.height - 14px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: jump-ta.has-hover ? Theme.hover : Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: Theme.shadow;
                    jump-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.jump-to-bottom(); }
                    }
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.chevron-down;
                        tint: Theme.text;
                    }
                    if root.open-unread > 0: Rectangle {
                        x: parent.width - self.width + 4px;
                        y: -6px;
                        height: 18px;
                        width: max(18px, badge.preferred-width + 10px);
                        border-radius: 9px;
                        background: Theme.accent;
                        badge := Text {
                            text: root.open-unread > 99 ? "99+" : root.open-unread;
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }
                }
            }
            if root.current-key != "" && root.sticker-open: StickerPanel {
                create-pack => { PackData.start(); }
                close => {
                    root.toggle-stickers();
                    root.focus-composer();
                }
            }
            // in place of the composer, the same inset. Not an `if`: `under-h` reads its height.
            request-bar := Rectangle {
                visible: root.current-key != "" && root.current-request;
                vertical-stretch: 0;
                min-height: self.visible ? request-lay.preferred-height : 0px;
                max-height: self.visible ? 100000px : 0px;
                request-lay := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 12px;
                RequestCard { answer(which) => { root.answer-request(which); } }
                }
            }
            composer-bar := Rectangle {
                visible: root.current-key != "" && !root.current-request;
                // as tall as what it holds: the message list takes the rest
                vertical-stretch: 0;
                min-height: self.visible ? 64px : 0px;
                max-height: self.visible ? 400px : 0px;
                // a pill holding the buttons and the text
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 12px;
                    Rectangle {
                    border-radius: 22px;
                    background: Theme.field;
                    VerticalLayout {
                        // what goes with the message: cards inside the pill, above the text
                        if root.edit-preview != "": HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                            Rectangle {
                                border-radius: 16px;
                                background: Theme.pane;
                                HorizontalLayout {
                                    padding: 6px;
                                    padding-left: 12px;
                                    spacing: 10px;
                                    Icon { y: (parent.height - self.height) / 2; size: 16px; icon: Icons.edit; tint: Theme.accent; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text { text: @tr("Editing"); color: Theme.accent; font-size: 12px; font-weight: 700; }
                                        Text { text: root.edit-preview; color: Theme.subtle; font-size: 12px; overflow: elide; }
                                    }
                                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.close; icon-size: 16px; width: 28px; height: 28px; clicked => { root.cancel-edit(); } }
                                }
                            }
                        }
                        if root.reply-preview != "": HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                            Rectangle {
                                border-radius: 16px;
                                background: Theme.pane;
                                HorizontalLayout {
                                    padding: 6px;
                                    padding-left: 12px;
                                    spacing: 10px;
                                    Icon { y: (parent.height - self.height) / 2; size: 16px; icon: Icons.reply; tint: Theme.accent; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text {
                                            text: root.reply-author == "" ? @tr("Reply") : root.reply-author == @tr("You") ? @tr("Replying to yourself") : @tr("Replying to {}", root.reply-author);
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }
                                        Text { text: root.reply-preview; color: Theme.subtle; font-size: 12px; overflow: elide; }
                                    }
                                    // the quote thumbnail, already sized for the message list's quote box
                                    if root.reply-has-image: Rectangle {
                                        width: 54px;
                                        height: 54px;
                                        border-radius: 11px;
                                        clip: true;
                                        background: Theme.loading;
                                        Image { width: 100%; height: 100%; source: root.reply-image; image-fit: cover; }
                                    }
                                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.close; icon-size: 16px; width: 28px; height: 28px; clicked => { root.cancel-reply(); } }
                                }
                            }
                        }
                        // a file goes alone: one card with its name and size
                        if root.pending-files.length > 0 && root.pending-files[0].is-file: HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                Rectangle {
                    height: 64px;
                    border-radius: 16px;
                    background: Theme.pane;
                    // the file card's mark in a message (`bubble.slint`)
                    Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: root.pending-files[0].danger ? Theme.warning : Theme.inset;
                        Icon {
                            icon: root.pending-files[0].danger ? Icons.warning : Icons.file;
                            size: 22px;
                            tint: root.pending-files[0].danger ? white : Theme.subtle;
                        }
                    }
                    VerticalLayout {
                        x: 64px;
                        y: 0px;
                        width: parent.width - 64px - 40px;
                        height: parent.height;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.pending-files[0].name;
                            color: Theme.text;
                            font-size: 14px;
                            overflow: elide;
                        }
                        Text {
                            text: root.pending-files[0].danger ? root.pending-files[0].size + " · " + @tr("May be dangerous") : root.pending-files[0].size;
                            color: root.pending-files[0].danger ? Theme.warning-text : Theme.subtle;
                            font-size: 12px;
                        }
                    }
                    Rectangle {
                        x: parent.width - self.width - 10px;
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: file-remove.has-hover ? Theme.on-media-hover : Theme.on-media;
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            viewbox-width: 8;
                            viewbox-height: 8;
                            commands: "M 0 0 L 8 8 M 8 0 L 0 8";
                            stroke: #ffffff;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                        }
                        file-remove := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.remove-attachment(0); }
                        }
                    }
                }
                        }
                        if root.pending-files.length > 0 && !root.pending-files[0].is-file: HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                            Rectangle {
                                border-radius: 16px;
                                background: Theme.pane;
                                HorizontalLayout {
                                    padding: 6px;
                    HStrip {
                        horizontal-stretch: 1;
                        height: 120px;
                        content-width: files-row.preferred-width;
                        files-row := HorizontalLayout {
                            spacing: 8px;
                            for f[i] in root.pending-files: Rectangle {
                                width: 120px;
                                height: 120px;
                                border-radius: 10px;
                                clip: true;
                                background: Theme.hover;
                                if f.has-thumb: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: f.thumb;
                                    // a still is already this size; a GIF's frame is cut to fill it
                                    image-fit: cover;
                                }
                                if f.gif && !f.playing: MediaLabel {
                                    text: "GIF";
                                    x: 6px;
                                    y: parent.height - self.height - 6px;
                                }
                                if f.gif: TouchArea {
                                    property <bool> hovered: self.has-hover;
                                    changed hovered => { root.pending-gif-hover(i, self.hovered); }
                                }
                                if !f.has-thumb: Icon {
                                    icon: f.video ? Icons.video : Icons.gallery;
                                    size: 32px;
                                }
                                Rectangle {
                                    x: parent.width - self.width - 3px;
                                    y: 3px;
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: remove-area.has-hover ? Theme.on-media-hover : Theme.on-media;
                                    // drawn, not a glyph: the glyph sits off the circle's center
                                    Path {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 8px;
                                        height: 8px;
                                        viewbox-width: 8;
                                        viewbox-height: 8;
                                        commands: "M 0 0 L 8 8 M 8 0 L 0 8";
                                        stroke: #ffffff;
                                        stroke-width: 1.5px;
                                        stroke-line-cap: round;
                                    }
                                    remove-area := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.remove-attachment(i); }
                                    }
                                }
                            }
                        }
                    }
                                }
                            }
                        }
                        if root.compose-link-url != "" && root.pending-files.length == 0 && root.edit-preview == "": HorizontalLayout {
                            padding: 6px;
                            padding-bottom: 0px;
                            Rectangle {
                                border-radius: 16px;
                                background: Theme.pane;
                                HorizontalLayout {
                                    padding: 6px;
                                    spacing: 10px;
                                    if root.compose-link-has-image: Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 10px;
                                        clip: true;
                                        Image {
                                            width: 44px;
                                            height: 44px;
                                            source: root.compose-link-image;
                                            // already resampled to this size
                                            image-fit: fill;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 1px;
                                        padding-left: root.compose-link-has-image ? 0px : 6px;
                                        Text {
                                            text: root.compose-link-title;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }
                                        if root.compose-link-desc != "": Text {
                                            text: root.compose-link-desc;
                                            color: Theme.subtle;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.compose-link-domain;
                                            color: Theme.subtle;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.close; icon-size: 16px; width: 28px; height: 28px; clicked => { root.link-dismiss(); } }
                                }
                            }
                        }
                    HorizontalLayout {
                        padding: 5px;
                        spacing: 2px;
                        IconButton {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            // the pill is about as light as the usual hover
                            hover-color: Theme.field-off;
                            icon: Icons.attach;
                            clicked => { root.attach(); }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            padding-left: 8px;
                            padding-right: 4px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            FocusScope {
                                // FocusScope and Rectangle don't take their child's size: grow with wrapped lines
                                min-height: root.view-once-on ? 20px : min(composer.preferred-height, 140px);
                                capture-key-pressed(event) => {
                                    if (root.mention-items.length > 0) {
                                        if (event.text == Key.UpArrow) {
                                            root.mention-sel = Math.max(0, root.mention-sel - 1);
                                            return accept;
                                        }
                                        if (event.text == Key.DownArrow) {
                                            root.mention-sel = Math.min(root.mention-items.length - 1, root.mention-sel + 1);
                                            return accept;
                                        }
                                        if ((event.text == Key.Return && !event.modifiers.shift) || event.text == Key.Tab) {
                                            root.mention-pick(root.mention-sel, composer.text, composer.cursor-position-byte-offset);
                                            return accept;
                                        }
                                        if (event.text == Key.Escape) {
                                            root.mention-items = [];
                                            return accept;
                                        }
                                    }
                                    // empty composer: edit my last message (not while an IME is composing)
                                    if (event.text == Key.UpArrow && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt
                                        && root.draft == "" && composer.preedit-text == "" && root.edit-last()) {
                                        return accept;
                                    }
                                    if (event.text == Key.Return && !event.modifiers.shift && SettingsData.enter-sends != event.modifiers.control) {
                                        root.send(composer.text);
                                        return accept;
                                    }
                                    // the panel floats over the composer: Esc closes it before edit/reply
                                    if (event.text == Key.Escape && root.sticker-open) {
                                        root.toggle-stickers();
                                        return accept;
                                    }
                                    if (event.text == Key.Escape && root.edit-preview != "") {
                                        root.cancel-edit();
                                        return accept;
                                    }
                                    if (event.text == Key.Escape && root.reply-preview != "") {
                                        root.cancel-reply();
                                        return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                                        if (root.paste-files()) {
                                            return accept;
                                        }
                                    }
                                    if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "f" || event.text == "F")) {
                                        root.search-in-chat();
                                        return accept;
                                    }
                                    // text styles (Signal Desktop's shortcuts): wrap the selection in markers
                                    if (event.modifiers.control && !event.modifiers.alt) {
                                        let k = event.text;
                                        let style = !event.modifiers.shift
                                            ? (k == "b" || k == "B" ? 1 : k == "i" || k == "I" ? 2 : k == "e" || k == "E" ? 5 : 0)
                                            : (k == "x" || k == "X" ? 4 : k == "b" || k == "B" ? 3 : 0);
                                        if (style != 0) {
                                            root.format-toggle(style, composer.text, composer.anchor-position-byte-offset, composer.cursor-position-byte-offset);
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                                // past the cap the text scrolls
                                ThinScroll {
                                    min-height: 0px;
                                    content-y <=> composer-flick.content-y;
                                    content-height: composer-flick.content-height;
                                    visible-height: composer-flick.visible-height;
                                    composer-flick := ScrollView {
                                        width: parent.width;
                                        height: parent.height;
                                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                        content-height: composer.height;
                                        composer := TextBox {
                                            x: 0px;
                                            y: 0px;
                                            // keep the text clear of the scrollbar's thumb. Always, not
                                            // only while it shows: the width sets the wrapped height,
                                            // which decides whether it shows
                                            width: composer-flick.visible-width - 10px;
                                            height: root.view-once-on ? 20px : self.preferred-height;
                                            text <=> root.draft;
                                            // kept, not sent, while a view-once photo is to go
                                            read-only: root.view-once-on;
                                            edited => {
                                                // over the 64KB a message can carry: the new part is cut to fit
                                                let cut = root.clamp-draft(self.text);
                                                if cut >= 0 {
                                                    self.set-selection-offsets(cut, cut);
                                                }
                                                root.composing(self.text != "");
                                                root.link-check();
                                                root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                            }
                                            cursor-position-changed(pos) => {
                                                // keep the cursor line in view (`pos` is its top)
                                                let line = 20px;
                                                let view = composer-flick.visible-height;
                                                if (pos.y + composer-flick.content-y < 0px) {
                                                    composer-flick.content-y = -pos.y;
                                                } else if (pos.y + line + composer-flick.content-y > view) {
                                                    composer-flick.content-y = max(view - self.height, view - pos.y - line);
                                                }
                                                root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                            }
                                            // IME composition (Hangul) changes neither text nor cursor: follow it too
                                            preedit-changed => {
                                                root.mention-check(self.text, self.cursor-position-byte-offset, self.preedit-text);
                                            }
                                            single-line: false;
                                            wrap: word-wrap;
                                            color: root.view-once-on ? transparent : Theme.text;
                                            font-size: 14px;
                                        }
                                        // hide as soon as IME composition starts (preedit isn't in text yet)
                                        if (root.draft == "" && composer.preedit-text == "") || root.view-once-on: Text {
                                            x: 0;
                                            y: 0;
                                            text: root.view-once-on ? @tr("View-once photo") : root.edit-preview != "" ? @tr("Edit message (Esc to cancel)") : @tr("Message");
                                            color: Theme.subtle;
                                            font-size: 14px;
                                        }
                                    }
                                }
                            }
                        }
                        // a sticker goes alone, never with a photo: a photo being sent takes its
                        // place with the quality photos go at (the setting)
                        if !root.pending-has-photo: IconButton {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            // the pill is about as light as the usual hover
                            hover-color: Theme.field-off;
                            icon: Icons.sticker;
                            active: root.sticker-open;
                            clicked => { root.toggle-stickers(); }
                        }
                        // drawn like the quality button next to it: crossed out when off, lit when on
                        if root.pending-view-once-able && root.reply-preview == "" && root.edit-preview == "": once-btn := Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: once-area.has-hover ? Theme.field-off : transparent;
                            once-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.view-once = !root.view-once;
                                    composer.focus();
                                }
                            }
                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 20px;
                                icon: Icons.view-once;
                                tint: root.view-once ? Theme.accent : Theme.subtle;
                            }
                            if !root.view-once: Path {
                                width: 34px;
                                height: 34px;
                                viewbox-width: 34;
                                viewbox-height: 34;
                                commands: "M 7 7 L 27 27";
                                stroke: Theme.subtle;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                            }
                            Tip {
                                hovered: once-area.has-hover;
                                text: root.view-once ? @tr("Sending as view once: it can be opened one time\nClick to send normally") : @tr("Sending normally\nClick to send as view once");
                            }
                        }
                        // drawn like its neighbors (an outline, no fill), crossed out when off and lit
                        // with the accent when on
                        if root.pending-has-photo: hd-btn := Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: hd-area.has-hover ? Theme.field-off : transparent;
                            hd-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    SettingsData.photo-quality = SettingsData.photo-quality == 1 ? 0 : 1;
                                    SettingsData.changed();
                                }
                            }
                            Rectangle {
                                width: 24px;
                                height: 17px;
                                border-radius: 4px;
                                border-width: 1.5px;
                                border-color: SettingsData.photo-quality == 1 ? Theme.accent : Theme.subtle;
                                background: SettingsData.photo-quality == 1 ? Theme.accent.with-alpha(0.2) : transparent;
                                Text {
                                    text: "HD";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: SettingsData.photo-quality == 1 ? Theme.accent : Theme.subtle;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            if SettingsData.photo-quality != 1: Path {
                                width: 34px;
                                height: 34px;
                                viewbox-width: 34;
                                viewbox-height: 34;
                                commands: "M 7 7 L 27 27";
                                stroke: Theme.subtle;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                            }
                            Tip {
                                hovered: hd-area.has-hover;
                                text: SettingsData.photo-quality == 1 ? @tr("Sending in high quality\nClick to switch to standard") : @tr("Sending in standard quality\nClick to switch to high");
                            }
                        }
                        send-btn := Rectangle {
                            property <bool> ready: root.draft != "" || root.pending-files.length > 0;
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: !self.ready ? Theme.field-off : send-ta.pressed ? Theme.accent.darker(0.2) : send-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                            send-ta := TouchArea {
                                enabled: send-btn.ready;
                                mouse-cursor: pointer;
                                clicked => { root.send(composer.text); }
                            }
                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 18px;
                                icon: Icons.send;
                                tint: send-btn.ready ? white : Theme.subtle;
                            }
                        }
                    }
                    }
                    }
                }
            }
        }
    }

    if page == "main" && GalleryData.open && root.current-key != "": GalleryPage {
        x: root.pane-x;
        width: root.width - root.pane-x;
        height: root.height;
    }

    if page == "main" && root.settings-open: SettingsPage {
        x: root.pane-x;
        width: root.width - root.pane-x;
        height: root.height;
        open-whatsnew => { root.open-whatsnew(); }
        close => { root.settings-open = false; }
        unlink => { root.unlink(); }
    }

    if page == "main" && PackData.open: PackPage {
        x: root.pane-x;
        width: root.width - root.pane-x;
        height: root.height;
        recent: root.recent-emoji;
    }

    // sidebar
    sidebar := Rectangle {
        // the box has the focus (a menu or the date picker of the filters takes it while
        // open): the buttons beside the box give it their room until it's left
        property <bool> typing: search-edit.focused || kind-menu.is-open || (CalendarData.open && CalendarData.until)
            || SearchData.picking;
        property <bool> searching: SearchData.active || self.typing;
        changed typing => {
            if (!self.typing) {
                root.side-hold = false;
                // folded, a contact list left has nowhere to wait: it was only for starting a chat
                if (root.side-folded) {
                    SearchData.leave-contacts();
                }
            }
        }
        visible: page == "main";
        width: root.side-wide ? root.side-open-w : root.rail-w;
        height: root.height;
        x: 0px;
        y: 0px;
        background: Theme.sidebar;
        // opened over the pane: lifted off it
        drop-shadow-blur: root.side-folded && root.side-wide ? 16px : 0px;
        drop-shadow-color: #00000040;
        VerticalLayout {
            // the box stays here while folded, for its focus to open the sidebar
            HorizontalLayout {
                visible: root.side-wide;
                padding: root.side-wide ? 10px : 0px;
                spacing: 6px;
                // as tall without the photo beside the box as with it
                min-height: root.side-wide ? 56px : 0px;
                max-height: root.side-wide ? 56px : 0px;
                // the contact list: the way back to the threads
                if SearchData.contacts: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.back;
                    clicked => {
                        SearchData.step-back();
                        // back to the thread list, not into a search
                        if (!SearchData.contacts) {
                            search-edit.blur();
                        }
                    }
                }
                if !SearchData.contacts && !sidebar.typing: MeButton {
                    // as tall as the search box beside it
                    min-height: 36px;
                    photo: root.me-photo;
                    has-photo: root.me-has-photo;
                    open: root.settings-open;
                    clicked => { root.toggle-settings(); }
                }
                search-edit := Field {
                    y: (parent.height - self.height) / 2;
                    // the chat's picture stands first in its place
                    icon: scope-chip.visible ? "" : Icons.search;
                    placeholder: SearchData.picking ? @tr("Sender's name")
                        : SearchData.scope-key != "" ? @tr("Search in {}", SearchData.scope-name)
                        : !SearchData.contacts ? @tr("Search")
                        : SearchData.find == FindKind.phone ? @tr("Enter a phone number")
                        : SearchData.find == FindKind.username ? @tr("Username (e.g. name.42)")
                        : @tr("Name, phone number, username");
                    text <=> SearchData.query;
                    edited => {
                        SearchData.preedit = self.preedit;
                        SearchData.changed();
                    }
                    // search as Hangul is composed, before it's committed to the text
                    preedit-changed => {
                        SearchData.preedit = self.preedit;
                        SearchData.changed();
                    }
                    accepted => { SearchData.accept(); }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            // nothing left to undo: out of the box, which gives the buttons
                            // beside it back
                            if (!SearchData.active) {
                                self.blur();
                            } else {
                                let leaving = SearchData.contacts;
                                SearchData.back();
                                if (leaving && !SearchData.contacts) {
                                    self.blur();
                                }
                            }
                            return accept;
                        }
                        // through the found messages, one by one
                        if (!SearchData.contacts && !SearchData.picking && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                            SearchData.step(event.text == Key.UpArrow ? -1 : 1);
                            return accept;
                        }
                        reject
                    }
                    lead: scope-chip.visible ? scope-chip.width + 4px : 0px;
                    // the chat searched in: where, not what, so in the box rather than
                    // among the filters below
                    scope-chip := ScopeToken {
                        visible: SearchData.scope-key != "" && !SearchData.picking;
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        clear => {
                            SearchData.leave-scope();
                            search-edit.focus();
                        }
                    }
                }
                // start a conversation: the contact list
                if !SearchData.contacts && !sidebar.typing: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.compose;
                    clicked => { root.open-contacts(); }
                }
            }
            // folded: the same buttons in a column, the search box's in its place
            if !root.side-wide: VerticalLayout {
                padding-top: 10px;
                padding-bottom: 6px;
                spacing: 4px;
                HorizontalLayout {
                    alignment: center;
                    MeButton {
                        height: 36px;
                        photo: root.me-photo;
                        has-photo: root.me-has-photo;
                        open: root.settings-open;
                        clicked => { root.toggle-settings(); }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    // a search left with results: they're still there
                    IconButton {
                        icon: Icons.search;
                        active: SearchData.active;
                        clicked => { root.focus-search(); }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.compose;
                        clicked => { root.open-contacts(); }
                    }
                }
            }
            // picking the sender filter: what the list is, and the way back
            if SearchData.picking: Rectangle {
                height: 34px;
                Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 30px;
                    border-radius: 8px;
                    background: Theme.selected;
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 12px;
                    spacing: 4px;
                    Text {
                        text: @tr("Who sent it?");
                        color: Theme.text;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.close;
                        icon-size: 14px;
                        width: 24px;
                        height: 24px;
                        clicked => {
                            SearchData.end-picking("", "");
                            search-edit.focus();
                        }
                    }
                }
            }
            // the message search's filters. Shown while the box has the focus too, so that a
            // search can start from a filter; a menu or the date picker takes the focus while
            // open. Set values run longer: the chips wrap rather than scroll out of sight
            chips := Rectangle {
                property <bool> shown: !SearchData.contacts && !SearchData.picking && sidebar.searching && root.side-wide;
                height: self.shown ? chip-flow.preferred-height + 8px : 0px;
                visible: self.shown;
                chip-flow := FlexboxLayout {
                    x: 8px;
                    y: 2px;
                    width: parent.width - 16px;
                    height: self.preferred-height;
                    spacing: 6px;
                    FilterChip {
                        text: SearchData.sender-key != "" ? SearchData.sender-name : @tr("Sender");
                        set: SearchData.sender-key != "";
                        clicked => {
                            SearchData.pick-sender();
                            search-edit.focus();
                        }
                        clear => {
                            SearchData.clear-sender();
                            search-edit.focus();
                        }
                    }
                    date-chip := FilterChip {
                        text: SearchData.until-day != 0 ? SearchData.until-label : @tr("Date");
                        set: SearchData.until-day != 0;
                        clicked => {
                            CalendarData.show-until(date-chip.absolute-position.x + 100px,
                                date-chip.absolute-position.y + date-chip.height + 4px);
                        }
                        clear => {
                            SearchData.clear-until();
                            search-edit.focus();
                        }
                    }
                    kind-chip := FilterChip {
                        text: SearchData.kind == 1 ? @tr("Photos and videos") : SearchData.kind == 2 ? @tr("Files")
                            : SearchData.kind == 3 ? @tr("Links") : @tr("Type");
                        set: SearchData.kind != 0;
                        clicked => { kind-menu.show(); }
                        clear => {
                            SearchData.set-kind(0);
                            search-edit.focus();
                        }
                        kind-menu := ChipMenu {
                            x: 0px;
                            y: parent.height + 4px;
                            ChipMenuRow {
                                text: @tr("Photos and videos");
                                current: SearchData.kind == 1;
                                clicked => {
                                    SearchData.set-kind(1);
                                    kind-menu.close();
                                }
                            }
                            ChipMenuRow {
                                text: @tr("Files");
                                current: SearchData.kind == 2;
                                clicked => {
                                    SearchData.set-kind(2);
                                    kind-menu.close();
                                }
                            }
                            ChipMenuRow {
                                text: @tr("Links");
                                current: SearchData.kind == 3;
                                clicked => {
                                    SearchData.set-kind(3);
                                    kind-menu.close();
                                }
                            }
                        }
                    }
                    // reads "@Me": what mentions us. Others' mentions are found by their
                    // name, as the text shows them
                    FilterChip {
                        text: @tr("Me");
                        icon: Icons.at;
                        set: SearchData.mentions;
                        clicked => {
                            SearchData.set-mentions(!SearchData.mentions);
                            search-edit.focus();
                        }
                        clear => {
                            SearchData.set-mentions(false);
                            search-edit.focus();
                        }
                    }
                }
            }
            if root.connection-text != "": Rectangle {
                height: 34px;
                Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 30px;
                    border-radius: 8px;
                    background: Theme.selected;
                }
                // folded: only what kind of thing it is
                if !root.side-wide && !root.connection-busy: Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 18px;
                    icon: Icons.warning;
                }
                if root.connection-busy: BusySpinner {
                    x: root.side-wide ? 20px : (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    thickness: 2px;
                }
                if root.side-wide: Text {
                    x: root.connection-busy ? 44px : 20px;
                    width: parent.width - self.x - 20px;
                    text: root.connection-text;
                    color: Theme.text;
                    font-size: 13px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            // the threads, or the search's results over them (the threads keep their place)
            Rectangle {
                vertical-stretch: 1;
                // folded, a search left with results keeps them for when the box opens again
                thread-scroll := ThinScroll {
                    visible: !SearchData.active || !root.side-wide;
                    // a thumb always up would crowd the folded rail
                    hover-only: true;
                    // folded, the peeked card has the pointer: the thumb shows beside it
                    keep: root.peek-on;
                    content-y <=> thread-list.content-y;
                    content-height: thread-list.content-height;
                    visible-height: thread-list.visible-height;
                    thread-list := ListView {
                        width: parent.width;
                        height: parent.height;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        // where the hovered row was is stale: the next row the pointer meets shows
                        changed content-y => {
                            root.peek-on = false;
                            root.hover-key = "";
                        }
                        for t in root.threads: ThreadRow {
                            item: t;
                            folded: !root.side-wide;
                            selected: t.key == root.current-key;
                            settled: thread-scroll.settled;
                            clicked => { root.pick-thread(t.key); }
                            menu(x, y) => { ThreadMenuData.open(t.key, x, y); }
                            hover(on) => {
                                if (on && self.folded) {
                                    root.rail-hover(t, self.absolute-position.y);
                                } else if (!on && root.hover-key == t.key) {
                                    root.hover-key = "";
                                }
                            }
                        }
                    }
                }
                if SearchData.active && root.side-wide: ThinScroll {
                    hover-only: true;
                    content-y <=> search-list.content-y;
                    content-height: search-list.content-height;
                    visible-height: search-list.visible-height;
                    search-list := ListView {
                        width: parent.width;
                        height: parent.height;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        // a new search starts at the top (rows are updated in place, so the
                        // list keeps its place for the next page of the same one)
                        property <string> asked: SearchData.query + SearchData.preedit + SearchData.scope-key
                            + SearchData.sender-key + SearchData.until-day + SearchData.kind + (SearchData.mentions ? "m" : "") + (SearchData.picking ? "p" : "");
                        changed asked => { self.content-y = 0; }
                        // ↑/↓ moved to a found message: it shows
                        changed reveal-n => { self.ensure-row-visible(SearchData.reveal-row, ScrollBehavior.instant); }
                        property <int> reveal-n: SearchData.reveal-n;
                        for r in SearchData.results: ResultRow {
                            item: r;
                            selected: (!SearchData.picking && (r.kind == ResultKind.thread || r.kind == ResultKind.contact) && r.thread.key == root.current-key)
                                || (r.kind == ResultKind.message && r.text == SearchData.picked && r.thread.key == root.current-key);
                            clicked => {
                                if (SearchData.picking) {
                                    if (r.kind == ResultKind.contact) {
                                        SearchData.end-picking(r.thread.key, r.thread.name);
                                        search-edit.focus();
                                    }
                                } else if (r.kind == ResultKind.find) {
                                    SearchData.pick-find(r.text);
                                    search-edit.focus();
                                } else if (r.kind == ResultKind.start) {
                                    if (r.ready) {
                                        SearchData.start(r.text);
                                    }
                                } else if (r.kind == ResultKind.more) {
                                    SearchData.more();
                                } else if (r.kind == ResultKind.message) {
                                    // the results stay, to go through them one by one. Picked
                                    // with the mouse: the box is done with (↑/↓ keep it)
                                    GalleryData.close();
                                    SearchData.show-found(r.thread.key, r.text);
                                    search-edit.blur();
                                } else if (r.kind != ResultKind.header) {
                                    root.settings-open = false;
                                    GalleryData.close();
                                    root.open-thread(r.thread.key);
                                    SearchData.leave-contacts();
                                }
                            }
                            menu(x, y) => {
                                if (r.kind == ResultKind.thread) {
                                    ThreadMenuData.open(r.thread.key, x, y);
                                }
                            }
                        }
                    }
                }
                if SearchData.active && root.side-wide && SearchData.results.length == 0: Text {
                    y: 24px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: SearchData.contacts && SearchData.query == "" ? @tr("No contacts")
                        : SearchData.scope-key != "" && SearchData.query == "" && SearchData.preedit == "" && !SearchData.filtered ? ""
                        : @tr("No results");
                    color: Theme.subtle;
                    font-size: 13px;
                }
            }
            // bars docked at the sidebar's foot: flat on the sidebar, a rule above each
            if SettingsData.update-version == "" && SettingsData.update-available != "": FootBar {
                height: 52px;
                folded: !root.side-wide;
                icon: Icons.download;
                tip: SettingsData.update-installing ? @tr("Downloading…")
                    : @tr("New version available") + ": " + SettingsData.current-version + " → " + SettingsData.update-available
                        + "\n" + @tr("Click to update");
                enabled: !SettingsData.update-installing;
                clicked => {
                    SettingsData.update-installing = true;
                    SettingsData.install-update();
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: @tr("New version available");
                        color: Theme.text;
                        font-size: 13px;
                        overflow: elide;
                    }
                    Text {
                        text: SettingsData.current-version + " → " + SettingsData.update-available;
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                Text {
                    text: SettingsData.update-installing ? @tr("Downloading…") : @tr("Update");
                    color: SettingsData.update-installing ? Theme.subtle : Theme.accent;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            if SettingsData.update-version != "": FootBar {
                height: 52px;
                folded: !root.side-wide;
                icon: Icons.download;
                tip: @tr("New version ready") + ": " + SettingsData.current-version + " → " + SettingsData.update-version
                    + "\n" + @tr("Click to restart");
                clicked => { SettingsData.restart-for-update(); }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: @tr("New version ready");
                        color: Theme.text;
                        font-size: 13px;
                        overflow: elide;
                    }
                    Text {
                        text: SettingsData.current-version + " → " + SettingsData.update-version;
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                Text {
                    text: @tr("Restart");
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        // drag to resize or fold, double click to fold or unfold; not while opened over the pane
        edge := TouchArea {
            enabled: !root.side-folded || !root.side-wide;
            x: parent.width - 3px;
            width: 7px;
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    root.drag-edge(self.absolute-position.x + self.mouse-x);
                }
            }
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    root.drag-from = root.side-width;
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    root.side-changed();
                }
            }
            double-clicked => {
                root.side-folded = !root.side-folded;
                root.side-changed();
            }
        }
    }

    // folded: the hovered row, whole, from the rail over the pane
    Timer {
        // only to let a pointer crossing the rail pass without a flash
        interval: 100ms;
        running: root.hover-key != "" && !root.peek-on && !root.side-wide;
        triggered => {
            root.peek-item = root.hover-item;
            root.peek-y = root.hover-y;
            root.peek-on = true;
        }
    }
    Timer {
        interval: 100ms;
        running: root.peek-on && root.hover-key == "" && !peek-row.hovered;
        triggered => { root.peek-on = false; }
    }
    Rectangle {
        visible: root.peek-on && !root.side-wide && page == "main";
        // a row cut off by the list's edge shows inside the list, not over what's beyond it (the
        // bars at the foot, the buttons above); the pointer on its visible part stays on this
        property <length> list-top: thread-list.absolute-position.y;
        // the row's own card, inset as in the list: nothing of this shows around it. Pushed in,
        // the card itself meets the edge
        x: 8px;
        y: max(self.list-top, min(root.peek-y + 1px, self.list-top + thread-list.height - self.height));
        width: root.side-open-w - 16px;
        height: peek-row.height - 2px;
        border-radius: 10px;
        background: Theme.sidebar;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        // the wheel, which the row lets through, still moves the rail under it
        TouchArea {
            // only over the rail's own place, like the row: the rest of the card lets the pointer through
            x: 0px;
            width: root.rail-w - 16px;
            scroll-event(e) => {
                root.peek-on = false;
                thread-list.content-y = max(thread-list.visible-height - thread-list.content-height, min(0px, thread-list.content-y + e.delta-y));
                accept
            }
        }
        peek-row := ThreadRow {
            x: -8px;
            y: -1px;
            width: root.side-open-w;
            hit-width: root.rail-w;
            item: root.peek-item;
            selected: root.peek-item.key == root.current-key;
            clicked => { root.pick-thread(root.peek-item.key); }
            menu(x, y) => { ThreadMenuData.open(root.peek-item.key, x, y); }
        }
    }

    // @mention popup, just above the composer
    if root.mention-items.length > 0: Rectangle {
        property <length> row-h: 36px;
        // a half row past six hints that the list scrolls
        property <length> list-h: min(root.mention-items.length * row-h, 6.5 * row-h);
        property <int> sel: root.mention-sel;
        property <[MentionItem]> items: root.mention-items;
        // keep the keyboard selection in view
        changed sel => {
            mention-list.content-y = min(max(mention-list.content-y, -sel * row-h), mention-list.visible-height - (sel + 1) * row-h);
        }
        changed items => { mention-list.content-y = 0px; }
        x: composer.absolute-position.x - 8px;
        y: composer-bar.absolute-position.y - self.height - 4px;
        width: 240px;
        height: list-h + 8px;
        border-radius: 10px;
        background: Theme.pane;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        ThinScroll {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: list-h;
            content-y <=> mention-list.content-y;
            content-height: mention-list.content-height;
            visible-height: mention-list.visible-height;
            mention-list := ListView {
                width: parent.width;
                height: parent.height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                for item[i] in root.mention-items: Rectangle {
                    height: row-h;
                    border-radius: 6px;
                    background: i == root.mention-sel ? Theme.selected : mta.has-hover ? Theme.hover : transparent;
                    mta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.mention-pick(i, composer.text, composer.cursor-position-byte-offset); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: start;
                        Avatar {
                            size: 24px;
                            y: 6px;
                            initial: item.initial;
                            tint: item.tint;
                        }
                        Text {
                            text: item.name;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // text style buttons, just above the composer while text in it is selected; a hovered one
    // tells its shortcut
    if composer.has-focus && composer.anchor-position-byte-offset != composer.cursor-position-byte-offset
        && composer.preedit-text == "" && root.mention-items.length == 0 && !root.sticker-open: Rectangle {
        property <int> on: TextOps.selected-styles(composer.text, composer.anchor-position-byte-offset, composer.cursor-position-byte-offset);
        property <string> hint;
        x: composer.absolute-position.x - 8px;
        y: composer-bar.absolute-position.y - self.height - 4px;
        width: style-row.preferred-width;
        height: style-row.preferred-height;
        border-radius: 10px;
        background: Theme.pane;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        // keeps clicks between the buttons off the list below
        TouchArea { }
        style-row := HorizontalLayout {
            padding: 4px;
            spacing: 2px;
            // style: view::STYLE_*
            for b in [
                { style: 1, icon: Icons.bold, hint: @tr("Bold") + "   Ctrl+B" },
                { style: 2, icon: Icons.italic, hint: @tr("Italic") + "   Ctrl+I" },
                { style: 4, icon: Icons.strike, hint: @tr("Strikethrough") + "   Ctrl+Shift+X" },
                { style: 5, icon: Icons.mono, hint: @tr("Monospace") + "   Ctrl+E" },
                { style: 3, icon: Icons.spoiler, hint: @tr("Spoiler") + "   Ctrl+Shift+B" },
            ]: IconButton {
                width: 32px;
                height: 32px;
                icon-size: 18px;
                active: Math.mod(Math.floor(on / Math.pow(2, b.style)), 2) == 1;
                icon: b.icon;
                changed hovered => {
                    if (self.hovered) {
                        hint = b.hint;
                    } else if (hint == b.hint) {
                        hint = "";
                    }
                }
                clicked => {
                    root.format-toggle(b.style, composer.text, composer.anchor-position-byte-offset, composer.cursor-position-byte-offset);
                }
            }
            if hint != "": Rectangle { width: 4px; }
            if hint != "": Text {
                text: hint;
                color: Theme.subtle;
                font-size: 12px;
                vertical-alignment: center;
            }
            // the hint's room after it
            if hint != "": Rectangle { width: 8px; }
        }
    }

    // message menu: reactions + actions, opened by right-clicking a message
    if root.menu-id != "": Rectangle {
        TouchArea {
            clicked => { root.menu-id = ""; }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.menu-id = "";
                }
            }
        }
        card := Rectangle {
            property <length> w: (root.menu-picker ? PickerLayout.columns : 7) * PickerLayout.cell + 12px;
            width: w;
            height: menu-col.preferred-height;
            x: max(8px, min(root.menu-x, root.width - w - 8px));
            y: max(8px, min(root.menu-y, root.height - self.height - 8px));
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if root.menu-picker: EmojiPicker {
                    mine: root.menu-mine;
                    recent: root.recent-emoji;
                    rows: root.picker-rows;
                    tab: root.picker-tab;
                    tab-changed(i) => {
                        root.picker-tab = i;
                        root.picker-tab-changed(i);
                    }
                    picked(e) => {
                        root.react(root.menu-id, e);
                        root.menu-id = "";
                    }
                }
                if !root.menu-picker: HorizontalLayout {
                    for e in ["❤️", "👍", "👎", "😂", "😮", "😢"]: ReactionCell {
                        emoji: e;
                        mine: e == root.menu-mine;
                        picked => {
                            root.react(root.menu-id, e);
                            root.menu-id = "";
                        }
                    }
                    // any other emoji; ours when it is none of the six
                    plus := ReactionCell {
                        icon: Icons.plus;
                        mine: root.menu-mine != "" && root.menu-mine != "❤️" && root.menu-mine != "👍" && root.menu-mine != "👎"
                            && root.menu-mine != "😂" && root.menu-mine != "😮" && root.menu-mine != "😢";
                        picked => {
                            root.picker-tab = 0;
                            root.menu-picker = true;
                            root.picker-tab-changed(0);
                        }
                    }
                }
                if !root.menu-picker && !root.menu-reacts: Rectangle { height: 1px; background: Theme.border; }
                if root.menu-pin-step && !root.menu-picker: HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        height: 28px;
                        text: @tr("Pin for");
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                for d in root.menu-pin-step && !root.menu-picker ? [
                    { label: @tr("24 hours"), secs: 86400 },
                    { label: @tr("7 days"), secs: 604800 },
                    { label: @tr("30 days"), secs: 2592000 },
                    { label: @tr("Forever"), secs: 0 },
                ] : []: MenuRow {
                    text: d.label;
                    clicked => {
                        root.pin-message(root.menu-id, d.secs);
                        root.menu-id = "";
                    }
                }
                if root.menu-actions: MenuRow {
                    icon: Icons.reply;
                    text: @tr("Reply");
                    clicked => {
                        root.reply(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if root.menu-can-save && root.menu-actions: MenuRow {
                    icon: Icons.download;
                    text: @tr("Save");
                    clicked => {
                        root.save-clicked(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if root.menu-can-copy && root.menu-actions: MenuRow {
                    icon: Icons.copy;
                    text: @tr("Copy image");
                    clicked => {
                        root.copy-image-clicked(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if root.menu-actions: MenuRow {
                    icon: Icons.pin;
                    text: root.menu-pinned ? @tr("Unpin") : @tr("Pin");
                    clicked => {
                        if (root.menu-pinned) {
                            root.unpin(root.menu-id);
                            root.menu-id = "";
                        } else {
                            root.menu-pin-step = true;
                        }
                    }
                }
                if root.menu-can-edit && root.menu-actions: MenuRow {
                    icon: Icons.edit;
                    text: @tr("Edit");
                    clicked => {
                        root.edit-message(root.menu-id);
                        root.menu-id = "";
                    }
                }
                if root.menu-media > 0 && root.menu-actions: MenuRow {
                    icon: root.menu-media == 2 ? Icons.sticker : Icons.gallery;
                    text: root.menu-media == 2 ? @tr("Sticker size") : @tr("Photo size");
                    clicked => { root.menu-size-step = true; }
                }
                if root.menu-size-step && !root.menu-picker: HorizontalLayout {
                    padding-left: 10px;
                    Text {
                        height: 28px;
                        text: root.menu-media == 2 ? @tr("Sticker size in chats") : @tr("Photo size in chats");
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                for s[i] in root.menu-size-step && !root.menu-picker ? [@tr("Small"), @tr("Medium"), @tr("Large")] : []: MenuRow {
                    text: s;
                    checked: i == (root.menu-media == 2 ? SettingsData.sticker-size : SettingsData.photo-size);
                    // the menu stays: the message changes beside it, and another size is a click away
                    clicked => {
                        if (root.menu-media == 2) {
                            SettingsData.sticker-size = i;
                        } else {
                            SettingsData.photo-size = i;
                        }
                        SettingsData.changed();
                    }
                }
                if root.menu-info != "" && root.menu-actions: MenuRow {
                    icon: Icons.info;
                    text: @tr("Info");
                    clicked => {
                        root.info-title = @tr("Message info");
                        root.info-text = root.menu-info;
                        root.menu-id = "";
                    }
                }
                if root.menu-can-delete && root.menu-actions: MenuRow {
                    icon: Icons.trash;
                    text: @tr("Delete for everyone");
                    danger: true;
                    clicked => {
                        root.delete-message(root.menu-id);
                        root.menu-id = "";
                    }
                }
            }
        }
    }

    // the pinned bar's menu, under its pin, right-aligned to it
    if root.pin-menu-open && root.pins.length > 0: Rectangle {
        property <int> idx: Math.min(root.pin-index, root.pins.length - 1);
        TouchArea {
            clicked => { root.pin-menu-open = false; }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.pin-menu-open = false;
                }
            }
        }
        Rectangle {
            property <length> w: 180px;
            width: w;
            height: pin-menu-col.preferred-height;
            x: max(8px, min(root.pin-menu-x - w, root.width - w - 8px));
            y: max(8px, min(root.pin-menu-y, root.height - self.height - 8px));
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            pin-menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                MenuRow {
                    text: @tr("Go to message");
                    clicked => {
                        root.pin-menu-open = false;
                        root.show-message(root.pins[idx].id);
                    }
                }
                MenuRow {
                    text: @tr("Unpin");
                    clicked => {
                        root.pin-menu-open = false;
                        root.unpin(root.pins[idx].id);
                    }
                }
            }
        }
    }

    if CalendarData.open: CalendarPopup {
        closed => {
            if (CalendarData.until) {
                search-edit.focus();
            } else {
                root.focus-composer();
            }
        }
    }
    if ThreadMenuData.key != "": ThreadMenu { }
    if ThreadMenuData.prefs-key != "": ThreadPrefsDialog { }

    if RepliesData.open: RepliesDialog { }
    if RequestData.tips-open: SafetyTipsDialog { }

    // message info (who received / read an outgoing message)
    if root.info-text != "": Rectangle {
        background: Theme.scrim;
        TouchArea {
            clicked => { root.info-text = ""; }
        }
        Rectangle {
            width: min(380px, parent.width - 40px);
            height: info-col.preferred-height;
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            info-col := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: root.info-title; font-weight: 700; font-size: 15px; color: Theme.text; }
                Text { text: root.info-text; wrap: word-wrap; color: Theme.text; font-size: 13px; }
                HorizontalLayout {
                    alignment: end;
                    PlainButton {
                        text: @tr("Close");
                        clicked => { root.info-text = ""; }
                    }
                }
            }
        }
    }

    // files being dragged over the conversation: where they would go
    if page == "main" && root.current-key != "" && root.drop-hover && !PackData.open: Rectangle {
        x: root.pane-x;
        y: 0px;
        width: root.width - root.pane-x;
        height: root.height;
        background: Theme.accent.with-alpha(0.14);
        border-width: 3px;
        border-color: Theme.accent;
        Text {
            text: @tr("Drop here to attach");
            color: Theme.accent;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // over the conversation pane, just above the composer (the window's bottom when there is none)
    if page == "main" && root.notice-text != "": Notice {
        text: root.notice-text;
        action: root.notice-action;
        action-clicked => { root.notice-action-clicked(); }
        max-text-width: root.width - root.pane-x - 76px;
        x: root.pane-x + (root.width - root.pane-x - self.width) / 2;
        // above everything that sits over the input (attachment, reply, link preview), not just the
        // input row: the list ends where those begin
        y: msg-list.absolute-position.y + msg-list.height - self.height - 10px;
    }

    // over everything, the sticker pack maker included
    if ConfirmData.open: ConfirmDialog {
        closed => {
            if (page == "main" && !root.settings-open && !PackData.open && root.current-key != "") {
                root.focus-composer();
            }
        }
    }
}
