// Small shared widgets.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";

// a short message over the content; clicks go through it. Fixed dark look: the image viewer uses it
// too, and globals aren't shared between windows.
// Indeterminate spinner. std-widgets' Spinner grows and shrinks its arc from a steadily turning
// start, so its head runs backwards half the time; here head and tail take turns moving ahead.
export component BusySpinner {
    in property <brush> stroke: Theme.accent;
    width: 36px;
    height: 36px;
    private property <duration> cycle: 1.4s;
    private property <float> phase: mod(animation-tick(), cycle) / cycle;
    // each cycle leaves the arc 0.75 turn further on, and the whole turns slowly besides
    private property <float> base: floor(animation-tick() / cycle) * 0.75 + animation-tick() / 3s;
    private property <float> h: clamp(phase * 2, 0, 1);
    private property <float> t: clamp(phase * 2 - 1, 0, 1);
    private property <float> head: 0.08 + 0.7 * h * h * (3 - 2 * h);
    private property <float> tail: 0.7 * t * t * (3 - 2 * t);
    private property <float> from: base + tail;
    private property <float> to: base + head;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.stroke;
        stroke-width: 3.5px;
        stroke-line-cap: round;
        MoveTo {
            x: 50 + 44 * sin(root.from * 360deg);
            y: 50 - 44 * cos(root.from * 360deg);
        }
        ArcTo {
            radius-x: 44;
            radius-y: 44;
            x: 50 + 44 * sin(root.to * 360deg);
            y: 50 - 44 * cos(root.to * 360deg);
            sweep: true;
            large-arc: root.to - root.from > 0.5;
        }
    }
}

export component Notice inherits Rectangle {
    in property <string> text;
    in property <length> max-text-width;
    // a button at the end ("" for none)
    in property <string> action;
    callback action-clicked();
    property <length> action-w: root.action != "" ? act-measure.preferred-width + 24px : 0px;
    act-measure := Text { visible: false; text: root.action; font-size: 13px; font-weight: 700; }
    width: min(label.preferred-width, root.max-text-width) + 28px + root.action-w;
    height: min(label.preferred-height, 40px) + 16px;
    border-radius: 8px;
    background: #303034;
    border-width: 1px;
    border-color: #ffffff20;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000050;
    label := Text {
        x: 14px;
        y: 8px;
        width: parent.width - 28px - root.action-w;
        height: parent.height - 16px;
        text: root.text;
        color: white;
        font-size: 13px;
        wrap: word-wrap;
        overflow: elide;
        horizontal-alignment: center;
    }
    if root.action != "": Rectangle {
        x: parent.width - root.action-w - 6px;
        y: 5px;
        width: root.action-w;
        height: parent.height - 10px;
        border-radius: 5px;
        background: act-area.has-hover ? #ffffff28 : #ffffff14;
        Text {
            text: root.action;
            color: #8ab4ff;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        act-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.action-clicked(); }
        }
    }
}

export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <length> size: 40px;
    // pre-cut round by the backend (avatar.rs) at the exact physical size
    in property <image> photo;
    in property <bool> has-photo;
    width: size;
    height: size;
    border-radius: size / 2;
    background: has-photo ? transparent : tint;
    Text {
        visible: !has-photo;
        text: initial;
        color: white;
        font-size: size * 0.42;
        font-weight: 700;
    }
    Image {
        visible: has-photo;
        width: size;
        height: size;
        source: photo;
        image-fit: fill;
    }
}

export component IconButton inherits Rectangle {
    // one of `Icons`
    in property <string> icon;
    in property <length> icon-size: 20px;
    in property <bool> enabled: true;
    // drawn in the accent (a panel it opens is showing)
    in property <bool> active;
    in property <color> hover-color: Theme.hover;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: ta.has-hover && enabled ? root.hover-color : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.icon-size;
        tint: !root.enabled ? Theme.border : root.active ? Theme.accent : Theme.subtle;
    }
}

// string edits the Slint language can't do (implemented in Rust)
export global TextOps {
    // `text` without the bytes between `a` and `b` (in either order)
    pure callback cut-out(string, int, int) -> string;
    // the text styles the selection between `a` and `b` already has, as `1 << style` bits
    pure callback selected-styles(string, int, int) -> int;
}

// The editable text of every input in the app (`Field`, the composer), so what Slint's
// TextInput does differently from other Windows apps is fixed in one place. When Slint fixes
// one, drop its handler here, not the component.
export component TextBox inherits TextInput {
    // composition started or changed; use this instead of `changed preedit-text`, which runs the
    // fix below
    callback preedit-changed();
    changed preedit-text => {
        // Slint deletes the selection only when the composition commits (not when it starts,
        // like other apps), so typing Hangul over selected text showed both until then.
        // Upstream fix: slint-ui/slint#14963
        if (self.preedit-text != "" && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
            let lo = min(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
            self.text = TextOps.cut-out(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
            self.set-selection-offsets(lo, lo);
            self.edited();
        }
        self.preedit-changed();
    }
}

// A row that scrolls sideways, with no scrollbar: a tile cut off at the edge shows there's more,
// and a bar would cover a strip this low. A Flickable that overflows only sideways rejects the
// wheel, so the event bubbles up to this TouchArea, which moves the row. Vertical overflow wants
// a scrollbar: use a ScrollView or ListView there, not a bare Flickable.
export component HStrip inherits TouchArea {
    in-out property <length> content-x <=> flick.content-x;
    in-out property <length> content-width <=> flick.content-width;
    scroll-event(e) => {
        flick.content-x = clamp(flick.content-x + (e.delta-y != 0px ? e.delta-y : e.delta-x),
            min(0px, flick.width - flick.content-width), 0px);
        accept
    }
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        @children
    }
}

// The app's scrollbar: a thin thumb over the right edge of a list whose own bar is off
// (`vertical-scrollbar-policy: always-off`), shown only while `active`. The stock bar is a 14px
// strip that fattens and gets a ground and arrows on hover, covering the rows it sits on. Size it
// as a 12px-wide strip along the list's right edge; it covers only the thumb's own height.
export component ThinThumb inherits Rectangle {
    in-out property <length> content-y;
    in property <length> content-height;
    in property <length> visible-height;
    in property <bool> active;
    property <length> max-y: max(0px, root.content-height - root.visible-height);
    property <length> thumb-h: root.content-height <= 0px ? 0px
        : min(root.visible-height, max(24px, root.visible-height * root.visible-height / root.content-height));
    property <length> saved-y;
    property <length> saved-pos;

    thumb := Rectangle {
        width: grab.has-hover || grab.pressed ? 6px : 3px;
        height: root.thumb-h;
        x: parent.width - self.width - 2px;
        y: root.max-y <= 0px ? 0px : (root.visible-height - self.height) * (-root.content-y / root.max-y);
        border-radius: self.width / 2;
        background: Theme.subtle;
        visible: root.max-y > 0px;
        opacity: root.active || grab.pressed ? 0.7 : 0;
        animate opacity { duration: 150ms; }
        animate width { duration: 100ms; easing: ease-out; }
    }
    grab := TouchArea {
        enabled: root.active || self.pressed;
        visible: root.max-y > 0px;
        x: 0px;
        y: thumb.y;
        width: parent.width;
        height: thumb.height;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.saved-y = -root.content-y;
                root.saved-pos = self.absolute-position.y + self.mouse-y;
            }
        }
        moved => {
            if (self.pressed && root.visible-height > root.thumb-h) {
                root.content-y = -clamp(root.saved-y + (self.absolute-position.y + self.mouse-y - root.saved-pos)
                    * root.max-y / (root.visible-height - root.thumb-h), 0px, root.max-y);
            }
        }
    }
}

// Wraps a ListView with the thumb above: it shows while the pointer is over the list.
export component ThinScroll inherits TouchArea {
    in-out property <length> content-y;
    in property <length> content-height;
    in property <length> visible-height;

    @children

    // keeps the thumb up while something drawn over the list has the pointer instead
    in property <bool> keep;

    ThinThumb {
        x: parent.width - 12px;
        width: 12px;
        height: parent.height;
        content-y <=> root.content-y;
        content-height: root.content-height;
        visible-height: root.visible-height;
        active: root.has-hover || root.keep;
    }
}

// one-line text field on a grey ground, no border; the accent ring while it has the focus
// a one-line text field (the search box with `icon: Icons.search`)
export component Field inherits Rectangle {
    in property <string> placeholder;
    // before the text (one of `Icons`)
    in property <string> icon;
    // room kept after the icon for what the caller puts there (its children, placed by it)
    in property <length> lead;
    in-out property <string> text;
    // what the IME is composing, not in `text` yet
    out property <string> preedit: input.preedit-text;
    out property <bool> focused: input.has-focus;
    callback edited();
    callback preedit-changed();
    callback accepted();
    callback key-pressed(KeyEvent) -> EventResult;
    forward-focus: input;
    public function blur() {
        input.clear-focus();
    }
    height: 34px;
    min-width: 80px;
    horizontal-stretch: 1;
    border-radius: 8px;
    // a long text scrolls inside instead of running past the edge
    clip: true;
    background: input.has-focus ? Theme.pane : Theme.field;
    border-width: input.has-focus ? 1.5px : 0px;
    border-color: Theme.accent;
    if root.icon != "": Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        size: 16px;
        icon: root.icon;
    }
    input := TextBox {
        x: (root.icon != "" ? 34px : 12px) + root.lead;
        width: parent.width - self.x - 10px;
        height: parent.height;
        single-line: true;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        edited => { root.edited(); }
        preedit-changed => { root.preedit-changed(); }
        accepted => { root.accepted(); }
        key-pressed(e) => { return root.key-pressed(e); }
    }
    if root.text == "" && input.preedit-text == "": Text {
        x: input.x;
        width: input.width;
        height: parent.height;
        text: root.placeholder;
        color: Theme.subtle;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }
    @children
}

export component MenuRow inherits Rectangle {
    in property <string> text;
    // before the text (one of `Icons`)
    in property <string> icon;
    in property <bool> danger;
    // the current one of a choice: a check at the end
    in property <bool> checked;
    callback clicked;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.checked: Icon {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        size: 16px;
        icon: Icons.check;
        tint: Theme.accent;
    }
    if root.icon != "": Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        size: 18px;
        icon: root.icon;
        tint: root.danger ? Theme.danger : Theme.text;
    }
    Text {
        x: root.icon != "" ? 38px : 10px;
        text: root.text;
        color: root.danger ? Theme.danger : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// red button for destructive actions (std Button can't be recolored)
export component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 32px;
    min-width: lbl.preferred-width + 32px;
    border-radius: 6px;
    // soft tint with red text
    background: Theme.dark
        ? (ta.pressed ? #4a2226 : (ta.has-hover ? #40201f : #331c1e))
        : (ta.pressed ? #ffd3d6 : (ta.has-hover ? #ffdfe1 : #ffe9ea));
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        text: root.text;
        color: Theme.danger;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// the main choice next to `DangerButton`s: filled with the accent
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 32px;
    min-width: lbl.preferred-width + 32px;
    border-radius: 6px;
    background: ta.pressed ? Theme.accent.darker(0.2) : (ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        text: root.text;
        color: white;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// on/off switch: std Switch takes the style's own blue in the dark theme, not the accent
export component Toggle inherits FocusScope {
    in-out property <bool> checked;
    callback toggled;
    width: 36px;
    height: 20px;
    // the keyboard reaches it with Tab; a click shouldn't leave a focus ring behind
    focus-on-click: false;
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.flip(); }
    function flip() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    key-pressed(e) => {
        if (e.text == " " || e.text == Key.Return) {
            root.flip();
            return accept;
        }
        reject
    }
    Rectangle {
        border-radius: 10px;
        opacity: root.enabled ? 1.0 : 0.4;
        background: root.checked ? Theme.accent : Theme.dark ? #48484e : #c9cad0;
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.text;
        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            y: 2px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: white;
            drop-shadow-blur: 2px;
            drop-shadow-color: Theme.shadow;
            animate x { duration: 120ms; easing: ease-out; }
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { root.flip(); }
        }
    }
}

// every other button with a label: grey like the input fields, the shape of `PrimaryButton`
export component PlainButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    min-width: lbl.preferred-width + 32px;
    border-radius: 6px;
    background: root.enabled && ta.has-hover ? Theme.field-off : Theme.field;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        text: root.text;
        color: root.enabled ? Theme.text : Theme.subtle;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    // before the text (one of `Icons`)
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    property <length> icon-w: root.icon != "" ? 20px : 0px;
    height: 28px;
    min-width: lbl.preferred-width + 20px + icon-w;
    max-width: 160px;
    border-radius: 14px;
    background: active ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.icon != "": Icon {
        x: 8px;
        y: (parent.height - self.height) / 2;
        size: 16px;
        icon: root.icon;
        tint: Theme.text;
    }
    lbl := Text {
        x: 10px + root.icon-w;
        width: parent.width - 20px - root.icon-w;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }
}

// one value of a list that may grow (languages), where `Segmented` would run out of room: the
// look of `PlainButton`, opening a menu card under it
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed(int);
    height: 32px;
    min-width: max(160px, lbl.preferred-width + 48px);
    border-radius: 6px;
    background: ta.has-hover ? Theme.field-off : Theme.field;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    lbl := Text {
        x: 12px;
        text: root.options[root.current];
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
    Icon {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        size: 16px;
        icon: Icons.chevron-down;
        tint: Theme.subtle;
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: drop-col.preferred-height;
        // the rows close it themselves: closing on any click dropped the row's click
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 12px;
            background: Theme.pane;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
            drop-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for o[i] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: i == root.current ? Theme.selected : (dta.has-hover ? Theme.hover : transparent);
                    dta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.current != i) {
                                root.current = i;
                                root.changed(i);
                            }
                            // last: closing ends the popup, and what came after it in this
                            // handler did nothing
                            popup.close();
                        }
                    }
                    Text {
                        x: 10px;
                        text: o;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: i == root.current ? 700 : 400;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// a row of mutually exclusive choices
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    callback changed(int);
    height: 30px;
    border-radius: 8px;
    background: Theme.hover;
    opacity: enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            min-width: seg-label.preferred-width + 20px;
            border-radius: 6px;
            background: i == root.current ? Theme.pane : (sta.has-hover && root.enabled ? Theme.selected : transparent);
            drop-shadow-blur: i == root.current ? 2px : 0px;
            drop-shadow-color: #00000030;
            sta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    if (root.current != i) {
                        root.current = i;
                        root.changed(i);
                    }
                }
            }
            seg-label := Text {
                text: o;
                color: Theme.text;
                font-size: 13px;
                font-weight: i == root.current ? 700 : 400;
            }
        }
    }
}
