// Small shared widgets.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";

// a short message over the content; clicks go through it. Fixed dark look: the image viewer uses it
// too, and globals aren't shared between windows.
// Indeterminate spinner. std-widgets' Spinner grows and shrinks its arc from a steadily turning
// start, so its head runs backwards half the time; here head and tail take turns moving ahead.
export component BusySpinner {
    in property <brush> stroke: Theme.accent;
    width: 36px;
    height: 36px;
    private property <duration> cycle: 1.4s;
    private property <float> phase: mod(animation-tick(), cycle) / cycle;
    // each cycle leaves the arc 0.75 turn further on, and the whole turns slowly besides
    private property <float> base: floor(animation-tick() / cycle) * 0.75 + animation-tick() / 3s;
    private property <float> h: clamp(phase * 2, 0, 1);
    private property <float> t: clamp(phase * 2 - 1, 0, 1);
    private property <float> head: 0.08 + 0.7 * h * h * (3 - 2 * h);
    private property <float> tail: 0.7 * t * t * (3 - 2 * t);
    private property <float> from: base + tail;
    private property <float> to: base + head;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.stroke;
        stroke-width: 3.5px;
        stroke-line-cap: round;
        MoveTo {
            x: 50 + 44 * sin(root.from * 360deg);
            y: 50 - 44 * cos(root.from * 360deg);
        }
        ArcTo {
            radius-x: 44;
            radius-y: 44;
            x: 50 + 44 * sin(root.to * 360deg);
            y: 50 - 44 * cos(root.to * 360deg);
            sweep: true;
            large-arc: root.to - root.from > 0.5;
        }
    }
}

export component Notice inherits Rectangle {
    in property <string> text;
    in property <length> max-text-width;
    // a button at the end ("" for none)
    in property <string> action;
    callback action-clicked();
    property <length> action-w: root.action != "" ? act-measure.preferred-width + 24px : 0px;
    act-measure := Text { visible: false; text: root.action; font-size: 13px; font-weight: 700; }
    width: min(label.preferred-width, root.max-text-width) + 28px + root.action-w;
    height: min(label.preferred-height, 40px) + 16px;
    border-radius: 8px;
    background: #303034;
    border-width: 1px;
    border-color: #ffffff20;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000050;
    label := Text {
        x: 14px;
        y: 8px;
        width: parent.width - 28px - root.action-w;
        height: parent.height - 16px;
        text: root.text;
        color: white;
        font-size: 13px;
        wrap: word-wrap;
        overflow: elide;
        horizontal-alignment: center;
    }
    if root.action != "": Rectangle {
        x: parent.width - root.action-w - 6px;
        y: 5px;
        width: root.action-w;
        height: parent.height - 10px;
        border-radius: 5px;
        background: act-area.has-hover ? #ffffff28 : #ffffff14;
        Text {
            text: root.action;
            color: #8ab4ff;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        act-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.action-clicked(); }
        }
    }
}

export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <length> size: 40px;
    // pre-cut round by the backend (avatar.rs) at the exact physical size
    in property <image> photo;
    in property <bool> has-photo;
    width: size;
    height: size;
    border-radius: size / 2;
    background: has-photo ? transparent : tint;
    Text {
        visible: !has-photo;
        text: initial;
        color: white;
        font-size: size * 0.42;
        font-weight: 700;
    }
    Image {
        visible: has-photo;
        width: size;
        height: size;
        source: photo;
        image-fit: fill;
    }
}

export component IconButton inherits Rectangle {
    // one of `Icons`
    in property <string> icon;
    in property <length> icon-size: 20px;
    in property <bool> enabled: true;
    // drawn in the accent (a panel it opens is showing)
    in property <bool> active;
    in property <color> hover-color: Theme.hover;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: ta.has-hover && enabled ? root.hover-color : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.icon-size;
        tint: !root.enabled ? Theme.border : root.active ? Theme.accent : Theme.subtle;
    }
}

// one-line text field on a grey ground, no border; the accent ring while it has the focus
// a one-line text field (the search box with `icon: Icons.search`)
export component Field inherits Rectangle {
    in property <string> placeholder;
    // before the text (one of `Icons`)
    in property <string> icon;
    in-out property <string> text;
    callback edited();
    callback accepted();
    callback key-pressed(KeyEvent) -> EventResult;
    forward-focus: input;
    height: 34px;
    min-width: 80px;
    horizontal-stretch: 1;
    border-radius: 8px;
    // a long text scrolls inside instead of running past the edge
    clip: true;
    background: input.has-focus ? Theme.pane : Theme.field;
    border-width: input.has-focus ? 1.5px : 0px;
    border-color: Theme.accent;
    if root.icon != "": Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        size: 16px;
        icon: root.icon;
    }
    input := TextInput {
        x: root.icon != "" ? 34px : 12px;
        width: parent.width - self.x - 10px;
        height: parent.height;
        single-line: true;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
        key-pressed(e) => { return root.key-pressed(e); }
    }
    if root.text == "" && input.preedit-text == "": Text {
        x: input.x;
        height: parent.height;
        text: root.placeholder;
        color: Theme.subtle;
        font-size: 13px;
        vertical-alignment: center;
    }
}

export component MenuRow inherits Rectangle {
    in property <string> text;
    // before the text (one of `Icons`)
    in property <string> icon;
    in property <bool> danger;
    callback clicked;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.icon != "": Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        size: 18px;
        icon: root.icon;
        tint: root.danger ? Theme.danger : Theme.text;
    }
    Text {
        x: root.icon != "" ? 38px : 10px;
        text: root.text;
        color: root.danger ? Theme.danger : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// red button for destructive actions (std Button can't be recolored)
export component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 32px;
    min-width: lbl.preferred-width + 32px;
    border-radius: 6px;
    // soft tint with red text
    background: Theme.dark
        ? (ta.pressed ? #4a2226 : (ta.has-hover ? #40201f : #331c1e))
        : (ta.pressed ? #ffd3d6 : (ta.has-hover ? #ffdfe1 : #ffe9ea));
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        text: root.text;
        color: Theme.danger;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// the main choice next to `DangerButton`s: filled with the accent
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 32px;
    min-width: lbl.preferred-width + 32px;
    border-radius: 6px;
    background: ta.pressed ? Theme.accent.darker(0.2) : (ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        text: root.text;
        color: white;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// on/off switch: std Switch takes the style's own blue in the dark theme, not the accent
export component Toggle inherits FocusScope {
    in-out property <bool> checked;
    callback toggled;
    width: 36px;
    height: 20px;
    // the keyboard reaches it with Tab; a click shouldn't leave a focus ring behind
    focus-on-click: false;
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.flip(); }
    function flip() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    key-pressed(e) => {
        if (e.text == " " || e.text == Key.Return) {
            root.flip();
            return accept;
        }
        reject
    }
    Rectangle {
        border-radius: 10px;
        opacity: root.enabled ? 1.0 : 0.4;
        background: root.checked ? Theme.accent : Theme.dark ? #48484e : #c9cad0;
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.text;
        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            y: 2px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: white;
            drop-shadow-blur: 2px;
            drop-shadow-color: Theme.shadow;
            animate x { duration: 120ms; easing: ease-out; }
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { root.flip(); }
        }
    }
}

// every other button with a label: grey like the input fields, the shape of `PrimaryButton`
export component PlainButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    min-width: lbl.preferred-width + 32px;
    border-radius: 6px;
    background: root.enabled && ta.has-hover ? Theme.field-off : Theme.field;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        text: root.text;
        color: root.enabled ? Theme.text : Theme.subtle;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    // before the text (one of `Icons`)
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    property <length> icon-w: root.icon != "" ? 20px : 0px;
    height: 28px;
    min-width: lbl.preferred-width + 20px + icon-w;
    max-width: 160px;
    border-radius: 14px;
    background: active ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.icon != "": Icon {
        x: 8px;
        y: (parent.height - self.height) / 2;
        size: 16px;
        icon: root.icon;
        tint: Theme.text;
    }
    lbl := Text {
        x: 10px + root.icon-w;
        width: parent.width - 20px - root.icon-w;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }
}

// a row of mutually exclusive choices
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    callback changed(int);
    height: 30px;
    border-radius: 8px;
    background: Theme.hover;
    opacity: enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            min-width: seg-label.preferred-width + 20px;
            border-radius: 6px;
            background: i == root.current ? Theme.pane : (sta.has-hover && root.enabled ? Theme.selected : transparent);
            drop-shadow-blur: i == root.current ? 2px : 0px;
            drop-shadow-color: #00000030;
            sta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    if (root.current != i) {
                        root.current = i;
                        root.changed(i);
                    }
                }
            }
            seg-label := Text {
                text: o;
                color: Theme.text;
                font-size: 13px;
                font-weight: i == root.current ? 700 : 400;
            }
        }
    }
}
