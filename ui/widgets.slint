// Small shared widgets.

import { Theme } from "theme.slint";

// a short message over the content; clicks go through it. Fixed dark look: the image viewer uses it
// too, and globals aren't shared between windows.
export component Notice inherits Rectangle {
    in property <string> text;
    in property <length> max-text-width;
    width: min(label.preferred-width, root.max-text-width) + 28px;
    height: min(label.preferred-height, 40px) + 16px;
    border-radius: 8px;
    background: #303034;
    border-width: 1px;
    border-color: #ffffff20;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000050;
    label := Text {
        x: 14px;
        y: 8px;
        width: parent.width - 28px;
        height: parent.height - 16px;
        text: root.text;
        color: white;
        font-size: 13px;
        wrap: word-wrap;
        overflow: elide;
        horizontal-alignment: center;
    }
}

export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <length> size: 40px;
    // pre-cut round by the backend (avatar.rs) at the exact physical size
    in property <image> photo;
    in property <bool> has-photo;
    width: size;
    height: size;
    border-radius: size / 2;
    background: has-photo ? transparent : tint;
    Text {
        visible: !has-photo;
        text: initial;
        color: white;
        font-size: size * 0.42;
        font-weight: 600;
    }
    Image {
        visible: has-photo;
        width: size;
        height: size;
        source: photo;
        image-fit: fill;
    }
}

export component IconButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: ta.has-hover && enabled ? Theme.hover : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: label;
        // the UI font (Malgun Gothic) lacks symbols like ✕ ➤, and the software renderer
        // does not fall back per glyph: use the symbol font for icons
        font-family: "Segoe UI Symbol";
        font-size: 18px;
        color: enabled ? Theme.subtle : Theme.border;
    }
}

// A peeling sticker: the sticker panel's icon, drawn as a vector so it doesn't depend
// on a font. Put it inside an `IconButton` with an empty label; it centers itself.
export component StickerIcon inherits Rectangle {
    in property <color> tint: Theme.subtle;
    Path {
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 22;
        viewbox-height: 22;
        // the sticker (a corner cut away) and the curled flap
        commands: "M 6 3 H 16 A 3 3 0 0 1 19 6 V 12 L 12 19 H 6 A 3 3 0 0 1 3 16 V 6 A 3 3 0 0 1 6 3 Z M 19 12 H 15 A 3 3 0 0 0 12 15 V 19";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: 10px;
        text: root.text;
        color: root.danger ? #e5484d : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// red button for destructive actions (std Button can't be recolored)
export component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 32px;
    min-width: lbl.preferred-width + 32px;
    border-radius: 6px;
    // soft tint with red text
    background: Theme.dark
        ? (ta.pressed ? #4a2226 : (ta.has-hover ? #40201f : #331c1e))
        : (ta.pressed ? #ffd3d6 : (ta.has-hover ? #ffdfe1 : #ffe9ea));
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        text: root.text;
        color: Theme.dark ? #ff6369 : #e5484d;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 28px;
    min-width: lbl.preferred-width + 20px;
    max-width: 160px;
    border-radius: 14px;
    background: active ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: Theme.text;
        font-size: 12.5px;
        overflow: elide;
        vertical-alignment: center;
    }
}

// a row of mutually exclusive choices
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    callback changed(int);
    height: 30px;
    border-radius: 8px;
    background: Theme.hover;
    opacity: enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            min-width: seg-label.preferred-width + 20px;
            border-radius: 6px;
            background: i == root.current ? Theme.pane : (sta.has-hover && root.enabled ? Theme.selected : transparent);
            drop-shadow-blur: i == root.current ? 2px : 0px;
            drop-shadow-color: #00000030;
            sta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    if (root.current != i) {
                        root.current = i;
                        root.changed(i);
                    }
                }
            }
            seg-label := Text {
                text: o;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: i == root.current ? 600 : 400;
            }
        }
    }
}
