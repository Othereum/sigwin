// "What's new" page: this version's release notes (over the conversation pane, like settings).

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NoteLine } from "types.slint";
import { IconButton } from "widgets.slint";

export component WhatsNewPage inherits Rectangle {
    in property <[NoteLine]> lines;
    callback close();
    background: Theme.pane;
    // swallow clicks so nothing underneath reacts
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 12px;
                Text {
                    text: "새로운 점";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    label: "✕";
                    clicked => { root.close(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // a ListView for its scrollbar. Rows have explicit heights from their wrapped text (a
        // layout would size a wrapping Text as one line and the content come out too short)
        ListView {
            vertical-stretch: 1;
            for line[i] in root.lines: Rectangle {
                property <length> top: (i == 0 ? 12px : 0px) + (line.kind == 0 ? 12px : line.kind == 3 && i > 0 ? 16px : 0px);
                property <length> bottom: i == root.lines.length - 1 ? 24px : 6px;
                height: top + txt.preferred-height + bottom;
                col := Rectangle {
                    width: min(560px, parent.width - 48px);
                    x: (parent.width - self.width) / 2;
                    if line.kind == 1: Text {
                        x: 0px;
                        y: top;
                        text: "•";
                        color: Theme.subtle;
                        font-size: 13.5px;
                    }
                    txt := Text {
                        x: line.kind == 1 ? 14px : 0px;
                        y: top;
                        width: parent.width - self.x;
                        text: line.text;
                        color: line.kind == 0 ? Theme.accent : Theme.text;
                        font-size: line.kind == 3 ? 16px : line.kind == 0 ? 12.5px : 13.5px;
                        font-weight: line.kind == 0 || line.kind == 3 ? 700 : 400;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
