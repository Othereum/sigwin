// The sidebar's search: threads, contacts and messages, the messages of one chat ("search in
// this chat"), or the contact list the ✎ button opens to start a conversation.

import { ThreadItem } from "types.slint";
import { Theme } from "theme.slint";
import { ThreadRow } from "thread_row.slint";
import { Icon, Icons } from "icons.slint";

export enum ResultKind { header, thread, contact, start, find, message, more, note }

// what the contact list's search box is for (its "Find by" rows pick one)
export enum FindKind { any, phone, username }

export struct ResultItem {
    kind: ResultKind,
    // a header's title; what a start row looks up; a find row's kind ("phone", "username");
    // a found message's id
    text: string,
    // a start row whose text is whole (a dim one can't be clicked yet)
    ready: bool,
    thread: ThreadItem,
}

export global SearchData {
    in-out property <string> query;
    // what the IME is composing at the end of `query`
    in-out property <string> preedit;
    // the contact list (✎) instead of the search over everything
    in-out property <bool> contacts;
    in-out property <FindKind> find;
    // "search in this chat": the thread whose messages alone are searched, and its name
    in-out property <string> scope-key;
    in-out property <string> scope-name;
    // the found message last opened, marked in the list
    in-out property <string> picked;
    in property <[ResultItem]> results;
    // the filters: who sent it ("c:<uuid>") and their name; up to which day (`until-day`, a local
    // day number, 0 none; Rust labels it `until-label`): only that end, since the results run
    // newest first; what (`kind`: 0 anything, 1 photos and videos, 2 files, 3 links); only those
    // that @mention us (`mentions`)
    in-out property <string> sender-key;
    in-out property <string> sender-name;
    in-out property <int> until-day;
    in-out property <string> until-label;
    in-out property <int> kind;
    in-out property <bool> mentions;
    out property <bool> filtered: sender-key != "" || until-day != 0 || kind != 0 || mentions;
    // the list is who sent messages, to pick the sender filter from: the box takes their name,
    // the search's own words wait in `held-query`
    in-out property <bool> picking;
    in-out property <string> held-query;
    // the list shows the results instead of the threads
    out property <bool> active: query != "" || preedit != "" || contacts || scope-key != "" || filtered || picking;
    // the query, the scope or a filter changed
    callback changed();
    // ↑ (-1) / ↓ (1) in the search box: open the found message before or after the one picked
    callback step(int);
    // the results list scrolls to show row `reveal-row`; `reveal-n` counts the requests, so the
    // same row can be asked again
    in property <int> reveal-row;
    in property <int> reveal-n;
    // Enter: the first row that opens something
    callback accept();
    // a start row: look up whom it names (its `text`) and open the conversation
    callback start(string);
    // a found message: open its chat (key) at it (id)
    callback show-found(string, string);
    // the next page of found messages
    callback more();

    public function search-in(key: string, name: string) {
        leave-contacts();
        if (picking) {
            picking = false;
            held-query = "";
        }
        scope-key = key;
        scope-name = name;
        query = "";
        changed();
    }

    public function leave-scope() {
        if (scope-key != "") {
            scope-key = "";
            scope-name = "";
            changed();
        }
    }

    public function leave-contacts() {
        if (contacts) {
            contacts = false;
            find = FindKind.any;
            query = "";
            changed();
        }
    }

    public function pick-sender() {
        if (!picking) {
            held-query = query;
            query = "";
            picking = true;
            changed();
        }
    }

    // out of picking, with `key` and `name` as the sender, or as it was ("")
    public function end-picking(key: string, name: string) {
        if (key != "") {
            sender-key = key;
            sender-name = name;
        }
        picking = false;
        query = held-query;
        held-query = "";
        changed();
    }

    public function clear-sender() {
        sender-key = "";
        sender-name = "";
        changed();
    }

    public function clear-until() {
        until-day = 0;
        changed();
    }

    public function set-kind(k: int) {
        kind = k;
        changed();
    }

    public function set-mentions(on: bool) {
        mentions = on;
        changed();
    }

    public function clear-filters() {
        sender-key = "";
        sender-name = "";
        until-day = 0;
        kind = 0;
        mentions = false;
        changed();
    }

    // Esc: picking a sender, what's typed, the filters, the chat searched in, the "Find by"
    // kind, the contact list
    public function back() {
        if (picking) {
            end-picking("", "");
        } else if (query != "") {
            query = "";
            changed();
        } else if (filtered) {
            clear-filters();
        } else if (scope-key != "") {
            leave-scope();
        } else if (find != FindKind.any) {
            find = FindKind.any;
            changed();
        } else {
            leave-contacts();
        }
    }

    // the ← button: out of a "Find by" kind, then out of the contact list
    public function step-back() {
        if (find != FindKind.any) {
            find = FindKind.any;
            query = "";
            changed();
        } else {
            leave-contacts();
        }
    }

    public function pick-find(kind: string) {
        find = kind == "username" ? FindKind.username : FindKind.phone;
        query = "";
        changed();
    }
}

// A filter of the search: grey with a chevron while it's off, its value on the selection color
// with a clear button once set. A menu it opens goes inside it (`@children`).
export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> set;
    // false: only its clear button does anything (the chat searched in)
    in property <bool> clickable: true;
    // false: an on/off chip, turned on by a click, with no menu to open
    in property <bool> menu: true;
    // one of `Icons`, before the label
    in property <string> icon;
    callback clicked();
    callback clear();
    property <length> label-w: min(lbl.preferred-width, 150px);
    property <length> label-x: icon != "" ? 30px : 12px;
    height: 28px;
    width: label-x + label-w + (set ? 28px : clickable && menu ? 26px : 12px);
    border-radius: 14px;
    property <color> fg: set ? Theme.link : Theme.text;
    background: set ? Theme.chip-on : ta.has-hover ? Theme.field-off : Theme.field;
    ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.icon != "": Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        size: 16px;
        icon: root.icon;
        tint: root.fg;
    }
    lbl := Text {
        x: root.label-x;
        width: root.label-w;
        text: root.text;
        color: root.fg;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }
    if !root.set && root.clickable && root.menu: Icon {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        size: 14px;
        icon: Icons.chevron-down;
        tint: Theme.subtle;
    }
    if root.set: Rectangle {
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: xta.has-hover ? Theme.notice-hover : transparent;
        xta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clear(); }
        }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: 12px;
            icon: Icons.close;
            tint: root.fg;
        }
    }
    @children
}

// a menu card hanging from a `FilterChip` (place it under the chip), its choices as `ChipMenuRow`s
export component ChipMenu inherits PopupWindow {
    width: 200px;
    height: col.preferred-height;
    // the rows close it themselves: closing on any click dropped the row's click
    close-policy: close-on-click-outside;
    Rectangle {
        border-radius: 12px;
        background: Theme.pane;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        col := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            @children
        }
    }
}

export component ChipMenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    callback clicked();
    height: 32px;
    border-radius: 6px;
    background: current ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: 10px;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        font-weight: root.current ? 700 : 400;
        vertical-alignment: center;
    }
}

export component ResultRow inherits Rectangle {
    in property <ResultItem> item;
    in property <bool> selected;
    callback clicked;
    callback menu(length, length);
    height: item.kind == ResultKind.header ? 30px : item.kind == ResultKind.find || item.kind == ResultKind.more ? 48px
        : item.kind == ResultKind.note ? max(40px, note-text.preferred-height + 16px) : 64px;
    opacity: item.kind == ResultKind.start && !item.ready ? 0.5 : 1;
    if item.kind == ResultKind.header: Text {
        x: 18px;
        y: 0;
        width: parent.width - 36px;
        height: parent.height;
        text: item.text;
        color: Theme.subtle;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }
    // an action, not someone: one line in the accent color beside a small round icon
    if item.kind == ResultKind.find: Rectangle {
        x: 8px;
        y: 1px;
        width: parent.width - 16px;
        height: parent.height - 2px;
        border-radius: 10px;
        background: find-ta.has-hover ? Theme.hover : transparent;
        find-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 12px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: find-ta.has-hover ? Theme.selected : Theme.hover;
                // the backend marks the kind with "@" (username) or "+" (phone number)
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 18px;
                    icon: root.item.thread.initial == "@" ? Icons.at : Icons.phone;
                    tint: Theme.text;
                }
            }
            Text {
                text: root.item.thread.name;
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    // dim, centered, wrapping: not something to click. Not in an `if`: the row's height reads it
    note-text := Text {
        visible: item.kind == ResultKind.note;
        x: 18px;
        width: parent.width - 36px;
        height: parent.height;
        text: item.kind == ResultKind.note ? item.text : "";
        color: Theme.subtle;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // the next page of found messages: one centered line in the accent color
    if item.kind == ResultKind.more: Rectangle {
        x: 8px;
        y: 1px;
        width: parent.width - 16px;
        height: parent.height - 2px;
        border-radius: 10px;
        background: more-ta.has-hover ? Theme.hover : transparent;
        more-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        Text {
            text: root.item.thread.name;
            color: Theme.accent;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if item.kind != ResultKind.header && item.kind != ResultKind.find && item.kind != ResultKind.more && item.kind != ResultKind.note: ThreadRow {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        item: root.item.thread;
        selected: root.selected;
        clicked => { root.clicked(); }
        menu(x, y) => { root.menu(x, y); }
    }
}
