// A message bubble and its parts.

import { MsgItem } from "types.slint";
import { Anim, Links, Theme } from "theme.slint";
import { Avatar } from "widgets.slint";

// time + delivery status of a message; clicking either shows who has it
export component MsgMeta inherits HorizontalLayout {
    in property <MsgItem> m;
    callback info(string);
    spacing: 4px;
    property <bool> bare: m.has-image && m.text == "" && m.quote == "" && m.attachment == "";
    Text {
        text: m.time;
        font-size: 10.5px;
        vertical-alignment: bottom;
        color: m.outgoing && !m.sticker && !m.big-emoji && !m.deleted && !root.bare ? #ffffffb0 : Theme.subtle;
        TouchArea {
            enabled: m.outgoing;
            mouse-cursor: m.outgoing ? pointer : default;
            clicked => { root.info(m.receipt-info); }
        }
    }
    if m.outgoing && m.status != "": Text {
        text: m.status;
        // ✓ is missing from the UI font; Hangul ("읽음") is missing from the symbol font
        font-family: m.status == "✓" || m.status == "✓✓" ? "Segoe UI Symbol" : "Malgun Gothic";
        font-size: 12px;
        vertical-alignment: bottom;
        color: m.sticker || m.big-emoji || root.bare ? Theme.subtle : #ffffffd0;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.info(m.receipt-info); }
        }
    }
}

export component MsgImage inherits Rectangle {
    in property <MsgItem> m;
    // flush: as wide as the bubble (which clips the corners), otherwise a fixed size
    in property <bool> flush;
    // the photo is the whole message: all four corners follow the bubble's
    in property <bool> whole;
    // the bubble's corner radii
    in property <length> r-tl: 18px;
    in property <length> r-tr: 18px;
    in property <length> r-bl: 18px;
    in property <length> r-br: 18px;
    callback attachment-clicked(string);
    callback menu(string, length, length);
    min-width: flush ? m.img-w : 0px;
    preferred-width: m.img-w;
    max-width: flush ? 100000px : m.img-w;
    height: m.img-h;
    // flush: only the top corners follow the bubble (the bubble itself must not clip: reader photos hang over its edge)
    border-top-left-radius: flush || whole ? r-tl : 8px;
    border-top-right-radius: flush || whole ? r-tr : 8px;
    border-bottom-left-radius: whole ? r-bl : flush ? 0px : 8px;
    border-bottom-right-radius: whole ? r-br : flush ? 0px : 8px;
    clip: true;
    // tell the Rust side a sticker is on screen: when the row is created, when a reused row gets
    // another message, when the still image arrives. Not on frame changes (an evicted sticker
    // must not ask for its frames again right away).
    property <string> sticker-id: m.sticker ? m.id : "";
    property <image> still: m.image;
    init => {
        if m.sticker { Anim.shown(m.id); }
    }
    changed sticker-id => {
        if m.sticker { Anim.shown(m.id); }
    }
    changed still => {
        if m.sticker { Anim.shown(m.id); }
    }
    Image {
        width: 100%;
        height: 100%;
        source: m.frames.length > 0 ? m.frames[m.frame[0]] : m.image;
        image-fit: m.sticker ? contain : cover;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.attachment-clicked(m.id); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// hover toolbar beside a bubble: reply, more (the menu has the reactions)
export component MsgTools inherits Rectangle {
    in property <bool> shown;
    out property <bool> hovered: ta-reply.has-hover || ta-more.has-hover || gap.has-hover;
    callback reply();
    callback more(length, length);
    width: 2 * 28px + 8px;
    height: 28px;
    opacity: shown || hovered ? 1.0 : 0.0;
    // 4px transparent gap next to the bubble keeps the hover from dropping while crossing to the buttons
    gap := TouchArea { }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        for icon[i] in ["↩", "⋯"]: Rectangle {
            width: 28px;
            border-radius: 14px;
            background: (i == 0 ? ta-reply.has-hover : ta-more.has-hover) ? Theme.hover : transparent;
            Text {
                text: icon;
                font-family: "Segoe UI Symbol";
                font-size: 16px;
                color: Theme.subtle;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    ta-reply := TouchArea {
        x: 4px;
        width: 28px;
        mouse-cursor: pointer;
        clicked => { root.reply(); }
    }
    ta-more := TouchArea {
        x: 32px;
        width: 28px;
        mouse-cursor: pointer;
        clicked => { root.more(self.absolute-position.x, self.absolute-position.y); }
    }
}

export component Bubble inherits VerticalLayout {
    in property <MsgItem> m;
    in property <length> max-w;
    // briefly outlined after jumping to it (pinned message bar)
    in property <bool> flash;
    callback attachment-clicked(string);
    // the quote in a reply: the quoted message's sent timestamp
    callback quote-clicked(string);
    callback reply(string);
    callback show-info(string);
    // right click: message menu at (x, y) in window coordinates
    callback menu(string, length, length);
    padding-left: 16px;
    padding-right: 16px;
    // Signal's spacing: 6px above and below a run, 1px between rows of one run
    padding-top: m.day-sep != "" || m.typing ? 8px : m.collapse-above ? 1px : 6px;
    // the newest row gets extra room below so it doesn't touch the composer
    in property <bool> last;
    padding-bottom: (m.typing ? 8px : (m.outgoing && m.readers.length > 0 ? (no-bubble ? 22px : 12px) : m.collapse-below ? 1px : 6px)) + (last ? 10px : 0px);
    // bubble corners: 18px, 4px on the side that joins a neighbour of the same run
    out property <length> r-tl: !m.outgoing && m.collapse-above ? 4px : 18px;
    out property <length> r-tr: m.outgoing && m.collapse-above ? 4px : 18px;
    out property <length> r-bl: !m.outgoing && m.collapse-below ? 4px : 18px;
    out property <length> r-br: m.outgoing && m.collapse-below ? 4px : 18px;
    spacing: 4px;
    opacity: m.pending ? 0.6 : 1.0;
    // plain text: the time sits at the right of the last line instead of below
    property <bool> inline-time: m.text != "" && !m.big-emoji && !m.sticker;
    // a photo alone: no bubble around it, the picture itself is the message
    property <bool> bare: m.has-image && m.text == "" && m.quote == "" && m.attachment == "";
    // photo with text: the photo sits flush on top of the bubble, the text below it
    property <bool> flush: m.has-image && !m.sticker && m.text != "" && m.quote == "";
    property <bool> no-bubble: m.sticker || m.big-emoji || bare;
    // height of the day separator above the message itself (centering a jump on the bubble)
    out property <length> lead: m.day-sep != "" ? root.padding-top + 36px + root.spacing : 0px;

    if m.day-sep != "": HorizontalLayout {
        alignment: center;
        height: 36px;
        padding-top: 6px;
        padding-bottom: 6px;
        Rectangle {
            border-radius: 10px;
            background: Theme.hover;
            HorizontalLayout {
                padding: 4px;
                padding-left: 10px;
                padding-right: 10px;
                Text { text: m.day-sep; color: Theme.subtle; font-size: 11.5px; }
            }
        }
    }

    if m.system: HorizontalLayout {
        alignment: center;
        Text {
            text: m.text;
            color: Theme.subtle;
            font-size: 12px;
            font-italic: true;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    // typing bubble: three dots lighting up in turn
    if m.typing: HorizontalLayout {
        alignment: start;
        spacing: 8px;
        if m.avatar-col: Avatar {
            size: 28px;
            initial: m.initial;
            tint: m.sender-color;
            photo: m.avatar;
            has-photo: m.has-avatar;
        }
        dots := Rectangle {
            border-radius: 14px;
            background: Theme.bubble-in;
            property <int> phase;
            Timer {
                interval: 350ms;
                triggered => { dots.phase = Math.mod(dots.phase + 1, 4); }
            }
            HorizontalLayout {
                padding: 11px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 5px;
                alignment: center;
                for i in 3: Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.subtle;
                    opacity: dots.phase == i ? 1.0 : 0.4;
                }
            }
        }
    }

    if !m.system && !m.typing: HorizontalLayout {
        alignment: m.outgoing ? end : start;
        spacing: 8px;
        if m.avatar-col: Rectangle {
            width: 28px;
            if m.show-avatar: Avatar {
                y: parent.height - self.height;
                size: 28px;
                initial: m.initial;
                tint: m.sender-color;
                photo: m.avatar;
                has-photo: m.has-avatar;
            }
        }
        Rectangle {
            max-width: root.flush ? max(m.img-w, 200px) : root.max-w;
            border-top-left-radius: root.r-tl;
            border-top-right-radius: root.r-tr;
            border-bottom-left-radius: root.r-bl;
            border-bottom-right-radius: root.r-br;
            background: m.deleted || m.sticker || m.big-emoji || root.bare ? transparent : (m.outgoing ? Theme.bubble-out : Theme.bubble-in);
            border-width: root.flash ? 3px : m.deleted ? 1px : 0px;
            border-color: root.flash ? #f5b400 : Theme.border;
            if !m.pending && !m.deleted: tools := MsgTools {
                x: m.outgoing ? -self.width : parent.width;
                y: (parent.height - self.height) / 2;
                shown: bta.has-hover;
                reply => { root.reply(m.id); }
                more(x, y) => { root.menu(m.id, x, y + 28px); }
            }
            // TouchArea is the parent of the content (not a sibling below it): it sees hover even over
            // the TextInput, and still takes the clicks the content ignores. It forwards the layout's size.
            bta := TouchArea {
                min-width: content.min-width;
                max-width: content.max-width;
                preferred-width: content.preferred-width;
                min-height: content.min-height;
                max-height: content.max-height;
                preferred-height: content.preferred-height;
                double-clicked => { root.reply(m.id); }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                        root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            content := VerticalLayout {
                spacing: 0px;
                if root.flush: MsgImage {
                    m: m;
                    flush: true;
                    r-tl: root.r-tl;
                    r-tr: root.r-tr;
                    attachment-clicked(id) => { root.attachment-clicked(id); }
                    menu(id, x, y) => { root.menu(id, x, y); }
                }
            VerticalLayout {
                padding: root.bare ? 0px : 9px;
                padding-top: root.bare ? 0px : root.flush ? 7px : 9px;
                padding-left: root.bare ? 0px : 12px;
                padding-right: root.bare ? 0px : 12px;
                spacing: 4px;
                if m.show-sender && !m.outgoing: Text {
                    text: m.sender;
                    color: m.sender-color;
                    font-size: 12px;
                    font-weight: 700;
                }
                if m.quote != "": Rectangle {
                    border-radius: 6px;
                    background: m.outgoing ? (qta.has-hover ? #ffffff48 : #ffffff30) : Theme.dark ? (qta.has-hover ? #ffffff22 : #ffffff14) : (qta.has-hover ? #0000001c : #00000010);
                    qta := TouchArea {
                        enabled: m.quote-id != "";
                        mouse-cursor: self.enabled ? pointer : default;
                        clicked => { root.quote-clicked(m.quote-id); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        Rectangle { width: 3px; background: m.outgoing ? white : Theme.accent; }
                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;
                            if m.quote-author != "": Text {
                                text: m.quote-author;
                                color: m.outgoing ? white : Theme.text;
                                font-size: 12px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: m.quote;
                                color: m.outgoing ? #ffffffd0 : Theme.subtle;
                                font-size: 12px;
                                wrap: word-wrap;
                                overflow: elide;
                                max-height: 48px;
                            }
                        }
                    }
                }
                if m.has-image && !root.flush: MsgImage {
                    m: m;
                    // a photo alone is the message: it takes the bubble's corners (stickers stay as they are)
                    whole: root.bare && !m.sticker;
                    r-tl: root.r-tl;
                    r-tr: root.r-tr;
                    r-bl: root.r-bl;
                    r-br: root.r-br;
                    attachment-clicked(id) => { root.attachment-clicked(id); }
                    menu(id, x, y) => { root.menu(id, x, y); }
                }
                if m.attachment != "": Rectangle {
                    border-radius: 6px;
                    background: ata.has-hover ? (m.outgoing ? #ffffff30 : Theme.hover) : transparent;
                    ata := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.attachment-clicked(m.id); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        padding: 2px;
                        Text { text: "📎"; font-size: 14px; }
                        Text {
                            text: m.attachment;
                            color: m.outgoing ? white : Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                // With @mentions or links the visible glyphs come from a StyledText on top (same font
                // and size, only colors and underlines differ, so it lays out like the TextInput) and
                // the TextInput under it is transparent, keeping selection. The StyledText takes only
                // events over a link (patched i-slint-core); the rest falls through to the TextInput,
                // and right clicks, which a read-only TextInput ignores, on to the bubble's TouchArea.
                if m.text != "": HorizontalLayout {
                    spacing: 8px;
                    if m.text != "": Rectangle {
                        horizontal-stretch: 1;
                        // trailing NBSPs stand in for the time: if they push the text onto another line,
                        // the time doesn't fit beside the last line and gets a row of its own
                        // (the time itself floats at the bottom right; `mm` measures its real width)
                        property <bool> with-time: root.inline-time && !m.hide-time;
                        property <string> pad: !with-time ? "" : mm.preferred-width <= 52px ? "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}" : mm.preferred-width <= 82px ? "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}" : mm.preferred-width <= 112px ? "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}" : "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}";
                        // fixed (the widest the text can get), so measuring doesn't loop with the layout
                        property <length> probe-w: (root.flush ? max(m.img-w, 200px) : root.max-w) - 24px;
                        property <bool> wraps: with-time && probe-pad.preferred-height > probe.preferred-height;
                        preferred-width: with-time ? probe.preferred-width + mm.preferred-width + 6px : probe.preferred-width;
                        mm := MsgMeta { visible: false; m: m; }
                        min-height: tl.min-height;
                        preferred-height: tl.preferred-height;
                        max-height: tl.max-height;
                        probe := Text {
                            visible: false;
                            width: probe-w;
                            text: m.text;
                            wrap: word-wrap;
                            font-size: 14px;
                        }
                        probe-pad := Text {
                            visible: false;
                            width: probe-w;
                            text: m.text + parent.pad;
                            wrap: word-wrap;
                            font-size: 14px;
                        }
                        tl := VerticalLayout {
                            TextInput {
                                text: m.text;
                                read-only: true;
                                single-line: false;
                                text-cursor-width: 0px; // selectable, but no blinking caret
                                wrap: word-wrap;
                                color: m.has-rich ? transparent : m.deleted ? Theme.subtle : (m.outgoing && !m.sticker && !m.big-emoji && !m.deleted ? white : Theme.text);
                                font-italic: m.deleted;
                                // emoji-only messages are shown large (color comes from the patched renderer)
                                font-size: m.big-emoji ? 40px : 14px;
                                selection-background-color: m.outgoing ? #ffffff60 : #2c6bed60;
                                selection-foreground-color: m.has-rich ? transparent : m.outgoing ? white : Theme.text;
                            }
                            if wraps: Rectangle { height: 14px; }
                        }
                        if m.has-rich: StyledText {
                            width: parent.width;
                            height: parent.height;
                            text: m.rich;
                            default-color: m.outgoing && !m.sticker ? white : Theme.text;
                            default-font-size: 14px;
                            link-color: m.outgoing ? white : Theme.dark ? #7aa7ff : #1f5fd6;
                            link-clicked(url) => { Links.open(url); }
                        }
                        if with-time: MsgMeta {
                            x: parent.width - self.width;
                            y: parent.height - self.height;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            m: m;
                            info(t) => { root.show-info(t); }
                        }
                    }
                }
                if m.more: HorizontalLayout {
                    alignment: start;
                    Text {
                        text: "더 읽기";
                        font-size: 13px;
                        font-weight: 700;
                        color: m.outgoing ? white : Theme.dark ? #7aa7ff : #1f5fd6;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Links.open("sigwin-more:" + m.id); }
                        }
                    }
                }
                if (!m.hide-time && !root.inline-time) || m.reactions.length > 0: HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    if m.reactions.length > 0: HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        for r in m.reactions: HorizontalLayout {
                            spacing: 1px;
                            Text {
                                text: r.emoji;
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            if r.count > 1: Text {
                                text: r.count;
                                font-size: 11px;
                                color: m.outgoing && !m.sticker && !m.big-emoji && !m.deleted ? white : Theme.text;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if !m.hide-time && !root.inline-time: MsgMeta {
                        m: m;
                        info(t) => { root.show-info(t); }
                    }
                }
            }
            }
            }
            // who read it: overlapping round photos straddling the bubble's bottom edge (ringed in the
            // pane color), a "+N" circle for the rest; `Bubble.padding-bottom` makes room for the lower half
            if m.outgoing && m.readers.length > 0: Rectangle {
                x: parent.width - self.width - 8px;
                // no bubble (sticker, bare photo, big emoji): the time sits at the bottom edge, so go fully below it
                y: root.no-bubble ? parent.height + 2px : parent.height - 9px;
                width: 18px + (m.readers.length + (m.readers-more > 0 ? 1 : 0) - 1) * 11px;
                height: 18px;
                for r[i] in m.readers: Rectangle {
                    x: i * 11px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.pane;
                    Avatar {
                        x: 1px;
                        y: 1px;
                        size: 16px;
                        initial: r.initial;
                        tint: r.tint;
                        photo: r.photo;
                        has-photo: r.has-photo;
                    }
                }
                if m.readers-more > 0: Rectangle {
                    x: m.readers.length * 11px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.pane;
                    Rectangle {
                        x: 1px;
                        y: 1px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.hover;
                        Text {
                            text: "+" + m.readers-more;
                            font-size: 9px;
                            color: Theme.text;
                        }
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-info(m.receipt-info); }
                }
            }
        }
    }
}
