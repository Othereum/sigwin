// A message bubble and its parts.

import { MsgItem } from "types.slint";
import { Anim, Links, Theme } from "theme.slint";
import { Avatar } from "widgets.slint";
import { RepliesData } from "replies.slint";

// time + delivery status of a message; clicking either shows who has it
export component MsgMeta inherits HorizontalLayout {
    in property <MsgItem> m;
    callback info(string);
    spacing: 4px;
    property <bool> bare: m.has-image && m.text == "" && m.quote == "" && m.attachment == "";
    Text {
        text: m.time;
        font-size: 10.5px;
        vertical-alignment: bottom;
        color: m.outgoing && !m.sticker && !m.big-emoji && !m.deleted && !root.bare ? #ffffffb0 : Theme.subtle;
        TouchArea {
            enabled: m.outgoing;
            mouse-cursor: m.outgoing ? pointer : default;
            clicked => { root.info(m.receipt-info); }
        }
    }
    // failed: said in red below the bubble, red text wouldn't read on the blue bubble
    if m.outgoing && m.status != "" && !m.failed: Text {
        text: m.status;
        // ✓ is missing from the UI font; Hangul ("읽음") is missing from the symbol font
        font-family: m.status == "✓" || m.status == "✓✓" ? "Segoe UI Symbol" : "Malgun Gothic";
        font-size: 12px;
        vertical-alignment: bottom;
        color: m.sticker || m.big-emoji || root.bare ? Theme.subtle : #ffffffd0;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.info(m.receipt-info); }
        }
    }
}

// marks a picture as a video: what a click does to it
component VideoMark inherits Rectangle {
    in property <bool> undownloaded;
    in property <int> progress: -1;
    in property <image> ring;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: #00000090;
    if undownloaded && progress >= 0: Image {
        width: 100%;
        height: 100%;
        source: ring;
        image-fit: fill;
    }
    if !undownloaded: Text {
        // the triangle's weight sits left of its box
        x: 14px;
        y: 0px;
        height: 100%;
        text: "▶";
        font-family: "Segoe UI Symbol";
        font-size: 16px;
        color: white;
        vertical-alignment: center;
    }
    if undownloaded && progress < 0: Text {
        width: 100%;
        height: 100%;
        // "Download" of Segoe MDL2 Assets (Windows 10+): an arrow into a tray
        text: "\u{E896}";
        font-family: "Segoe MDL2 Assets";
        font-size: 18px;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // while it downloads, a click stops that
    if undownloaded && progress >= 0: Text {
        width: 100%;
        height: 100%;
        text: "✕";
        font-family: "Segoe UI Symbol";
        font-size: 14px;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// a video's length or a file's size, in a corner of its picture
component MediaLabel inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 10px;
    height: label.preferred-height + 2px;
    border-radius: 4px;
    background: #00000090;
    label := Text {
        text: root.text;
        font-size: 11px;
        color: white;
    }
}

export component MsgImage inherits Rectangle {
    in property <MsgItem> m;
    // flush: as wide as the bubble (which clips the corners), otherwise a fixed size
    in property <bool> flush;
    // the photo is the whole message: all four corners follow the bubble's
    in property <bool> whole;
    // the bubble's corner radii
    in property <length> r-tl: 18px;
    in property <length> r-tr: 18px;
    in property <length> r-bl: 18px;
    in property <length> r-br: 18px;
    callback attachment-clicked(string, int);
    callback menu(string, length, length);
    min-width: flush ? m.img-w : 0px;
    preferred-width: m.img-w;
    max-width: flush ? 100000px : m.img-w;
    height: m.img-h;
    // flush: only the top corners follow the bubble (the bubble itself must not clip: reader photos hang over its edge)
    border-top-left-radius: flush || whole ? r-tl : 8px;
    border-top-right-radius: flush || whole ? r-tr : 8px;
    border-bottom-left-radius: whole ? r-bl : flush ? 0px : 8px;
    border-bottom-right-radius: whole ? r-br : flush ? 0px : 8px;
    clip: true;
    // tell the Rust side a sticker is on screen: when the row is created, when a reused row gets
    // another message, when the still image arrives. Not on frame changes (an evicted sticker
    // must not ask for its frames again right away).
    property <string> sticker-id: m.sticker ? m.id : "";
    property <image> still: m.image;
    init => {
        if m.sticker { Anim.shown(m.id); }
    }
    changed sticker-id => {
        if m.sticker { Anim.shown(m.id); }
    }
    changed still => {
        if m.sticker { Anim.shown(m.id); }
    }
    if m.cells.length == 0: Image {
        width: 100%;
        height: 100%;
        source: m.frames.length > 0 ? m.frames[m.frame[0]] : m.image;
        image-fit: m.sticker ? contain : cover;
    }
    if m.video: Rectangle {
        // until the picture arrives, or if there is none
        background: #80808030;
        z: -1;
    }
    if m.video: VideoMark { undownloaded: m.undownloaded; progress: m.progress; ring: m.ring; }
    if m.media-label != "": MediaLabel {
        text: m.media-label;
        x: 6px;
        y: parent.height - self.height - 6px;
    }
    if m.gif && m.frames.length == 0 && m.media-label == "": MediaLabel {
        text: "GIF";
        x: 6px;
        y: parent.height - self.height - 6px;
    }
    if m.cells.length == 0: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.attachment-clicked(m.id, 0); }
        // the row id with it: a reused row instance keeps the hover while its message changes
        property <string> gif-id: m.gif && self.has-hover ? m.id : "";
        changed gif-id => { Anim.gif-hover(self.gif-id == "" ? m.id : self.gif-id, self.gif-id != ""); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    for cell[i] in m.cells: Rectangle {
        x: cell.x;
        y: cell.y;
        width: cell.w;
        height: cell.h;
        // until the image arrives
        background: #80808030;
        Image {
            width: 100%;
            height: 100%;
            source: cell.image;
            // already resampled to this size
            image-fit: fill;
        }
        if cell.video && cell.more == 0: VideoMark { undownloaded: cell.undownloaded; progress: cell.progress; ring: cell.ring; }
        if cell.label != "" && cell.more == 0: MediaLabel {
            text: cell.label;
            x: 6px;
            y: parent.height - self.height - 6px;
        }
        if cell.more > 0: Rectangle {
            background: #00000080;
            Text {
                text: "+" + cell.more;
                color: white;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.attachment-clicked(m.id, i); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

// a link's preview: a wide image on top, a small one beside the text; clicking opens the link
component LinkPreview inherits Rectangle {
    in property <MsgItem> m;
    callback menu(string, length, length);
    property <bool> wide: m.link-img-w > 100px;
    property <bool> small: m.link-img-w > 0px && !wide;
    preferred-width: 300px;
    // a wide image is pre-resampled to exactly this width; stretching it would be nearest-neighbor
    max-width: wide ? m.link-img-w : 100000px;
    border-radius: 8px;
    clip: true;
    background: m.outgoing ? (ta.has-hover ? #ffffff48 : #ffffff30) : Theme.dark ? (ta.has-hover ? #ffffff22 : #ffffff14) : (ta.has-hover ? #0000001c : #00000010);
    VerticalLayout {
        if wide: Rectangle {
            height: m.link-img-h;
            background: #80808030;
            Image {
                width: 100%;
                height: 100%;
                source: m.link-image;
                image-fit: cover;
            }
        }
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            if small: Rectangle {
                width: m.link-img-w;
                height: m.link-img-h;
                border-radius: 6px;
                clip: true;
                background: #80808030;
                Image {
                    width: 100%;
                    height: 100%;
                    source: m.link-image;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                if m.link-title != "": Text {
                    text: m.link-title;
                    color: m.outgoing ? white : Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    wrap: word-wrap;
                    overflow: elide;
                    height: min(self.preferred-height, 36px);
                }
                if m.link-desc != "": Text {
                    text: m.link-desc;
                    color: m.outgoing ? #ffffffd0 : Theme.subtle;
                    font-size: 12px;
                    wrap: word-wrap;
                    overflow: elide;
                    height: min(self.preferred-height, 34px);
                }
                Text {
                    text: m.link-domain;
                    color: m.outgoing ? #ffffffb0 : Theme.subtle;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Links.open(m.link-url); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> font: "Segoe UI Symbol";
    in property <length> size: 16px;
    out property <bool> hovered: ta.has-hover;
    callback clicked(length, length);
    width: 28px;
    border-radius: 14px;
    background: ta.has-hover ? Theme.hover : transparent;
    Text {
        text: root.icon;
        font-family: root.font;
        font-size: root.size;
        color: Theme.subtle;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y); }
    }
}

// hover toolbar beside a bubble: reply, save (a message with pictures, videos or files), more (the menu has the reactions)
export component MsgTools inherits Rectangle {
    in property <bool> shown;
    in property <bool> can-save;
    out property <bool> hovered: b-reply.hovered || b-save.hovered || b-more.hovered || gap.has-hover;
    callback reply();
    callback save();
    callback more(length, length);
    width: (root.can-save ? 3 : 2) * 28px + 8px;
    height: 28px;
    opacity: shown || hovered ? 1.0 : 0.0;
    // 4px transparent gap next to the bubble keeps the hover from dropping while crossing to the buttons
    gap := TouchArea { }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        b-reply := ToolButton {
            icon: "↩";
            clicked(x, y) => { root.reply(); }
        }
        b-save := ToolButton {
            visible: root.can-save;
            width: root.can-save ? 28px : 0px;
            // the video's download glyph (Segoe MDL2 Assets)
            icon: "\u{E896}";
            font: "Segoe MDL2 Assets";
            size: 15px;
            clicked(x, y) => { root.save(); }
        }
        b-more := ToolButton {
            icon: "⋯";
            clicked(x, y) => { root.more(x, y); }
        }
    }
}

// the quoted message inside a reply bubble, and the reply preview above the composer
export component QuoteBox inherits Rectangle {
    in property <string> author;
    in property <string> text;
    in property <image> image;
    in property <bool> has-image;
    // inside one of our own bubbles (light-on-accent colors)
    in property <bool> outgoing;
    in property <bool> clickable;
    callback clicked();
    // right click, in window coordinates
    callback menu(length, length);
    border-radius: 6px;
    clip: true;
    background: outgoing ? (qta.has-hover ? #ffffff48 : #ffffff30) : Theme.dark ? (qta.has-hover ? #ffffff22 : #ffffff14) : (qta.has-hover ? #0000001c : #00000010);
    qta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        Rectangle { width: 3px; background: root.outgoing ? white : Theme.accent; }
        VerticalLayout {
            padding: 6px;
            spacing: 1px;
            // don't stretch the rows into the space a taller picture leaves
            alignment: start;
            if root.author != "": Text {
                text: root.author;
                color: root.outgoing ? white : Theme.text;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
            }
            // `max-height` on the Text alone doesn't cut it: the box is sized by the full text.
            // This frame is as tall as the text, up to 2 lines, and the Text elides within it.
            Rectangle {
                height: min(body.preferred-height, 36px);
                body := Text {
                    width: 100%;
                    height: 100%;
                    text: root.text;
                    color: root.outgoing ? #ffffffd0 : Theme.subtle;
                    font-size: 13px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }
        // in a layout, so the box grows to hold it
        // flush with the box's right edge (the box clips the corners)
        if root.has-image: Rectangle {
            width: 54px;
            height: 54px;
            background: #80808030;
            Image {
                width: 100%;
                height: 100%;
                source: root.image;
                image-fit: cover;
            }
        }
    }
}

export component Bubble inherits VerticalLayout {
    in property <MsgItem> m;
    in property <length> max-w;
    // briefly outlined after jumping to it (pinned message bar)
    in property <bool> flash;
    callback attachment-clicked(string, int);
    // the file line (a photo is `attachment-clicked`)
    callback file-clicked(string);
    // the hover toolbar's save: every picture, video and file of the message
    callback save-clicked(string);
    // the quote in a reply: the quoted message's sent timestamp
    callback quote-clicked(string);
    callback reply(string);
    // "오늘", "어제", "11월 7일 (토)": the day separator's text
    pure callback day-label(int) -> string;
    callback show-info(string);
    // click on a reaction chip: "emoji  names"
    callback show-reactors(string);
    // right click: message menu at (x, y) in window coordinates
    callback menu(string, length, length);
    padding-left: 16px;
    padding-right: 16px;
    // Signal's spacing: 6px above and below a run, 1px between rows of one run
    padding-top: m.day-sep || m.unread-divider || m.typing ? 8px : m.collapse-above ? 1px : 6px;
    // the newest row gets extra room below so it doesn't touch the composer
    in property <bool> last;
    // the chips and the readers hang below the bubble: room for the part under its edge
    padding-bottom: (m.typing ? 8px : (has-chips ? (under-time ? 10px : no-bubble && !photo-only ? 30px : 19px) : m.outgoing && m.readers.length > 0 ? (no-bubble ? 22px : 15px) : m.collapse-below ? 1px : 6px)) + (last ? 10px : 0px);
    // bubble corners: 18px, 4px on the side that joins a neighbour of the same run
    out property <length> r-tl: !m.outgoing && m.collapse-above ? 4px : 18px;
    out property <length> r-tr: m.outgoing && m.collapse-above ? 4px : 18px;
    out property <length> r-bl: !m.outgoing && m.collapse-below ? 4px : 18px;
    out property <length> r-br: m.outgoing && m.collapse-below ? 4px : 18px;
    spacing: 4px;
    opacity: m.pending && !m.failed ? 0.6 : 1.0;
    // reactions and the reply count hang below the bubble as chips
    property <bool> has-chips: m.reactions.length > 0 || m.replies > 0;
    // plain text: the time sits at the right of the last line instead of below
    property <bool> inline-time: m.text != "" && !m.big-emoji && !m.sticker;
    // a photo alone: no bubble around it, the picture itself is the message
    property <bool> bare: m.has-image && m.text == "" && m.quote == "" && m.attachment == "";
    // photo with text: the photo sits flush on top of the bubble, the text below it
    property <bool> flush: m.has-image && !m.sticker && m.text != "" && m.quote == "";
    property <bool> no-bubble: m.sticker || m.big-emoji || bare;
    property <bool> photo-only: bare && !m.sticker && !m.big-emoji;
    // a received bare photo: its time sits beside it, so the chips straddle the picture's bottom edge like a bubble's
    property <bool> side-time: photo-only && !m.outgoing && !m.hide-time;
    // a sent bare photo: the time row sits under the picture, so the chips straddle its edge, above that row
    property <bool> under-time: photo-only && m.outgoing && !m.hide-time;
    // height of the day separator above the message itself (centering a jump on the bubble)
    out property <length> lead: m.day-sep || m.unread-divider ? root.padding-top + (m.day-sep ? 36px + root.spacing : 0px) + (m.unread-divider ? 28px + root.spacing : 0px) : 0px;

    if m.day-sep: HorizontalLayout {
        alignment: center;
        height: 36px;
        padding-top: 6px;
        padding-bottom: 6px;
        Rectangle {
            border-radius: 10px;
            background: Theme.hover;
            HorizontalLayout {
                padding: 4px;
                padding-left: 10px;
                padding-right: 10px;
                Text { text: root.day-label(m.day); color: Theme.subtle; font-size: 11.5px; }
            }
        }
    }

    // where the unread messages start
    if m.unread-divider: HorizontalLayout {
        height: 28px;
        spacing: 10px;
        Rectangle {
            Rectangle { y: parent.height / 2; height: 1px; background: Theme.accent; opacity: 0.5; }
        }
        Text {
            text: "안 읽은 메시지";
            color: Theme.accent;
            font-size: 11.5px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle {
            Rectangle { y: parent.height / 2; height: 1px; background: Theme.accent; opacity: 0.5; }
        }
    }

    if m.system: HorizontalLayout {
        alignment: center;
        Text {
            text: m.text;
            color: Theme.subtle;
            font-size: 12px;
            font-italic: true;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    // typing bubble: three dots lighting up in turn
    if m.typing: HorizontalLayout {
        alignment: start;
        spacing: 8px;
        if m.avatar-col: Avatar {
            size: 28px;
            initial: m.initial;
            tint: m.sender-color;
            photo: m.avatar;
            has-photo: m.has-avatar;
        }
        dots := Rectangle {
            border-radius: 14px;
            background: Theme.bubble-in;
            property <int> phase;
            Timer {
                interval: 350ms;
                triggered => { dots.phase = Math.mod(dots.phase + 1, 4); }
            }
            HorizontalLayout {
                padding: 11px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 5px;
                alignment: center;
                for i in 3: Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.subtle;
                    opacity: dots.phase == i ? 1.0 : 0.4;
                }
            }
        }
    }

    if !m.system && !m.typing: HorizontalLayout {
        alignment: m.outgoing ? end : start;
        spacing: 8px;
        if m.avatar-col: Rectangle {
            width: 28px;
            if m.show-avatar: Avatar {
                y: parent.height - self.height;
                size: 28px;
                initial: m.initial;
                tint: m.sender-color;
                photo: m.avatar;
                has-photo: m.has-avatar;
            }
        }
        Rectangle {
            max-width: root.flush ? max(m.img-w, 200px) : root.max-w;
            // a short bubble is at least as wide as its chips
            min-width: has-chips ? chips.width + 16px : 0px;
            border-top-left-radius: root.r-tl;
            border-top-right-radius: root.r-tr;
            border-bottom-left-radius: root.r-bl;
            border-bottom-right-radius: root.r-br;
            background: m.deleted || m.sticker || m.big-emoji || root.bare ? transparent : (m.outgoing ? Theme.bubble-out : Theme.bubble-in);
            border-width: m.deleted ? 1px : 0px;
            border-color: Theme.border;
            if !m.pending && !m.deleted: tools := MsgTools {
                x: m.outgoing ? -self.width : parent.width;
                y: (parent.height - self.height) / 2;
                shown: bta.has-hover;
                can-save: !m.sticker && (m.has-image || m.attachment != "");
                save => { root.save-clicked(m.id); }
                reply => { root.reply(m.id); }
                more(x, y) => { root.menu(m.id, x, y + 28px); }
            }
            // TouchArea is the parent of the content (not a sibling below it): it sees hover even over
            // the TextInput, and still takes the clicks the content ignores. It forwards the layout's size.
            bta := TouchArea {
                min-width: content.min-width;
                max-width: content.max-width;
                preferred-width: content.preferred-width;
                min-height: content.min-height;
                max-height: content.max-height;
                preferred-height: content.preferred-height;
                double-clicked => { root.reply(m.id); }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                        root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            content := VerticalLayout {
                spacing: 0px;
                if root.flush: MsgImage {
                    m: m;
                    flush: true;
                    r-tl: root.r-tl;
                    r-tr: root.r-tr;
                    attachment-clicked(id, index) => { root.attachment-clicked(id, index); }
                    menu(id, x, y) => { root.menu(id, x, y); }
                }
            VerticalLayout {
                padding: root.bare ? 0px : 9px;
                padding-top: root.bare ? 0px : root.flush ? 7px : 9px;
                padding-left: root.bare ? 0px : 12px;
                padding-right: root.bare ? 0px : 12px;
                spacing: 4px;
                if m.show-sender && !m.outgoing: HorizontalLayout {
                    // a bare photo has no padding of its own: keep the name off the bubble's edge (and the flash border)
                    padding-left: root.bare ? 8px : 0px;
                    padding-top: root.bare ? 5px : 0px;
                    padding-bottom: root.bare ? 3px : 0px;
                    Text {
                        text: m.sender;
                        color: m.sender-color;
                        font-size: 12px;
                        font-weight: 700;
                    }
                }
                if m.quote != "": QuoteBox {
                    author: m.quote-author;
                    text: m.quote;
                    image: m.quote-image;
                    has-image: m.has-quote-image;
                    outgoing: m.outgoing;
                    clickable: m.quote-id != "";
                    clicked => { root.quote-clicked(m.quote-id); }
                    menu(x, y) => { root.menu(m.id, x, y); }
                }
                if m.has-image && !root.flush: MsgImage {
                    m: m;
                    // a photo alone is the message: it takes the bubble's corners (stickers stay as they are)
                    whole: root.bare && !m.sticker;
                    r-tl: root.r-tl;
                    r-tr: root.r-tr;
                    r-bl: root.r-bl;
                    r-br: root.r-br;
                    attachment-clicked(id, index) => { root.attachment-clicked(id, index); }
                    menu(id, x, y) => { root.menu(id, x, y); }
                }
                if m.attachment != "": Rectangle {
                    border-radius: 6px;
                    background: ata.has-hover ? (m.outgoing ? #ffffff30 : Theme.hover) : transparent;
                    ata := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.file-clicked(m.id); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                root.menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        padding: 4px;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            y: 0px;
                            border-radius: 6px;
                            background: m.file-danger ? #d97706 : m.outgoing ? #ffffff40 : Theme.accent;
                            Text {
                                text: m.file-ext != "" ? m.file-ext : "FILE";
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            max-width: 220px;
                            Text {
                                text: m.file-name;
                                color: m.outgoing ? white : Theme.text;
                                font-size: 14px;
                                overflow: elide;
                            }
                            if m.file-size != "" || m.file-danger: Text {
                                text: m.file-danger ? (m.file-size != "" ? m.file-size + " · " : "") + "위험할 수 있음" : m.file-size;
                                color: m.file-danger ? (m.outgoing ? #ffe2a8 : #f0a030) : m.outgoing ? #ffffffc0 : Theme.subtle;
                                font-size: 12px;
                            }
                        }
                    }
                }
                if m.link-url != "": LinkPreview {
                    m: m;
                    menu(id, x, y) => { root.menu(id, x, y); }
                }
                // With @mentions or links the visible glyphs come from a StyledText on top (same font
                // and size, only colors and underlines differ, so it lays out like the TextInput) and
                // the TextInput under it is transparent, keeping selection. The StyledText takes only
                // events over a link (patched i-slint-core); the rest falls through to the TextInput,
                // and right clicks, which a read-only TextInput ignores, on to the bubble's TouchArea.
                if m.text != "": HorizontalLayout {
                    spacing: 8px;
                    if m.text != "": Rectangle {
                        horizontal-stretch: 1;
                        // trailing NBSPs stand in for the time: if they push the text onto another line,
                        // the time doesn't fit beside the last line and gets a row of its own
                        // (the time itself floats at the bottom right; `mm` measures its real width)
                        property <bool> with-time: root.inline-time && !m.hide-time;
                        property <string> pad: !with-time ? "" : mm.preferred-width <= 52px ? "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}" : mm.preferred-width <= 82px ? "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}" : mm.preferred-width <= 112px ? "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}" : "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}";
                        // fixed (the widest the text can get), so measuring doesn't loop with the layout
                        property <length> probe-w: (root.flush ? max(m.img-w, 200px) : root.max-w) - 24px;
                        property <bool> wraps: with-time && probe-pad.preferred-height > probe.preferred-height;
                        preferred-width: with-time ? probe.preferred-width + mm.preferred-width + 6px : probe.preferred-width;
                        mm := MsgMeta { visible: false; m: m; }
                        min-height: tl.min-height;
                        preferred-height: tl.preferred-height;
                        max-height: tl.max-height;
                        probe := Text {
                            visible: false;
                            width: probe-w;
                            text: m.text;
                            wrap: word-wrap;
                            font-size: m.big-emoji ? 40px : 14px;
                        }
                        probe-pad := Text {
                            visible: false;
                            width: probe-w;
                            text: m.text + parent.pad;
                            wrap: word-wrap;
                            font-size: 14px;
                        }
                        tl := VerticalLayout {
                            TextInput {
                                text: m.text;
                                read-only: true;
                                single-line: false;
                                text-cursor-width: 0px; // selectable, but no blinking caret
                                wrap: word-wrap;
                                color: m.has-rich ? transparent : m.deleted ? Theme.subtle : (m.outgoing && !m.sticker && !m.big-emoji && !m.deleted ? white : Theme.text);
                                font-italic: m.deleted;
                                // emoji-only messages are shown large (color comes from the patched renderer)
                                font-size: m.big-emoji ? 40px : 14px;
                                selection-background-color: m.outgoing ? #ffffff60 : #2c6bed60;
                                selection-foreground-color: m.has-rich ? transparent : m.outgoing ? white : Theme.text;
                            }
                            if wraps: Rectangle { height: 14px; }
                        }
                        if m.has-rich: StyledText {
                            width: parent.width;
                            height: parent.height;
                            text: m.rich;
                            default-color: m.outgoing && !m.sticker ? white : Theme.text;
                            default-font-size: 14px;
                            link-color: m.outgoing ? white : Theme.dark ? #7aa7ff : #1f5fd6;
                            link-clicked(url) => { Links.open(url); }
                        }
                        if with-time: MsgMeta {
                            x: parent.width - self.width;
                            y: parent.height - self.height;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            m: m;
                            info(t) => { root.show-info(t); }
                        }
                    }
                }
                if m.more: HorizontalLayout {
                    alignment: start;
                    Text {
                        text: "더 읽기";
                        font-size: 13px;
                        font-weight: 700;
                        color: m.outgoing ? white : Theme.dark ? #7aa7ff : #1f5fd6;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Links.open("sigwin-more:" + m.id); }
                        }
                    }
                }
                if !m.hide-time && !root.inline-time && !root.side-time: HorizontalLayout {
                    alignment: end;
                    MsgMeta {
                        m: m;
                        info(t) => { root.show-info(t); }
                    }
                }
            }
            }
            }
            // jump flash: drawn over the content, since a photo would cover a border on the bubble itself
            if root.flash: Rectangle {
                border-top-left-radius: root.r-tl;
                border-top-right-radius: root.r-tr;
                border-bottom-left-radius: root.r-bl;
                border-bottom-right-radius: root.r-br;
                border-width: 3px;
                border-color: #f5b400;
            }
            // reactions: pill chips straddling the bubble's bottom edge, ringed in the pane color like the
            // readers; `Bubble.padding-bottom` makes room. Always present (hidden when empty) so the bubble
            // can take its width as a minimum. A click shows who reacted.
            chips := Rectangle {
                visible: has-chips;
                // received: right side; sent: left (the readers take the right)
                x: m.outgoing ? 8px : parent.width - self.width - 8px;
                y: root.under-time ? parent.height - 25px : root.no-bubble && !root.photo-only ? parent.height + 2px : parent.height - 8px;
                width: has-chips ? chip-row.preferred-width : 0px;
                height: has-chips ? chip-row.preferred-height : 0px;
                border-radius: 13px;
                background: Theme.pane;
                chip-row := HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for r in m.reactions: Rectangle {
                        border-radius: 11px;
                        border-width: r.mine ? 1.5px : 0px;
                        border-color: Theme.accent;
                        background: Theme.bubble-in;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: r.count > 1 ? 7px : 6px;
                            spacing: 3px;
                            // the emoji sits 1px lower than the count (centered in 2px of extra top padding)
                            VerticalLayout {
                                padding-top: 2px;
                                Text {
                                    text: r.emoji;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                            }
                            if r.count > 1: Text {
                                text: r.count;
                                font-size: 11px;
                                font-weight: r.mine ? 700 : 400;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-reactors(r.emoji + "  " + r.who); }
                        }
                    }
                    // how many replies it has; a click lists them
                    if m.replies > 0: Rectangle {
                        border-radius: 11px;
                        background: reply-ta.has-hover ? Theme.hover : Theme.bubble-in;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 3px;
                            Text {
                                text: "↩";
                                font-family: "Segoe UI Symbol";
                                font-size: 12px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                            Text {
                                text: m.replies;
                                font-size: 11px;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }
                        reply-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { RepliesData.request(m.id); }
                        }
                    }
                }
            }
            // who read it: overlapping round photos straddling the bubble's bottom edge (ringed in the
            // pane color), a "+N" circle for the rest; `Bubble.padding-bottom` makes room for the lower half
            if m.outgoing && m.readers.length > 0: Rectangle {
                x: parent.width - self.width - 8px;
                // no bubble (sticker, bare photo, big emoji): the time sits at the bottom edge, so go fully below it
                y: root.no-bubble ? parent.height + 2px : parent.height - 6px;
                width: 18px + (m.readers.length + (m.readers-more > 0 ? 1 : 0) - 1) * 11px;
                height: 18px;
                for r[i] in m.readers: Rectangle {
                    x: i * 11px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.pane;
                    Avatar {
                        x: 1px;
                        y: 1px;
                        size: 16px;
                        initial: r.initial;
                        tint: r.tint;
                        photo: r.photo;
                        has-photo: r.has-photo;
                    }
                }
                if m.readers-more > 0: Rectangle {
                    x: m.readers.length * 11px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.pane;
                    Rectangle {
                        x: 1px;
                        y: 1px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.hover;
                        Text {
                            text: "+" + m.readers-more;
                            font-size: 9px;
                            color: Theme.text;
                        }
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-info(m.receipt-info); }
                }
            }
        }
        // a bare photo's time: beside it at the bottom, on the side facing the pane's middle
        if root.side-time: VerticalLayout {
            alignment: end;
            MsgMeta {
                m: m;
                info(t) => { root.show-info(t); }
            }
        }
    }

    if m.failed: HorizontalLayout {
        alignment: end;
        spacing: 12px;
        Text {
            text: "전송 실패";
            font-size: 12px;
            font-weight: 700;
            color: Theme.dark ? #ff6b6b : #d32f2f;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.show-info(m.receipt-info); }
            }
        }
        Text {
            text: "다시 보내기";
            font-size: 12px;
            font-weight: 700;
            color: Theme.dark ? #7aa7ff : #1f5fd6;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Links.open("sigwin-retry:" + m.id); }
            }
        }
        Text {
            text: "삭제";
            font-size: 12px;
            color: Theme.subtle;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Links.open("sigwin-discard:" + m.id); }
            }
        }
    }
}
