// The app's icon set. Every icon is a path drawn here: font glyphs don't render when the font
// lacks them (no per-glyph fallback in the software renderer) and look different in every font.
//
// Paths are on a 24-unit grid and drawn as outlines; `Icon` keeps the stroke at 1.5px whatever
// the size, so small and large icons have the same line weight.

import { Theme } from "theme.slint";

export global Icons {
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
    out property <string> back: "M 19 12 H 5 M 11 6 L 5 12 L 11 18";
    out property <string> plus: "M 12 5 V 19 M 5 12 H 19";
    out property <string> settings: "M 10.32 5.72 L 10.32 3.36 A 8.8 8.8 0 0 1 13.68 3.36 L 13.68 5.72 A 6.5 6.5 0 0 1 15.25 6.37 L 16.92 4.7 A 8.8 8.8 0 0 1 19.3 7.08 L 17.63 8.75 A 6.5 6.5 0 0 1 18.28 10.32 L 20.64 10.32 A 8.8 8.8 0 0 1 20.64 13.68 L 18.28 13.68 A 6.5 6.5 0 0 1 17.63 15.25 L 19.3 16.92 A 8.8 8.8 0 0 1 16.92 19.3 L 15.25 17.63 A 6.5 6.5 0 0 1 13.68 18.28 L 13.68 20.64 A 8.8 8.8 0 0 1 10.32 20.64 L 10.32 18.28 A 6.5 6.5 0 0 1 8.75 17.63 L 7.08 19.3 A 8.8 8.8 0 0 1 4.7 16.92 L 6.37 15.25 A 6.5 6.5 0 0 1 5.72 13.68 L 3.36 13.68 A 8.8 8.8 0 0 1 3.36 10.32 L 5.72 10.32 A 6.5 6.5 0 0 1 6.37 8.75 L 4.7 7.08 A 8.8 8.8 0 0 1 7.08 4.7 L 8.75 6.37 A 6.5 6.5 0 0 1 10.32 5.72 Z M 14.75 12 A 2.75 2.75 0 1 1 9.25 12 A 2.75 2.75 0 1 1 14.75 12 Z";
    out property <string> chat: "M 8 5 H 16 A 4 4 0 0 1 20 9 V 12 A 4 4 0 0 1 16 16 H 10 L 5.5 19 L 6.5 15.2 A 4 4 0 0 1 4 12 V 9 A 4 4 0 0 1 8 5 Z";
    out property <string> compose: "M 11 4 H 6.5 A 2.5 2.5 0 0 0 4 6.5 V 17.5 A 2.5 2.5 0 0 0 6.5 20 H 17.5 A 2.5 2.5 0 0 0 20 17.5 V 13 M 17.5 3.5 L 20.5 6.5 L 12.5 14.5 H 9.5 V 11.5 Z";
    out property <string> edit: "M 16 4 L 20 8 L 9 19 H 5 V 15 Z M 13.5 6.5 L 17.5 10.5";
    out property <string> bell:"M 18 16 V 11 A 6 6 0 0 0 6 11 V 16 L 4.5 18 H 19.5 Z M 12 3 V 5 M 10 21 H 14";
    out property <string> bell-off: "M 18 13 V 11 A 6 6 0 0 0 9 5.8 M 6.6 8.4 A 6 6 0 0 0 6 11 V 16 L 4.5 18 H 16 M 12 3 V 5 M 10 21 H 14 M 4 4 L 20 20";
    out property <string> pin: "M 17.32 6.68 L 20.4 9.75 Q 21.25 10.6 20.04 10.69 L 17.33 10.9 Q 14.84 11.08 14.64 13.57 L 14.24 18.59 Q 14.12 20.09 13.06 19.03 L 4.97 10.94 Q 3.91 9.88 5.41 9.76 L 10.43 9.36 Q 12.92 9.16 13.1 6.67 L 13.31 3.96 Q 13.4 2.75 14.25 3.6 Z M 9.01 14.99 L 3.25 20.75";
    out property <string> attach: "M 18.36 11.29 L 10.59 19.07 A 4 4 0 0 1 4.93 13.41 L 14.47 3.87 A 3 3 0 0 1 18.72 8.11 L 9.88 16.95 A 2 2 0 0 1 7.05 14.12 L 13.41 7.76";
    out property <string> sticker: "M 7 4 H 17 A 3 3 0 0 1 20 7 V 13 L 13 20 H 7 A 3 3 0 0 1 4 17 V 7 A 3 3 0 0 1 7 4 Z M 20 13 H 16 A 3 3 0 0 0 13 16 V 20";
    out property <string> send: "M 4.5 4.5 L 20 12 L 4.5 19.5 L 7.5 12 Z M 7.5 12 H 12.5";
    out property <string> reply: "M 9 6 L 4 11 L 9 16 M 4 11 H 14 A 6 6 0 0 1 20 17 V 19";
    out property <string> react: "M 20.5 12 A 8.5 8.5 0 1 1 3.5 12 A 8.5 8.5 0 1 1 20.5 12 Z M 8.5 14 A 4 4 0 0 0 15.5 14 M 9 9.5 V 10 M 15 9.5 V 10";
    out property <string> download: "M 12 4 V 15 M 7 10 L 12 15 L 17 10 M 5 20 H 19";
    out property <string> open-outside: "M 13.5 4.5 H 19.5 V 10.5 M 19.5 4.5 L 11 13 M 17.5 14 V 18 A 1.5 1.5 0 0 1 16 19.5 H 6 A 1.5 1.5 0 0 1 4.5 18 V 8 A 1.5 1.5 0 0 1 6 6.5 H 10";
    out property <string> info: "M 20.5 12 A 8.5 8.5 0 1 1 3.5 12 A 8.5 8.5 0 1 1 20.5 12 Z M 12 11 V 16 M 12 8 V 8.2";
    out property <string> trash: "M 4.5 7 H 19.5 M 9.5 7 V 4.5 H 14.5 V 7 M 6.5 7 L 7.5 19.5 H 16.5 L 17.5 7 M 10 11 V 16 M 14 11 V 16";
    out property <string> file:"M 6 3.5 H 13.5 L 18.5 8.5 V 20.5 H 6 Z M 13.5 3.5 V 8.5 H 18.5";
    out property <string> search: "M 17.5 11 A 6.5 6.5 0 1 1 4.5 11 A 6.5 6.5 0 1 1 17.5 11 Z M 16 16 L 20 20";
    out property <string> video: "M 5 6.5 H 13 A 2 2 0 0 1 15 8.5 V 15.5 A 2 2 0 0 1 13 17.5 H 5 A 2 2 0 0 1 3 15.5 V 8.5 A 2 2 0 0 1 5 6.5 Z M 15 10.5 L 21 7.5 V 16.5 L 15 13.5";
    out property <string> chevron-down: "M 6 9 L 12 15 L 18 9";
    out property <string> chevron-left: "M 15 5 L 8 12 L 15 19";
    out property <string> chevron-right: "M 9 5 L 16 12 L 9 19";
    out property <string> check: "M 5 12.5 L 10 17.5 L 19 7";
    out property <string> check-double: "M 1.5 12.5 L 6 17 L 14.5 7.5 M 12 16 L 13 17 L 21.5 7.5";
    out property <string> phone: "M 8 3 H 16 A 2 2 0 0 1 18 5 V 19 A 2 2 0 0 1 16 21 H 8 A 2 2 0 0 1 6 19 V 5 A 2 2 0 0 1 8 3 Z M 11 18 H 13";
    out property <string> at: "M 15.5 12 A 3.5 3.5 0 1 1 8.5 12 A 3.5 3.5 0 1 1 15.5 12 Z M 15.5 9 V 13.5 A 2.5 2.5 0 0 0 20.5 13.5 V 12 A 8.5 8.5 0 1 0 17 18.8";
    // filled shapes: draw with `filled: true`
    out property <string> more: "M 4.5 12 A 1.5 1.5 0 1 0 7.5 12 A 1.5 1.5 0 1 0 4.5 12 Z M 10.5 12 A 1.5 1.5 0 1 0 13.5 12 A 1.5 1.5 0 1 0 10.5 12 Z M 16.5 12 A 1.5 1.5 0 1 0 19.5 12 A 1.5 1.5 0 1 0 16.5 12 Z";
    out property <string> play: "M 8.5 5.5 L 18.5 12 L 8.5 18.5 Z";
}

export component Icon inherits Path {
    // one of `Icons`
    in property <string> icon;
    in property <length> size: 20px;
    in property <color> tint: Theme.subtle;
    in property <bool> filled;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.icon;
    fill: root.filled ? root.tint : transparent;
    stroke: root.filled ? transparent : root.tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
}
