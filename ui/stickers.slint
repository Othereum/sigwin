// Sticker picker panel.

import { PackItem, PreviewItem, StickerItem } from "types.slint";
import { Anim, Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Field, HStrip, IconButton, MenuRow, PlainButton, PrimaryButton, Tip, TipPlace, ThinScroll } from "widgets.slint";
import { ChipMenu } from "search.slint";
import { Icon, Icons } from "icons.slint";
import { MediaLabel } from "bubble.slint";

export global StickerData {
    in property <[PackItem]> packs;
    // false until the pack list has arrived, so an empty list isn't shown as "no packs"
    in property <bool> packs-loaded;
    in property <[StickerItem]> stickers;
    // the open pack's id, "recent" for the recently used tab (`types::RECENT_TAB`), or "+" for
    // the pack page
    in-out property <string> current-pack;
    // stickers were sent from here: the recently used tab shows, before the packs
    in property <bool> has-recent;
    in-out property <string> pack-url;
    callback pick-pack(string);
    callback send-sticker(string, int);
    // take the recently used tab's sticker at this index off it
    callback forget-recent(int);
    callback add-pack-url(string);
    // move the pack at this index to that one
    callback move-pack(int, int);
    // asks first
    callback remove-pack(int);
    // the installed pack's index among `packs`, -1 if it isn't one
    pure callback pack-index(string) -> int;
    // a pack not installed, in a tab of its own after the installed ones
    in property <bool> has-preview;
    in property <PreviewItem> preview;
    callback install-preview();
    callback retry-preview();
    // the grid's sticker to show (scrolled to and marked for a moment), -1 none
    in-out property <int> focus-index: -1;
    // the grid's sticker to show big, -1 none; answered with `peek-img`, made at `peek-size`
    // (its size in chats) on its longer side
    callback peek(int);
    in property <image> peek-img;
    in property <float> peek-size: 180;
}

// A pack's cover with rounded corners. `small`: smaller in its selected tab, drawn from an image
// made at that size (the renderer scales nearest-neighbor); sizes match `PACK_COVER(_SMALL)`.
component PackCover inherits Rectangle {
    in property <PackItem> pack;
    in property <bool> small;
    width: root.small ? 28px : 32px;
    height: self.width;
    border-radius: root.small ? 5px : 6px;
    // no size animation: the software renderer steps it in whole pixels, nearest-neighbor
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        // until the small one arrives, the other one scaled
        source: root.small && root.pack.cover-small.width > 0 ? root.pack.cover-small : root.pack.cover;
        image-fit: contain;
    }
}

// Installed packs: drag a row to reorder, click it to open the pack.
component PackList inherits Rectangle {
    property <length> row-h: 44px;
    // the pressed row (-1 none), and whether it has moved far enough to be a drag
    property <int> drag: -1;
    property <bool> dragging;
    // the pointer's y in the visible part, so the drop place follows while the list scrolls
    property <length> drag-vy;
    // the gap between rows it would drop into, 0 to packs.length
    property <int> slot: clamp(round((self.drag-vy - view.content-y) / self.row-h), 0, StickerData.packs.length);
    property <bool> lands: self.dragging && self.slot != self.drag && self.slot != self.drag + 1;
    // how near an edge a drag scrolls the list
    property <length> edge: 28px;

    ThinScroll {
        width: parent.width;
        height: parent.height;
        content-y <=> view.content-y;
        content-height: view.content-height;
        visible-height: view.visible-height;
        view := ScrollView {
            width: parent.width;
            height: parent.height;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            content-height: StickerData.packs.length * root.row-h;
            for p[i] in StickerData.packs: Rectangle {
                x: 0px;
                y: i * root.row-h;
                // clear of the scrollbar thumb
                width: view.visible-width - 8px;
                height: root.row-h;
                border-radius: 10px;
                background: root.dragging && root.drag == i ? Theme.selected : (root.drag < 0 && ta.has-hover ? Theme.hover : transparent);
                ta := TouchArea {
                    mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
                    pointer-event(e) => {
                        if e.button != PointerEventButton.left {
                            return;
                        }
                        if e.kind == PointerEventKind.down {
                            root.drag = i;
                            root.dragging = false;
                            root.drag-vy = parent.y + self.mouse-y + view.content-y;
                        } else if e.kind == PointerEventKind.up && root.drag == i {
                            if root.lands {
                                StickerData.move-pack(i, root.slot > i ? root.slot - 1 : root.slot);
                            } else if !root.dragging {
                                StickerData.pick-pack(p.id);
                            }
                            root.drag = -1;
                            root.dragging = false;
                        }
                    }
                    moved => {
                        if root.drag != i {
                            return;
                        }
                        root.drag-vy = parent.y + self.mouse-y + view.content-y;
                        if !root.dragging && abs(self.mouse-y - self.pressed-y) > 4px {
                            root.dragging = true;
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 4px;
                    spacing: 10px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.grip;
                        filled: true;
                        size: 16px;
                    }
                    PackCover {
                        y: (parent.height - self.height) / 2;
                        pack: p;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: p.title;
                            color: Theme.text;
                            overflow: elide;
                        }
                        if p.author != "": Text {
                            text: p.author;
                            color: Theme.subtle;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.trash;
                        accessible-role: button;
                        accessible-label: @tr("Remove");
                        clicked => { StickerData.remove-pack(i); }
                        Tip { hovered: parent.hovered; text: @tr("Remove"); }
                    }
                }
            }
            // where the dragged row would land
            Rectangle {
                x: 4px;
                y: root.slot * root.row-h - 1px;
                width: view.visible-width - 16px;
                height: 2px;
                border-radius: 1px;
                visible: root.lands;
                background: Theme.accent;
            }
        }
    }

    Timer {
        interval: 16ms;
        running: root.dragging && (root.drag-vy < root.edge || root.drag-vy > view.visible-height - root.edge);
        triggered => {
            view.content-y = clamp(view.content-y + (root.drag-vy < root.edge ? 6px : -6px), min(0px, view.visible-height - view.content-height), 0px);
        }
    }
}

export component StickerPanel inherits Rectangle {
    callback create-pack();
    callback close();

    property <length> cell: 84px;
    // a sticker's size in its cell: keep PICKER_CELL (src/backend/stickers.rs) equal to it
    property <length> art: cell - 4px;
    // the side paddings, and room for the grid's scrollbar thumb
    property <int> cols: max(1, floor((self.width - 50px) / cell));
    property <bool> manage: StickerData.current-pack == "" || StickerData.current-pack == "+";
    property <bool> previewing: StickerData.has-preview && StickerData.current-pack == StickerData.preview.pack.id;
    property <bool> recent: StickerData.current-pack == "recent";
    // the tab under the pointer (the preview's is `packs.length`, the recently used one's
    // `packs.length + 1`), and its x in the strip's view: the hint is drawn outside the strip,
    // which would clip it
    property <int> tip-i: -1;
    property <length> tip-x;
    property <string> tip-text: root.tip-i == StickerData.packs.length + 1 ? @tr("Recently used")
        : root.tip-i >= 0 && root.tip-i < StickerData.packs.length ? StickerData.packs[root.tip-i].title : StickerData.preview.pack.title;
    // the recently used tab comes before the installed packs', the preview's after them
    property <int> lead-tabs: StickerData.has-recent ? 1 : 0;
    // a tab and the gap after it. The strip's width comes from the count, not from its layout:
    // that is laid out only when drawn, after the tabs that just arrived are revealed.
    property <length> tab-pitch: 44px;
    property <length> tabs-width: max(0px, (StickerData.packs.length + root.lead-tabs + (StickerData.has-preview ? 1 : 0)) * root.tab-pitch - 4px);
    // the selected tab comes into view: when picked, when the panel opens, when the tabs arrive
    // the grid cell under the pointer (-1 none), and whether a big copy of it shows: once the
    // pointer has rested a moment, then at once from cell to cell until it has been off the
    // cells a while
    property <int> hover-i: -1;
    // that cell's place in the panel (the grid is in an `if`: its ids aren't reachable here)
    property <length> hover-x;
    property <length> hover-y;
    property <bool> peeking;
    // the grid is scrolling (`ThinScroll.scrolling`): the big one goes meanwhile, so it doesn't
    // change with every cell passing under the pointer, and comes back at once where the pointer
    // rests after
    property <bool> scrolling;
    // off for now: some may find it in the way, and whether it needs a setting is still open
    property <bool> peek-enabled: false;
    property <int> peek-i: root.peek-enabled && root.peeking && !root.manage ? root.hover-i : -1;
    function hovered(i: int, x: length, y: length) {
        root.hover-i = i;
        root.hover-x = x - root.absolute-position.x;
        root.hover-y = y - root.absolute-position.y;
    }
    changed peek-i => { StickerData.peek(self.peek-i); }
    // the recently used sticker right-clicked, and where its menu opens (in the panel)
    property <int> menu-i: -1;
    property <length> menu-x;
    property <length> menu-y;
    property <string> cur: StickerData.current-pack;
    property <bool> loaded: StickerData.packs-loaded;
    changed cur => {
        root.hover-i = -1;
        root.peeking = false;
        root.reveal-tab();
    }
    changed loaded => { root.reveal-tab(); }
    init => { root.reveal-tab(); }
    function reveal-tab() {
        let i = StickerData.pack-index(root.cur);
        if !root.previewing && !root.recent && i < 0 {
            return;
        }
        let left = root.recent ? 0px : (root.lead-tabs + (root.previewing ? StickerData.packs.length : i)) * root.tab-pitch;
        // the least move that puts the tab clear of the edge fades
        let x = clamp(strip.content-x, strip.width - 28px - left - 40px, 28px - left);
        strip.content-x = clamp(x, min(0px, strip.width - strip.content-width), 0px);
    }

    height: 308px;
    // a card over the composer, inset like it
    Rectangle {
        x: 16px;
        y: 8px;
        width: parent.width - 32px;
        height: parent.height - 8px;
        border-radius: 16px;
        background: Theme.sidebar;
        border-width: 1px;
        border-color: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        spacing: 6px;
        // pack tabs
        HorizontalLayout {
            height: 40px;
            spacing: 4px;
            Rectangle {
                horizontal-stretch: 1;
                strip := HStrip {
                    content-width: root.tabs-width;
                    tabs := HorizontalLayout {
                        spacing: 4px;
                        if StickerData.has-recent: Rectangle {
                            width: 40px;
                            height: 40px;
                            accessible-role: button;
                            accessible-label: @tr("Recently used");
                            border-radius: 10px;
                            background: root.recent ? Theme.selected : (rta.has-hover ? Theme.hover : transparent);
                            Icon { icon: Icons.recent; size: 24px; tint: root.recent ? Theme.accent : Theme.subtle; }
                            rta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { StickerData.pick-pack("recent"); }
                                changed has-hover => {
                                    if self.has-hover {
                                        root.tip-i = StickerData.packs.length + 1;
                                        root.tip-x = parent.x + strip.content-x;
                                    } else if root.tip-i == StickerData.packs.length + 1 {
                                        root.tip-i = -1;
                                    }
                                }
                            }
                        }
                        for p[i] in StickerData.packs: Rectangle {
                            width: 40px;
                            height: 40px;
                            accessible-role: button;
                            accessible-label: p.title;
                            border-radius: 10px;
                            background: p.id == StickerData.current-pack ? Theme.selected : (pta.has-hover ? Theme.hover : transparent);
                            PackCover { pack: p; small: p.id == StickerData.current-pack; }
                            pta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { StickerData.pick-pack(p.id); }
                                changed has-hover => {
                                    if self.has-hover {
                                        root.tip-i = i;
                                        root.tip-x = parent.x + strip.content-x;
                                    } else if root.tip-i == i {
                                        root.tip-i = -1;
                                    }
                                }
                            }
                        }
                        // not installed: outlined, apart from the installed ones
                        if StickerData.has-preview: Rectangle {
                            width: 40px;
                            height: 40px;
                            accessible-role: button;
                            accessible-label: StickerData.preview.pack.title;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.accent;
                            background: root.previewing ? Theme.selected : (prta.has-hover ? Theme.hover : transparent);
                            PackCover { pack: StickerData.preview.pack; small: root.previewing; }
                            prta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { StickerData.pick-pack(StickerData.preview.pack.id); }
                                changed has-hover => {
                                    if self.has-hover {
                                        root.tip-i = StickerData.packs.length;
                                        root.tip-x = parent.x + strip.content-x;
                                    } else if root.tip-i == StickerData.packs.length {
                                        root.tip-i = -1;
                                    }
                                }
                            }
                        }
                    }
                }
                // fades at an edge that cuts tabs off, so the strip shows there are more
                // (Rectangles take no pointer, so the tabs under them stay clickable)
                Rectangle {
                    x: 0px;
                    width: 28px;
                    visible: strip.content-x < -1px;
                    background: @linear-gradient(90deg, Theme.sidebar, Theme.sidebar.with-alpha(0));
                }
                Rectangle {
                    x: parent.width - self.width;
                    width: 28px;
                    visible: strip.content-x > min(0px, strip.width - strip.content-width) + 1px;
                    background: @linear-gradient(90deg, Theme.sidebar.with-alpha(0), Theme.sidebar);
                }
            }
            // outside the strip so it stays in reach however many packs there are
            IconButton {
                width: 40px;
                height: 40px;
                icon: Icons.settings;
                active: root.manage;
                accessible-role: button;
                accessible-label: @tr("Manage packs");
                clicked => { StickerData.pick-pack("+"); }
                Tip { hovered: parent.hovered; text: @tr("Manage packs"); }
            }
        }
        // a pack not installed: what it is, and installing it
        if root.previewing && !StickerData.preview.failed: HorizontalLayout {
            height: 40px;
            spacing: 10px;
            padding-left: 4px;
            padding-right: 4px;
            PackCover {
                y: (parent.height - self.height) / 2;
                pack: StickerData.preview.pack;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: StickerData.preview.loading ? @tr("Loading…") : StickerData.preview.pack.title;
                    color: StickerData.preview.loading ? Theme.subtle : Theme.text;
                    font-weight: 700;
                    overflow: elide;
                }
                if !StickerData.preview.loading && !StickerData.preview.failed: Text {
                    text: (StickerData.preview.pack.author != "" ? StickerData.preview.pack.author + " · " : "")
                        + @tr("{n} sticker" | "{n} stickers" % StickerData.preview.count);
                    color: Theme.subtle;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            PrimaryButton {
                y: (parent.height - self.height) / 2;
                text: StickerData.preview.installing ? @tr("Adding…") : @tr("Add");
                enabled: !StickerData.preview.loading && !StickerData.preview.failed && !StickerData.preview.installing;
                progress: StickerData.preview.installing ? StickerData.preview.progress : -1;
                clicked => { StickerData.install-preview(); }
            }
        }
        if root.previewing && StickerData.preview.failed: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 10px;
            Text {
                text: @tr("Couldn't load the sticker pack");
                color: Theme.subtle;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                PlainButton {
                    text: @tr("Try again");
                    clicked => { StickerData.retry-preview(); }
                }
            }
        }
        // the manifest on its way: the header says so
        if root.previewing && StickerData.preview.loading: Rectangle { vertical-stretch: 1; }
        // sticker grid
        if !root.manage && !(root.previewing && (StickerData.preview.loading || StickerData.preview.failed)): grid := ThinScroll {
            property <int> first: max(0, floor(-grid-view.content-y / root.cell)) * root.cols;
            property <int> end: min(StickerData.stickers.length, ceil((-grid-view.content-y + grid-view.visible-height) / root.cell) * root.cols);
            property <int> focused: StickerData.focus-index;
            init => {
                Anim.picker-view(self.first, self.end);
                self.show-focus();
            }
            changed scrolling => {
                root.scrolling = self.scrolling;
                if self.scrolling {
                    root.hover-i = -1;
                }
            }
            changed first => { Anim.picker-view(self.first, self.end); }
            changed end => { Anim.picker-view(self.first, self.end); }
            changed focused => { self.show-focus(); }
            // the focused sticker's row in the middle, as far as the grid goes
            function show-focus() {
                if self.focused >= 0 {
                    grid-view.content-y = -clamp(floor(self.focused / root.cols) * root.cell - (grid-view.visible-height - root.cell) / 2, 0px, max(0px, grid-view.content-height - grid-view.visible-height));
                }
            }
            vertical-stretch: 1;
            max-width: 100000px;
            content-y <=> grid-view.content-y;
            content-height: grid-view.content-height;
            visible-height: grid-view.visible-height;
            grid-view := ScrollView {
                width: parent.width;
                height: parent.height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                content-height: ceil(StickerData.stickers.length / root.cols) * root.cell;
                for s[i] in StickerData.stickers: Rectangle {
                    x: mod(i, root.cols) * root.cell;
                    y: floor(i / root.cols) * root.cell;
                    width: root.cell;
                    height: root.cell;
                    border-radius: 12px;
                    // a preview's stickers aren't sent: no hover that says they are
                    background: !root.previewing && sta.has-hover ? Theme.hover : transparent;
                    border-width: i == StickerData.focus-index ? 2px : 0px;
                    border-color: Theme.accent;
                    Image {
                        width: root.art;
                        height: root.art;
                        source: s.anim.width > 0 ? s.anim : s.img;
                        image-fit: contain;
                    }
                    // a previewed pack's sticker on its way
                    if root.previewing && s.img.width == 0 && !s.failed: Rectangle {
                        width: root.art;
                        height: root.art;
                        border-radius: 10px;
                        background: Theme.loading;
                    }
                    if s.failed: Icon {
                        icon: Icons.warning;
                        size: 20px;
                        tint: Theme.subtle;
                    }
                    // the pointer on it plays it
                    if Anim.hover-only && s.animated && !sta.has-hover: MediaLabel {
                        icon: Icons.play;
                        x: 6px;
                        y: parent.height - self.height - 6px;
                    }
                    sta := TouchArea {
                        mouse-cursor: root.previewing ? MouseCursor.default : MouseCursor.pointer;
                        clicked => {
                            if !root.previewing {
                                StickerData.send-sticker(s.pack, s.id);
                            }
                        }
                        pointer-event(e) => {
                            if root.recent && e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                                root.menu-i = i;
                                root.menu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                root.menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                recent-menu.show();
                            }
                        }
                        changed has-hover => {
                            if s.animated { Anim.hover(s.pack, s.id, self.has-hover); }
                            if self.has-hover && !root.scrolling {
                                root.hovered(i, parent.absolute-position.x, parent.absolute-position.y);
                            } else if root.hover-i == i {
                                root.hover-i = -1;
                            }
                        }
                    }
                    property <int> settled: grid.settled;
                    changed settled => {
                        if sta.has-hover {
                            root.hovered(i, self.absolute-position.x, self.absolute-position.y);
                        }
                    }
                }
            }
        }
        // the pack page: add one (a signal.art link, or make one), then the installed packs
        if root.manage: VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            padding-top: 4px;
            HorizontalLayout {
                spacing: 6px;
                padding-left: 4px;
                padding-right: 4px;
                Field {
                    height: 32px;
                    placeholder: @tr("Paste a signal.art sticker link");
                    text <=> StickerData.pack-url;
                    accepted => { StickerData.add-pack-url(StickerData.pack-url); }
                    key-pressed(event) => {
                        if (event.text != Key.Escape) {
                            return reject;
                        }
                        root.close();
                        accept
                    }
                }
                PlainButton {
                    text: @tr("Open");
                    clicked => { StickerData.add-pack-url(StickerData.pack-url); }
                }
                PlainButton {
                    text: @tr("Create a sticker pack");
                    clicked => { root.create-pack(); }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // holds the rest of the panel whatever shows in it
            Rectangle {
                vertical-stretch: 1;
                if StickerData.packs-loaded && StickerData.packs.length == 0: Text {
                    width: parent.width;
                    height: parent.height;
                    text: @tr("No sticker packs yet");
                    color: Theme.subtle;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if StickerData.packs.length > 0: PackList {
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }

    // the hovered tab's title, below it (padding-left / padding-top of the layout)
    Rectangle {
        x: 20px + root.tip-x;
        y: 16px;
        width: 40px;
        height: 40px;
        Tip {
            hovered: root.tip-i >= 0 && root.tip-text != "";
            place: TipPlace.below-center;
            text: root.tip-text;
        }
    }

    recent-menu := ChipMenu {
        // German needs more than the menu's usual width
        width: 260px;
        x: min(root.menu-x, root.width - self.width - 16px);
        y: root.menu-y;
        MenuRow {
            icon: Icons.trash;
            text: @tr("Remove from recently used");
            clicked => {
                StickerData.forget-recent(root.menu-i);
                recent-menu.close();
            }
        }
    }

    Timer {
        interval: 1500ms;
        running: StickerData.focus-index >= 0;
        triggered => { StickerData.focus-index = -1; }
    }

    Timer {
        interval: 400ms;
        running: !root.peeking && root.hover-i >= 0;
        triggered => { root.peeking = true; }
    }
    Timer {
        interval: 300ms;
        running: root.peeking && root.hover-i < 0 && !root.scrolling;
        triggered => { root.peeking = false; }
    }

    // the sticker under the pointer, big, right above its cell where the eyes are, hiding none
    // of its row or those below; below the cell if the window has no room above. It takes no
    // pointer, so the cells it covers still get it.
    if root.peek-i >= 0 && StickerData.peek-img.width > 0: Rectangle {
        property <length> side: StickerData.peek-size * 1px;
        width: self.side + 24px;
        height: self.side + 24px;
        x: clamp(root.hover-x + root.cell / 2 - self.width / 2, 16px, root.width - 16px - self.width);
        y: root.hover-y - self.height + root.absolute-position.y >= 8px ? root.hover-y - self.height : root.hover-y + root.cell;
        border-radius: 16px;
        background: Theme.sidebar;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        Image {
            width: parent.side;
            height: parent.side;
            source: StickerData.peek-img;
            image-fit: contain;
        }
    }
}
