// Sticker picker panel.

import { PackItem, StickerItem } from "types.slint";
import { Anim, Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Field, HStrip, PlainButton, TextButton, ThinScroll } from "widgets.slint";
import { Icons } from "icons.slint";

export component StickerPanel inherits Rectangle {
    in property <[PackItem]> packs;
    in property <[StickerItem]> stickers;
    in property <string> current-pack;
    in-out property <string> url-text;
    callback pick-pack(string);
    callback send-sticker(string, int);
    callback install-pack(string);
    callback add-pack-url(string);
    callback create-pack();
    callback close();

    property <length> cell: 84px;
    // the side paddings, and room for the grid's scrollbar thumb
    property <int> cols: max(1, floor((self.width - 50px) / cell));
    property <bool> suggest: current-pack == "" || current-pack == "+";

    height: 308px;
    // a card over the composer, inset like it
    Rectangle {
        x: 16px;
        y: 8px;
        width: parent.width - 32px;
        height: parent.height - 8px;
        border-radius: 16px;
        background: Theme.sidebar;
        border-width: 1px;
        border-color: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        spacing: 6px;
        // pack tabs
        HStrip {
            height: 40px;
            content-width: tabs.preferred-width;
            tabs := HorizontalLayout {
                spacing: 4px;
                for p in root.packs: Rectangle {
                    visible: p.installed;
                    width: p.installed ? 40px : 0px;
                    height: 40px;
                    border-radius: 10px;
                    background: p.id == root.current-pack ? Theme.selected : (pta.has-hover ? Theme.hover : transparent);
                    Image { width: 32px; height: 32px; source: p.cover; image-fit: contain; }
                    pta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-pack(p.id); }
                    }
                }
                TextButton {
                    y: 6px;
                    text: @tr("Add pack");
                    icon: Icons.plus;
                    active: root.suggest;
                    clicked => { root.pick-pack("+"); }
                }
            }
        }
        // sticker grid
        if !root.suggest: ThinScroll {
            property <int> first: max(0, floor(-grid-view.content-y / root.cell)) * root.cols;
            property <int> end: min(root.stickers.length, ceil((-grid-view.content-y + grid-view.visible-height) / root.cell) * root.cols);
            init => { Anim.picker-view(self.first, self.end); }
            changed first => { Anim.picker-view(self.first, self.end); }
            changed end => { Anim.picker-view(self.first, self.end); }
            vertical-stretch: 1;
            max-width: 100000px;
            content-y <=> grid-view.content-y;
            content-height: grid-view.content-height;
            visible-height: grid-view.visible-height;
            grid-view := ScrollView {
                width: parent.width;
                height: parent.height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                content-height: ceil(root.stickers.length / root.cols) * root.cell;
                for s[i] in root.stickers: Rectangle {
                    x: mod(i, root.cols) * root.cell;
                    y: floor(i / root.cols) * root.cell;
                    width: root.cell;
                    height: root.cell;
                    border-radius: 12px;
                    background: sta.has-hover ? Theme.hover : transparent;
                    Image {
                        width: root.cell - 12px;
                        height: root.cell - 12px;
                        source: s.anim.width > 0 ? s.anim : s.img;
                        image-fit: contain;
                    }
                    sta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.send-sticker(root.current-pack, s.id); }
                        changed has-hover => {
                            if s.animated { Anim.hover(root.current-pack, s.id, self.has-hover); }
                        }
                    }
                }
            }
        }
        // add packs: Signal's built-in packs + signal.art link
        if root.suggest: ThinScroll {
            vertical-stretch: 1;
            max-width: 100000px;
            content-y <=> sug-view.content-y;
            content-height: sug-view.content-height;
            visible-height: sug-view.visible-height;
            sug-view := ScrollView {
                width: parent.width;
                height: parent.height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                content-height: sug.preferred-height;
                sug := VerticalLayout {
                    // the Add buttons clear of the scrollbar's thumb
                    width: sug-view.visible-width - 12px;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: start;
                        PlainButton {
                            text: @tr("Create a sticker pack");
                            clicked => { root.create-pack(); }
                        }
                    }
                    Rectangle { height: 4px; }
                    Text { text: @tr("Featured sticker packs"); color: Theme.subtle; font-size: 12px; }
                    for p in root.packs: HorizontalLayout {
                        visible: !p.installed;
                        height: p.installed ? 0px : 34px;
                        spacing: 8px;
                        Text {
                            text: p.title;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        PlainButton {
                            text: @tr("Add");
                            clicked => { root.install-pack(p.id); }
                        }
                    }
                    Rectangle { height: 8px; }
                    Text { text: @tr("Add from a signal.art sticker link"); color: Theme.subtle; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 6px;
                        Field {
                            height: 32px;
                            placeholder: "https://signal.art/addstickers/#pack_id=…&pack_key=…";
                            text <=> root.url-text;
                            accepted => { root.add-pack-url(root.url-text); }
                            key-pressed(event) => {
                                if (event.text != Key.Escape) {
                                    return reject;
                                }
                                root.close();
                                accept
                            }
                        }
                        PlainButton {
                            text: @tr("Add");
                            clicked => { root.add-pack-url(root.url-text); }
                        }
                    }
                }
            }
        }
    }
}
