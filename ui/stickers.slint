// Sticker picker panel.

import { LineEdit, Button } from "std-widgets.slint";
import { PackItem, StickerItem } from "types.slint";
import { Anim, Theme } from "theme.slint";
import { TextButton } from "widgets.slint";
import { Icons } from "icons.slint";

export component StickerPanel inherits Rectangle {
    in property <[PackItem]> packs;
    in property <[StickerItem]> stickers;
    in property <string> current-pack;
    in-out property <string> url-text;
    callback pick-pack(string);
    callback send-sticker(string, int);
    callback install-pack(string);
    callback add-pack-url(string);

    property <length> cell: 84px;
    property <int> cols: max(1, floor((self.width - 40px) / cell));
    property <bool> suggest: current-pack == "" || current-pack == "+";

    height: 308px;
    // a card over the composer, inset like it
    Rectangle {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: parent.height - 8px;
        border-radius: 16px;
        background: Theme.sidebar;
        border-width: 1px;
        border-color: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        spacing: 6px;
        // pack tabs
        // The wheel only scrolls vertically, which this Flickable can't: the parent TouchArea
        // gets the event the Flickable rejects and turns it into a horizontal move.
        TouchArea {
            height: 40px;
            scroll-event(e) => {
                tabs-flick.content-x = clamp(tabs-flick.content-x + (e.delta-y != 0px ? e.delta-y : e.delta-x),
                    min(0px, tabs-flick.width - tabs-flick.content-width), 0px);
                accept
            }
            tabs-flick := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: tabs.preferred-width;
                tabs := HorizontalLayout {
                    spacing: 4px;
                    for p in root.packs: Rectangle {
                        visible: p.installed;
                        width: p.installed ? 40px : 0px;
                        height: 40px;
                        border-radius: 10px;
                        background: p.id == root.current-pack ? Theme.selected : (pta.has-hover ? Theme.hover : transparent);
                        Image { width: 32px; height: 32px; source: p.cover; image-fit: contain; }
                        pta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick-pack(p.id); }
                        }
                    }
                    TextButton {
                        y: 6px;
                        text: "팩 추가";
                        icon: Icons.plus;
                        active: root.suggest;
                        clicked => { root.pick-pack("+"); }
                    }
                }
            }
        }
        // sticker grid
        if !root.suggest: Flickable {
            vertical-stretch: 1;
            max-width: 100000px;
            content-height: ceil(root.stickers.length / root.cols) * root.cell;
            for s[i] in root.stickers: Rectangle {
                x: mod(i, root.cols) * root.cell;
                y: floor(i / root.cols) * root.cell;
                width: root.cell;
                height: root.cell;
                border-radius: 12px;
                background: sta.has-hover ? Theme.hover : transparent;
                Image {
                    width: root.cell - 12px;
                    height: root.cell - 12px;
                    source: s.frames.length > 0 ? s.frames[s.frame[0]] : s.img;
                    image-fit: contain;
                }
                sta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.send-sticker(root.current-pack, s.id); }
                    changed has-hover => {
                        if s.animated { Anim.hover(root.current-pack, s.id, self.has-hover); }
                    }
                }
            }
        }
        // add packs: Signal's built-in packs + signal.art link
        if root.suggest: Flickable {
            vertical-stretch: 1;
            max-width: 100000px;
            content-height: sug.preferred-height;
            sug := VerticalLayout {
                spacing: 4px;
                Text { text: "추천 스티커 팩"; color: Theme.subtle; font-size: 12px; }
                for p in root.packs: HorizontalLayout {
                    visible: !p.installed;
                    height: p.installed ? 0px : 34px;
                    spacing: 8px;
                    Text {
                        text: p.title;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Button {
                        text: "추가";
                        clicked => { root.install-pack(p.id); }
                    }
                }
                Rectangle { height: 8px; }
                Text { text: "signal.art 스티커 링크로 추가"; color: Theme.subtle; font-size: 12px; }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: "https://signal.art/addstickers/#pack_id=…&pack_key=…";
                        text <=> root.url-text;
                        accepted(t) => { root.add-pack-url(t); }
                    }
                    Button {
                        text: "추가";
                        clicked => { root.add-pack-url(root.url-text); }
                    }
                }
            }
        }
    }
}
