// Theme colors and the link-click hook.

import { Palette } from "std-widgets.slint";

// clickable links in message text (see src/link.rs)
export global Links {
    callback open(string);
}

// animated stickers (src/gui/anim.rs). A row with frames shows `frames[frame[0]]`: `frame` is a
// one-element model the Rust timer updates at each frame's exact time, shared by the rows of one
// sticker, so a frame change touches just that image.
export global Anim {
    // a sticker row was put on screen or changed (message id): load its frames, keep them longer
    callback shown(string);
    // a picker sticker gained or lost the hover
    callback hover(string, int, bool);
    // a GIF picture in the message list (message id) gained or lost the hover: it plays meanwhile
    callback gif-hover(string, int, bool);
}

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> accent: #2c6bed;
    out property <color> sidebar: dark ? #1b1b1d : #f6f6f8;
    out property <color> pane: dark ? #121212 : #ffffff;
    // visually identical twin of `pane`, used to force a full repaint (see AppWindow.repaint-flip)
    out property <color> pane-twin: dark ? #121213 : #fffffe;
    out property <color> border: dark ? #2a2a2d : #e3e3e6;
    out property <color> text: dark ? #e9e9eb : #1b1b1d;
    out property <color> subtle: dark ? #9a9aa0 : #6b6b70;
    out property <color> bubble-in: dark ? #2b2b2e : #e9e9eb;
    out property <color> bubble-out: accent;
    out property <color> selected: dark ? #2c2c31 : #dfe7fb;
    out property <color> hover: dark ? #232326 : #ececf0;
    // input fields without a border (search box, composer), and a button that can't be used on one
    out property <color> field: dark ? #242427 : #eeeff2;
    out property <color> field-off: dark ? #33333a : #dcdde2;
    // a card of related rows on the pane (settings sections)
    out property <color> group: dark ? #1b1b1d : #f4f5f7;
    // destructive actions (delete, block)
    out property <color> danger: dark ? #ff6369 : #e5484d;
    // a message that failed to send
    out property <color> failed: dark ? #ff6b6b : #d32f2f;
    // links in incoming bubbles and in text on the pane
    out property <color> link: dark ? #7aa7ff : #1f5fd6;
    // a file that may be unsafe to open: its mark, and the warning text beside it
    out property <color> warning: #d97706;
    out property <color> warning-text: #f0a030;
}
